<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Menu Management | Restaurant Owner | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="min-h-screen bg-orange-50 font-sans">
  <div class="flex min-h-screen">
    <%- include('../partials/restaurantOwner/sidebar') %>

      <!-- MAIN CONTENT -->
      <main class="flex-1 lg:ml-72 p-5 sm:p-8 transition-all duration-300" id="mainContentWrapper">
        <div class="mb-8 flex justify-between items-center">
          <div class="flex flex-wrap items-start md:items-center gap-3">
            <button onclick="toggleSidebar()"
              class="p-2 -ml-2 mt-1 md:mt-0 text-gray-600 hover:text-orange-500 rounded-xl hover:bg-orange-50 transition-colors lg:hidden">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
            <div>
              <h2 class="text-2xl font-bold text-gray-800">Menu Management</h2>
              <p class="text-gray-500 mt-1">Manage categories and menu items for each branch.</p>

            </div>
          </div>
        </div>

        <!-- Step 1: Select Restaurant & Branch -->
        <div class="bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-gray-100 mb-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Restaurant</label>
              <select id="restaurantSelect"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none transition-colors">
                <option value="" disabled selected>Loading restaurants...</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">Branch</label>
              <select id="branchSelect"
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none transition-colors"
                disabled>
                <option value="" disabled selected>Select a restaurant first</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Tabs (hidden until branch is selected) -->
        <div id="branchTabs" class="hidden flex gap-4 mb-6 border-b border-gray-200">
          <button id="tabCategories"
            class="py-2 px-4 border-b-2 border-orange-500 font-bold text-orange-600 transition-colors"
            onclick="switchMenuTab('categories')">Categories & Items</button>
          <button id="tabModifiers"
            class="py-2 px-4 border-b-2 border-transparent font-medium text-gray-500 hover:text-gray-800 transition-colors"
            onclick="switchMenuTab('modifiers')">Modifiers</button>
        </div>

        <!-- Category Management -->
        <div id="categorySection" class="hidden">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-xl font-bold text-gray-800">Categories</h3>
            <div class="flex gap-2">
              <button onclick="openCsvModal()"
                class="bg-green-500 hover:bg-green-600 text-white px-4 py-2.5 rounded-lg font-medium shadow transition-colors flex items-center gap-2">
                Import CSV
              </button>
              <button onclick="openAddCategoryModal()"
                class="bg-orange-500 hover:bg-orange-600 text-white px-5 py-2.5 rounded-lg font-medium shadow transition-colors flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                New Category
              </button>
            </div>
          </div>

          <div id="categoriesContainer" class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="p-5 sm:p-8 text-center text-gray-500">Loading categories...</div>
          </div>
        </div>

        <!-- Modifiers Management -->
        <div id="modifiersSection" class="hidden">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-xl font-bold text-gray-800">Modifier Groups</h3>
            <button onclick="openAddModifierGroupModal()"
              class="bg-orange-500 hover:bg-orange-600 text-white px-5 py-2.5 rounded-lg font-medium shadow transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              New Group
            </button>
          </div>

          <div id="modifiersContainer" class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="p-5 sm:p-8 text-center text-gray-500">Loading modifiers...</div>
          </div>
        </div>

        <!-- Placeholder when no branch selected -->
        <div id="placeholderSection"
          class="bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center justify-center min-h-[300px]">
          <div class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center text-orange-500 mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01">
              </path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-700">Select a Restaurant & Branch</h3>
          <p class="text-gray-500 text-sm mt-1 text-center max-w-xs">Choose a restaurant and branch above to view and
            manage its menu categories.</p>
        </div>
      </main>
  </div>

  <!-- Add / Edit Category Modal -->
  <div id="categoryModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-md rounded-2xl shadow-xl p-4 sm:p-6">
      <h3 id="categoryModalTitle" class="text-xl font-bold text-gray-800 mb-4">Add Category</h3>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Name <span class="text-red-500">*</span></label>
          <input type="text" id="categoryName" placeholder="e.g. Starters"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Description</label>
          <input type="text" id="categoryDescription" placeholder="Optional description"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Display Order</label>
          <input type="number" id="categoryOrder" value="0" min="0"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
        </div>
        <input type="hidden" id="editCategoryId" value="" />
        <div class="flex justify-end gap-3 mt-4 pt-4 border-t border-gray-100">
          <button onclick="closeCategoryModal()"
            class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg">Cancel</button>
          <button onclick="saveCategory()" id="saveCategoryBtn"
            class="px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-lg font-medium shadow">Save</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Add / Edit Menu Item Modal -->
  <div id="menuItemModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-2xl rounded-2xl shadow-xl p-4 sm:p-6 max-h-[90vh] overflow-y-auto">
      <h3 id="itemModalTitle" class="text-xl font-bold text-gray-800 mb-4">Add Menu Item</h3>
      <div class="space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Name <span
                class="text-red-500">*</span></label>
            <input type="text" id="itemName" placeholder="e.g. Paneer Tikka"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">SKU (Unique) <span
                class="text-red-500">*</span></label>
            <input type="text" id="itemSku" placeholder="e.g. PT-001"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Description</label>
          <textarea id="itemDescription" rows="2" placeholder="Delicious paneer marinated in spices..."
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none"></textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Base Price (₹) <span
                class="text-red-500">*</span></label>
            <input type="number" id="itemPrice" min="0" step="0.01" placeholder="e.g. 250"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Food Type <span
                class="text-red-500">*</span></label>
            <select id="itemFoodType"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none">
              <option value="VEG">Vegetarian</option>
              <option value="NON_VEG">Non-Vegetarian</option>
              <option value="VEGAN">Vegan</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Dietary Tags</label>
          <input type="text" id="itemDietaryTags" placeholder="e.g. Gluten-Free, Dairy-Free"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
          <p class="text-xs text-gray-500 mt-1">Comma separated</p>
        </div>

        <div class="flex flex-wrap items-center gap-3 sm:gap-6">
          <label class="flex items-center cursor-pointer">
            <input type="checkbox" id="itemIsAvailable" checked
              class="w-5 h-5 text-orange-500 border-gray-300 rounded focus:ring-orange-500" />
            <span class="ml-2 text-gray-700 font-medium">Available in stock</span>
          </label>
          <label class="flex items-center cursor-pointer">
            <input type="checkbox" id="itemIsBestseller"
              class="w-5 h-5 text-orange-500 border-gray-300 rounded focus:ring-orange-500" />
            <span class="ml-2 text-gray-700 font-medium">Mark as Bestseller</span>
          </label>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Item Image (Optional)</label>
          <input type="file" id="itemImage" accept="image/*"
            class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-orange-50 file:text-orange-700 hover:file:bg-orange-100" />
        </div>

        <input type="hidden" id="editItemCategoryId" value="" />
        <input type="hidden" id="editItemId" value="" />

        <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-gray-100">
          <button onclick="closeItemModal()"
            class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg">Cancel</button>
          <button onclick="saveItem()" id="saveItemBtn"
            class="px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-lg font-medium shadow">Save
            Item</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Add / Edit Modifier Group Modal -->
  <div id="modifierGroupModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-md rounded-2xl shadow-xl p-4 sm:p-6">
      <h3 id="groupModalTitle" class="text-xl font-bold text-gray-800 mb-4">Add Modifier Group</h3>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Name <span class="text-red-500">*</span></label>
          <input type="text" id="groupName" placeholder="e.g. Choose Size"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Description</label>
          <input type="text" id="groupDescription" placeholder="Optional description"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Min Selection</label>
            <input type="number" id="groupMin" value="0" min="0"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-1">Max Selection</label>
            <input type="number" id="groupMax" value="1" min="1"
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
          </div>
        </div>
        <div class="flex flex-wrap items-center gap-3 sm:gap-6 mt-2">
          <label class="flex items-center cursor-pointer">
            <input type="checkbox" id="groupIsRequired"
              class="w-5 h-5 text-orange-500 border-gray-300 rounded focus:ring-orange-500" />
            <span class="ml-2 text-gray-700 font-medium">Required</span>
          </label>
          <label class="flex items-center cursor-pointer">
            <input type="checkbox" id="groupMultiSelect"
              class="w-5 h-5 text-orange-500 border-gray-300 rounded focus:ring-orange-500" />
            <span class="ml-2 text-gray-700 font-medium">Allow Multi-Select</span>
          </label>
        </div>
        <input type="hidden" id="editGroupId" value="" />
        <div class="flex justify-end gap-3 mt-4 pt-4 border-t border-gray-100">
          <button onclick="closeModifierGroupModal()"
            class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg">Cancel</button>
          <button onclick="saveModifierGroup()" id="saveGroupBtn"
            class="px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-lg font-medium shadow">Save</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Add / Edit Modifier Option Modal -->
  <div id="modifierOptionModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-md rounded-2xl shadow-xl p-4 sm:p-6">
      <h3 id="optionModalTitle" class="text-xl font-bold text-gray-800 mb-4">Add Option</h3>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Option Name <span
              class="text-red-500">*</span></label>
          <input type="text" id="optionName" placeholder="e.g. Regular"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Price (₹) <span
              class="text-red-500">*</span></label>
          <input type="number" id="optionPrice" value="0" min="0" step="0.01"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
        </div>
        <div>
          <label class="flex items-center cursor-pointer">
            <input type="checkbox" id="optionIsAvailable" checked
              class="w-5 h-5 text-orange-500 border-gray-300 rounded focus:ring-orange-500" />
            <span class="ml-2 text-gray-700 font-medium">Available</span>
          </label>
        </div>
        <input type="hidden" id="editOptionId" value="" />
        <input type="hidden" id="editOptionGroupId" value="" />
        <div class="flex justify-end gap-3 mt-4 pt-4 border-t border-gray-100">
          <button onclick="closeModifierOptionModal()"
            class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg">Cancel</button>
          <button onclick="saveModifierOption()" id="saveOptionBtn"
            class="px-4 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-lg font-medium shadow">Save</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Attach Modifiers to Menu Item Modal -->
  <div id="attachModifiersModal" class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-lg rounded-2xl shadow-xl p-4 sm:p-6">
      <h3 class="text-xl font-bold text-gray-800 mb-4">Manage Modifiers for Item</h3>
      <div class="mb-4">
        <label class="block text-sm font-semibold text-gray-700 mb-1">Attach Modifier Group</label>
        <div class="flex gap-2">
          <select id="attachGroupId"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none">
            <option value="" disabled selected>Select a group...</option>
          </select>
          <button onclick="attachGroupToItem()"
            class="px-4 py-2 bg-orange-500 text-white rounded-lg font-medium whitespace-nowrap">Attach</button>
        </div>
      </div>
      <div id="attachedGroupsContainer" class="space-y-2 mb-4 max-h-[40vh] overflow-y-auto">
        <!-- Attached groups -->
      </div>
      <input type="hidden" id="attachModifiersItemId" value="" />
      <div class="flex justify-end border-t border-gray-100 pt-4 mt-2">
        <button onclick="closeAttachModifiersModal()"
          class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg">Close</button>
      </div>
    </div>
  </div>

  <!-- Availability Schedules Modal -->
  <div id="schedulesModal" class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-lg rounded-2xl shadow-xl p-4 sm:p-6">
      <h3 class="text-xl font-bold text-gray-800 mb-4">Availability Schedules</h3>
      <div class="mb-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">Day</label>
          <select id="scheduleDay" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
            <option value="0">Sunday</option>
            <option value="1">Monday</option>
            <option value="2">Tuesday</option>
            <option value="3">Wednesday</option>
            <option value="4">Thursday</option>
            <option value="5">Friday</option>
            <option value="6">Saturday</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">Start Time</label>
          <input type="time" id="scheduleStart" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">End Time</label>
          <div class="flex gap-2">
            <input type="time" id="scheduleEnd" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
            <button onclick="addSchedule()"
              class="px-3 py-2 bg-orange-500 text-white rounded-lg text-sm font-medium">+</button>
          </div>
        </div>
      </div>
      <div id="schedulesContainer" class="space-y-2 mb-4 max-h-[40vh] overflow-y-auto border-t border-gray-100 pt-4">
        <!-- Schedules -->
      </div>
      <input type="hidden" id="schedulesItemId" value="" />
      <div class="flex justify-end border-t border-gray-100 pt-4 mt-2">
        <button onclick="closeSchedulesModal()"
          class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg">Close</button>
      </div>
    </div>
  </div>

  <!-- CSV Import Modal -->
  <div id="csvModal" class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-md rounded-2xl shadow-xl p-4 sm:p-6">
      <h3 class="text-xl font-bold text-gray-800 mb-4">Bulk Import Menu Items</h3>
      <div class="space-y-4">
        <p class="text-sm text-gray-500">Upload a CSV file containing: categoryId, sku, name, description, basePrice,
          foodType.</p>
        <input type="file" id="csvFile" accept=".csv"
          class="w-full block text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-orange-50 file:text-orange-700 hover:file:bg-orange-100" />
      </div>
      <div class="flex justify-end gap-3 mt-4 pt-4 border-t border-gray-100">
        <button onclick="closeCsvModal()" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg">Cancel</button>
        <button onclick="uploadCsv()" id="uploadCsvBtn"
          class="px-4 py-2 bg-green-500 hover:bg-green-600 text-white rounded-lg font-medium shadow">Upload</button>
      </div>
    </div>
  </div>

  <script>
    let selectedRestaurantId = null;
    let selectedBranchId = null;

    async function loadRestaurantsForDropdown() {
      try {
        const res = await fetch('/restaurant-management/mine');
        const select = document.getElementById('restaurantSelect');
        if (res.ok) {
          const data = await res.json();
          const restaurants = data.restaurants || [];
          if (restaurants.length === 0) {
            select.innerHTML = `<option disabled selected>No restaurants found</option>`;
          } else {
            select.innerHTML = `<option value="" disabled selected>Select a restaurant...</option>` +
              restaurants.map(r => `<option value="${r.id}">${r.businessName}</option>`).join('');
          }
        }
      } catch (err) { console.error(err); }
    }

    async function loadBranches(restaurantId) {
      const branchSelect = document.getElementById('branchSelect');
      branchSelect.disabled = true;
      branchSelect.innerHTML = `<option disabled selected>Loading branches...</option>`;

      try {
        const res = await fetch(`/restaurant-management/${restaurantId}/branches`);
        if (res.ok) {
          const data = await res.json();
          const branches = data.data || data.branches || [];
          if (branches.length === 0) {
            branchSelect.innerHTML = `<option disabled selected>No branches found — create one first</option>`;
          } else {
            branchSelect.innerHTML = `<option value="" disabled selected>Select a branch...</option>` +
              branches.map(b => `<option value="${b.id}">${b.name || b.branchName || b.city || 'Branch ' + b.id}</option>`).join('');
            branchSelect.disabled = false;
          }
        } else {
          branchSelect.innerHTML = `<option disabled selected>Error loading branches</option>`;
        }
      } catch (err) {
        console.error(err);
        branchSelect.innerHTML = `<option disabled selected>Error loading branches</option>`;
      }
    }

    async function loadCategories() {
      if (!selectedBranchId) return;
      const container = document.getElementById('categoriesContainer');
      container.innerHTML = `<div class="p-5 sm:p-8 text-center text-gray-500">Loading...</div>`;

      try {
        const res = await fetch(`/menu-category/branches/${selectedBranchId}/categories`);
        if (res.ok) {
          const data = await res.json();
          const categories = data.data || [];
          if (categories.length === 0) {
