      <form id="addressForm" class="space-y-3.5" novalidate>
        <input type="hidden" id="editAddressId" />

        <!-- Label -->
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-2">Label</label>
          <div class="flex gap-3">
            <label class="label-radio flex-1"><input type="radio" name="label" value="HOME" /><span>🏠
                Home</span></label>
            <label class="label-radio flex-1"><input type="radio" name="label" value="WORK" /><span>💼
                Work</span></label>
            <label class="label-radio flex-1"><input type="radio" name="label" value="OTHER" /><span>📍
                Other</span></label>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1" for="f_contactName">Contact Name</label>
            <input type="text" id="f_contactName" class="if" placeholder="Full name" autocomplete="name" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1" for="f_contactPhone">Contact Phone</label>
            <input type="tel" id="f_contactPhone" class="if" placeholder="10-digit number" autocomplete="tel"
              maxlength="10" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1" for="f_addressLine1">Address Line 1</label>
          <input type="text" id="f_addressLine1" class="if" placeholder="Street, Building, Area"
            autocomplete="address-line1" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1" for="f_addressLine2">
            Address Line 2 <span class="text-gray-400 font-normal">(optional)</span>
          </label>
          <input type="text" id="f_addressLine2" class="if" placeholder="Apartment, Floor, etc."
            autocomplete="address-line2" />
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1" for="f_landmark">
            Landmark <span class="text-gray-400 font-normal">(optional)</span>
          </label>
          <input type="text" id="f_landmark" class="if" placeholder="Nearby landmark" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1" for="f_city">City</label>
            <input type="text" id="f_city" class="if" placeholder="City" autocomplete="address-level2" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1" for="f_state">State</label>
            <input type="text" id="f_state" class="if" placeholder="State" autocomplete="address-level1" />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1" for="f_postalCode">Postal Code</label>
            <input type="text" id="f_postalCode" class="if" placeholder="PIN Code" autocomplete="postal-code"
              maxlength="10" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1" for="f_country">Country</label>
            <input type="text" id="f_country" class="if" placeholder="Country" autocomplete="country-name"
              value="India" />
