              <p class="mt-4 text-sm font-medium bg-orange-600/30 px-3 py-1.5 rounded-lg inline-block" id="loyaltyRatesDisplay">Loading rates...</p>
            </div>

            <h3 class="font-bold text-gray-800 mb-4">Transaction History</h3>
