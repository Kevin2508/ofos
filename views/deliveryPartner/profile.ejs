<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Profile | Delivery Partner | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="min-h-screen bg-orange-50 font-sans">
  <div class="flex min-h-screen">
    <!-- SIDEBAR -->
    <aside
      class="w-64 bg-white border-r border-orange-100 shadow-lg flex flex-col fixed h-full z-10 transition-transform duration-300">
      <div class="p-6 text-center border-b border-orange-50">
        <h1 class="text-3xl font-extrabold text-orange-500">epicureDelivery</h1>
      </div>

      <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
        <a href="/d/delivery-partner-dashboard"
          class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6">
            </path>
          </svg>
          <span>Dashboard</span>
        </a>
        <a href="/d/delivery-partner-assignments"
          class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01">
            </path>
          </svg>
          <span>My Assignments</span>
        </a>
        <a href="/d/delivery-partner-earnings"
          class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
            </path>
          </svg>
          <span>Earnings</span>
        </a>
        <a href="/d/delivery-partner-profile"
          class="flex items-center space-x-3 px-4 py-3 rounded-xl bg-orange-100 text-orange-600 font-semibold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <span>Profile</span>
        </a>
      </nav>

      <div class="p-4 border-t border-orange-50">
        <button id="logoutBtn"
          class="flex items-center justify-center space-x-2 w-full bg-orange-500 text-white rounded-xl py-3 hover:bg-orange-600 transition-colors shadow-md hover:shadow-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          <span class="font-semibold">Logout</span>
        </button>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="flex-1 ml-64 p-8">
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-gray-800">My Profile</h2>
        <p class="text-gray-500 mt-1">Manage your personal and vehicle information.</p>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-orange-100 p-8 max-w-3xl">
        <div class="flex items-center space-x-6 mb-8 pb-8 border-b border-gray-100">
          <div
            class="w-24 h-24 bg-orange-100 rounded-full flex items-center justify-center text-orange-500 overflow-hidden shadow-inner">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-2xl font-bold text-gray-800" id="profName">Loading...</h3>
            <p class="text-gray-500" id="profEmail">...</p>
            <span id="profStatusBadge"
              class="mt-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
              OFFLINE
            </span>
          </div>
        </div>

        <form id="profileForm" class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
              <input type="text" id="firstName" name="firstName" disabled
                class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-500" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
              <input type="text" id="lastName" name="lastName" disabled
                class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-500" />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
              <input type="text" id="phone" name="phone" disabled
                class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-500" />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Vehicle Type</label>
              <input type="text" id="vehicleType" name="vehicleType" disabled
                class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-500 font-semibold" />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Vehicle Registration Number</label>
            <input type="text" id="vehicleReg" name="vehicleReg" disabled
              class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-500 uppercase font-mono tracking-wider" />
          </div>

          <p class="text-xs text-gray-400 mt-4 italic">
            * To change your registered phone, email, or vehicle, please contact administrator support.
          </p>
        </form>
      </div>
    </main>
  </div>

  <script>
    async function loadProfile() {
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/delivery-partner/profile', {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        if (res.ok) {
          const data = await res.json();
          const user = data.user || {};
          const deliveryPartner = user.deliveryPartner || {};

          document.getElementById('profName').innerText = `${user.firstName || ''} ${user.lastName || ''}`.trim() || 'Partner';
          document.getElementById('profEmail').innerText = user.email || 'No email';

          document.getElementById('firstName').value = user.firstName || '';
          document.getElementById('lastName').value = user.lastName || '';
          document.getElementById('phone').value = user.phone || '';

          document.getElementById('vehicleType').value = deliveryPartner.vehicleType || '';
          document.getElementById('vehicleReg').value = deliveryPartner.vehicleRegistrationNumber || '';

          const badge = document.getElementById('profStatusBadge');
          if (deliveryPartner.isOnline) {
            badge.textContent = 'ONLINE';
            badge.className = 'mt-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800';
          } else {
            badge.textContent = 'OFFLINE';
            badge.className = 'mt-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800';
          }
        }
      } catch (err) {
        console.error(err);
        showToast('Failed to load profile', 'error');
      }
    }

    loadProfile();

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        const token = localStorage.getItem('token') || '';
        await fetch('/auth/logout', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
      } catch (e) { console.error(e); }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });;
  </script>
  <%- include('../partials/toast') %>
</body>

</html>