<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Promotions | Restaurant Owner | epicure</title>
  <link rel="stylesheet" href="/styles/build.css">
</head>
<body class="min-h-screen bg-orange-50 font-sans">
  <div class="flex min-h-screen">
    <%- include('../partials/restaurantOwner/sidebar') %>
    <main class="flex-1 lg:ml-72 p-8 transition-all duration-300" id="mainContentWrapper">
      <div class="mb-8 flex justify-between items-center">
        <div>
          <h2 class="text-2xl font-bold text-gray-800">Promotions & Offers</h2>
          <p class="text-gray-500 mt-1">Create deals of the day and specific discounts for your restaurants.</p>
        </div>
        <button onclick="document.getElementById('addPromoModal').classList.remove('hidden')" class="px-4 py-2 bg-orange-500 text-white rounded-lg hover:bg-orange-600">+ Create Promotion</button>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="w-full text-left whitespace-nowrap">
          <thead class="bg-gray-50 text-gray-500 text-sm uppercase">
            <tr>
              <th class="px-6 py-4 font-semibold">Code / Deal</th>
              <th class="px-6 py-4 font-semibold">Type</th>
              <th class="px-6 py-4 font-semibold">Discount</th>
              <th class="px-6 py-4 font-semibold">Validity</th>
              <th class="px-6 py-4 font-semibold">Status</th>
            </tr>
          </thead>
          <tbody id="promoList" class="divide-y divide-gray-50">
            <tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">Loading promotions...</td></tr>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <!-- Add Promo Modal -->
  <div id="addPromoModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50">
    <div class="bg-white rounded-xl shadow-lg p-6 w-full max-w-lg">
      <h3 class="text-xl font-bold mb-4">Create Promotion</h3>
      <form id="addPromoForm" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1">Code (or "DEAL_OF_DAY")</label>
          <input type="text" id="promoCode" required class="w-full px-3 py-2 border rounded-lg" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1">Type</label>
            <select id="promoType" class="w-full px-3 py-2 border rounded-lg">
              <option value="PERCENTAGE">Percentage (%)</option>
              <option value="FLAT">Flat Discount (₹)</option>
              <option value="FREE_DELIVERY">Free Delivery</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Value</label>
            <input type="number" id="promoValue" required class="w-full px-3 py-2 border rounded-lg" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1">Valid From</label>
            <input type="datetime-local" id="promoValidFrom" required class="w-full px-3 py-2 border rounded-lg" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Valid Until</label>
            <input type="datetime-local" id="promoValidUntil" required class="w-full px-3 py-2 border rounded-lg" />
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Min Order Amount (₹)</label>
          <input type="number" id="promoMinAmount" class="w-full px-3 py-2 border rounded-lg" />
        </div>
        <div class="flex justify-end gap-2 mt-6">
          <button type="button" onclick="document.getElementById('addPromoModal').classList.add('hidden')" class="px-4 py-2 border rounded-lg text-gray-600">Cancel</button>
          <button type="submit" class="px-4 py-2 bg-orange-500 text-white rounded-lg">Create</button>
        </div>
      </form>
    </div>
  </div>

  <%- include('../partials/toast') %>
  <script>
    let myRestaurantIds = [];
    async function loadRestaurants() {
      const token = localStorage.getItem('token') || '';
      const res = await fetch('/restaurant-management/mine', { headers: { 'Authorization': `Bearer ${token}` } });
      if (res.ok) {
        const data = await res.json();
        myRestaurantIds = (data.restaurants || []).map(r => String(r.id));
      }
    }

    async function loadPromos() {
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/coupons/restaurant-coupons', { headers: { 'Authorization': `Bearer ${token}` } });
        if (res.ok) {
          const data = await res.json();
          const promos = data.data.coupons || [];
          const list = document.getElementById('promoList');
          // Filter to only show promos linked to my restaurants
          const myPromos = promos.filter(p => p.couponRestaurants.some(cr => myRestaurantIds.includes(cr.restaurantId)));
          
          if (myPromos.length > 0) {
            list.innerHTML = myPromos.map(p => `
              <tr class="hover:bg-orange-50">
                <td class="px-6 py-4 font-bold">${p.code}</td>
                <td class="px-6 py-4">${p.couponType}</td>
                <td class="px-6 py-4">${p.couponType==='PERCENTAGE'? p.value+'%' : '₹'+p.value}</td>
                <td class="px-6 py-4 text-sm text-gray-500">${new Date(p.validFrom).toLocaleDateString()} - ${new Date(p.validUntil).toLocaleDateString()}</td>
                <td class="px-6 py-4"><span class="px-2 py-1 bg-${p.isActive?'green':'red'}-100 text-${p.isActive?'green':'red'}-800 rounded-full text-xs">${p.isActive?'Active':'Inactive'}</span></td>
              </tr>
            `).join('');
          } else {
            list.innerHTML = '<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">No active promotions.</td></tr>';
          }
        }
      } catch (err) { console.error(err); }
    }

    document.getElementById('addPromoForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      if(myRestaurantIds.length === 0) return showToast('No restaurants available', 'error');
      
      const payload = {
        code: document.getElementById('promoCode').value,
        couponType: document.getElementById('promoType').value,
        value: parseFloat(document.getElementById('promoValue').value),
        validFrom: new Date(document.getElementById('promoValidFrom').value).toISOString(),
        validUntil: new Date(document.getElementById('promoValidUntil').value).toISOString(),
        minimumOrderAmount: document.getElementById('promoMinAmount').value ? parseFloat(document.getElementById('promoMinAmount').value) : undefined,
        restaurantIds: myRestaurantIds
      };

      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/coupons/restaurant-coupons', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (res.ok) {
          showToast('Promotion created!', 'success');
          document.getElementById('addPromoModal').classList.add('hidden');
          loadPromos();
        } else {
          const data = await res.json();
          showToast(data.message || 'Error creating promotion', 'error');
        }
      } catch (err) { showToast('Network error', 'error'); }
    });

    async function init() {
      await loadRestaurants();
      await loadPromos();
    }
    init();
  </script>
</body>
</html>
