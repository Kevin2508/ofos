<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Profile | Restaurant Owner | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="min-h-screen bg-orange-50 font-sans">
  <div class="flex min-h-screen">
    <%- include('../partials/restaurantOwner/sidebar') %>

    <!-- MAIN CONTENT -->
    <main class="flex-1 lg:ml-72 p-8 transition-all duration-300" id="mainContentWrapper">
      <div class="mb-8 flex justify-between items-center">
        <div>
          <h2 class="text-2xl font-bold text-gray-800">My Profile</h2>
          <p class="text-gray-500 mt-1">Manage your account information.</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 max-w-3xl overflow-hidden">
        <div class="h-32 bg-orange-100 relative"></div>
        <div class="px-8 pb-8 pt-4 relative">
          <div
            class="absolute -top-16 w-32 h-32 bg-white rounded-full border-4 border-white shadow-lg overflow-hidden flex items-center justify-center text-orange-500">
            <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>

          <div class="mt-16">
            <h3 class="text-2xl font-bold text-gray-800">Owner Account</h3>
            <p class="text-gray-500 text-sm">Restaurant Owner Role</p>
          </div>

          <hr class="my-6 border-gray-100" />

          <div class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">First Name</label>
                <input type="text" id="firstName" disabled value="Loading..."
                  class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-500 cursor-not-allowed" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Last Name</label>
                <input type="text" id="lastName" disabled value="" placeholder="Loading..."
                  class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-500 cursor-not-allowed" />
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
              <input type="email" id="email" disabled value="Loading..."
                class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-500 cursor-not-allowed" />
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
              <input type="text" id="phone" disabled value="Loading..."
                class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-lg text-gray-500 cursor-not-allowed" />
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    async function loadProfile() {
      try {
        const res = await fetch('/auth/me');
        if (res.ok) {
          const data = await res.json();
          const user = data.data?.user || {};

          document.getElementById('firstName').value = user.firstName || '';
          document.getElementById('lastName').value = user.lastName || '';
          document.getElementById('email').value = user.email || '';
          document.getElementById('phone').value = user.phone || '';
        }
      } catch (err) {
        console.error('Failed to fetch profile', err);
      }
    }

    loadProfile();

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        const token = localStorage.getItem('token') || '';
        await fetch('/auth/logout', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
      } catch (e) { console.error(e); }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });;
  </script>
  <%- include('../partials/toast') %>
</body>

</html>