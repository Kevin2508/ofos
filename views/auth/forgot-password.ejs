<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password | ofos - Food Ordering System</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body>
  <div class="min-h-screen bg-gray-50 flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-8">
      <!-- Header -->
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-800 mb-2">
          Forgot Password?
        </h2>
        <p class="text-gray-500 text-sm">
          Enter your email or phone to receive a reset link
        </p>
      </div>

      <!-- Form -->
      <form id="forgotForm" class="space-y-6">
        <!-- Email/Phone Field -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Email or Phone Number
          </label>
          <input type="text" id="userIdentifier" name="userIdentifier" placeholder="Enter email or 10 digit phone"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-colors" />
          <p id="userIdentifierError" class="mt-1 text-sm text-red-500"></p>
        </div>

        <!-- Submit Button -->
        <button type="submit" id="submitBtn"
          class="w-full bg-orange-500 hover:bg-orange-600 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 shadow-md hover:shadow-lg">
          Send Reset Link
        </button>
      </form>

      <!-- Footer Links -->
      <div class="mt-6 pt-6 border-t border-gray-200 space-y-3">
        <p class="text-sm text-gray-600 text-center">
          Remembered your password?
          <a href="/loginPage" class="font-medium text-orange-500 hover:text-orange-600 transition-colors">
            Login
          </a>
        </p>
        <p class="text-sm text-gray-600 text-center">
          Don't have an account?
          <a href="/registerPage" class="font-medium text-orange-500 hover:text-orange-600 transition-colors">
            Create Account
          </a>
        </p>
      </div>
    </div>
  </div>

  <script>
    const forgotForm = document.getElementById('forgotForm');
    const userIdentifier = document.getElementById('userIdentifier');
    const userIdentifierError = document.getElementById(
      'userIdentifierError'
    );
    const submitBtn = document.getElementById('submitBtn');

    /* Validation based on your Joi schema */
    function validateUserIdentifier(value) {
      const trimmed = value.trim();
      if (!trimmed) return 'User identifier is required';

      const phoneRegex = /^[0-9]{10}$/;
      const emailRegex =
        /^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.(com|net|org|io)$/;

      if (phoneRegex.test(trimmed)) return '';
      if (/^[0-9]+$/.test(trimmed) && trimmed.length !== 10) {
        return 'Contact number must be exactly 10 digits';
      }
      if (emailRegex.test(trimmed)) return '';

      return 'Please enter a valid email address ending in .com';
    }

    function clearMessages() {
      userIdentifierError.textContent = '';
    }

    forgotForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearMessages();

      const identifierValue = userIdentifier.value.trim();
      const validationError = validateUserIdentifier(identifierValue);
      if (validationError) {
        userIdentifierError.textContent = validationError;
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      try {
        const response = await fetch('/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userIdentifier: identifierValue }),
        });

        const data = await response.json();

        if (!response.ok) {
          showToast(data.message || 'Failed to send reset link', 'error');
          return;
        }

        if (data.otp) {
          window.location.href = `/resetPasswordPage?resetToken=${data.otp}`;
        } else if (('link', data.link)) {
          window.location.href = data.link;
        }
        showToast(data.message || 'Reset link sent successfully', 'success');
      } catch (err) {
        showToast('Something went wrong. Please try again.', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Reset Link';
      }
    });
  </script>
  <%- include('../partials/toast') %>
</body>

</html>