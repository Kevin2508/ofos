<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>OTP Verification | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body>
  <div class="min-h-screen bg-gray-50 flex items-center justify-center p-4">
    <div class="w-full max-w-sm bg-white rounded-2xl shadow-xl p-5 sm:p-8 text-center">
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-gray-800 mb-2">Your Verification Code</h2>
        <p class="text-gray-500 text-sm">Please use this OTP to verify your phone number</p>
      </div>

      <div class="bg-orange-50 border border-orange-200 rounded-xl p-4 sm:p-6 mb-6">
        <span class="text-4xl font-mono font-bold text-orange-600 tracking-widest">
          <%= otp %>
        </span>
      </div>

      <p class="text-sm text-gray-500 mb-4">
        You can close this tab and enter the code in the original window.
      </p>

      <button onclick="window.close()"
        class="w-full bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold py-3 px-4 rounded-lg transition-colors duration-200">
        Close Tab
      </button>
    </div>
  </div>
</body>

</html>