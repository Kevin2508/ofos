<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | ofos</title>
    <link rel="stylesheet" href="/styles/build.css" />
  </head>
  <body class="min-h-screen bg-orange-50">
    <div class="min-h-screen flex items-center justify-center px-4 py-10">
      <div class="w-full max-w-md">
        <!-- Logo / Heading -->
        <div class="text-center mb-8">
          <h1 class="text-5xl font-extrabold text-orange-500">ofos</h1>
          <p class="text-gray-600 mt-2">Login and order your favorite food</p>
        </div>

        <!-- Card -->
        <div
          class="bg-white rounded-3xl shadow-xl p-8 border border-orange-100"
        >
          <h2 class="text-2xl font-bold text-gray-800 mb-6">Welcome Back 👋</h2>

          <form id="loginForm" class="space-y-5">
            <!-- Email / Phone -->
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">
                Email or Phone Number
              </label>

              <input
                type="text"
                id="userIdentifier"
                name="userIdentifier"
                placeholder="Enter email or 10 digit phone"
                class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-orange-500"
              />

              <p id="userIdentifierError" class="text-red-500 text-sm mt-1"></p>
            </div>

            <!-- Password -->
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">
                Password
              </label>

              <div class="relative">
                <input
                  type="password"
                  id="password"
                  name="password"
                  placeholder="Enter password"
                  class="w-full px-4 py-3 pr-16 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-orange-500"
                />

                <button
                  type="button"
                  id="togglePassword"
                  class="absolute right-4 top-1/2 -translate-y-1/2 text-orange-500 font-medium"
                >
                  Show
                </button>
              </div>

              <p id="passwordError" class="text-red-500 text-sm mt-1"></p>
            </div>

            <!-- Remember + Forgot -->
            <div class="flex items-center justify-between">
              <label class="flex items-center gap-2 cursor-pointer">
                <input
                  type="checkbox"
                  id="rememberMe"
                  name="rememberMe"
                  value="true"
                  class="accent-orange-500"
                />

                <span class="text-sm text-gray-700"> Remember Me </span>
              </label>

              <a
                href="/forgotPasswordPage"
                class="text-sm font-medium text-orange-500 hover:text-orange-600"
              >
                Forgot Password?
              </a>
            </div>

            <!-- API Error -->
            <div
              id="apiError"
              class="hidden bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl text-sm"
            ></div>

            <!-- Submit -->
            <button
              type="submit"
              id="loginBtn"
              class="w-full bg-orange-500 hover:bg-orange-600 text-white font-semibold py-3 rounded-xl transition duration-200"
            >
              Login
            </button>
          </form>

          <!-- Register -->
          <div class="mt-6 text-center">
            <p class="text-gray-600">
              Don't have an account?

              <a
                href="/registerPage"
                class="font-semibold text-orange-500 hover:text-orange-600"
              >
                Register
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>

    <script>
      const loginForm = document.getElementById('loginForm');
      const loginBtn = document.getElementById('loginBtn');

      const userIdentifier = document.getElementById('userIdentifier');
      const password = document.getElementById('password');
      const rememberMe = document.getElementById('rememberMe');

      const userIdentifierError = document.getElementById(
        'userIdentifierError'
      );
      const passwordError = document.getElementById('passwordError');
      const apiError = document.getElementById('apiError');

      const togglePassword = document.getElementById('togglePassword');

      /* -------------------------------
   Show / Hide Password
-------------------------------- */
      togglePassword.addEventListener('click', () => {
        if (password.type === 'password') {
          password.type = 'text';
          togglePassword.textContent = 'Hide';
        } else {
          password.type = 'password';
          togglePassword.textContent = 'Show';
        }
      });

      /* -------------------------------
   Validation
-------------------------------- */

      function validateUserIdentifier(value) {
        const trimmed = value.trim();

        if (!trimmed) {
          return 'please enter email or phone as userIdentifier';
        }

        const phoneRegex = /^[0-9]{10}$/;

        const emailRegex =
          /^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.(com|net|org|io)$/;

        if (phoneRegex.test(trimmed)) {
          return '';
        }

        if (/^[0-9]+$/.test(trimmed) && trimmed.length !== 10) {
          return 'Contact number must be exactly 10 digits';
        }

        if (emailRegex.test(trimmed)) {
          return '';
        }

        return 'Please enter a valid email address ending in .com';
      }

      function validatePassword(value) {
        if (!value) {
          return 'Password is required';
        }

        if (value.length < 8) {
          return 'Password must be at least 8 characters';
        }

        return '';
      }

      function clearErrors() {
        userIdentifierError.textContent = '';
        passwordError.textContent = '';

        apiError.classList.add('hidden');
        apiError.textContent = '';
      }

      //  Submit
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        clearErrors();

        const identifierValue = userIdentifier.value.trim();
        const passwordValue = password.value;

        const identifierValidation = validateUserIdentifier(identifierValue);

        const passwordValidation = validatePassword(passwordValue);

        let hasError = false;

        if (identifierValidation) {
          userIdentifierError.textContent = identifierValidation;
          hasError = true;
        }

        if (passwordValidation) {
          passwordError.textContent = passwordValidation;
          hasError = true;
        }

        if (hasError) return;

        loginBtn.disabled = true;
        loginBtn.textContent = 'Logging in...';

        try {
          const response = await fetch('/auth/login', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              userIdentifier: identifierValue,
              password: passwordValue,
              rememberMe: rememberMe.checked ? 'true' : 'false',
            }),
          });

          const data = await response.json();

          if (!response.ok) {
            apiError.classList.remove('hidden');

            apiError.textContent = data.message || data.error || 'Login failed';

            return;
          }

          // console.log(data.data.user);
          window.location.href = data.redirectUrl || '/';
        } catch (error) {
          apiError.classList.remove('hidden');
          apiError.textContent = 'Something went wrong. Please try again.';
        } finally {
          loginBtn.disabled = false;
          loginBtn.textContent = 'Login';
        }
      });
    </script>
  </body>
</html>
