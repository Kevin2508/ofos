        <label class="flex items-center gap-2 cursor-pointer pt-1 select-none">
          <input type="checkbox" id="f_isDefault" class="w-4 h-4 accent-orange-500 rounded" />
          <span class="text-sm font-semibold text-gray-700">Set as default address</span>
        </label>

        <div id="addressFormError"
          class="hidden bg-red-50 text-red-600 text-sm px-4 py-2.5 rounded-xl border border-red-200"></div>

        <div class="flex gap-3 pt-1">
          <button type="button" id="modalCancelBtn"
            class="flex-1 py-3 rounded-xl font-semibold text-gray-600 bg-gray-100 hover:bg-gray-200 transition-colors">Cancel</button>
          <button type="submit" id="addressSubmitBtn"
            class="flex-1 py-3 rounded-xl font-bold text-white bg-orange-500 hover:bg-orange-600 disabled:opacity-60 disabled:cursor-not-allowed transition-colors shadow-sm">
            Save Address
