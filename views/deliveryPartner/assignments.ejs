<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Assignments | Delivery Partner | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="min-h-screen bg-orange-50 font-sans">
  <div class="flex min-h-screen">
    <%- include('../partials/deliveryPartner/sidebar') %>

    <!-- MAIN CONTENT -->
    <main class="flex-1 lg:ml-72 p-8 transition-all duration-300" id="mainContentWrapper">
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-gray-800">My Assignments</h2>
        <p class="text-gray-500 mt-1">View your active and past deliveries.</p>
      </div>

      <!-- Filter / Tabs for assignments -->
      <div class="mb-6 border-b border-gray-200">
        <nav class="-mb-px flex space-x-8" aria-label="Tabs">
          <button class="border-orange-500 text-orange-600 whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
            All Assignments
          </button>
        </nav>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left whitespace-nowrap">
            <thead>
              <tr class="bg-gray-50 border-b border-gray-100 text-gray-500 text-sm uppercase tracking-wider">
                <th class="px-6 py-4 font-semibold">Assignment ID</th>
                <th class="px-6 py-4 font-semibold">Restaurant</th>
                <th class="px-6 py-4 font-semibold">Date</th>
                <th class="px-6 py-4 font-semibold text-right">Earnings</th>
                <th class="px-6 py-4 font-semibold text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="assignmentsList" class="divide-y divide-gray-50 text-gray-700">
              <tr>
                <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                  <div class="animate-pulse flex justify-center">Loading assignments...</div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script>
    async function loadAssignments() {
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/delivery-partner/assignments/all', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        const list = document.getElementById('assignmentsList');

        if (res.ok) {
          const data = await res.json();
          const assignments = data.assignments || [];

          if (assignments.length === 0) {
            list.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">No assignments found.</td></tr>`;
          } else {
            list.innerHTML = assignments.map(a => {
                let actionsHtml = '';
                if (a.status === 'PENDING') {
                   actionsHtml = `
                     <button onclick="updateAssignmentStatus('${a.id}', 'accept')" class="bg-green-100 text-green-700 px-3 py-1 rounded-lg font-bold text-xs hover:bg-green-200 transition-colors mr-2">Accept</button>
                     <button onclick="updateAssignmentStatus('${a.id}', 'decline')" class="bg-red-100 text-red-700 px-3 py-1 rounded-lg font-bold text-xs hover:bg-red-200 transition-colors">Decline</button>
                   `;
                } else if (a.status === 'ACCEPTED') {
                   actionsHtml = `
                     <button onclick="updateAssignmentStatus('${a.id}', 'pickup')" class="bg-blue-100 text-blue-700 px-3 py-1 rounded-lg font-bold text-xs hover:bg-blue-200 transition-colors">Pick Up Order</button>
                   `;
                } else if (a.status === 'PICKED_UP') {
                   actionsHtml = `
                     <button onclick="deliverOrderPrompt('${a.id}')" class="bg-purple-100 text-purple-700 px-3 py-1 rounded-lg font-bold text-xs hover:bg-purple-200 transition-colors">Deliver Order</button>
                   `;
                }

                return `
                <tr class="hover:bg-orange-50 transition-colors group">
                  <td class="px-6 py-4 font-medium text-gray-900 group-hover:text-orange-600">#${a.id}</td>
                  <td class="px-6 py-4 text-gray-600">${a.restaurant?.businessName || 'Unknown'}</td>
                  <td class="px-6 py-4 text-gray-500 text-sm">${new Date(a.createdAt).toLocaleString()}</td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${a.status === 'DELIVERED' ? 'bg-green-100 text-green-800' :
                a.status === 'CANCELLED' ? 'bg-red-100 text-red-800' :
                  'bg-orange-100 text-orange-800'
              }">
                      ${a.status}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-right font-semibold text-gray-700">₹${a.earnings || 0}</td>
                  <td class="px-6 py-4 text-right">
                    ${actionsHtml}
                  </td>
                </tr>
              `}).join('');
          }
        } else {
          list.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">Could not load assignments.</td></tr>`;
        }
      } catch (err) {
        console.error(err);
        document.getElementById('assignmentsList').innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-red-500">Failed to load data.</td></tr>`;
      }
    }

    loadAssignments();

    async function updateAssignmentStatus(assignmentId, action) {
      if (!confirm(`Are you sure you want to ${action} this assignment?`)) return;
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch(`/delivery-partner/assignments/${assignmentId}/${action}`, {
          method: 'PATCH',
          headers: { 
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          }
        });
        if (res.ok) {
          showToast('Assignment updated successfully', 'success');
          loadAssignments();
        } else {
          const data = await res.json();
          showToast(data.message || 'Failed to update assignment', 'error');
        }
      } catch (err) {
        console.error(err);
        showToast('Network error while updating assignment', 'error');
      }
    }

    async function deliverOrderPrompt(assignmentId) {
      const otp = prompt('Enter the 4-digit Delivery PIN from the customer:');
      if (!otp) return;
      
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch(`/delivery-partner/assignments/${assignmentId}/deliver`, {
          method: 'PATCH',
          headers: { 
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ otp })
        });
        if (res.ok) {
          showToast('Order delivered successfully!', 'success');
          loadAssignments();
        } else {
          const data = await res.json();
          showToast(data.message || 'Failed to deliver order', 'error');
        }
      } catch (err) {
        console.error(err);
        showToast('Network error while delivering order', 'error');
      }
    }

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        const token = localStorage.getItem('token') || '';
        await fetch('/auth/logout', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
      } catch (e) { console.error(e); }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });;
  </script>
  <%- include('../partials/toast') %>
</body>

</html>