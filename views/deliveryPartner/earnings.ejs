<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Earnings | Delivery Partner | ofos</title>
    <link rel="stylesheet" href="/styles/build.css" />
  </head>
  <body class="min-h-screen bg-orange-50 font-sans">
    <div class="flex min-h-screen">
      <!-- SIDEBAR -->
      <aside class="w-64 bg-white border-r border-orange-100 shadow-lg flex flex-col fixed h-full z-10 transition-transform duration-300">
        <div class="p-6 text-center border-b border-orange-50">
          <h1 class="text-3xl font-extrabold text-orange-500">ofos Delivery</h1>
        </div>

        <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
          <a href="/delivery-partner-dashboard" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            <span>Dashboard</span>
          </a>
          <a href="/delivery-partner-assignments" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
            <span>My Assignments</span>
          </a>
          <a href="/delivery-partner-earnings" class="flex items-center space-x-3 px-4 py-3 rounded-xl bg-orange-100 text-orange-600 font-semibold transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>Earnings</span>
          </a>
          <a href="/delivery-partner-profile" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            <span>Profile</span>
          </a>
        </nav>

        <div class="p-4 border-t border-orange-50">
          <button id="logoutBtn" class="flex items-center justify-center space-x-2 w-full bg-orange-500 text-white rounded-xl py-3 hover:bg-orange-600 transition-colors shadow-md hover:shadow-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            <span class="font-semibold">Logout</span>
          </button>
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <main class="flex-1 ml-64 p-8">
        <div class="mb-8">
          <h2 class="text-2xl font-bold text-gray-800">Earnings</h2>
          <p class="text-gray-500 mt-1">Track your payout and financial history.</p>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-orange-100 mb-8 flex items-center justify-between">
          <div>
            <p class="text-gray-500 font-medium">Total Lifetime Earnings</p>
            <h3 id="totalEarnings" class="text-4xl font-extrabold text-orange-600 mt-1">₹0</h3>
          </div>
          <div class="p-4 bg-orange-50 text-orange-500 rounded-2xl">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
        </div>

        <h3 class="text-xl font-bold text-gray-800 mb-4">Earnings History</h3>
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left whitespace-nowrap">
              <thead>
                <tr class="bg-gray-50 border-b border-gray-100 text-gray-500 text-sm uppercase tracking-wider">
                  <th class="px-6 py-4 font-semibold">Date</th>
                  <th class="px-6 py-4 font-semibold">Amount</th>
                  <th class="px-6 py-4 font-semibold">Type</th>
                  <th class="px-6 py-4 font-semibold">Description</th>
                </tr>
              </thead>
              <tbody id="earningsList" class="divide-y divide-gray-50 text-gray-700">
                <tr>
                  <td colspan="4" class="px-6 py-8 text-center text-gray-500">
                    <div class="animate-pulse flex justify-center">Loading earnings...</div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>

    <script>
      async function loadEarnings() {
        try {
          const token = localStorage.getItem('token') || '';
          const headers = { 'Authorization': `Bearer ${token}` };

          // Fetch Total
          const resEarnings = await fetch('/delivery-partner/earnings', { headers });
          if (resEarnings.ok) {
            const earnData = await resEarnings.json();
            document.getElementById('totalEarnings').innerText = '₹' + (earnData.data?.totalEarnings || 0);
          }

          // Fetch History
          const resHistory = await fetch('/delivery-partner/earnings/history', { headers });
          const list = document.getElementById('earningsList');
          
          if (resHistory.ok) {
            const data = await resHistory.json();
            const history = data.data?.history || [];
            
            if (history.length === 0) {
              list.innerHTML = `<tr><td colspan="4" class="px-6 py-8 text-center text-gray-500">No earnings history found.</td></tr>`;
            } else {
              list.innerHTML = history.map(e => `
                <tr class="hover:bg-orange-50 transition-colors">
                  <td class="px-6 py-4 text-gray-500 text-sm">${new Date(e.createdAt).toLocaleString()}</td>
                  <td class="px-6 py-4 font-medium text-green-600">+₹${e.amount}</td>
                  <td class="px-6 py-4"><span class="bg-gray-100 px-2 py-1 rounded text-xs font-semibold">${e.type || 'EARNING'}</span></td>
                  <td class="px-6 py-4 text-gray-600">${e.description || 'Order Earnings'}</td>
                </tr>
              `).join('');
            }
          } else {
            list.innerHTML = `<tr><td colspan="4" class="px-6 py-8 text-center text-gray-500">Could not load earnings history.</td></tr>`;
          }
        } catch (err) {
          console.error(err);
          document.getElementById('earningsList').innerHTML = `<tr><td colspan="4" class="px-6 py-8 text-center text-red-500">Failed to load data.</td></tr>`;
        }
      }

      loadEarnings();

      document.getElementById('logoutBtn').addEventListener('click', () => {
        localStorage.removeItem('token');
        document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        window.location.href = '/loginPage';
      });
    </script>
    <%- include('../partials/toast') %>
  </body>
</html>
