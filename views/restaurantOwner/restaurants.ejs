<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Restaurants | Restaurant Owner | ofos</title>
    <link rel="stylesheet" href="/styles/build.css" />
  </head>
  <body class="min-h-screen bg-orange-50 font-sans">
    <div class="flex min-h-screen">
      <!-- SIDEBAR -->
      <aside class="w-64 bg-white border-r border-orange-100 shadow-lg flex flex-col fixed h-full z-10 transition-transform duration-300">
        <div class="p-6 text-center border-b border-orange-50">
          <h1 class="text-3xl font-extrabold text-orange-500">ofos Partner</h1>
        </div>

        <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
          <a href="/restaurant-owner-dashboard" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
            <span>Dashboard</span>
          </a>
          <a href="/restaurant-owner-restaurants" class="flex items-center space-x-3 px-4 py-3 rounded-xl bg-orange-100 text-orange-600 font-semibold transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            <span>Restaurants</span>
          </a>
          <a href="/restaurant-owner-menu" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
            <span>Menu Management</span>
          </a>
          <a href="/restaurant-owner-orders" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            <span>Orders</span>
          </a>
          <a href="/restaurant-owner-profile" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            <span>Profile</span>
          </a>
        </nav>

        <div class="p-4 border-t border-orange-50">
          <button id="logoutBtn" class="flex items-center justify-center space-x-2 w-full bg-orange-500 text-white rounded-xl py-3 hover:bg-orange-600 transition-colors shadow-md hover:shadow-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            <span class="font-semibold">Logout</span>
          </button>
        </div>
      </aside>

      <!-- MAIN CONTENT -->
      <main class="flex-1 ml-64 p-8">
        <div class="mb-8 flex justify-between items-center">
          <div>
            <h2 class="text-2xl font-bold text-gray-800">My Restaurants</h2>
            <p class="text-gray-500 mt-1">Manage your restaurants and their details.</p>
          </div>
          <button onclick="toggleModal('addRestaurantModal')" class="bg-orange-500 hover:bg-orange-600 text-white px-5 py-2.5 rounded-lg font-medium shadow transition-colors">
            + Add Restaurant
          </button>
        </div>

        <!-- Restaurants List -->
        <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-6" id="restaurantsContainer">
          <!-- Populated by JS -->
          <div class="col-span-full py-12 text-center text-gray-500">
            Loading restaurants...
          </div>
        </div>
      </main>
    </div>

    <!-- ADD RESTAURANT MODAL -->
    <div id="addRestaurantModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 transition-opacity">
      <div class="bg-white w-full max-w-2xl rounded-2xl shadow-xl overflow-hidden flex flex-col max-h-[90vh]">
        <div class="px-6 py-4 border-b border-gray-100 flex justify-between items-center bg-gray-50">
          <h3 class="text-xl font-bold text-gray-800">Add New Restaurant</h3>
          <button onclick="toggleModal('addRestaurantModal')" class="text-gray-400 hover:text-gray-600">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
        
        <div class="p-6 overflow-y-auto flex-1">
          <form id="addRestaurantForm" class="space-y-5">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Business Name <span class="text-red-500">*</span></label>
                <input type="text" id="businessName" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Legal Business Name <span class="text-red-500">*</span></label>
                <input type="text" id="legalBusinessName" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
              </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Primary Email <span class="text-red-500">*</span></label>
                <input type="email" id="primaryEmail" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Primary Phone <span class="text-red-500">*</span></label>
                <input type="text" id="primaryPhone" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
              <textarea id="description" rows="3" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none"></textarea>
            </div>
            
            <div class="flex justify-end pt-4 space-x-3 border-t border-gray-100">
              <button type="button" onclick="toggleModal('addRestaurantModal')" class="px-5 py-2 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50">Cancel</button>
              <button type="submit" class="px-5 py-2 bg-orange-500 hover:bg-orange-600 text-white rounded-lg font-medium shadow-sm" id="submitRestaurantBtn">Save Restaurant</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script>
      function toggleModal(id) {
        const modal = document.getElementById(id);
        modal.classList.toggle('hidden');
      }

      async function loadRestaurants() {
        try {
          const token = localStorage.getItem('token') || '';
          const res = await fetch('/restaurant-management/mine', {
            headers: { 'Authorization': `Bearer ${token}` }
          });
          
          const container = document.getElementById('restaurantsContainer');
          
          if (res.ok) {
            const data = await res.json();
            const restaurants = data.data || [];
            
            if (restaurants.length === 0) {
              container.innerHTML = `<div class="col-span-full py-12 text-center text-gray-500 bg-white rounded-2xl border border-gray-100 shadow-sm">You haven't added any restaurants yet.</div>`;
              return;
            }

            container.innerHTML = restaurants.map(r => `
              <div class="bg-white rounded-2xl shadow-sm border border-orange-100 overflow-hidden hover:shadow-md transition-shadow flex flex-col">
                <div class="h-32 bg-gray-200 relative">
                  ${r.coverImageUrl ? `<img src="${r.coverImageUrl}" class="w-full h-full object-cover" />` : `<div class="w-full h-full flex items-center justify-center text-gray-400">No Cover</div>`}
                  <div class="absolute -bottom-8 left-6 w-16 h-16 bg-white rounded-full border-4 border-white shadow overflow-hidden">
                    ${r.logoUrl ? `<img src="${r.logoUrl}" class="w-full h-full object-cover" />` : `<div class="w-full h-full bg-orange-100 flex items-center justify-center text-orange-500 font-bold">${r.businessName.charAt(0)}</div>`}
                  </div>
                  <div class="absolute top-4 right-4">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold shadow-sm ${
                      r.status === 'ACTIVE' ? 'bg-green-100 text-green-800' :
                      r.status === 'PENDING_VERIFICATION' ? 'bg-yellow-100 text-yellow-800' :
                      r.status === 'PAUSED' ? 'bg-gray-100 text-gray-800' :
                      'bg-red-100 text-red-800'
                    }">
                      ${r.status}
                    </span>
                  </div>
                </div>
                <div class="pt-10 px-6 pb-6 flex-1 flex flex-col">
                  <h3 class="text-xl font-bold text-gray-800 line-clamp-1">${r.businessName}</h3>
                  <p class="text-sm text-gray-500 mb-4 line-clamp-1">${r.legalBusinessName}</p>
                  
                  <div class="space-y-2 mb-6 flex-1">
                    <p class="text-sm text-gray-600 flex items-center"><svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg> ${r.primaryEmail}</p>
                    <p class="text-sm text-gray-600 flex items-center"><svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg> ${r.primaryPhone}</p>
                  </div>
                  
                  <div class="flex space-x-2 mt-auto">
                    <button class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 py-2 rounded-lg text-sm font-medium transition-colors">Manage</button>
                    ${r.status === 'ACTIVE' ? 
                      `<button onclick="updateStatus('${r.id}', 'pause')" class="flex-1 bg-yellow-100 hover:bg-yellow-200 text-yellow-700 py-2 rounded-lg text-sm font-medium transition-colors">Pause</button>` :
                      r.status === 'PAUSED' ? 
                      `<button onclick="updateStatus('${r.id}', 'resume')" class="flex-1 bg-green-100 hover:bg-green-200 text-green-700 py-2 rounded-lg text-sm font-medium transition-colors">Resume</button>` : ''
                    }
                  </div>
                </div>
              </div>
            `).join('');
          } else {
            container.innerHTML = `<div class="col-span-full py-12 text-center text-red-500">Failed to load restaurants.</div>`;
          }
        } catch (err) {
          console.error(err);
        }
      }

      document.getElementById('addRestaurantForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = document.getElementById('submitRestaurantBtn');
        btn.disabled = true;
        btn.textContent = 'Saving...';
        
        try {
          const token = localStorage.getItem('token') || '';
          const payload = {
            businessName: document.getElementById('businessName').value.trim(),
            legalBusinessName: document.getElementById('legalBusinessName').value.trim(),
            primaryEmail: document.getElementById('primaryEmail').value.trim(),
            primaryPhone: document.getElementById('primaryPhone').value.trim(),
            description: document.getElementById('description').value.trim(),
          };

          const res = await fetch('/restaurant-management', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify(payload)
          });

          const data = await res.json();
          if (res.ok) {
            showToast('Restaurant created successfully! Pending verification.', 'success');
            toggleModal('addRestaurantModal');
            document.getElementById('addRestaurantForm').reset();
            loadRestaurants();
          } else {
            throw new Error(data.message || 'Failed to create restaurant');
          }
        } catch (err) {
          showToast(err.message, 'error');
        } finally {
          btn.disabled = false;
          btn.textContent = 'Save Restaurant';
        }
      });

      async function updateStatus(id, action) {
        try {
          const token = localStorage.getItem('token') || '';
          const res = await fetch(`/restaurant-management/${id}/${action}`, {
            method: 'PATCH',
            headers: { 'Authorization': `Bearer ${token}` }
          });
          
          if (res.ok) {
            showToast(`Restaurant ${action}d successfully.`, 'success');
            loadRestaurants();
          } else {
            const data = await res.json();
            throw new Error(data.message || `Failed to ${action} restaurant`);
          }
        } catch (err) {
          showToast(err.message, 'error');
        }
      }

      loadRestaurants();

      document.getElementById('logoutBtn').addEventListener('click', () => {
        localStorage.removeItem('token');
        document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
        window.location.href = '/loginPage';
      });
    </script>
    <%- include('../partials/toast') %>
  </body>
</html>
