<%- include('../partials/header', { pageTitle: 'Dashboard' , pageSubtitle: 'Welcome back, ' + (user && user.name ?
  user.name : 'Owner' ), activePage: 'dashboard' , user: user }) %>

  <% if (typeof success !=='undefined' && success) { %>
    <div class="alert alert-success" data-autohide>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
        stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
        <polyline points="22 4 12 14.01 9 11.01" />
      </svg>
      <%= success %>
    </div>
    <% } %>

      <% if (!restaurant) { %>
        <!-- ============ NO RESTAURANT REGISTERED YET ============ -->
        <div class="card">
          <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
              stroke-linejoin="round">
              <path d="M3 7l1.5-4h15L21 7" />
              <path
                d="M3 7h18v2a3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1-3 3 3 3 0 0 1-3-3V7z" />
              <path d="M5 12v8h14v-8" />
            </svg>
            <h3>No Restaurant Registered Yet</h3>
            <p>Register your restaurant to start receiving orders on Quick Bites.</p>
            <a href="/ro/restaurant-owner/restaurant/new" class="btn btn-primary">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
              </svg>
              Register Restaurant
            </a>
          </div>
        </div>

        <% } else { %>
          <!-- ============ RESTAURANT OVERVIEW ============ -->

          <!-- Verification status banner -->
          <% if (restaurant.verification_status==='pending' ) { %>
            <div class="alert alert-warning">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
              </svg>
              Your restaurant is <strong>pending verification</strong>. Please upload required documents to get
              verified.
              <a href="/ro/restaurant-owner/documents"
                style="margin-left:auto; font-weight:700; color:#B5651D; text-decoration:underline;">Upload
                Documents</a>
            </div>
            <% } else if (restaurant.verification_status==='rejected' ) { %>
              <div class="alert alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="15" y1="9" x2="9" y2="15" />
                  <line x1="9" y1="9" x2="15" y2="15" />
                </svg>
                Your verification was <strong>rejected</strong>. Please re-check and re-upload your documents.
                <a href="/ro/restaurant-owner/documents"
                  style="margin-left:auto; font-weight:700; color:var(--danger); text-decoration:underline;">View
                  Documents</a>
              </div>
              <% } %>

                <!-- Stat cards -->
                <div class="grid grid-4" style="margin-bottom: 8px;">
                  <div class="stat-card">
                    <div class="stat-icon orange">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z" />
                        <circle cx="12" cy="10" r="2.5" />
                      </svg>
                    </div>
                    <div class="stat-info">
                      <div class="stat-value">
                        <%= branches ? branches.length : 0 %>
                      </div>
                      <div class="stat-label">Total Branches</div>
                    </div>
                  </div>

                  <div class="stat-card">
                    <div class="stat-icon teal">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                        <polyline points="22 4 12 14.01 9 11.01" />
                      </svg>
                    </div>
                    <div class="stat-info">
                      <div class="stat-value">
                        <%= branches ? branches.filter(b=> b.status === 'active').length : 0 %>
                      </div>
                      <div class="stat-label">Active Branches</div>
                    </div>
                  </div>

                  <div class="stat-card">
                    <div class="stat-icon navy">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <path d="M6 2l1.5 3h9L18 2" />
                        <path d="M3.5 6h17l-1.4 13.5a2 2 0 0 1-2 1.5H6.9a2 2 0 0 1-2-1.5z" />
                        <line x1="9" y1="10" x2="15" y2="10" />
                      </svg>
                    </div>
                    <div class="stat-info">
                      <div class="stat-value">
                        <%= typeof totalOrders !=='undefined' ? totalOrders : 0 %>
                      </div>
                      <div class="stat-label">Total Orders</div>
                    </div>
                  </div>

                  <div class="stat-card">
                    <div class="stat-icon amber">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                      </svg>
                    </div>
                    <div class="stat-info">
                      <div class="stat-value">
                        <span
                          class="badge <%= restaurant.verification_status === 'verified' ? 'badge-verified' : (restaurant.verification_status === 'pending' ? 'badge-pending' : 'badge-rejected') %>"
                          style="font-size:13px;">
                          <%= restaurant.verification_status %>
                        </span>
                      </div>
                      <div class="stat-label">Verification Status</div>
                    </div>
                  </div>
                </div>

                <!-- Restaurant Profile Summary -->
                <div class="section-title">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M3 7l1.5-4h15L21 7" />
                    <path
                      d="M3 7h18v2a3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1-3 3 3 3 0 0 1-3-3V7z" />
                    <path d="M5 12v8h14v-8" />
                  </svg>
                  Restaurant Profile
                </div>

                <div class="card">
                  <div class="card-body" style="display:flex; gap:20px; flex-wrap:wrap; align-items:center;">
                    <% if (restaurant.logo_url) { %>
                      <img src="<%= restaurant.logo_url %>" alt="Logo" class="preview-thumb-round">
                      <% } else { %>
                        <div class="preview-thumb-round"
                          style="background:var(--neutral-200); display:flex; align-items:center; justify-content:center; color:var(--neutral-500);">
                          <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 7l1.5-4h15L21 7" />
                            <path
                              d="M3 7h18v2a3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1-3 3 3 3 0 0 1-3-3V7z" />
                            <path d="M5 12v8h14v-8" />
                          </svg>
                        </div>
                        <% } %>

                          <div style="flex:1; min-width:200px;">
                            <h3 style="font-size:19px; margin-bottom:6px;">
                              <%= restaurant.name %>
                            </h3>
                            <p style="font-size:13px; color:var(--neutral-600); margin-bottom:8px;">
                              <%= restaurant.description || 'No description added yet.' %>
                            </p>
                            <div style="display:flex; gap:8px; flex-wrap:wrap;">
                              <% if (restaurant.cuisine_tags && restaurant.cuisine_tags.length) { %>
                                <% restaurant.cuisine_tags.forEach(tag=> { %>
                                  <span class="badge badge-active"
                                    style="background:var(--neutral-200); color:var(--tertiary);">
                                    <%= tag %>
                                  </span>
                                  <% }) %>
                                    <% } %>
                            </div>
                          </div>

                          <a href="/ro/restaurant-owner/restaurant" class="btn btn-outlined">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round">
                              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                            </svg>
                            Manage Profile
                          </a>
                  </div>
                </div>

                <!-- Branches summary -->
                <div class="section-title" style="justify-content:space-between;">
                  <span style="display:flex; align-items:center; gap:8px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                      stroke-linejoin="round">
                      <path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z" />
                      <circle cx="12" cy="10" r="2.5" />
                    </svg>
                    Your Branches
                  </span>
                  <a href="/ro/restaurant-owner/branches"
                    style="font-size:13px; font-weight:700; color:var(--primary);">View All</a>
                </div>

                <% if (branches && branches.length> 0) { %>
                  <div class="grid grid-3">
                    <% branches.slice(0, 3).forEach(branch=> { %>
                      <div class="branch-card">
                        <div class="branch-card-img">
                          <% if (branch.cover_url) { %>
                            <img src="<%= branch.cover_url %>" alt="<%= branch.branch_name %>"
                              style="width:100%; height:100%; object-fit:cover;">
                            <% } else { %>
                              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 7l1.5-4h15L21 7" />
                                <path
                                  d="M3 7h18v2a3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1-3 3 3 3 0 0 1-3-3V7z" />
                                <path d="M5 12v8h14v-8" />
                              </svg>
                              <% } %>
                                <div class="branch-status">
                                  <span
                                    class="badge <%= branch.status === 'active' ? 'badge-active' : 'badge-paused' %>">
                                    <%= branch.status %>
                                  </span>
                                </div>
                        </div>
                        <div class="branch-card-body">
                          <h4>
                            <%= branch.branch_name %>
                          </h4>
                          <div class="addr">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                              stroke-linecap="round" stroke-linejoin="round">
                              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1 1 18 0z" />
                              <circle cx="12" cy="10" r="3" />
                            </svg>
                            <span>
                              <%= branch.address %>
                            </span>
                          </div>
                        </div>
                        <div class="branch-card-footer">
                          <a href="/ro/restaurant-owner/branches/<%= branch.id %>" class="btn btn-outlined btn-sm">View
                            Details</a>
                        </div>
                      </div>
                      <% }) %>
                  </div>
                  <% } else { %>
                    <div class="card">
                      <div class="empty-state">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                          stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z" />
                          <circle cx="12" cy="10" r="2.5" />
                        </svg>
                        <h3>No Branches Added</h3>
                        <p>Every restaurant must have at least one branch. Add your first branch to start operating.</p>
                        <a href="/ro/restaurant-owner/branches/new" class="btn btn-primary">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19" />
                            <line x1="5" y1="12" x2="19" y2="12" />
                          </svg>
                          Add Branch
                        </a>
                      </div>
                    </div>
                    <% } %>

                      <% } %>

                        <%- include('../partials/footer') %>