<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Fleet Manager Dashboard | ofos</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>
<body class="min-h-screen bg-orange-50 font-sans text-gray-800">
  <div class="flex min-h-screen">
    <!-- SIDEBAR -->
    <aside class="w-64 bg-white border-r border-orange-100 shadow-lg flex flex-col fixed h-full z-10 transition-transform duration-300">
      <div class="p-6 text-center border-b border-orange-50">
        <h1 class="text-3xl font-extrabold text-orange-500">Fleet Control</h1>
      </div>

      <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
        <a href="/fleet-manager-dashboard" class="flex items-center space-x-3 px-4 py-3 rounded-xl bg-orange-100 text-orange-600 font-semibold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          <span>Dashboard</span>
        </a>
        <a href="/fleet-manager-partners" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
          <span>Delivery Partners</span>
        </a>
        <a href="/fleet-manager-assignments" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          <span>Assignments</span>
        </a>
        <a href="/fleet-manager-profile" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          <span>Profile</span>
        </a>
      </nav>

      <div class="p-4 border-t border-orange-50">
        <button id="logoutBtn" class="flex items-center justify-center space-x-2 w-full bg-orange-500 text-white rounded-xl py-3 hover:bg-orange-600 transition-colors shadow-md hover:shadow-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
          <span class="font-semibold">Logout</span>
        </button>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="flex-1 ml-64 p-8">
      <div class="mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Fleet Operations</h2>
        <p class="text-gray-500 mt-2">Monitor delivery partners and active assignments.</p>
      </div>

      <!-- STAT CARDS -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-500">Total Partners</p>
            <h3 id="statPartners" class="text-3xl font-bold text-gray-900 mt-1">0</h3>
          </div>
          <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          </div>
        </div>
        
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 flex items-center justify-between">
          <div>
            <p class="text-sm font-medium text-gray-500">Active Assignments</p>
            <h3 id="statAssignments" class="text-3xl font-bold text-gray-900 mt-1">0</h3>
          </div>
          <div class="w-12 h-12 bg-orange-100 text-orange-600 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
          </div>
        </div>
      </div>

      <!-- CONTENT -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
          <div class="flex justify-between items-center mb-6">
            <h3 class="text-xl font-bold text-gray-900">Recent Partners</h3>
            <a href="/fleet-manager-partners" class="text-orange-600 hover:text-orange-700 text-sm font-medium">View All &rarr;</a>
          </div>
          <div class="space-y-4" id="recentPartnersList">
            <div class="animate-pulse flex space-x-4">
              <div class="rounded-full bg-slate-200 h-10 w-10"></div>
              <div class="flex-1 space-y-2 py-1">
                <div class="h-4 bg-slate-200 rounded w-3/4"></div>
                <div class="h-4 bg-slate-200 rounded w-1/2"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
          <div class="flex justify-between items-center mb-6">
            <h3 class="text-xl font-bold text-gray-900">Recent Assignments</h3>
            <a href="/fleet-manager-assignments" class="text-orange-600 hover:text-orange-700 text-sm font-medium">View All &rarr;</a>
          </div>
          <div class="space-y-4" id="recentAssignmentsList">
            <div class="animate-pulse flex space-x-4">
              <div class="flex-1 space-y-2 py-1">
                <div class="h-4 bg-slate-200 rounded w-full"></div>
                <div class="h-4 bg-slate-200 rounded w-5/6"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>

  <script>
    async function loadDashboard() {
      try {
        const token = localStorage.getItem('token') || '';
        const headers = { 'Authorization': `Bearer ${token}` };

        // Load Partners
        const pRes = await fetch('/fleet-manager/delivery-partners/all', { headers });
        if (pRes.ok) {
          const pData = await pRes.json();
          const partners = pData.data || [];
          document.getElementById('statPartners').innerText = partners.length;
          
          const pList = document.getElementById('recentPartnersList');
          if (partners.length === 0) {
            pList.innerHTML = '<p class="text-gray-500 text-sm">No partners found.</p>';
          } else {
            pList.innerHTML = partners.slice(0, 5).map(p => `
              <div class="flex items-center justify-between p-3 hover:bg-gray-50 rounded-lg transition-colors border border-transparent hover:border-gray-100">
                <div class="flex items-center space-x-3">
                  <div class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-sm">
                    ${(p.vehicleType?.[0] || 'V').toUpperCase()}
                  </div>
                  <div>
                    <p class="font-medium text-gray-900">Partner #${p.id}</p>
                    <p class="text-xs text-gray-500">${p.vehicleNumber || 'No Plate'}</p>
                  </div>
                </div>
                <span class="px-2 py-1 bg-gray-100 text-gray-600 rounded text-xs font-medium">${p.status}</span>
              </div>
            `).join('');
          }
        }

        // Load Assignments
        const aRes = await fetch('/fleet-manager/all/assignments', { headers });
        if (aRes.ok) {
          const aData = await aRes.json();
          const assignments = aData.data || [];
          document.getElementById('statAssignments').innerText = assignments.length;
          
          const aList = document.getElementById('recentAssignmentsList');
          if (assignments.length === 0) {
            aList.innerHTML = '<div class="text-center py-8"><p class="text-gray-500 text-sm">No assignments!</p></div>';
          } else {
            aList.innerHTML = assignments.slice(0, 5).map(a => `
              <div class="p-3 hover:bg-gray-50 rounded-lg transition-colors border border-transparent hover:border-gray-100">
                <div class="flex justify-between items-start">
                  <div>
                    <p class="font-medium text-gray-900">Order #${a.orderId}</p>
                    <p class="text-xs text-gray-500 mt-1">Assigned to Partner #${a.deliveryPartnerId}</p>
                  </div>
                  <span class="px-2 py-1 bg-orange-100 text-orange-800 rounded text-xs font-medium">${a.status}</span>
                </div>
              </div>
            `).join('');
          }
        }
      } catch (err) {
        console.error(err);
      }
    }

    loadDashboard();

    document.getElementById('logoutBtn').addEventListener('click', () => {
      localStorage.removeItem('token');
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });
  </script>
</body>
</html>
