<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Orders | Restaurant Owner | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="min-h-screen bg-orange-50 font-sans">
  <div class="flex min-h-screen">
    <%- include('../partials/restaurantOwner/sidebar') %>

    <!-- MAIN CONTENT -->
    <main class="flex-1 lg:ml-72 p-5 sm:p-8 transition-all duration-300" id="mainContentWrapper">
      <div class="mb-8 flex flex-col md:flex-row md:justify-between md:items-center gap-4">
        <div>
          <h2 class="text-2xl font-bold text-gray-800">Orders Management</h2>
          <p class="text-gray-500 mt-1">View and manage customer orders across your restaurants.</p>
        </div>
        <div class="flex flex-wrap gap-2 items-center">
          <input type="text" id="searchFilter" placeholder="Search Order ID" class="px-3 py-2 border border-gray-300 rounded-lg text-sm outline-none" oninput="loadOrders()" />
          <input type="date" id="dateFilter" class="px-3 py-2 border border-gray-300 rounded-lg text-sm outline-none" onchange="loadOrders()" />
          <select id="paymentFilter" class="px-3 py-2 border border-gray-300 rounded-lg text-sm outline-none" onchange="loadOrders()">
            <option value="ALL">All Payments</option>
            <option value="PAID">Paid</option>
            <option value="PENDING">Pending</option>
            <option value="FAILED">Failed</option>
          </select>
          <select id="statusFilter" class="px-3 py-2 border border-gray-300 rounded-lg text-sm outline-none" onchange="loadOrders()">
            <option value="ALL">All Orders</option>
            <option value="ACTIVE" selected>Active Orders</option>
            <option value="PLACED">Pending</option>
            <option value="ACCEPTED">Accepted</option>
            <option value="PREPARING">Preparing</option>
            <option value="READY_FOR_PICKUP">Ready for Pickup</option>
            <option value="COMPLETED">Completed</option>
            <option value="CANCELLED">Cancelled</option>
          </select>
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left whitespace-nowrap">
            <thead>
              <tr class="bg-gray-50 border-b border-gray-100 text-gray-500 text-sm uppercase tracking-wider">
                <th class="px-6 py-4 font-semibold">Order ID</th>
                <th class="px-6 py-4 font-semibold">Customer</th>
                <th class="px-6 py-4 font-semibold">Amount</th>
                <th class="px-6 py-4 font-semibold">Status</th>
                <th class="px-6 py-4 font-semibold">Date</th>
                <th class="px-6 py-4 font-semibold text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="ordersList" class="divide-y divide-gray-50 text-gray-700">
              <tr>
                <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                  <div class="animate-pulse flex justify-center">Loading orders...</div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script>
    let knownOrderIds = new Set();
    const notificationSound = new Audio('/audio/notification.mp3'); // Optional sound alert

    async function loadOrders(silent = false) {
      try {
        const token = localStorage.getItem('token') || '';
        const status = document.getElementById('statusFilter').value;
        const search = document.getElementById('searchFilter').value;
        const date = document.getElementById('dateFilter').value;
        const payment = document.getElementById('paymentFilter').value;
        
        let query = `/orders/restaurant?status=${status}&limit=50`;
        if (search) query += `&search=${encodeURIComponent(search)}`;
        if (date) query += `&date=${encodeURIComponent(date)}`;
        if (payment) query += `&payment=${encodeURIComponent(payment)}`;

        const res = await fetch(query, {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        const list = document.getElementById('ordersList');
        if (!silent && list.innerHTML.includes('Loading')) {
          list.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500"><div class="animate-pulse flex justify-center">Loading orders...</div></td></tr>`;
        }

        if (res.ok) {
          const data = await res.json();
          const orders = data.data || [];

          if (orders.length === 0) {
            list.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">No orders found.</td></tr>`;
          } else {
            let hasNewOrder = false;
            list.innerHTML = orders.map(o => {
                if (!knownOrderIds.has(o.id) && o.orderStatus === 'PLACED') {
                  hasNewOrder = true;
                  knownOrderIds.add(o.id);
                }

                const status = o.orderStatus || o.status || 'PENDING';
                let actionsHtml = '';
                
                if (status === 'PLACED' || status === 'PENDING') {
                   actionsHtml = `
                     <button onclick="updateOrderStatus('${o.id}', 'accept')" class="bg-green-100 text-green-700 px-3 py-1 rounded-lg font-bold text-xs hover:bg-green-200 transition-colors mr-2">Accept</button>
                     <button onclick="updateOrderStatus('${o.id}', 'reject')" class="bg-red-100 text-red-700 px-3 py-1 rounded-lg font-bold text-xs hover:bg-red-200 transition-colors">Reject</button>
                   `;
                } else if (status === 'ACCEPTED') {
                   actionsHtml = `
                     <button onclick="updateOrderStatus('${o.id}', 'preparing')" class="bg-blue-100 text-blue-700 px-3 py-1 rounded-lg font-bold text-xs hover:bg-blue-200 transition-colors">Mark Preparing</button>
                   `;
                } else if (status === 'PREPARING') {
                   actionsHtml = `
                     <button onclick="updateOrderStatus('${o.id}', 'ready')" class="bg-purple-100 text-purple-700 px-3 py-1 rounded-lg font-bold text-xs hover:bg-purple-200 transition-colors">Mark Ready</button>
                   `;
                }

                actionsHtml = `<button onclick="viewOrderDetails('${o.id}')" class="bg-gray-100 text-gray-700 px-3 py-1 rounded-lg font-bold text-xs hover:bg-gray-200 transition-colors mr-2">Details</button>` + actionsHtml;

                return `
                <tr class="hover:bg-orange-50 transition-colors">
                  <td class="px-6 py-4 font-medium text-gray-900">#${o.orderNumber || o.id}</td>
                  <td class="px-6 py-4 text-gray-600">${o.customerUser?.customerProfile?.displayName || 'Customer'}</td>
                  <td class="px-6 py-4 font-semibold text-gray-700">₹${o.totalAmount || o.amount || 0}</td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                      ${status}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-gray-500 text-sm">${new Date(o.createdAt).toLocaleString()}</td>
                  <td class="px-6 py-4 text-right">
                    ${actionsHtml}
                  </td>
                </tr>
              `}).join('');
              
            if (hasNewOrder && !silent) {
              try { notificationSound.play(); } catch(e){}
            }
          }
        } else {
          list.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">Failed to load orders.</td></tr>`;
        }
      } catch (err) {
        console.error(err);
        document.getElementById('ordersList').innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-red-500">Error loading data.</td></tr>`;
      }
    }

    loadOrders();
    
    let pollInterval = setInterval(() => {
      loadOrders(true);
    }, 10000); // Poll every 10s

    async function updateOrderStatus(orderId, action) {
      if (!confirm(`Are you sure you want to ${action} this order?`)) return;
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch(`/orders/${orderId}/${action}`, {
          method: 'PATCH',
          headers: { 
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ reason: 'Restaurant action' })
        });
        if (res.ok) {
          showToast('Order status updated successfully', 'success');
          loadOrders(); // reload
        } else {
          const data = await res.json();
          showToast(data.message || 'Failed to update order', 'error');
        }
      } catch (err) {
        console.error(err);
        showToast('Network error while updating order', 'error');
      }
    }

    // Order Details Modal
    async function viewOrderDetails(orderId) {
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch(`/orders/restaurant/${orderId}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (res.ok) {
          const data = await res.json();
          const order = data.data;
          document.getElementById('modalOrderTitle').innerText = `Order #${order.orderNumber || order.id}`;
          
          let itemsHtml = order.items.map(item => {
            return `
              <div class="flex justify-between items-center py-2 border-b border-gray-50 last:border-0 ${item.isUnavailable ? 'opacity-50' : ''}">
                <div>
                  <p class="font-medium text-gray-800 ${item.isUnavailable ? 'line-through' : ''}">${item.quantity}x ${item.itemName}</p>
                  ${item.specialInstructions ? `<p class="text-xs text-orange-600">Note: ${item.specialInstructions}</p>` : ''}
                  ${item.isUnavailable ? `<span class="text-xs text-red-500 font-bold">Unavailable</span>` : ''}
                </div>
                <div class="flex flex-wrap items-center gap-3">
                  <span class="font-semibold">₹${item.lineTotal}</span>
                  ${!item.isUnavailable && order.orderStatus !== 'COMPLETED' && order.orderStatus !== 'CANCELLED' ? 
                    `<button onclick="markItemUnavailable('${order.id}', '${item.id}')" class="text-xs bg-red-100 text-red-600 hover:bg-red-200 px-2 py-1 rounded">Mark Unavailable</button>` : ''}
                </div>
              </div>
            `;
          }).join('');

          document.getElementById('modalOrderContent').innerHTML = `
            <div class="bg-gray-50 p-4 rounded-lg text-sm mb-4">
              <p><strong>Customer:</strong> ${order.customerUser?.customerProfile?.displayName || 'Guest'}</p>
              <p><strong>Status:</strong> ${order.orderStatus}</p>
              <p><strong>Payment:</strong> ${order.paymentStatus}</p>
              <p><strong>Type:</strong> ${order.deliveryType} ${order.scheduledFor ? `(Scheduled: ${new Date(order.scheduledFor).toLocaleString()})` : '(ASAP)'}</p>
            </div>
            <h4 class="font-bold text-gray-700 mb-2 border-b pb-1">Items</h4>
            <div class="space-y-1 mb-4">
              ${itemsHtml}
            </div>
            <div class="text-right border-t pt-2 font-bold text-lg">
              Total: ₹${order.totalAmount}
            </div>
          `;
          document.getElementById('orderDetailsModal').classList.remove('hidden');
        } else {
          showToast('Failed to load details', 'error');
        }
      } catch (e) {
        showToast('Error loading details', 'error');
      }
    }

    function closeOrderDetailsModal() {
      document.getElementById('orderDetailsModal').classList.add('hidden');
    }

    async function markItemUnavailable(orderId, itemId) {
      if (!confirm('Mark item as unavailable and process partial refund?')) return;
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch(`/orders/${orderId}/items/${itemId}/unavailable`, {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (res.ok) {
          showToast('Item marked unavailable', 'success');
          viewOrderDetails(orderId); // refresh modal
          loadOrders(true); // refresh background list
        } else {
          const data = await res.json();
          showToast(data.message || 'Failed to update item', 'error');
        }
      } catch (e) { showToast('Error', 'error'); }
    }

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        const token = localStorage.getItem('token') || '';
        await fetch('/auth/logout', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
      } catch (e) { console.error(e); }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });;
  </script>
  <!-- Order Details Modal -->
  <div id="orderDetailsModal" class="hidden fixed inset-0 z-[60] flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white w-full max-w-2xl rounded-2xl shadow-xl p-4 sm:p-6 max-h-[90vh] flex flex-col">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-xl font-bold text-gray-800" id="modalOrderTitle">Order Details</h3>
        <button onclick="closeOrderDetailsModal()" class="text-gray-400 hover:text-gray-600 text-2xl leading-none">&times;</button>
      </div>
      <div id="modalOrderContent" class="overflow-y-auto flex-1 text-gray-700"></div>
    </div>
  </div>

  <%- include('../partials/toast') %>
</body>

</html>