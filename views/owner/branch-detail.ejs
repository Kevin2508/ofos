<%-
  include('../partials/header', {
    pageTitle: 'Branch Details',
    pageSubtitle: branch.branch_name,
    activePage: 'branches',
    user: user
  })
%>

<div class="breadcrumb">
  <a href="/restaurant-owner/dashboard">Dashboard</a>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
  <a href="/restaurant-owner/branches">Branches</a>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
  <span><%= branch.branch_name %></span>
</div>

<div class="page-header">
  <div class="title-group">
    <h2><%= branch.branch_name %></h2>
    <p>Branch ID: #<%= branch.id %></p>
  </div>
  <div style="display:flex; gap:10px; align-items:center;">
    <span class="badge <%= branch.status === 'active' ? 'badge-active' : 'badge-paused' %>"><%= branch.status %></span>
    <a href="/restaurant-owner/branches/<%= branch.id %>/edit" class="btn btn-secondary">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      Edit
    </a>
  </div>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success" data-autohide>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    <%= success %>
  </div>
<% } %>

<div class="grid grid-2">
  <!-- Cover image -->
  <div class="card">
    <div class="card-header"><h3>Branch Cover Image</h3></div>
    <div class="card-body">
      <% if (branch.cover_url) { %>
        <img src="<%= branch.cover_url %>" id="branchCoverPreview" class="preview-thumb" alt="Branch Cover">
      <% } else { %>
        <img src="" id="branchCoverPreview" class="preview-thumb" style="display:none;" alt="Branch Cover Preview">
        <div class="upload-box" style="margin-bottom:14px; cursor:default;" id="noCoverPlaceholder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7l1.5-4h15L21 7"/><path d="M3 7h18v2a3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1-3 3 3 3 0 0 1-3-3V7z"/><path d="M5 12v8h14v-8"/></svg>
          <div class="upload-text">No cover image uploaded</div>
        </div>
      <% } %>
      <form action="/restaurant-owner/branches/<%= branch.id %>/cover" method="POST" enctype="multipart/form-data">
        <div class="upload-box">
          <input type="file" name="cover" accept="image/*" data-preview-input="branchCoverPreview" required>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          <div class="upload-text">Click to upload cover image</div>
          <div class="upload-sub">PNG, JPG up to 5MB</div>
        </div>
        <button type="submit" class="btn btn-primary btn-block" style="margin-top:14px;">Upload Cover</button>
      </form>
    </div>
  </div>

  <!-- Branch info -->
  <div class="card">
    <div class="card-header"><h3>Branch Information</h3></div>
    <div class="card-body">
      <div class="form-group">
        <label>Address</label>
        <p style="font-size:14px;"><%= branch.address %>, <%= branch.city %>, <%= branch.state %> - <%= branch.pincode %></p>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Contact</label>
          <p style="font-size:14px;"><%= branch.phone || '-' %></p>
        </div>
        <div class="form-group">
          <label>Operating Hours</label>
          <p style="font-size:14px;"><%= branch.opening_time %> - <%= branch.closing_time %></p>
        </div>
      </div>
      <% if (branch.latitude && branch.longitude) { %>
        <div class="form-group">
          <label>Coordinates</label>
          <p style="font-size:14px;"><%= branch.latitude %>, <%= branch.longitude %></p>
        </div>
      <% } %>

      <div class="form-group">
        <label>Order Acceptance</label>
        <div style="display:flex; gap:10px; align-items:center; margin-top:6px;">
          <span class="badge <%= branch.status === 'active' ? 'badge-active' : 'badge-paused' %>"><%= branch.status %></span>
          <% if (branch.status === 'active') { %>
            <form action="/restaurant-owner/branches/<%= branch.id %>/pause?_method=PATCH" method="POST">
              <button type="submit" class="btn btn-outlined btn-sm">Pause Orders</button>
            </form>
          <% } else { %>
            <form action="/restaurant-owner/branches/<%= branch.id %>/resume?_method=PATCH" method="POST">
              <button type="submit" class="btn btn-secondary btn-sm">Resume Orders</button>
            </form>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Pause modal trigger (optional auto-resume time) -->
<% if (branch.status === 'active') { %>
<div class="card" style="margin-top:20px;">
  <div class="card-header"><h3>Temporary Pause with Auto-Resume</h3></div>
  <div class="card-body">
    <p style="font-size:13px; color:var(--neutral-600); margin-bottom:14px;">
      Pause order acceptance temporarily and set a time for it to automatically resume.
    </p>
    <form action="/restaurant-owner/branches/<%= branch.id %>/pause?_method=PATCH" method="POST" style="display:flex; gap:12px; align-items:flex-end; flex-wrap:wrap;">
      <div class="form-group" style="margin-bottom:0; flex:1; min-width:220px;">
        <label>Auto-resume At</label>
        <input type="datetime-local" name="resume_at" class="form-control">
      </div>
      <button type="submit" class="btn btn-primary">Pause Until Then</button>
    </form>
  </div>
</div>
<% } %>

<%- include('../partials/footer') %>
