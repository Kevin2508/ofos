<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Audit Logs | Admin | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="min-h-screen bg-orange-50 font-sans text-gray-800">
  <div class="flex min-h-screen">
    <%- include('../partials/admin/sidebar') %>

    <!-- MAIN CONTENT -->
    <main class="flex-1 lg:ml-72 p-8 transition-all duration-300" id="mainContentWrapper">
      <div class="mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Audit Logs</h2>
        <p class="text-gray-500 mt-2">Track important system and user activities across the platform.</p>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left whitespace-nowrap">
            <thead>
              <tr class="bg-slate-50 border-b border-gray-100 text-slate-500 text-sm uppercase tracking-wider">
                <th class="px-6 py-4 font-semibold">User ID</th>
                <th class="px-6 py-4 font-semibold">Action</th>
                <th class="px-6 py-4 font-semibold">Details</th>
                <th class="px-6 py-4 font-semibold">Timestamp</th>
              </tr>
            </thead>
            <tbody id="logsList" class="divide-y divide-gray-50 text-gray-700">
              <tr>
                <td colspan="4" class="px-6 py-8 text-center text-gray-500">
                  <div class="animate-pulse flex justify-center">Loading audit logs...</div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script>
    async function loadLogs() {
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/admin/audit-logs', {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        const list = document.getElementById('logsList');
        if (res.ok) {
          const data = await res.json();
          const logs = data.data?.auditLogs || [];

          if (logs.length === 0) {
            list.innerHTML = `<tr><td colspan="4" class="px-6 py-8 text-center text-gray-500">No recent activity.</td></tr>`;
          } else {
            list.innerHTML = logs.map(l => `
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4 font-medium text-orange-600">
                  ${l.actor ? l.actor.firstName + ' ' + (l.actor.lastName || '') : 'User #' + (l.actorUserId || '?')}
                </td>
                <td class="px-6 py-4">
                  <span class="px-2 py-1 bg-gray-100 text-gray-800 rounded text-xs font-semibold">${l.action}</span>
                </td>
                <td class="px-6 py-4 text-gray-500 text-sm max-w-xs truncate" title="${l.entityType} #${l.entityId}">
                  <div><strong>${l.entityType}</strong> #${l.entityId}</div>
                  <div class="text-xs text-gray-400 truncate mt-1">
                    ${l.newValues ? 'Updates: ' + JSON.stringify(l.newValues) : ''}
                  </div>
                </td>
                <td class="px-6 py-4 text-sm text-gray-500">
                  ${new Date(l.createdAt).toLocaleString()}
                </td>
              </tr>
            `).join('');
          }
        }
      } catch (err) {
        console.error(err);
      }
    }

    loadLogs();

    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      try {
        const token = localStorage.getItem('token') || '';
        await fetch('/auth/logout', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
      } catch (e) { console.error(e); }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });;
  </script>
</body>

</html>