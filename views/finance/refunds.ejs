<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Refunds | Finance Manager | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="min-h-screen bg-orange-50 font-sans text-gray-800">
  <div class="flex min-h-screen">
    <%- include('../partials/finance/sidebar') %>

    <!-- MAIN CONTENT -->
    <main class="flex-1 lg:ml-72 p-5 sm:p-8 transition-all duration-300" id="mainContentWrapper">
      <div class="mb-8 flex flex-wrap items-start md:items-center gap-3">
        <button onclick="toggleSidebar()" class="p-2 -ml-2 mt-1 md:mt-0 text-gray-600 hover:text-orange-500 rounded-xl hover:bg-orange-50 transition-colors lg:hidden">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
        <div>
          <h2 class="text-3xl font-bold text-gray-900">Refunds Processing</h2>
        <p class="text-gray-500 mt-2">Manage customer refunds for cancelled or disputed orders.</p>
      
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left whitespace-nowrap">
            <thead>
              <tr class="bg-orange-50 border-b border-gray-100 text-gray-600 text-sm uppercase tracking-wider">
                <th class="px-6 py-4 font-semibold">Reference</th>
                <th class="px-6 py-4 font-semibold">Order ID</th>
                <th class="px-6 py-4 font-semibold">Reason</th>
                <th class="px-6 py-4 font-semibold">Amount</th>
                <th class="px-6 py-4 font-semibold">Status</th>
                <th class="px-6 py-4 font-semibold text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="refundsList" class="divide-y divide-gray-50 text-gray-700">
              <tr>
                <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                  <div class="animate-pulse flex justify-center">Loading refunds...</div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script>
    async function updateStatus(id, newStatus) {
      if (!confirm(`Mark this refund as ${newStatus}?`)) return;
      try {
        const res = await fetch(`/finance/refunds/${id}/status`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ status: newStatus })
        });
        if (res.ok) {
          alert('Refund status updated!');
          loadRefunds();
        } else {
          alert('Failed to update status.');
        }
      } catch (err) {
        console.error(err);
      }
    }

    async function loadRefunds() {
      try {
        const res = await fetch('/finance/refunds', {
          headers: {}
        });

        const list = document.getElementById('refundsList');
        if (res.ok) {
          const data = await res.json();
          const refunds = data.data || [];

          if (refunds.length === 0) {
            list.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">No refunds found.</td></tr>`;
          } else {
            list.innerHTML = refunds.map(r => `
              <tr class="hover:bg-orange-50/50 transition-colors">
                <td class="px-6 py-4 font-bold text-gray-900">${r.refundReference}</td>
                <td class="px-6 py-4 text-gray-600">Order #${r.orderId}</td>
                <td class="px-6 py-4 text-sm text-gray-500 truncate max-w-xs" title="${r.reason}">
                  ${r.reason}
                </td>
                <td class="px-6 py-4 font-medium text-red-600">₹${r.amount.toFixed(2)}</td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${r.status === 'COMPLETED' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'}">
                    ${r.status}
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  ${r.status === 'INITIATED' || r.status === 'PROCESSING' ? `
                    <button onclick="updateStatus('${r.id}', 'COMPLETED')" class="text-orange-600 hover:text-orange-800 text-sm font-medium">Mark Completed</button>
                  ` : `<span class="text-sm text-gray-400">Done</span>`}
                </td>
              </tr>
            `).join('');
          }
        }
      } catch (err) {
        console.error(err);
      }
    }

    loadRefunds();

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        await fetch('/auth/logout', {
          headers: {}
        });
      } catch (e) { console.error(e); }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });;
  </script>
</body>

</html>