<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | ofos - Food Ordering System</title>
    <link rel="stylesheet" href="/styles/build.css" />
  </head>
  <body
    class="min-h-screen bg-linear-to-br from-orange-50 via-rose-50 to-amber-50"
  >
    <!-- Floating food decorations -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden select-none">
      <span class="absolute top-16 left-[15%] text-5xl opacity-15">🍕</span>
      <span class="absolute top-32 right-[20%] text-4xl opacity-20">🍔</span>
      <span class="absolute bottom-24 left-[25%] text-6xl opacity-10">🌮</span>
      <span class="absolute top-1/3 right-[15%] text-3xl opacity-15">🥗</span>
      <span class="absolute bottom-40 right-[30%] text-5xl opacity-10">🍜</span>
      <span class="absolute top-3/4 left-[10%] text-4xl opacity-15">🍣</span>
    </div>

    <div
      class="min-h-screen flex items-center justify-center px-4 py-10 relative"
    >
      <div class="w-full max-w-5xl">
        <div
          class="bg-white/80 backdrop-blur-sm rounded-3xl shadow-2xl overflow-hidden border border-orange-100/60"
        >
          <div class="lg:flex">
            <!-- Left Brand Panel -->
            <div
              class="lg:w-5/12 bg-linear-to-br from-orange-500 via-orange-600 to-rose-600 p-8 lg:p-10 text-white flex flex-col justify-between relative overflow-hidden min-h-70 lg:min-h-0"
            >
              <div
                class="absolute -top-24 -right-24 w-72 h-72 bg-white/5 rounded-full"
              ></div>
              <div
                class="absolute -bottom-20 -left-20 w-56 h-56 bg-white/5 rounded-full"
              ></div>
              <div
                class="absolute top-1/2 -translate-y-1/2 right-0 w-32 h-32 bg-white/3 rounded-full"
              ></div>

              <div class="relative">
                <div class="flex items-center gap-3 mb-5">
                  <span class="text-3xl">🍽️</span>
                  <h1 class="text-3xl font-extrabold tracking-tight">ofos</h1>
                </div>
                <p class="text-orange-100 text-base leading-relaxed mb-7">
                  Your favorite food, delivered
                  <span class="font-semibold text-white">fresh & fast</span> to
                  your doorstep.
                </p>
                <div class="space-y-4">
                  <div class="flex items-center gap-3">
                    <span
                      class="shrink-0 w-10 h-10 bg-white/20 rounded-full flex items-center justify-center text-lg"
                      >🚀</span
                    >
                    <div>
                      <p class="font-semibold text-sm">Fast Delivery</p>
                      <p class="text-xs text-orange-100">30 min or it's free</p>
                    </div>
                  </div>
                  <div class="flex items-center gap-3">
                    <span
                      class="shrink-0 w-10 h-10 bg-white/20 rounded-full flex items-center justify-center text-lg"
                      >🍳</span
                    >
                    <div>
                      <p class="font-semibold text-sm">100+ Restaurants</p>
                      <p class="text-xs text-orange-100">
                        From local to global cuisine
                      </p>
                    </div>
                  </div>
                  <div class="flex items-center gap-3">
                    <span
                      class="shrink-0 w-10 h-10 bg-white/20 rounded-full flex items-center justify-center text-lg"
                      >⭐</span
                    >
                    <div>
                      <p class="font-semibold text-sm">Best Prices</p>
                      <p class="text-xs text-orange-100">
                        Exclusive deals & offers
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="relative mt-6 pt-5 border-t border-white/20">
                <div
                  class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-orange-100"
                >
                  <span>🍕 Pizza</span>
                  <span>🍔 Burger</span>
                  <span>🌮 Taco</span>
                  <span>🥗 Salad</span>
                  <span>🍜 Noodles</span>
                </div>
              </div>
            </div>

            <!-- Right Form Panel -->
            <div class="lg:w-7/12 p-8 lg:p-12">
              <div class="max-w-sm mx-auto">
                <div class="text-center lg:text-left mb-8">
                  <h2 class="text-2xl font-bold text-gray-800">
                    Welcome Back! 👋
                  </h2>
                  <p class="text-gray-400 mt-1 text-sm">
                    Log in to continue ordering your favorites
                  </p>
                </div>

                <form id="loginForm" class="space-y-5">
                  <div>
                    <label
                      class="block text-sm font-semibold text-gray-700 mb-1.5"
                    >
                      Email or Phone Number
                    </label>
                    <input
                      type="text"
                      id="userIdentifier"
                      name="userIdentifier"
                      placeholder="Enter email or 10 digit phone"
                      class="w-full px-4 py-3.5 rounded-2xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition duration-200 bg-gray-50 focus:bg-white"
                    />
                    <p
                      id="userIdentifierError"
                      class="text-red-500 text-sm mt-1.5"
                    ></p>
                  </div>

                  <div>
                    <label
                      class="block text-sm font-semibold text-gray-700 mb-1.5"
                    >
                      Password
                    </label>
                    <div class="relative">
                      <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter password"
                        class="w-full px-4 py-3.5 pr-16 rounded-2xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition duration-200 bg-gray-50 focus:bg-white"
                      />
                      <button
                        type="button"
                        id="togglePassword"
                        class="absolute right-4 top-1/2 -translate-y-1/2 text-orange-500 font-semibold text-sm hover:text-orange-600 transition"
                      >
                        Show
                      </button>
                    </div>
                    <p
                      id="passwordError"
                      class="text-red-500 text-sm mt-1.5"
                    ></p>
                  </div>

                  <div class="flex items-center justify-between">
                    <label class="flex items-center gap-2 cursor-pointer group">
                      <input
                        type="checkbox"
                        id="rememberMe"
                        name="rememberMe"
                        value="true"
                        class="w-4 h-4 accent-orange-500 rounded border-gray-300"
                      />
                      <span
                        class="text-sm text-gray-500 group-hover:text-gray-700 transition"
                      >
                        Remember Me
                      </span>
                    </label>
                    <a
                      href="/forgotPasswordPage"
                      class="text-sm font-medium text-orange-500 hover:text-orange-600 transition"
                    >
                      Forgot Password?
                    </a>
                  </div>

                  <button
                    type="submit"
                    id="loginBtn"
                    class="w-full bg-linear-to-r from-orange-500 to-rose-500 hover:from-orange-600 hover:to-rose-600 text-white font-semibold py-3.5 rounded-2xl transition duration-200 shadow-lg shadow-orange-200 hover:shadow-xl hover:shadow-orange-300 cursor-pointer"
                  >
                    Login
                  </button>
                </form>

                <div class="mt-8 text-center">
                  <p class="text-gray-400 text-sm">
                    Don't have an account?
                    <a
                      href="/registerPage"
                      class="font-semibold text-orange-500 hover:text-orange-600 transition"
                    >
                      Create Account
                    </a>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      const loginForm = document.getElementById('loginForm');
      const loginBtn = document.getElementById('loginBtn');

      const userIdentifier = document.getElementById('userIdentifier');
      const password = document.getElementById('password');
      const rememberMe = document.getElementById('rememberMe');

      const userIdentifierError = document.getElementById(
        'userIdentifierError'
      );
      const passwordError = document.getElementById('passwordError');

      const togglePassword = document.getElementById('togglePassword');

      /* -------------------------------
   Show / Hide Password
-------------------------------- */
      togglePassword.addEventListener('click', () => {
        if (password.type === 'password') {
          password.type = 'text';
          togglePassword.textContent = 'Hide';
        } else {
          password.type = 'password';
          togglePassword.textContent = 'Show';
        }
      });

      /* -------------------------------
   Validation
-------------------------------- */

      function validateUserIdentifier(value) {
        const trimmed = value.trim();

        if (!trimmed) {
          return 'please enter email or phone as userIdentifier';
        }

        const phoneRegex = /^[0-9]{10}$/;

        const emailRegex =
          /^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.(com|net|org|io)$/;

        if (phoneRegex.test(trimmed)) {
          return '';
        }

        if (/^[0-9]+$/.test(trimmed) && trimmed.length !== 10) {
          return 'Contact number must be exactly 10 digits';
        }

        if (emailRegex.test(trimmed)) {
          return '';
        }

        return 'Please enter a valid email address ending in .com';
      }

      function validatePassword(value) {
        if (!value) {
          return 'Password is required';
        }

        if (value.length < 8) {
          return 'Password must be at least 8 characters';
        }

        return '';
      }

      function clearErrors() {
        userIdentifierError.textContent = '';
        passwordError.textContent = '';
      }

      //  Submit
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        clearErrors();

        const identifierValue = userIdentifier.value.trim();
        const passwordValue = password.value;

        const identifierValidation = validateUserIdentifier(identifierValue);

        const passwordValidation = validatePassword(passwordValue);

        let hasError = false;

        if (identifierValidation) {
          userIdentifierError.textContent = identifierValidation;
          hasError = true;
        }

        if (passwordValidation) {
          passwordError.textContent = passwordValidation;
          hasError = true;
        }

        if (hasError) return;

        loginBtn.disabled = true;
        loginBtn.textContent = 'Logging in...';

        try {
          const response = await fetch('/auth/login', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({
              userIdentifier: identifierValue,
              password: passwordValue,
              rememberMe: rememberMe.checked ? 'true' : 'false',
            }),
          });

          const data = await response.json();

          if (!response.ok) {
            showToast(data.message || data.error || 'Login failed', 'error');
            return;
          }

          // console.log(data.data.user);
          window.location.href = data.redirectUrl || '/';
        } catch (error) {
          showToast('Something went wrong. Please try again.', 'error');
        } finally {
          loginBtn.disabled = false;
          loginBtn.textContent = 'Login';
        }
      });
    </script>
    <%- include('../partials/toast') %>
  </body>
</html>
