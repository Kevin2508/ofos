<%-
  include('../partials/header', {
    pageTitle: 'Branches',
    pageSubtitle: 'Manage your restaurant branches',
    activePage: 'branches',
    user: user
  })
%>

<div class="breadcrumb">
  <a href="/restaurant-owner/dashboard">Dashboard</a>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
  <span>Branches</span>
</div>

<div class="page-header">
  <div class="title-group">
    <h2>Branches</h2>
    <p><%= restaurant.name %> &middot; <%= branches ? branches.length : 0 %> branch<%= (branches && branches.length === 1) ? '' : 'es' %></p>
  </div>
  <a href="/restaurant-owner/branches/new" class="btn btn-primary">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Add Branch
  </a>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success" data-autohide>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    <%= success %>
  </div>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-error">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
    <%= error %>
  </div>
<% } %>

<% if (branches && branches.length > 0) { %>
  <div class="grid grid-3">
    <% branches.forEach(branch => { %>
      <div class="branch-card">
        <div class="branch-card-img">
          <% if (branch.cover_url) { %>
            <img src="<%= branch.cover_url %>" alt="<%= branch.branch_name %>" style="width:100%; height:100%; object-fit:cover;">
          <% } else { %>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7l1.5-4h15L21 7"/><path d="M3 7h18v2a3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1-3 3 3 3 0 0 1-3-3 3 3 0 0 1-3 3 3 3 0 0 1-3-3V7z"/><path d="M5 12v8h14v-8"/></svg>
          <% } %>
          <div class="branch-status">
            <span class="badge <%= branch.status === 'active' ? 'badge-active' : 'badge-paused' %>"><%= branch.status %></span>
          </div>
        </div>
        <div class="branch-card-body">
          <h4><%= branch.branch_name %></h4>
          <div class="addr">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span><%= branch.address %></span>
          </div>
          <div class="branch-card-meta">
            <span><%= branch.phone || 'No phone added' %></span>
            <span><%= branch.opening_time || '--' %> - <%= branch.closing_time || '--' %></span>
          </div>
        </div>
        <div class="branch-card-footer">
          <a href="/restaurant-owner/branches/<%= branch.id %>" class="btn btn-outlined btn-sm">View</a>
          <a href="/restaurant-owner/branches/<%= branch.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
          <% if (branch.status === 'active') { %>
            <form action="/restaurant-owner/branches/<%= branch.id %>/pause?_method=PATCH" method="POST">
              <button type="submit" class="icon-btn-square" title="Pause Branch">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
              </button>
            </form>
          <% } else { %>
            <form action="/restaurant-owner/branches/<%= branch.id %>/resume?_method=PATCH" method="POST">
              <button type="submit" class="icon-btn-square" title="Resume Branch">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
              </button>
            </form>
          <% } %>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="card">
    <div class="empty-state">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
      <h3>No Branches Added Yet</h3>
      <p>Every restaurant must have at least one branch to start receiving orders.</p>
      <a href="/restaurant-owner/branches/new" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Your First Branch
      </a>
    </div>
  </div>
<% } %>

<%- include('../partials/footer') %>
