<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manage Users | Admin | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="min-h-screen bg-orange-50 font-sans text-gray-800">
  <div class="flex min-h-screen">
    <%- include('../partials/admin/sidebar') %>

    <!-- MAIN CONTENT -->
    <main class="flex-1 lg:ml-72 p-8 transition-all duration-300" id="mainContentWrapper">
      <div class="mb-8 flex justify-between items-center">
        <div>
          <h2 class="text-3xl font-bold text-gray-900">User Management</h2>
          <p class="text-gray-500 mt-2">View all registered users and manage their status.</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left whitespace-nowrap">
            <thead>
              <tr class="bg-slate-50 border-b border-gray-100 text-slate-500 text-sm uppercase tracking-wider">
                <th class="px-6 py-4 font-semibold">User Details</th>
                <th class="px-6 py-4 font-semibold">Role</th>
                <th class="px-6 py-4 font-semibold">Role Status</th>
                <th class="px-6 py-4 font-semibold">Date Joined</th>
                <th class="px-6 py-4 font-semibold text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="usersList" class="divide-y divide-gray-50 text-gray-700">
              <tr>
                <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                  <div class="animate-pulse flex justify-center">Loading users...</div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
    </main>
  </div>

  <!-- User Details Modal -->
  <div id="userModal" class="hidden fixed inset-0 bg-black/40 flex items-center justify-center p-4 z-[80]">
    <div class="bg-white w-full max-w-lg rounded-3xl p-6 shadow-xl transform transition-all">
      <div class="flex justify-between items-center mb-5">
        <h3 class="text-xl font-bold text-gray-900">User Details</h3>

        <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600 transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div id="userDetails" class="space-y-3 text-gray-700 bg-slate-50 p-4 rounded-xl border border-gray-100 mb-6"></div>

      <div class="mt-5">
        <label class="block mb-2 font-semibold"> Role </label>

        <select id="updateRole" class="w-full px-4 py-3 rounded-xl border">
          <option value="Customer">Customer</option>
          <option value="Admin">Admin</option>
          <option value="Restaurant_owner">Restaurant Owner</option>
          <option value="Restaurant_staff">Restaurant Staff</option>
          <option value="Fleet_manager">Fleet Manager</option>
          <option value="Delivery_partner">Delivery Partner</option>
          <option value="Finance_manager">Finance Manager</option>
        </select>
      </div>

      <div class="mt-4">
        <label class="block mb-2 font-semibold"> Role Status </label>

        <select id="updateStatus" class="w-full px-4 py-3 rounded-xl border">
          <option value="REQUESTED">REQUESTED</option>
          <option value="ASSIGNED">ASSIGNED</option>
          <option value="REJECTED">REJECTED</option>
          <option value="SUSPENDED">SUSPENDED</option>
        </select>
      </div>

      <button id="updateBtn" onclick="updateUser()"
        class="w-full mt-6 bg-orange-500 text-white py-3.5 rounded-xl font-bold hover:bg-orange-600 transition-colors shadow-lg shadow-orange-500/30">
        Update User
      </button>
    </div>
  </div>

  <script>
    let users = [];
    let selectedUserId = null;

    // Initial Load
    fetchUsers();

    // Get users
    async function fetchUsers() {
      try {
        const token = localStorage.getItem('token') || '';
        const response = await fetch('/admin/users', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        json = await response.json();
        if (response.ok) {
          renderUsers(json.data.users || []);
        } else {
          showToast(json.message || 'Failed to load users', 'error');
        }
      } catch (error) {
        showToast('Failed to load users', 'error');
      }
    }

    function renderUsers(data) {
      const table = document.getElementById('usersList');
      if (!data.length) {
        table.innerHTML = `
      <tr>
        <td colspan="5" class="p-6 text-center text-gray-500">
          No users found
        </td>
      </tr>
    `;

        return;
      }

      table.innerHTML = data
        .map(
          (user) => {
            const roleName = user.roles && user.roles.length > 0 ? user.roles.map(r => r.name).join(', ') : 'Customer';
            const roleStatus = user.roles && user.roles.length > 0 ? user.roles[0].status : 'N/A';
            
            // Determine badge color based on status
            let statusColorClass = 'bg-gray-100 text-gray-800';
            if (roleStatus === 'ASSIGNED') statusColorClass = 'bg-green-100 text-green-800';
            if (roleStatus === 'REQUESTED') statusColorClass = 'bg-yellow-100 text-yellow-800';
            if (roleStatus === 'REJECTED') statusColorClass = 'bg-red-100 text-red-800';
            if (roleStatus === 'SUSPENDED') statusColorClass = 'bg-orange-100 text-orange-800';

            return `
    <tr class="hover:bg-slate-50 transition-colors border-t border-gray-100">
      <td class="px-6 py-4">
        <div class="font-medium text-gray-900">${user.firstName} ${user.lastName || ''}</div>
        <div class="text-sm text-gray-500">${user.email}</div>
      </td>
      <td class="px-6 py-4 capitalize">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
          ${roleName}
        </span>
      </td>
      <td class="px-6 py-4 capitalize">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${statusColorClass}">
          ${roleStatus}
        </span>
      </td>
      <td class="px-6 py-4 text-sm text-gray-500">
        ${new Date(user.joiningDate).toLocaleDateString()}
      </td>

      <td class="px-6 py-4 text-right">

        <button
          onclick="viewUser('${user.id}')"
          class="bg-orange-50 text-orange-600 hover:bg-orange-100 hover:text-orange-700 font-semibold px-4 py-2 rounded-lg transition-colors">

          Manage

        </button>

      </td>

    </tr>

  `;}
        )
        .join('');
    }

    // View User
    async function viewUser(id) {
      selectedUserId = id;

      try {
        const token = localStorage.getItem('token') || '';
        const response = await fetch(`/admin/user/${id}`, {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        const json = await response.json();
        if (response.ok && json.data?.user) {
          const user = json.data.user;
          document.getElementById('userDetails').innerHTML = `
        <p><b>Name:</b> ${user.firstName} ${user.lastName || ''}</p>
        <p><b>Email:</b> ${user.email}</p>
        <p><b>Phone:</b> ${user.phone || 'N/A'}</p>
      `;

          const roleName = user.roles && user.roles.length > 0 ? user.roles[0].name : 'Customer';
          const roleStatus = user.roles && user.roles.length > 0 ? user.roles[0].status : 'REQUESTED';

          document.getElementById('updateRole').value = roleName;
          document.getElementById('updateStatus').value = roleStatus;

          document.getElementById('userModal').classList.remove('hidden');
        } else {
          showToast(json.message || 'Failed to fetch user details', 'error');
        }
      } catch (err) {
        showToast('Error fetching user', 'error');
      }
    }

    function closeModal() {
      document.getElementById('userModal').classList.add('hidden');
    }

    // Update user
    async function updateUser() {
      const btn = document.getElementById('updateBtn');

      btn.disabled = true;
      btn.textContent = 'Updating...';

      try {
        const token = localStorage.getItem('token') || '';
        const response = await fetch(`/admin/user/${selectedUserId}/status`, {
          method: 'PATCH',

          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },

          body: JSON.stringify({
            roleName: document.getElementById('updateRole').value,
            status: document.getElementById('updateStatus').value,
          }),
        });

        const data = await response.json();

        if (response.ok) {
          showToast('User updated successfully', 'success');
          closeModal();
          fetchUsers();
        } else {
          showToast(data.message || 'Failed to update user', 'error');
        }
      } catch (err) {
        showToast('Something went wrong. Please try again.', 'error');
      } finally {
        btn.disabled = false;
        btn.textContent = 'Update User';
      }
    }

  </script>
  <%- include('../partials/toast') %>
</body>

</html>