    </div>
  </div>

  <!-- ══════════════════════════════════════════════
     PAYMENT MODAL
  ═══════════════════════════════════════════════ -->
  <div id="paymentModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="paymentModalTitle">
    <div class="modal-box">
      <div class="flex items-center justify-between mb-5">
        <h3 id="paymentModalTitle" class="text-xl font-bold text-gray-800">Add Payment Method</h3>
        <button onclick="closePaymentModal()" class="p-2 text-gray-400 hover:text-gray-600 rounded-full hover:bg-gray-100 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <form id="paymentForm" class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-2">Type</label>
          <div class="flex gap-3">
            <label class="label-radio flex-1"><input type="radio" name="paymentType" value="CARD" checked /><span>💳 Card</span></label>
            <label class="label-radio flex-1"><input type="radio" name="paymentType" value="UPI" /><span>📱 UPI</span></label>
          </div>
        </div>
        
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1" for="pm_identifier">Card Number / UPI ID</label>
          <input type="text" id="pm_identifier" name="identifier" class="if" placeholder="XXXX-XXXX-XXXX-1234 or name@upi" required />
        </div>
        
        <div>
          <label class="block text-sm font-semibold text-gray-600 mb-1" for="pm_provider">Provider (Simulation)</label>
          <select id="pm_provider" name="provider" class="if">
             <option value="RAZORPAY">Razorpay</option>
             <option value="STRIPE">Stripe</option>
          </select>
        </div>

        <button type="submit" id="paymentSubmitBtn" class="w-full py-3 rounded-xl font-bold text-white bg-orange-500 hover:bg-orange-600 transition-colors shadow-sm">
          Save Payment Method
        </button>
      </form>
    </div>
  </div>

  <script>
    (function () {
      'use strict';

      // ─── State ────────────────────────────────────────────────────
      let cachedAddresses = [];

      // ─── DOM refs ─────────────────────────────────────────────────
      const profileLoading = document.getElementById('profileLoading');
      const profileContent = document.getElementById('profileContent');
      const addressesList = document.getElementById('addressesList');
      const addressModal = document.getElementById('addressModal');
      const addressForm = document.getElementById('addressForm');
      const addressFormErr = document.getElementById('addressFormError');
      const addressSubmitBtn = document.getElementById('addressSubmitBtn');
      const editAddressId = document.getElementById('editAddressId');
      const modalTitle = document.getElementById('modalTitle');

      // ─── Modal open / close ───────────────────────────────────────
      function openModal() {
        addressModal.classList.add('open');
        document.body.style.overflow = 'hidden';
        // focus first field for accessibility
        setTimeout(() => document.getElementById('f_contactName').focus(), 100);
      }

      function closeModal() {
        addressModal.classList.remove('open');
        document.body.style.overflow = '';
        addressFormErr.classList.add('hidden');
        addressForm.reset();
        document.getElementById('f_country').value = 'India';
        document.getElementById('f_latitude').value = '0';
        document.getElementById('f_longitude').value = '0';
        editAddressId.value = '';
      }

      // Close on backdrop click
      addressModal.addEventListener('click', function (e) {
        if (e.target === addressModal) closeModal();
      });

      // Close on ✕ button
      document.getElementById('modalCloseBtn').addEventListener('click', closeModal);

      // Close on Cancel button
      document.getElementById('modalCancelBtn').addEventListener('click', closeModal);

      // Close on Escape key
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && addressModal.classList.contains('open')) closeModal();
      });

      // Add New button
      document.getElementById('addAddressBtn').addEventListener('click', function () {
        modalTitle.textContent = 'Add New Address';
        addressSubmitBtn.textContent = 'Save Address';
        openModal();
      });

      // ─── Tab switching ────────────────────────────────────────────
      window.switchTab = function (tab) {
        document.querySelectorAll('.profile-section').forEach(s => s.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(b => {
          b.classList.remove('active');
          b.classList.add('text-gray-600', 'hover:bg-orange-50');
        });
        document.getElementById('section-' + tab).classList.add('active');
        const btn = document.getElementById('tab-' + tab);
        btn.classList.add('active');
        btn.classList.remove('text-gray-600', 'hover:bg-orange-50');
      };

      // ─── Password toggle ──────────────────────────────────────────
      document.querySelectorAll('.pw-toggle').forEach(btn => {
        btn.addEventListener('click', function () {
          const inp = document.getElementById(this.dataset.target);
          inp.type = inp.type === 'password' ? 'text' : 'password';
        });
      });

      // ─── Password strength ────────────────────────────────────────
      document.getElementById('newPassword').addEventListener('input', function () {
        const v = this.value;
        const bar = document.getElementById('pwStrengthBar');
        const fill = document.getElementById('pwStrengthFill');
        const label = document.getElementById('pwStrengthLabel');
        if (!v) { bar.classList.add('hidden'); label.classList.add('hidden'); return; }
        bar.classList.remove('hidden'); label.classList.remove('hidden');
        let score = 0;
        if (v.length >= 8) score++;
        if (/[A-Z]/.test(v)) score++;
        if (/[0-9]/.test(v)) score++;
        if (/[^A-Za-z0-9]/.test(v)) score++;
        const levels = [
          { w: '25%', color: '#ef4444', text: 'Weak' },
          { w: '50%', color: '#f97316', text: 'Fair' },
          { w: '75%', color: '#eab308', text: 'Good' },
          { w: '100%', color: '#22c55e', text: 'Strong' },
        ];
        const l = levels[Math.max(score - 1, 0)];
        fill.style.width = l.w; fill.style.background = l.color;
        label.textContent = l.text; label.style.color = l.color;
      });

      // ─── Load profile ─────────────────────────────────────────────
      async function loadProfile() {
        try {
          const res = await fetch('/customer/profile-data');
          const json = await res.json();
          profileLoading.classList.add('hidden');

          if (!res.ok || !json.data) {
            showToast('Failed to load profile', 'error');
            return;
          }

          const u = json.data.user;
          document.getElementById('pi_firstName').value = u.firstName || '';
          document.getElementById('pi_lastName').value = u.lastName || '';
          document.getElementById('pi_email').value = u.email || '';
          document.getElementById('pi_phone').value = u.phone || '';

          renderHeader(u);
          renderAddresses(json.data.addresses || []);
          renderRoles(u);
          loadSessions();
          loadPreferences();
          loadPaymentMethods();
          loadLoyaltyData();
          profileContent.classList.remove('hidden');
        } catch {
          profileLoading.classList.add('hidden');
          showToast('Error loading profile', 'error');
        }
      }

      function renderHeader(user) {
        // Avatar
        const container = document.getElementById('avatarContainer');
        if (user.profileImageUrl) {
          container.innerHTML = `<img src="${escHtml(user.profileImageUrl)}" class="profile-avatar" alt="Profile picture" />`;
        } else {
          const initial = user.firstName ? user.firstName.charAt(0).toUpperCase() : 'U';
          container.innerHTML = `<div class="avatar-initial" aria-hidden="true">${escHtml(initial)}</div>`;
        }

        // Name
        document.getElementById('profileName').textContent =
          [user.firstName, user.lastName].filter(Boolean).join(' ');

        // Email
        const emailSpan = document.getElementById('profileEmail').querySelector('span');
        emailSpan.textContent = user.email || 'Not provided';

        // Phone
        const phoneSpan = document.getElementById('profilePhone').querySelector('span');
        phoneSpan.textContent = user.phone || '—';

        // Verification badges
        const badges = document.getElementById('verificationBadges');
        badges.innerHTML = '';
        if (user.emailVerified) badges.innerHTML += `<span class="inline-flex items-center gap-1 text-xs px-2.5 py-0.5 bg-green-50 text-green-600 rounded-full font-semibold border border-green-200">✔ Email Verified</span>`;
        if (user.phoneVerified) badges.innerHTML += `<span class="inline-flex items-center gap-1 text-xs px-2.5 py-0.5 bg-green-50 text-green-600 rounded-full font-semibold border border-green-200">✔ Phone Verified</span>`;

        // Joined date
        if (user.createdAt) {
          document.getElementById('profileJoined').textContent =
            'Member since ' + new Date(user.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' });
        }
      }

      // ─── Addresses rendering ──────────────────────────────────────
      const LABEL_META = {
        HOME: { cls: 'badge-home', icon: '🏠' },
        WORK: { cls: 'badge-work', icon: '💼' },
        OTHER: { cls: 'badge-other', icon: '📍' },
      };

      function renderAddresses(addresses) {
        cachedAddresses = addresses;

        if (!addresses.length) {
          addressesList.innerHTML = `
        <div class="bg-white border border-dashed border-orange-200 rounded-2xl p-10 text-center">
          <div class="text-5xl mb-3">📭</div>
          <p class="text-gray-500 font-medium">No addresses saved yet</p>
          <p class="text-gray-400 text-sm mt-1">Tap "Add New" to save a delivery address</p>
        </div>`;
          return;
        }

        addressesList.innerHTML = addresses.map(addr => {
          const meta = LABEL_META[addr.label] || { cls: 'badge-other', icon: '📍' };
          const line2 = [addr.addressLine2, addr.landmark].filter(Boolean).join(', ');
          return `
        <div class="addr-card bg-white border border-orange-100 rounded-2xl p-5 shadow-sm">
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="${meta.cls} inline-flex items-center gap-1 text-xs font-bold px-2.5 py-0.5 rounded-full">
                  ${meta.icon} ${escHtml(addr.label)}
                </span>
                ${addr.isDefault ? '<span class="text-xs bg-orange-100 text-orange-600 font-bold px-2.5 py-0.5 rounded-full border border-orange-200">⭐ Default</span>' : ''}
              </div>
              <p class="font-semibold text-gray-800">
                ${escHtml(addr.contactName)}
                <span class="font-normal text-gray-500 text-sm">· ${escHtml(addr.contactPhone)}</span>
              </p>
              <p class="text-gray-600 text-sm mt-1">${escHtml(addr.addressLine1)}${line2 ? ', ' + escHtml(line2) : ''}</p>
              <p class="text-gray-600 text-sm">${escHtml(addr.city)}, ${escHtml(addr.state)} – ${escHtml(addr.postalCode)}, ${escHtml(addr.country)}</p>
            </div>
            <div class="flex flex-col gap-2 flex-shrink-0">
              <button onclick="editAddress('${escHtml(addr.id)}')"
                class="p-2 rounded-xl text-orange-500 bg-orange-50 hover:bg-orange-100 transition-colors"
                title="Edit address" aria-label="Edit address">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
              </button>
              <button onclick="deleteAddress('${escHtml(addr.id)}')"
                class="p-2 rounded-xl text-red-400 bg-red-50 hover:bg-red-100 transition-colors"
                title="Delete address" aria-label="Delete address">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              </button>
            </div>
          </div>
          ${!addr.isDefault ? `
            <button onclick="setAsDefault('${escHtml(addr.id)}')"
              class="mt-3 w-full text-xs font-semibold text-orange-500 hover:text-orange-600 py-2 border border-orange-200 rounded-xl hover:bg-orange-50 transition-colors">
              Set as Default
            </button>` : ''}
        </div>`;
        }).join('');
      }

      // ─── Roles rendering ──────────────────────────────────────────
      function renderRoles(user) {
        const rolesList = document.getElementById('profileRolesList');
        const roles = user.roles || [];
        const pendingRoles = user.pendingRoles || [];

        let html = '';

        if (roles.length > 0) {
          html += roles.map(role => `
        <div class="flex items-center gap-3 p-3 bg-green-50 border border-green-200 rounded-xl">
          <div class="w-10 h-10 rounded-full bg-green-100 flex items-center justify-center text-green-600 font-bold">✓</div>
          <div>
            <p class="font-bold text-green-800">${role}</p>
            <p class="text-xs text-green-600">Active & Assigned</p>
          </div>
        </div>
      `).join('');
        }

        if (pendingRoles.length > 0) {
          html += pendingRoles.map(role => `
        <div class="flex items-center gap-3 p-3 bg-yellow-50 border border-yellow-200 rounded-xl">
          <div class="w-10 h-10 rounded-full bg-yellow-100 flex items-center justify-center text-yellow-600 font-bold">⏱</div>
          <div>
            <p class="font-bold text-yellow-800">${role}</p>
            <p class="text-xs text-yellow-600">Request pending admin review</p>
          </div>
        </div>
      `).join('');
        }

        if (html === '') {
          html = '<p class="text-gray-500 text-sm">You currently have no roles assigned.</p>';
        }

        rolesList.innerHTML = html;
      }

      // ─── Edit address ─────────────────────────────────────────────
      window.editAddress = function (id) {
        const addr = cachedAddresses.find(a => String(a.id) === String(id));
        if (!addr) return;

        modalTitle.textContent = 'Edit Address';
        editAddressId.value = addr.id;
        addressSubmitBtn.textContent = 'Update Address';

        // Populate radio
        document.querySelectorAll('[name="label"]').forEach(r => { r.checked = r.value === addr.label; });

        document.getElementById('f_contactName').value = addr.contactName || '';
        document.getElementById('f_contactPhone').value = addr.contactPhone || '';
        document.getElementById('f_addressLine1').value = addr.addressLine1 || '';
        document.getElementById('f_addressLine2').value = addr.addressLine2 || '';
        document.getElementById('f_landmark').value = addr.landmark || '';
        document.getElementById('f_city').value = addr.city || '';
        document.getElementById('f_state').value = addr.state || '';
        document.getElementById('f_postalCode').value = addr.postalCode || '';
        document.getElementById('f_country').value = addr.country || 'India';
        document.getElementById('f_latitude').value = addr.latitude ?? 0;
        document.getElementById('f_longitude').value = addr.longitude ?? 0;
        document.getElementById('f_isDefault').checked = addr.isDefault || false;

        openModal();
      };

      // ─── Delete address ───────────────────────────────────────────
      window.deleteAddress = async function (id) {
        if (!confirm('Delete this address?')) return;
        try {
          const res = await fetch(`/customer/addresses/${id}`, { method: 'DELETE' });
          res.ok ? (showToast('Address deleted', 'success'), loadProfile())
            : showToast('Failed to delete address', 'error');
        } catch { showToast('Network error', 'error'); }
      };

      // ─── Set default ──────────────────────────────────────────────
      window.setAsDefault = async function (id) {
        try {
          const res = await fetch(`/customer/address/${id}`, { method: 'PATCH' });
          res.ok ? (showToast('Default address updated!', 'success'), loadProfile())
            : showToast('Failed to update default', 'error');
        } catch { showToast('Network error', 'error'); }
      };

      // ─── Address form submit ──────────────────────────────────────
      addressForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        addressFormErr.classList.add('hidden');

        const labelEl = addressForm.querySelector('[name="label"]:checked');
        if (!labelEl) {
          addressFormErr.textContent = 'Please select a label (Home / Work / Other).';
          addressFormErr.classList.remove('hidden');
          return;
        }

        const id = editAddressId.value.trim();
        const payload = {
          label: labelEl.value,
          contactName: document.getElementById('f_contactName').value.trim(),
          contactPhone: document.getElementById('f_contactPhone').value.trim(),
          addressLine1: document.getElementById('f_addressLine1').value.trim(),
          addressLine2: document.getElementById('f_addressLine2').value.trim() || undefined,
          landmark: document.getElementById('f_landmark').value.trim() || undefined,
          city: document.getElementById('f_city').value.trim(),
          state: document.getElementById('f_state').value.trim(),
          postalCode: document.getElementById('f_postalCode').value.trim(),
          country: document.getElementById('f_country').value.trim(),
          latitude: parseFloat(document.getElementById('f_latitude').value) || 0,
          longitude: parseFloat(document.getElementById('f_longitude').value) || 0,
          isDefault: document.getElementById('f_isDefault').checked,
        };

        addressSubmitBtn.disabled = true;
        addressSubmitBtn.textContent = 'Saving…';

        try {
          const url = id ? `/customer/addresses/${id}` : '/customer/addresses';
          const method = id ? 'PATCH' : 'POST';
          const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const json = await res.json();

          if (res.ok) {
            closeModal();
            showToast(id ? 'Address updated!' : 'Address added!', 'success');
            loadProfile();
          } else {
            const msg = json.errors ? json.errors.join(', ') : (json.message || 'Something went wrong.');
            addressFormErr.textContent = msg;
            addressFormErr.classList.remove('hidden');
          }
        } catch {
          addressFormErr.textContent = 'Network error. Please try again.';
          addressFormErr.classList.remove('hidden');
        } finally {
          addressSubmitBtn.disabled = false;
          addressSubmitBtn.textContent = id ? 'Update Address' : 'Save Address';
        }
      });

      // ─── Change password ──────────────────────────────────────────
      document.getElementById('changePasswordForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const errEl = document.getElementById('pwError');
        const btn = document.getElementById('changePwBtn');
        errEl.classList.add('hidden');

        const currentPassword = document.getElementById('currentPassword').value;
        const newPassword = document.getElementById('newPassword').value;
        const confirmPassword = document.getElementById('confirmPassword').value;

        if (newPassword !== confirmPassword) {
          errEl.textContent = 'New passwords do not match.';
          errEl.classList.remove('hidden');
          return;
        }
        if (newPassword.length < 8) {
          errEl.textContent = 'New password must be at least 8 characters.';
          errEl.classList.remove('hidden');
          return;
        }

        btn.disabled = true; btn.textContent = 'Updating…';

        try {
          const res = await fetch('/customer/change-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ currentPassword, newPassword, confirmPassword }),
          });
          const json = await res.json();

          if (res.ok) {
            showToast('Password changed successfully!', 'success');
            this.reset();
            document.getElementById('pwStrengthBar').classList.add('hidden');
            document.getElementById('pwStrengthLabel').classList.add('hidden');
          } else {
            errEl.textContent = json.message || 'Failed to change password.';
            errEl.classList.remove('hidden');
          }
        } catch {
          errEl.textContent = 'Network error. Please try again.';
          errEl.classList.remove('hidden');
        } finally {
          btn.disabled = false; btn.textContent = 'Update Password';
        }
      });

      // ─── Utility ──────────────────────────────────────────────────
      function escHtml(str) {
        if (str === null || str === undefined) return '';
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      // ─── Boot ─────────────────────────────────────────────────────
      loadProfile();
      // ─── Location ─────────────────────────────────────────────────
      window.useCurrentLocation = function () {
        if (!navigator.geolocation) {
          showToast('Geolocation is not supported by your browser', 'error');
          return;
        }
        navigator.geolocation.getCurrentPosition(pos => {
          document.getElementById('f_latitude').value = pos.coords.latitude;
          document.getElementById('f_longitude').value = pos.coords.longitude;
          showToast('Location acquired successfully!', 'success');
        }, err => {
          showToast('Unable to retrieve location', 'error');
        });
      };

      // ─── Sessions ──────────────────────────────────────────────────
      async function loadSessions() {
        try {
          const res = await fetch('/customer/sessions');
          if (!res.ok) return;
          const { data } = await res.json();
          const list = document.getElementById('sessionsList');
          if (!data || data.length === 0) {
            list.innerHTML = '<div class="text-sm text-gray-500">No active sessions found.</div>';
            return;
          }
          list.innerHTML = data.map(s => {
            const isCurrent = false; // Could detect current token if available
            return `
            <div class="flex items-center justify-between bg-gray-50 border border-gray-100 p-3 rounded-xl">
              <div>
                <p class="font-bold text-gray-800 text-sm">${s.userAgent || 'Unknown Device'} ${isCurrent ? '<span class="text-xs text-green-600 bg-green-50 px-2 py-0.5 rounded-full ml-1 border border-green-200">Current</span>' : ''}</p>
                <p class="text-xs text-gray-500 mt-0.5">IP: ${s.ipAddress || 'Unknown'} • Expires: ${new Date(s.expiresAt).toLocaleDateString()}</p>
              </div>
              <button onclick="revokeSession('${s.id}')" class="text-xs font-bold text-red-500 hover:text-red-700 bg-white border border-red-100 hover:bg-red-50 px-3 py-1.5 rounded-lg transition-colors shadow-sm">Log Out</button>
            </div>
            `;
          }).join('');
        } catch (e) { console.error(e); }
      }

      window.revokeSession = async function(id) {
        if(!confirm('Are you sure you want to log out this device?')) return;
        try {
          const res = await fetch('/customer/sessions/' + id, { method: 'DELETE' });
          if (res.ok) {
            showToast('Session revoked', 'success');
            loadSessions();
          } else {
            showToast('Failed to revoke session', 'error');
          }
        } catch(e) { showToast('Error', 'error'); }
      };

      // ─── Personal Info Form ────────────────────────────────────────
      document.getElementById('personalInfoForm').addEventListener('submit', async function (e) {
        e.preventDefault();
        const btn = document.getElementById('savePersonalInfoBtn');
        const originalText = btn.textContent;
        btn.textContent = 'Saving...';
        btn.disabled = true;

        const formData = new FormData(this);
        
        // Remove empty file input
        if (document.getElementById('pi_profilePicture').files.length === 0) {
          formData.delete('profilePicture');
        }

        try {
          const res = await fetch('/customer/setup-profile', {
            method: 'POST',
            body: formData
          });

          const json = await res.json();
          if (res.ok) {
            showToast('Profile updated successfully!', 'success');
            loadProfile(); // reload to show changes
          } else {
            showToast(json.message || 'Update failed', 'error');
          }
        } catch (err) {
          showToast('Network error', 'error');
        } finally {
          btn.textContent = originalText;
          btn.disabled = false;
        }
      });

      // ─── Preferences Form ────────────────────────────────────────
      async function loadPreferences() {
        try {
          const res = await fetch('/customer/preferences');
          if (!res.ok) return;
          const { data } = await res.json();
          if (data) {
            document.getElementById('pref_vegetarian').checked = data.vegetarian;
            document.getElementById('pref_vegan').checked = data.vegan;
            document.getElementById('pref_glutenFree').checked = data.glutenFree;
            document.getElementById('pref_halal').checked = data.halal;
            document.getElementById('pref_jain').checked = data.jain;
          }
        } catch(e) {}
      }

      document.getElementById('preferencesForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        const payload = {
          vegetarian: document.getElementById('pref_vegetarian').checked,
          vegan: document.getElementById('pref_vegan').checked,
          glutenFree: document.getElementById('pref_glutenFree').checked,
          halal: document.getElementById('pref_halal').checked,
          jain: document.getElementById('pref_jain').checked,
        };

        const btn = document.getElementById('savePrefsBtn');
        const txt = btn.textContent;
        btn.textContent = 'Saving...';
        btn.disabled = true;

        try {
          const res = await fetch('/customer/preferences', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if(res.ok) {
             showToast('Preferences saved successfully', 'success');
          } else {
             showToast('Failed to save preferences', 'error');
          }
        } catch(e) {
          showToast('Error saving preferences', 'error');
        } finally {
          btn.textContent = txt;
          btn.disabled = false;
        }
      });

      // ─── Payment Methods ──────────────────────────────────────────
      window.openPaymentModal = function() {
         document.getElementById('paymentModal').classList.add('open');
      };
      window.closePaymentModal = function() {
         document.getElementById('paymentModal').classList.remove('open');
         document.getElementById('paymentForm').reset();
      };
      
      async function loadPaymentMethods() {
        try {
          const res = await fetch('/customer/payment-methods');
          if (!res.ok) return;
          const { data } = await res.json();
          const list = document.getElementById('paymentsList');
          if (!data || data.length === 0) {
            list.innerHTML = `
              <div class="bg-white border border-dashed border-orange-200 rounded-2xl p-10 text-center">
                <div class="text-4xl mb-3">💳</div>
                <p class="text-gray-500 font-medium">No payment methods saved</p>
                <p class="text-gray-400 text-sm mt-1">Add a card or UPI ID for faster checkout</p>
              </div>`;
            return;
          }

          list.innerHTML = data.map(pm => `
             <div class="bg-white border border-orange-100 rounded-2xl p-4 shadow-sm flex justify-between items-center">
               <div class="flex items-center gap-3">
                 <div class="p-2 bg-orange-50 rounded-lg text-orange-500 text-xl">
                   ${pm.paymentType === 'CARD' ? '💳' : '📱'}
                 </div>
                 <div>
                   <p class="font-bold text-gray-800">${pm.paymentType === 'CARD' ? 'Card' : 'UPI'} ending in ${pm.maskedIdentifier.slice(-4)}</p>
                   <p class="text-xs text-gray-500">Provider: ${pm.provider}</p>
                 </div>
               </div>
               <button onclick="deletePaymentMethod('${pm.id}')" class="p-2 text-red-500 bg-red-50 rounded-lg hover:bg-red-100">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
               </button>
             </div>
          `).join('');
        } catch(e) {}
      }

      window.deletePaymentMethod = async function(id) {
         if(!confirm('Delete this payment method?')) return;
         try {
            const res = await fetch('/customer/payment-methods/' + id, { method: 'DELETE' });
            if(res.ok) {
               showToast('Payment method deleted', 'success');
               loadPaymentMethods();
            } else {
               showToast('Failed to delete', 'error');
            }
         } catch(e) {}
      };

      document.getElementById('paymentForm').addEventListener('submit', async function(e) {
         e.preventDefault();
         const formData = new FormData(this);
         
         const payload = {
            paymentType: formData.get('paymentType'),
            provider: formData.get('provider'),
            maskedIdentifier: formData.get('identifier').toString().slice(-4).padStart(8, '*'),
            gatewayToken: 'simulated_tok_' + Math.random().toString(36).substring(7)
         };

         const btn = document.getElementById('paymentSubmitBtn');
         const txt = btn.textContent;
         btn.textContent = 'Saving...';
         btn.disabled = true;

         try {
            const res = await fetch('/customer/payment-methods', {
               method: 'POST',
               headers: { 'Content-Type': 'application/json' },
               body: JSON.stringify(payload)
            });
            if(res.ok) {
               showToast('Payment method saved', 'success');
               closePaymentModal();
               loadPaymentMethods();
            } else {
               const err = await res.json();
               showToast(err.message || 'Failed to save', 'error');
            }
         } catch(e) {
            showToast('Error', 'error');
         } finally {
            btn.textContent = txt;
            btn.disabled = false;
         }
      });

      window.loadLoyaltyData = async function () {
        try {
          const res = await fetch('/loyalty', { headers: { 'Content-Type': 'application/json' } });
          const data = await res.json();
          if (res.ok && data.success) {
             const loyalty = data.data;
             document.getElementById('loyaltyPointsDisplay').textContent = loyalty.balance;
             document.getElementById('loyaltyRatesDisplay').textContent = `Earn ${loyalty.earningRate} pts per ₹1 spent. 1 pt = ₹${loyalty.redemptionRate} off.`;
             
             const list = document.getElementById('loyaltyTransactionsList');
             if (loyalty.transactions && loyalty.transactions.length > 0) {
                 list.innerHTML = loyalty.transactions.map(t => `
                    <div class="flex items-center justify-between p-4 border border-orange-50 rounded-xl hover:bg-orange-50/50 transition-colors">
                      <div>
                         <p class="font-bold text-gray-800">${t.transactionType === 'EARN' ? 'Points Earned' : t.transactionType === 'REDEEM' ? 'Points Redeemed' : 'Adjustment'}</p>
                         <p class="text-sm text-gray-500">${t.description || ''}</p>
                         <p class="text-xs text-gray-400 mt-1">${new Date(t.createdAt).toLocaleString()}</p>
                      </div>
                      <div class="${t.transactionType === 'EARN' ? 'text-green-600' : 'text-red-500'} font-bold text-lg">
                         ${t.transactionType === 'EARN' ? '+' : '-'}${Math.abs(t.points)}
                      </div>
                    </div>
                 `).join('');
             } else {
                 list.innerHTML = '<p class="text-gray-500 text-sm">No transactions yet.</p>';
             }
          }
        } catch (e) {
          console.error('Failed to load loyalty details', e);
        }
      };

    })();
  </script>

  <%- include('../partials/toast') %>
    <%- include('../partials/customer-sidebar') %>
</body>

</html>