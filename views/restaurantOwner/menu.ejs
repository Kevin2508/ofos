      document.getElementById('modifierGroupModal').classList.remove('hidden');
    }

    function openEditModifierGroupModal(id, name, desc, min, max, isReq, multi) {
      document.getElementById('groupModalTitle').textContent = 'Edit Modifier Group';
      document.getElementById('editGroupId').value = id;
      document.getElementById('groupName').value = name;
      document.getElementById('groupDescription').value = desc;
      document.getElementById('groupMin').value = min;
      document.getElementById('groupMax').value = max;
      document.getElementById('groupIsRequired').checked = isReq;
      document.getElementById('groupMultiSelect').checked = multi;
      document.getElementById('modifierGroupModal').classList.remove('hidden');
    }

    function closeModifierGroupModal() { document.getElementById('modifierGroupModal').classList.add('hidden'); }

    async function saveModifierGroup() {
      const id = document.getElementById('editGroupId').value;
      const isEdit = !!id;
      const payload = {
        name: document.getElementById('groupName').value.trim(),
        description: document.getElementById('groupDescription').value.trim(),
        minSelection: parseInt(document.getElementById('groupMin').value) || 0,
        maxSelection: parseInt(document.getElementById('groupMax').value) || 1,
        isRequired: document.getElementById('groupIsRequired').checked,
        allowMultipleSelection: document.getElementById('groupMultiSelect').checked,
      };

      if (!payload.name) return showToast('Name required', 'error');

      const url = isEdit ? `/modifier/branches/modifier-groups/${id}` : `/modifier/branches/${selectedBranchId}/modifier-group`;
      const method = isEdit ? 'PATCH' : 'POST';

      try {
        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(isEdit ? payload : { ...payload, options: [] })
        });
        if (res.ok) {
          showToast('Saved', 'success');
          closeModifierGroupModal();
          loadModifiers();
        } else {
          showToast('Error saving', 'error');
        }
      } catch (e) { showToast('Error', 'error'); }
    }

    async function deleteModifierGroup(id) {
      if (!confirm('Delete this group?')) return;
      try {
        const res = await fetch(`/modifier/modifier-groups/${id}`, { method: 'DELETE', });
        if (res.ok) { showToast('Deleted', 'success'); loadModifiers(); }
      } catch (e) { }
    }

    function openAddModifierOptionModal(groupId) {
      document.getElementById('optionModalTitle').textContent = 'Add Option';
      document.getElementById('editOptionId').value = '';
      document.getElementById('editOptionGroupId').value = groupId;
      document.getElementById('optionName').value = '';
      document.getElementById('optionPrice').value = '0';
      document.getElementById('optionIsAvailable').checked = true;
      document.getElementById('modifierOptionModal').classList.remove('hidden');
    }

    function openEditModifierOptionModal(id, groupId, name, price, isAvail) {
      document.getElementById('optionModalTitle').textContent = 'Edit Option';
      document.getElementById('editOptionId').value = id;
      document.getElementById('editOptionGroupId').value = groupId;
      document.getElementById('optionName').value = name;
      document.getElementById('optionPrice').value = price;
      document.getElementById('optionIsAvailable').checked = isAvail;
      document.getElementById('modifierOptionModal').classList.remove('hidden');
    }

    function closeModifierOptionModal() { document.getElementById('modifierOptionModal').classList.add('hidden'); }

    async function saveModifierOption() {
      const id = document.getElementById('editOptionId').value;
      const groupId = document.getElementById('editOptionGroupId').value;
      const isEdit = !!id;
      const payload = {
        optionName: document.getElementById('optionName').value.trim(),
        price: parseFloat(document.getElementById('optionPrice').value) || 0,
        isAvailable: document.getElementById('optionIsAvailable').checked
      };

      const url = isEdit ? `/modifier/modifier-options/${id}` : `/modifier/modifier-groups/${groupId}/options`;
      const method = isEdit ? 'PATCH' : 'POST';

      try {
        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (res.ok) {
          showToast('Saved', 'success');
          closeModifierOptionModal();
          loadModifiers();
        } else {
          showToast('Error', 'error');
        }
      } catch (e) { }
    }

    async function deleteModifierOption(id) {
      if (!confirm('Delete option?')) return;
      try {
        const res = await fetch(`/modifier/modifier-options/${id}`, { method: 'DELETE', });
        if (res.ok) { showToast('Deleted', 'success'); loadModifiers(); }
      } catch (e) { }
    }

    // ==========================================
    // ATTACH MODIFIERS TO ITEM
    // ==========================================
    let currentAttachItemId = null;
    let currentAttachCategoryId = null;

    async function openAttachModifiersModal(itemId, categoryId) {
      currentAttachItemId = itemId;
      currentAttachCategoryId = categoryId;
      document.getElementById('attachModifiersItemId').value = itemId;
      document.getElementById('attachModifiersModal').classList.remove('hidden');

      // Ensure modifiers are loaded
      if (allModifiersData.length === 0 && selectedBranchId) {
        const res = await fetch(`/modifier/branches/${selectedBranchId}`, {});
        if (res.ok) {
          const data = await res.json();
          allModifiersData = data.data || [];
        }
      }

      const select = document.getElementById('attachGroupId');
      select.innerHTML = '<option value="" disabled selected>Select a group...</option>' +
        allModifiersData.map(g => `<option value="${g.id}">${g.name}</option>`).join('');

      renderAttachedGroups();
    }

    function closeAttachModifiersModal() {
      document.getElementById('attachModifiersModal').classList.add('hidden');
      if (currentAttachCategoryId) loadItemsForCategory(currentAttachCategoryId);
    }

    function renderAttachedGroups() {
      const item = window.menuItemsData ? window.menuItemsData[currentAttachItemId] : null;
      const container = document.getElementById('attachedGroupsContainer');
      if (!item || !item.modifierGroups || item.modifierGroups.length === 0) {
        container.innerHTML = '<p class="text-sm text-gray-500">No modifiers attached.</p>';
        return;
      }
      container.innerHTML = item.modifierGroups.map(mg => {
        const group = mg.modifierGroup;
        return `
          <div class="bg-gray-50 p-2 rounded flex justify-between items-center border border-gray-100">
            <span class="text-sm font-semibold text-gray-800">${group.name}</span>
            <button onclick="detachGroupFromItem('${group.id}')" class="text-xs text-red-600 hover:underline">Remove</button>
          </div>
        `;
      }).join('');
    }

    async function attachGroupToItem() {
      const groupId = document.getElementById('attachGroupId').value;
      if (!groupId || !currentAttachItemId) return;
      try {
        const res = await fetch(`/modifier/menu-items/${currentAttachItemId}/modifier-groups`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ modifierGroupId: groupId }) // body not needed actually if it's params, but let's check modifier.controller: body is { modifierGroupId } according to routes: Wait, the route is `/menu-items/:itemId/modifier-groups`, controller `attachModifierGroup` expects `groupId` probably from body or query. Let's send in body. Wait, route is `/:itemId/modifier-groups`. I will send { modifierGroupId: groupId } in body just in case, but usually it's in body.
        });
        // Actually looking at the route `modifierRouter.post('/menu-items/:itemId/modifier-groups',attachModifierGroup);`
        // In modifier.dto.ts it expects `modifierGroupId: number` in body

        // I'll send it
        await loadItemsForCategory(currentAttachCategoryId);
        openAttachModifiersModal(currentAttachItemId, currentAttachCategoryId);
      } catch (e) { }
    }

    async function detachGroupFromItem(groupId) {
      if (!confirm('Remove this modifier group from item?')) return;
      try {
        const res = await fetch(`/modifier/menu-items/${currentAttachItemId}/modifier-groups/${groupId}`, {
          method: 'DELETE',

        });
        await loadItemsForCategory(currentAttachCategoryId);
        openAttachModifiersModal(currentAttachItemId, currentAttachCategoryId);
      } catch (e) { }
    }

    // ==========================================
    // AVAILABILITY SCHEDULES
    // ==========================================
    async function openSchedulesModal(itemId, categoryId) {
      document.getElementById('schedulesItemId').value = itemId;
      document.getElementById('schedulesModal').classList.remove('hidden');
      loadSchedules(itemId);
    }

    function closeSchedulesModal() {
      document.getElementById('schedulesModal').classList.add('hidden');
    }

    async function loadSchedules(itemId) {
      const container = document.getElementById('schedulesContainer');
      container.innerHTML = '<p class="text-sm text-gray-500">Loading...</p>';
      try {
        const res = await fetch(`/menu-item/menu-items/${itemId}/availability-schedules`,);
        if (res.ok) {
          const data = await res.json();
          const schedules = data.data || [];
          if (schedules.length === 0) {
            container.innerHTML = '<p class="text-sm text-gray-500">No specific schedules found (Available 24/7 if stock is ON).</p>';
          } else {
            const days = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
            container.innerHTML = schedules.map(s => `
              <div class="bg-gray-50 p-2 rounded flex justify-between items-center border border-gray-100">
                <span class="text-sm font-medium text-gray-800">${days[s.dayOfWeek]}: ${new Date(s.startTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })} - ${new Date(s.endTime).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
                <button onclick="deleteSchedule('${itemId}', '${s.id}')" class="text-xs text-red-600 hover:underline">Del</button>
              </div>
            `).join('');
          }
        }
      } catch (e) {
        container.innerHTML = '<p class="text-sm text-red-500">Error loading schedules.</p>';
      }
    }

    async function addSchedule() {
      const itemId = document.getElementById('schedulesItemId').value;
      const dayOfWeek = parseInt(document.getElementById('scheduleDay').value);
      let startTime = document.getElementById('scheduleStart').value;
      let endTime = document.getElementById('scheduleEnd').value;
      if (!startTime || !endTime) return showToast('Start and end times are required', 'error');

      if (startTime.split(':').length === 2) startTime += ':00';
      if (endTime.split(':').length === 2) endTime += ':00';

      try {
        const res = await fetch(`/menu-item/menu-items/${itemId}/availability-schedules`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ dayOfWeek, startTime, endTime })
        });
        if (res.ok) {
          loadSchedules(itemId);
        } else {
          showToast('Failed to add schedule', 'error');
        }
      } catch (e) { showToast('Error', 'error'); }
    }

    async function deleteSchedule(itemId, scheduleId) {
      if (!confirm('Delete schedule?')) return;
      try {
        const res = await fetch(`/menu-item/menu-items/${itemId}/availability-schedules/${scheduleId}`, {
          method: 'DELETE',

        });
        if (res.ok) {
          loadSchedules(itemId);
        }
      } catch (e) { showToast('Error', 'error'); }
    }

    // ==========================================
    // INITIALIZATION
    // ==========================================
    document.getElementById('restaurantSelect').addEventListener('change', (e) => {
      selectedRestaurantId = e.target.value;
      selectedBranchId = null;
      document.getElementById('categorySection').classList.add('hidden');
      document.getElementById('branchTabs').classList.add('hidden');
      document.getElementById('modifiersSection').classList.add('hidden');
      document.getElementById('placeholderSection').classList.remove('hidden');
      loadBranches(selectedRestaurantId);
    });

    document.getElementById('branchSelect').addEventListener('change', (e) => {
      selectedBranchId = e.target.value;
      document.getElementById('categorySection').classList.remove('hidden');
      document.getElementById('branchTabs').classList.remove('hidden');
      document.getElementById('placeholderSection').classList.add('hidden');
      switchMenuTab('categories');
      loadCategories();
      loadModifiers(); // Prefetch modifiers
    });

    loadRestaurantsForDropdown();

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        await fetch('/auth/logout', {});
      } catch (e) { }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });
  </script>
  <%- include('../partials/toast') %>
</body>

</html>