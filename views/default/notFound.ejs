<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Page Not Found | ofos</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="min-h-screen bg-orange-50/50 flex flex-col items-center justify-center p-4 font-sans">
  <div class="max-w-md w-full text-center">
    <!-- 404 Visual -->
    <div class=" mb-8 flex justify-center">
      <h1 class="text-[150px] font-black text-orange-500/20 leading-none select-none tracking-tighter">404</h1>
    </div>

    <h2 class="text-3xl font-extrabold text-gray-900 mb-3">Oops! Page not found</h2>
    <p class="text-gray-500 mb-8 leading-relaxed max-w-sm mx-auto">
      We couldn't find the page you were looking for. It might have been moved or simply doesn't exist.
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <button onclick="window.history.back()"
        class="bg-white border-2 border-gray-200 hover:border-gray-300 text-gray-700 font-bold py-3 px-8 rounded-xl transition-colors">
        Go Back
      </button>
      <a href="/"
        class="bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-xl transition-colors shadow-md hover:shadow-lg focus:ring-4 focus:ring-orange-500/30">
        Homepage
      </a>
    </div>
  </div>
</body>

</html>