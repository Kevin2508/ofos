<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Orders | Restaurant Owner | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="min-h-screen bg-orange-50 font-sans">
  <div class="flex min-h-screen">
    <%- include('../partials/restaurantOwner/sidebar') %>

    <!-- MAIN CONTENT -->
    <main class="flex-1 lg:ml-72 p-8 transition-all duration-300" id="mainContentWrapper">
      <div class="mb-8 flex justify-between items-center">
        <div>
          <h2 class="text-2xl font-bold text-gray-800">Orders Management</h2>
          <p class="text-gray-500 mt-1">View and manage customer orders across your restaurants.</p>
        </div>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left whitespace-nowrap">
            <thead>
              <tr class="bg-gray-50 border-b border-gray-100 text-gray-500 text-sm uppercase tracking-wider">
                <th class="px-6 py-4 font-semibold">Order ID</th>
                <th class="px-6 py-4 font-semibold">Customer</th>
                <th class="px-6 py-4 font-semibold">Amount</th>
                <th class="px-6 py-4 font-semibold">Status</th>
                <th class="px-6 py-4 font-semibold">Date</th>
                <th class="px-6 py-4 font-semibold text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="ordersList" class="divide-y divide-gray-50 text-gray-700">
              <tr>
                <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                  <div class="animate-pulse flex justify-center">Loading orders...</div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script>
    async function loadOrders() {
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/orders', {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        const list = document.getElementById('ordersList');

        if (res.ok) {
          const data = await res.json();
          const orders = data.data || [];

          if (orders.length === 0) {
            list.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">No orders found.</td></tr>`;
          } else {
            list.innerHTML = orders.map(o => {
                const status = o.orderStatus || o.status || 'PENDING';
                let actionsHtml = '';
                
                if (status === 'PLACED' || status === 'PENDING') {
                   actionsHtml = `
                     <button onclick="updateOrderStatus('${o.id}', 'accept')" class="bg-green-100 text-green-700 px-3 py-1 rounded-lg font-bold text-xs hover:bg-green-200 transition-colors mr-2">Accept</button>
                     <button onclick="updateOrderStatus('${o.id}', 'reject')" class="bg-red-100 text-red-700 px-3 py-1 rounded-lg font-bold text-xs hover:bg-red-200 transition-colors">Reject</button>
                   `;
                } else if (status === 'ACCEPTED') {
                   actionsHtml = `
                     <button onclick="updateOrderStatus('${o.id}', 'preparing')" class="bg-blue-100 text-blue-700 px-3 py-1 rounded-lg font-bold text-xs hover:bg-blue-200 transition-colors">Mark Preparing</button>
                   `;
                } else if (status === 'PREPARING') {
                   actionsHtml = `
                     <button onclick="updateOrderStatus('${o.id}', 'ready')" class="bg-purple-100 text-purple-700 px-3 py-1 rounded-lg font-bold text-xs hover:bg-purple-200 transition-colors">Mark Ready</button>
                   `;
                }

                return `
                <tr class="hover:bg-orange-50 transition-colors">
                  <td class="px-6 py-4 font-medium text-gray-900">#${o.orderNumber || o.id}</td>
                  <td class="px-6 py-4 text-gray-600">${o.customerUser?.customerProfile?.displayName || 'Customer'}</td>
                  <td class="px-6 py-4 font-semibold text-gray-700">₹${o.totalAmount || o.amount || 0}</td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                      ${status}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-gray-500 text-sm">${new Date(o.createdAt).toLocaleString()}</td>
                  <td class="px-6 py-4 text-right">
                    ${actionsHtml}
                  </td>
                </tr>
              `}).join('');
          }
        } else {
          list.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">Failed to load orders.</td></tr>`;
        }
      } catch (err) {
        console.error(err);
        document.getElementById('ordersList').innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-red-500">Error loading data.</td></tr>`;
      }
    }

    loadOrders();

    async function updateOrderStatus(orderId, action) {
      if (!confirm(`Are you sure you want to ${action} this order?`)) return;
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch(`/orders/${orderId}/${action}`, {
          method: 'PATCH',
          headers: { 
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ reason: 'Restaurant action' })
        });
        if (res.ok) {
          showToast('Order status updated successfully', 'success');
          loadOrders(); // reload
        } else {
          const data = await res.json();
          showToast(data.message || 'Failed to update order', 'error');
        }
      } catch (err) {
        console.error(err);
        showToast('Network error while updating order', 'error');
      }
    }

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        const token = localStorage.getItem('token') || '';
        await fetch('/auth/logout', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
      } catch (e) { console.error(e); }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });;
  </script>
  <%- include('../partials/toast') %>
</body>

</html>