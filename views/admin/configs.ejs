<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Configurations | Admin | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
  <script src="/js/form-validator.js"></script>
</head>

<body class="min-h-screen bg-orange-50 font-sans text-gray-800">
  <div class="flex min-h-screen">
    <%- include('../partials/admin/sidebar') %>

    <!-- MAIN CONTENT -->
    <main class="flex-1 lg:ml-72 p-5 sm:p-8 transition-all duration-300" id="mainContentWrapper">
      <div class="flex justify-between items-center mb-8">
        <div class="flex flex-wrap items-start md:items-center gap-3">
          <button onclick="toggleSidebar()" class="p-2 -ml-2 mt-1 md:mt-0 text-gray-600 hover:text-orange-500 rounded-xl hover:bg-orange-50 transition-colors lg:hidden">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <div>
            <h2 class="text-3xl font-bold text-gray-900">System Configurations</h2>
            <p class="text-gray-500 mt-2">Manage global settings like service limits, delivery radii, and platform fees.
            </p>
          </div>
        </div>
        <button onclick="toggleAddModal(true)"
          class="bg-orange-600 hover:bg-orange-700 text-white font-medium py-2 px-5 rounded-xl transition-colors shadow-sm flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add Config
        </button>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 sm:p-8 max-w-5xl">
        <div id="configsContainer" class="space-y-6">
          <div class="py-8 text-center text-gray-500">Loading configurations...</div>
        </div>
      </div>
    </main>
  </div>

  <!-- Add Config Modal -->
  <div id="addModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-md p-4 sm:p-6 shadow-xl">
      <h3 class="text-xl font-bold text-gray-900 mb-4">Add Configuration</h3>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Config Key</label>
          <input type="text" id="addKey" placeholder="e.g. PLATFORM_FEE"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none uppercase" />
          <p id="addKeyError" class="mt-1 text-sm text-red-500"></p>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Config Value</label>
          <input type="text" id="addValue" placeholder="e.g. 5.00"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
          <p id="addValueError" class="mt-1 text-sm text-red-500"></p>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Description (Optional)</label>
          <input type="text" id="addDesc" placeholder="e.g. Default platform fee in percentage"
            class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
        </div>
        <div class="flex justify-end gap-3 mt-6">
          <button onclick="toggleAddModal(false)"
            class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg">Cancel</button>
          <button onclick="addConfig()"
            class="px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700">Save</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Update Config Modal -->
  <div id="updateModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-md p-4 sm:p-6 shadow-xl">
      <h3 class="text-xl font-bold text-gray-900 mb-4">Update Configuration</h3>
      <div class="space-y-4">
        <input type="hidden" id="originalUpdateKey" />
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Config Key</label>
          <input type="text" id="updateKey" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none uppercase" />
          <p id="updateKeyError" class="mt-1 text-sm text-red-500"></p>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Config Value</label>
          <input type="text" id="updateValue"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
          <p id="updateValueError" class="mt-1 text-sm text-red-500"></p>
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Description (Optional)</label>
          <input type="text" id="updateDesc" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
        </div>
        <div class="flex justify-end gap-3 mt-6">
          <button onclick="toggleUpdateModal(false)"
            class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg">Cancel</button>
          <button onclick="submitUpdateConfig()"
            class="px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token') || '';

    function toggleAddModal(show) {
      const modal = document.getElementById('addModal');
      if (show) {
        modal.classList.remove('hidden');
        document.getElementById('addKey').value = '';
        document.getElementById('addValue').value = '';
        document.getElementById('addDesc').value = '';
      } else {
        modal.classList.add('hidden');
      }
    }

    function toggleUpdateModal(show, key = '', value = '', desc = '') {
      const modal = document.getElementById('updateModal');
      if (show) {
        document.getElementById('originalUpdateKey').value = key;
        document.getElementById('updateKey').value = key;
        document.getElementById('updateValue').value = value;
        document.getElementById('updateDesc').value = desc;
        modal.classList.remove('hidden');
      } else {
        modal.classList.add('hidden');
      }
    }

    async function loadConfigs() {
      try {
        const res = await fetch('/admin/config', { headers: { 'Authorization': `Bearer ${token}` } });
        const container = document.getElementById('configsContainer');
        if (res.ok) {
          const data = await res.json();
          const configs = data.data || [];

          if (configs.length === 0) {
            container.innerHTML = `<div class="py-8 text-center text-gray-500">No configs found in the database.</div>`;
          } else {
            container.innerHTML = configs.map(c => `
              <div class="flex items-start gap-4 p-4 border rounded-xl hover:shadow-sm transition-shadow">
                <div class="flex-1 space-y-2">
                  <div class="flex items-center justify-between">
                    <label class="block text-sm font-bold text-gray-800">${c.configKey}</label>
                  </div>
                  <div class="px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg text-gray-900 font-mono text-sm break-all">${c.configValue}</div>
                  <p class="text-xs text-gray-500">${c.description || 'System configuration parameter'}</p>
                </div>
                <div class="flex flex-col gap-2 mt-6">
                  <button onclick="toggleUpdateModal(true, '${c.configKey}', '${c.configValue.replace(/'/g, "\\'")}', '${(c.description || '').replace(/'/g, "\\'")}')" class="px-4 py-2 bg-orange-100 text-orange-600 hover:bg-orange-200 rounded-lg text-sm font-semibold transition-colors">Update</button>
                  <button onclick="deleteConfig('${c.configKey}')" class="px-4 py-2 bg-red-50 text-red-600 hover:bg-red-100 rounded-lg text-sm font-semibold transition-colors">Delete</button>
                </div>
              </div>
            `).join('');
          }
        }
      } catch (err) { console.error(err); }
    }

    const addConfigRules = {
      addKey: { required: true, pattern: /^[a-zA-Z0-9 \-_]{1,50}$/, patternMsg: 'Key must be 1-50 chars: letters, numbers, space, dash, underscore', label: 'Config key' },
      addValue: { required: true, label: 'Config value' },
    };
    const updateConfigRules = {
      updateKey: { required: true, pattern: /^[a-zA-Z0-9 \-_]{1,50}$/, patternMsg: 'Key must be 1-50 chars: letters, numbers, space, dash, underscore', label: 'Config key' },
      updateValue: { required: true, label: 'Config value' },
    };

    FormValidator.bindLiveValidation(addConfigRules);
    FormValidator.bindLiveValidation(updateConfigRules);

    async function addConfig() {
      if (!FormValidator.validate(addConfigRules)) return;

      const key = document.getElementById('addKey').value.trim();
      const value = document.getElementById('addValue').value.trim();
      const desc = document.getElementById('addDesc').value.trim();

      try {
        const res = await fetch('/admin/config', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ key, value, description: desc })
        });
        const data = await res.json();
        if (res.ok) {
          toggleAddModal(false);
          loadConfigs();
        } else {
          showToast(data.message || 'Error adding config', 'error');
        }
      } catch (e) { showToast('Error adding config', 'error'); }
    }

    async function submitUpdateConfig() {
      if (!FormValidator.validate(updateConfigRules)) return;

      const key = document.getElementById('originalUpdateKey').value;
      const newKey = document.getElementById('updateKey').value.trim();
      const value = document.getElementById('updateValue').value.trim();
      const description = document.getElementById('updateDesc').value.trim();

      try {
        const res = await fetch('/admin/config/update', {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ key, newKey, value, description })
        });
        if (res.ok) {
          toggleUpdateModal(false);
          loadConfigs();
        } else {
          const data = await res.json();
          showToast(data.message || 'Error updating config', 'error');
        }
      } catch (e) { showToast('Error updating config', 'error'); }
    }

    async function deleteConfig(key) {
      if (!confirm(`Are you sure you want to delete ${key}?`)) return;
      try {
        const res = await fetch(`/admin/config/${key}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (res.ok) {
          loadConfigs();
        } else {
          const data = await res.json();
          alert(data.message || 'Error deleting config');
        }
      } catch (e) { alert('Error deleting config'); }
    }

    loadConfigs();

    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      try {
        await fetch('/auth/logout', { headers: { 'Authorization': `Bearer ${token}` } });
      } catch (e) { }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });
  </script>
</body>

</html>