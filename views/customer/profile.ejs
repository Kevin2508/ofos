                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Loyalty Points
            </h2>
            <div class="bg-gradient-to-r from-orange-500 to-orange-400 rounded-2xl p-6 text-white mb-8 shadow-lg">
              <p class="text-orange-100 font-medium mb-1">Current Balance</p>
              <div class="flex items-end gap-3">
                <h3 class="text-4xl font-extrabold" id="loyaltyPointsDisplay">0</h3>
