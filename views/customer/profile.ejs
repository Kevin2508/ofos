        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-semibold text-gray-600 mb-1" for="f_latitude">Latitude</label>
            <input type="number" step="any" id="f_latitude" class="if" placeholder="0.000000" value="0" />
