          allModifiersData = data.data || [];
          if (allModifiersData.length === 0) {
            container.innerHTML = `<div class="p-5 sm:p-8 text-center text-gray-500">No modifier groups found.</div>`;
          } else {
            container.innerHTML = allModifiersData.map(group => `
