# ==========================================
# OFOS Environment Configuration (.env.example)
# ==========================================

# Server
PORT=3000
BACKEND_URL=http://localhost:3000

# PostgreSQL Target Database (OFOS Platform Dev)
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>?schema=public
POSTGRES_DATABASE_URL="postgresql://postgres:password@localhost:5432/ofos_platform_dev?schema=public"

# Legacy Reference Database (MySQL - port 3307)
LEGACY_DATABASE_URL="mysql://root:password@127.0.0.1:3307/ofos_db"

# Legacy DB Config variables
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=password
DB_NAME=ofos_db

# Primary Database URL used by active application
DATABASE_URL="postgresql://postgres:password@localhost:5432/ofos_platform_dev?schema=public"

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Security & Hashing Salts
PASSWORD_HASH_SALT=10
OTP_HASH_SALT=10
OTP_MAX_ATTEMPTS=5

# JWT Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
JWT_REFRESH_EXPIRE_REMEMBER_ME=30d
COOKIE_EXPIRE=7d
COOKIE_EXPIRE_REMEMBER_ME=30d
RESET_TOKEN_EXPIRE=15m
OTP_EXPIRE=5m

# Redis Cache & Sessions
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Google GenAI / Gemini
GEMINI_API_KEY=your_gemini_api_key_here
