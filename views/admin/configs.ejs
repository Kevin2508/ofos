<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>System Config | ofos Admin</title>
    <link rel="stylesheet" href="/styles/build.css" />
  </head>

  <body class="min-h-screen bg-orange-50">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="w-64 bg-white border-r border-orange-100 shadow-md">
        <div class="p-6">
          <h1 class="text-3xl font-extrabold text-orange-500">ofos Admin</h1>
        </div>

        <nav class="px-4 space-y-2">
          <a
            href="/admin/dashboard"
            class="block px-4 py-2 rounded-xl hover:bg-orange-50"
          >
            Dashboard
          </a>

          <a
            href="/admin/users"
            class="block px-4 py-2 rounded-xl hover:bg-orange-50"
          >
            User Management
          </a>

          <a
            href="/admin/restaurants"
            class="block px-4 py-2 rounded-xl hover:bg-orange-50"
          >
            Restaurants
          </a>

          <a
            href="/admin/orders"
            class="block px-4 py-2 rounded-xl hover:bg-orange-50"
          >
            Orders
          </a>

          <a
            href="/admin/config"
            class="block px-4 py-2 rounded-xl bg-orange-100 text-orange-600 font-semibold"
          >
            System Config
          </a>

          <a
            href="/admin/audit-logs"
            class="block px-4 py-2 rounded-xl hover:bg-orange-50"
          >
            Audit Logs
          </a>
        </nav>
      </aside>

      <!-- MAIN -->
      <main class="flex-1 p-8">
        <!-- Header -->
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-gray-800">System Configuration</h2>

          <p class="text-gray-600 mt-1">Manage platform-wide settings</p>
        </div>

        <!-- Message -->
        <div
          id="message"
          class="hidden mb-5 px-4 py-3 rounded-xl text-sm"
        ></div>

        <!-- Config Container -->
        <div
          id="configContainer"
          class="bg-white rounded-2xl shadow border border-orange-100 p-6"
        >
          Loading configurations...
        </div>
      </main>
    </div>

    <script>
      let configs = [];

      /*
  Fetch Config
*/
      async function fetchConfig() {
        const container = document.getElementById('configContainer');

        try {
          const res = await fetch('/admin/config');
          configs = await res.json();

          renderConfigs(configs);
        } catch (err) {
          container.innerHTML = `
      <div class="text-red-600">
        Failed to load system config
      </div>
    `;
        }
      }

      /*
  Render Config UI
*/
      function renderConfigs(data) {
        const container = document.getElementById('configContainer');

        container.innerHTML = data
          .map(
            (cfg) => `

    <div class="mb-6 border-b pb-4">

      <label class="block text-gray-700 font-semibold mb-2">
        ${cfg.key}
      </label>

      <div class="flex gap-3">

        <input
          id="cfg-${cfg.key}"
          type="text"
          value="${cfg.value}"
          class="flex-1 px-4 py-3 border rounded-xl focus:ring-2 focus:ring-orange-500 focus:outline-none"
        />

        <button
          onclick="updateConfig('${cfg.key}')"
          class="bg-orange-500 text-white px-5 py-3 rounded-xl hover:bg-orange-600">

          Save

        </button>

      </div>

    </div>

  `
          )
          .join('');
      }

      /*
  Update Config
*/
      async function updateConfig(key) {
        const input = document.getElementById(`cfg-${key}`);

        const value = input.value;

        const message = document.getElementById('message');

        message.classList.add('hidden');

        try {
          const res = await fetch('/admin/config/update', {
            method: 'PATCH',

            headers: {
              'Content-Type': 'application/json',
            },

            body: JSON.stringify({
              key,
              value,
            }),
          });

          const data = await res.json();

          if (!res.ok) {
            showMessage(data.message || 'Update failed', false);
            return;
          }

          showMessage('Configuration updated successfully', true);
        } catch (err) {
          showMessage('Something went wrong', false);
        }
      }

      /*
  Message UI
*/
      function showMessage(text, success) {
        const message = document.getElementById('message');

        message.classList.remove('hidden');

        message.className = `mb-5 px-4 py-3 rounded-xl text-sm border ${
          success
            ? 'bg-green-50 text-green-600 border-green-200'
            : 'bg-red-50 text-red-600 border-red-200'
        }`;

        message.textContent = text;
      }

      /*
  Init
*/
      fetchConfig();
    </script>
  </body>
</html>
