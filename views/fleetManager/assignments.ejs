<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Assignments | Fleet Manager | ofos</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>
<body class="min-h-screen bg-orange-50 font-sans text-gray-800">
  <div class="flex min-h-screen">
    <!-- SIDEBAR -->
    <aside class="w-64 bg-white border-r border-orange-100 shadow-lg flex flex-col fixed h-full z-10 transition-transform duration-300">
      <div class="p-6 text-center border-b border-orange-50">
        <h1 class="text-3xl font-extrabold text-orange-500">Fleet Control</h1>
      </div>

      <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
        <a href="/fleet-manager-dashboard" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          <span>Dashboard</span>
        </a>
        <a href="/fleet-manager-partners" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
          <span>Delivery Partners</span>
        </a>
        <a href="/fleet-manager-assignments" class="flex items-center space-x-3 px-4 py-3 rounded-xl bg-orange-100 text-orange-600 font-semibold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          <span>Assignments</span>
        </a>
        <a href="/fleet-manager-profile" class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          <span>Profile</span>
        </a>
      </nav>

      <div class="p-4 border-t border-orange-50">
        <button id="logoutBtn" class="flex items-center justify-center space-x-2 w-full bg-orange-500 text-white rounded-xl py-3 hover:bg-orange-600 transition-colors shadow-md hover:shadow-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
          <span class="font-semibold">Logout</span>
        </button>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="flex-1 ml-64 p-8">
      <div class="mb-8 flex justify-between items-center">
        <div>
          <h2 class="text-3xl font-bold text-gray-900">Active Assignments</h2>
          <p class="text-gray-500 mt-2">Track deliveries and reassign if necessary.</p>
        </div>
        <button onclick="document.getElementById('assignModal').classList.remove('hidden')" class="bg-orange-600 hover:bg-orange-700 text-white font-medium py-2 px-4 rounded-xl shadow-sm transition-colors">
          + New Assignment
        </button>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left whitespace-nowrap">
            <thead>
              <tr class="bg-orange-50 border-b border-gray-100 text-gray-600 text-sm uppercase tracking-wider">
                <th class="px-6 py-4 font-semibold">Assignment ID</th>
                <th class="px-6 py-4 font-semibold">Order ID</th>
                <th class="px-6 py-4 font-semibold">Partner ID</th>
                <th class="px-6 py-4 font-semibold">Status</th>
                <th class="px-6 py-4 font-semibold text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="assignmentsList" class="divide-y divide-gray-50 text-gray-700">
              <tr>
                <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                  <div class="animate-pulse flex justify-center">Loading assignments...</div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Assign Modal -->
      <div id="assignModal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex justify-center items-center z-50">
        <div class="bg-white rounded-2xl p-8 max-w-md w-full shadow-2xl">
          <h3 class="text-xl font-bold text-gray-900 mb-4">Assign Order</h3>
          <form id="assignForm" class="space-y-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Order ID</label>
              <input type="number" id="assignOrderId" class="w-full px-4 py-2 bg-gray-50 border border-gray-300 rounded-lg text-gray-900 focus:ring-2 focus:ring-orange-500 outline-none" required />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Partner ID</label>
              <input type="number" id="assignPartnerId" class="w-full px-4 py-2 bg-gray-50 border border-gray-300 rounded-lg text-gray-900 focus:ring-2 focus:ring-orange-500 outline-none" required />
            </div>
            <div class="flex justify-end space-x-3 pt-4">
              <button type="button" onclick="document.getElementById('assignModal').classList.add('hidden')" class="px-4 py-2 text-gray-600 hover:text-gray-800 font-medium">Cancel</button>
              <button type="submit" class="px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700 font-medium">Assign</button>
            </div>
          </form>
        </div>
      </div>

    </main>
  </div>

  <script>
    async function reassign(id) {
      const newPartnerId = prompt('Enter new Delivery Partner ID for this assignment:');
      if (!newPartnerId) return;
      const reason = prompt('Reason for reassignment? (optional)');
      
      const token = localStorage.getItem('token') || '';
      try {
        const res = await fetch(`/fleet-manager/${id}/reassign`, {
          method: 'PATCH',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ newDeliveryPartnerId: parseInt(newPartnerId), reason })
        });
        if (res.ok) {
          alert('Successfully reassigned!');
          loadAssignments();
        } else {
          const err = await res.json();
          alert('Failed: ' + (err.error || 'Unknown error'));
        }
      } catch (err) {
        console.error(err);
      }
    }

    async function loadAssignments() {
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/fleet-manager/all/assignments', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
        
        const list = document.getElementById('assignmentsList');
        if (res.ok) {
          const data = await res.json();
          const assignments = data.data || [];
          
          if (assignments.length === 0) {
            list.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">No active assignments.</td></tr>`;
          } else {
            list.innerHTML = assignments.map(a => `
              <tr class="hover:bg-orange-50/50 transition-colors">
                <td class="px-6 py-4 font-bold text-gray-900">#${a.id}</td>
                <td class="px-6 py-4 text-gray-600">Order #${a.orderId}</td>
                <td class="px-6 py-4 text-orange-600 font-medium">Partner #${a.deliveryPartnerId}</td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                    ${a.status}
                  </span>
                </td>
                <td class="px-6 py-4 text-right space-x-2">
                  <button onclick="reassign(${a.id})" class="text-blue-600 hover:text-blue-800 text-sm font-medium">Reassign</button>
                </td>
              </tr>
            `).join('');
          }
        }
      } catch (err) {
        console.error(err);
      }
    }

    document.getElementById('assignForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const orderId = document.getElementById('assignOrderId').value;
      const partnerId = document.getElementById('assignPartnerId').value;
      const token = localStorage.getItem('token') || '';

      try {
        const res = await fetch(`/fleet-manager/${orderId}/assign`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ deliveryPartnerId: parseInt(partnerId) })
        });
        if (res.ok) {
          alert('Assignment created successfully!');
          document.getElementById('assignModal').classList.add('hidden');
          document.getElementById('assignForm').reset();
          loadAssignments();
        } else {
          const err = await res.json();
          alert('Failed to assign: ' + (err.error || 'Unknown error'));
        }
      } catch (err) {
        console.error(err);
      }
    });

    loadAssignments();

    document.getElementById('logoutBtn').addEventListener('click', () => {
      localStorage.removeItem('token');
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });
  </script>
</body>
</html>
