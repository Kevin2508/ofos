<!-- ============================================
  PARTIAL: TOPBAR
  Variables expected: pageTitle, pageSubtitle, user {name, role}
============================================= -->
<header class="topbar">
  <div class="topbar-left">
    <button class="menu-toggle" id="menuToggle">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <div>
      <h1><%= pageTitle %></h1>
      <% if (typeof pageSubtitle !== 'undefined' && pageSubtitle) { %>
        <div class="subtitle"><%= pageSubtitle %></div>
      <% } %>
    </div>
  </div>

  <div class="search-box">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input type="text" placeholder="Search...">
  </div>

  <div class="topbar-right">
    <button class="icon-btn" title="Notifications">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
      <span class="badge-dot"></span>
    </button>
    <div class="user-chip">
      <div class="avatar"><%= (user && user.name) ? user.name.charAt(0).toUpperCase() : 'O' %></div>
      <div class="user-meta">
        <div class="name"><%= (user && user.name) ? user.name : 'Restaurant Owner' %></div>
        <div class="role">Restaurant Owner</div>
      </div>
    </div>
  </div>
</header>
