<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Configurations | Admin | ofos</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="min-h-screen bg-orange-50 font-sans text-gray-800">
  <div class="flex min-h-screen">
    <!-- SIDEBAR -->
    <aside
      class="w-64 bg-white border-r border-orange-100 shadow-lg flex flex-col fixed h-full z-10 transition-transform duration-300">
      <div class="p-6 text-center border-b border-orange-50">
        <h1 class="text-3xl font-extrabold text-orange-500">ofos Admin</h1>
      </div>

      <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
        <a href="/a/admin-dashboard"
          class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6">
            </path>
          </svg>
          <span>Dashboard</span>
        </a>
        <a href="/a/admin-users"
          class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z">
            </path>
          </svg>
          <span>Users</span>
        </a>
        <a href="/a/admin-restaurants"
          class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4">
            </path>
          </svg>
          <span>Restaurants</span>
        </a>
        <a href="/a/admin-orders"
          class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
          <span>Global Orders</span>
        </a>
        <a href="/a/admin-configs"
          class="flex items-center space-x-3 px-4 py-3 rounded-xl bg-orange-100 text-orange-600 font-semibold transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z">
            </path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z">
            </path>
          </svg>
          <span>Configurations</span>
        </a>
        <a href="/a/admin-audit-logs"
          class="flex items-center space-x-3 px-4 py-3 rounded-xl text-gray-600 hover:bg-orange-50 hover:text-orange-500 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
            </path>
          </svg>
          <span>Audit Logs</span>
        </a>
      </nav>

      <div class="p-4 border-t border-orange-50">
        <button id="logoutBtn"
          class="flex items-center justify-center space-x-2 w-full bg-orange-500 text-white rounded-xl py-3 hover:bg-orange-600 transition-colors shadow-md hover:shadow-lg">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
          </svg>
          <span class="font-semibold">Logout</span>
        </button>
      </div>
    </aside>

    <!-- MAIN CONTENT -->
    <main class="flex-1 ml-64 p-8">
      <div class="flex justify-between items-center mb-8">
        <div>
          <h2 class="text-3xl font-bold text-gray-900">System Configurations</h2>
          <p class="text-gray-500 mt-2">Manage global settings like service limits, delivery radii, and platform fees.</p>
        </div>
        <button onclick="toggleAddModal(true)" class="bg-orange-600 hover:bg-orange-700 text-white font-medium py-2 px-5 rounded-xl transition-colors shadow-sm flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          Add Config
        </button>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 max-w-5xl">
        <div id="configsContainer" class="space-y-6">
          <div class="py-8 text-center text-gray-500">Loading configurations...</div>
        </div>
      </div>
    </main>
  </div>

  <!-- Add Config Modal -->
  <div id="addModal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center">
    <div class="bg-white rounded-2xl w-full max-w-md p-6 shadow-xl">
      <h3 class="text-xl font-bold text-gray-900 mb-4">Add Configuration</h3>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Config Key</label>
          <input type="text" id="addKey" placeholder="e.g. PLATFORM_FEE" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-orange-500 outline-none uppercase" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Config Value</label>
          <input type="text" id="addValue" placeholder="e.g. 5.00" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-1">Description (Optional)</label>
          <input type="text" id="addDesc" placeholder="e.g. Default platform fee in percentage" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-orange-500 outline-none" />
        </div>
        <div class="flex justify-end gap-3 mt-6">
          <button onclick="toggleAddModal(false)" class="px-4 py-2 text-gray-600 hover:bg-gray-100 rounded-lg">Cancel</button>
          <button onclick="addConfig()" class="px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700">Save</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const token = localStorage.getItem('token') || '';

    function toggleAddModal(show) {
      const modal = document.getElementById('addModal');
      if (show) {
        modal.classList.remove('hidden');
        document.getElementById('addKey').value = '';
        document.getElementById('addValue').value = '';
        document.getElementById('addDesc').value = '';
      } else {
        modal.classList.add('hidden');
      }
    }

    async function loadConfigs() {
      try {
        const res = await fetch('/admin/config', { headers: { 'Authorization': `Bearer ${token}` } });
        const container = document.getElementById('configsContainer');
        if (res.ok) {
          const data = await res.json();
          const configs = data.data || [];

          if (configs.length === 0) {
            container.innerHTML = `<div class="py-8 text-center text-gray-500">No configs found in the database.</div>`;
          } else {
            container.innerHTML = configs.map(c => `
              <div class="flex items-start gap-4 p-4 border rounded-xl hover:shadow-sm transition-shadow">
                <div class="flex-1 space-y-2">
                  <div class="flex items-center justify-between">
                    <label class="block text-sm font-bold text-gray-800">${c.configKey}</label>
                  </div>
                  <input type="text" id="val_${c.configKey}" value="${c.configValue}" class="w-full px-4 py-2 bg-gray-50 border border-gray-200 rounded-lg text-gray-900 focus:ring-2 focus:ring-orange-500 outline-none" />
                  <p class="text-xs text-gray-500">${c.description || 'System configuration parameter'}</p>
                </div>
                <div class="flex flex-col gap-2 mt-6">
                  <button onclick="updateConfig('${c.configKey}')" class="px-4 py-2 bg-orange-100 text-orange-600 hover:bg-orange-200 rounded-lg text-sm font-semibold transition-colors">Update</button>
                  <button onclick="deleteConfig('${c.configKey}')" class="px-4 py-2 bg-red-50 text-red-600 hover:bg-red-100 rounded-lg text-sm font-semibold transition-colors">Delete</button>
                </div>
              </div>
            `).join('');
          }
        }
      } catch (err) { console.error(err); }
    }

    async function addConfig() {
      const key = document.getElementById('addKey').value.trim();
      const value = document.getElementById('addValue').value.trim();
      const desc = document.getElementById('addDesc').value.trim();

      if (!key || !value) return alert('Key and Value are required');

      try {
        const res = await fetch('/admin/config', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ key, value, description: desc })
        });
        const data = await res.json();
        if (res.ok) {
          toggleAddModal(false);
          loadConfigs();
        } else {
          alert(data.message || 'Error adding config');
        }
      } catch (e) { alert('Error adding config'); }
    }

    async function updateConfig(key) {
      const value = document.getElementById(`val_${key}`).value;
      try {
        const res = await fetch('/admin/config/update', {
          method: 'PATCH',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ key, value })
        });
        if (res.ok) {
          alert('Config updated successfully');
          loadConfigs();
        } else {
          const data = await res.json();
          alert(data.message || 'Error updating config');
        }
      } catch (e) { alert('Error updating config'); }
    }

    async function deleteConfig(key) {
      if (!confirm(`Are you sure you want to delete ${key}?`)) return;
      try {
        const res = await fetch(`/admin/config/${key}`, {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (res.ok) {
          loadConfigs();
        } else {
          const data = await res.json();
          alert(data.message || 'Error deleting config');
        }
      } catch (e) { alert('Error deleting config'); }
    }

    loadConfigs();

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        await fetch('/auth/logout', { headers: { 'Authorization': `Bearer ${token}` } });
      } catch (e) { }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });
  </script>
</body>

</html>