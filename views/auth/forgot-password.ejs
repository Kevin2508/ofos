<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password | ofos</title>
    <link rel="stylesheet" href="/styles/build.css" />
  </head>
  <body
    class="min-h-screen bg-orange-50 flex items-center justify-center px-4 py-10"
  >
    <div class="w-full max-w-md">
      <!-- Logo / Heading -->
      <div class="text-center mb-8">
        <h1 class="text-5xl font-extrabold text-orange-500">ofos</h1>
        <p class="text-gray-600 mt-2">
          Enter your email or phone to reset password
        </p>
      </div>

      <!-- Card -->
      <div class="bg-white rounded-3xl shadow-xl p-8 border border-orange-100">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">Forgot Password</h2>

        <form id="forgotForm" class="space-y-5">
          <!-- Email / Phone -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Email or Phone Number
            </label>
            <input
              type="text"
              id="userIdentifier"
              name="userIdentifier"
              placeholder="Enter email or 10 digit phone"
              class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-orange-500"
            />
            <p id="userIdentifierError" class="text-red-500 text-sm mt-1"></p>
          </div>

          <!-- API Error / Success -->
          <div
            id="apiMessage"
            class="hidden px-4 py-3 rounded-xl text-sm"
          ></div>

          <!-- Submit -->
          <button
            type="submit"
            id="submitBtn"
            class="w-full bg-orange-500 hover:bg-orange-600 text-white font-semibold py-3 rounded-xl transition duration-200"
          >
            Send Reset Link
          </button>
        </form>

        <!-- Back links -->
        <div class="mt-6 text-center space-y-2 text-sm text-gray-600">
          <p>
            Remembered your password?
            <a
              href="/loginPage"
              class="font-semibold text-orange-500 hover:text-orange-600"
              >Login</a
            >
          </p>
          <p>
            Don't have an account?
            <a
              href="/registerPage"
              class="font-semibold text-orange-500 hover:text-orange-600"
              >Register</a
            >
          </p>
        </div>
      </div>
    </div>

    <script>
      const forgotForm = document.getElementById('forgotForm');
      const userIdentifier = document.getElementById('userIdentifier');
      const userIdentifierError = document.getElementById(
        'userIdentifierError'
      );
      const apiMessage = document.getElementById('apiMessage');
      const submitBtn = document.getElementById('submitBtn');

      /* Validation based on your Joi schema */
      function validateUserIdentifier(value) {
        const trimmed = value.trim();
        if (!trimmed) return 'User identifier is required';

        const phoneRegex = /^[0-9]{10}$/;
        const emailRegex =
          /^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.(com|net|org|io)$/;

        if (phoneRegex.test(trimmed)) return '';
        if (/^[0-9]+$/.test(trimmed) && trimmed.length !== 10) {
          return 'Contact number must be exactly 10 digits';
        }
        if (emailRegex.test(trimmed)) return '';

        return 'Please enter a valid email address ending in .com';
      }

      function clearMessages() {
        userIdentifierError.textContent = '';
        apiMessage.textContent = '';
        apiMessage.classList.add('hidden');
        apiMessage.classList.remove(
          'bg-green-50',
          'text-green-600',
          'bg-red-50',
          'text-red-600',
          'border-red-200',
          'border-green-200'
        );
      }

      forgotForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearMessages();

        const identifierValue = userIdentifier.value.trim();
        const validationError = validateUserIdentifier(identifierValue);
        if (validationError) {
          userIdentifierError.textContent = validationError;
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';

        try {
          const response = await fetch('/auth/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userIdentifier: identifierValue }),
          });

          const data = await response.json();

          if (!response.ok) {
            apiMessage.classList.remove('hidden');
            apiMessage.classList.add(
              'bg-red-50',
              'text-red-600',
              'border',
              'border-red-200'
            );
            apiMessage.textContent =
              data.message || 'Failed to send reset link';
            return;
          }

          if (data.otp) {
            window.location.href = `/resetPasswordPage?resetToken=${data.otp}`;
          } else if (('link', data.link)) {
            window.location.href = data.link;
          }
          apiMessage.classList.remove('hidden');
          apiMessage.classList.add(
            'bg-green-50',
            'text-green-600',
            'border',
            'border-green-200'
          );
          apiMessage.textContent =
            data.message || 'Reset link sent successfully';
        } catch (err) {
          apiMessage.classList.remove('hidden');
          apiMessage.classList.add(
            'bg-red-50',
            'text-red-600',
            'border',
            'border-red-200'
          );
          apiMessage.textContent = 'Something went wrong. Please try again.';
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send Reset Link';
        }
      });
    </script>
  </body>
</html>
