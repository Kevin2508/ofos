  <script>
    async function loadUsers() {
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/admin/users', {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        const list = document.getElementById('usersList');
        if (res.ok) {
          const data = await res.json();
          const users = data.data?.users || [];

          if (users.length === 0) {
            list.innerHTML = `<tr><td colspan="4" class="px-6 py-8 text-center text-gray-500">No users found.</td></tr>`;
          } else {
            list.innerHTML = users.map(u => `
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-full bg-orange-100 text-orange-600 flex items-center justify-center font-bold">
                      ${(u.firstName?.[0] || 'U').toUpperCase()}
                    </div>
                    <div>
                      <p class="font-medium text-gray-900">${u.firstName || ''} ${u.lastName || ''}</p>
                      <p class="text-xs text-gray-500">${u.email}</p>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-medium bg-slate-100 text-slate-800">
                    ${u.roles?.[0]?.name || 'User'}
                  </span>
                </td>
                <td class="px-6 py-4 text-sm text-gray-500">
                  ${new Date(u.createdAt).toLocaleDateString()}
                </td>
                <td class="px-6 py-4 text-right">
                  <button class="text-orange-600 hover:text-orange-800 text-sm font-medium" onclick="alert('Manage user modal coming soon!')">Manage</button>
                </td>
              </tr>
            `).join('');
          }
        }
      } catch (err) {
        console.error(err);
      }
    }

    loadUsers();

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        const token = localStorage.getItem('token') || '';
        await fetch('/auth/logout', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
      } catch (e) { console.error(e); }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });;
