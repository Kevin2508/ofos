<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password | ofos - Food Ordering System</title>
    <link rel="stylesheet" href="/styles/build.css" />
  </head>
  <body
    class="min-h-screen bg-linear-to-br from-orange-50 via-rose-50 to-amber-50"
  >
    <!-- Floating food decorations -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden select-none">
      <span class="absolute top-20 left-[18%] text-5xl opacity-15">🍕</span>
      <span class="absolute top-40 right-[22%] text-4xl opacity-20">🍔</span>
      <span class="absolute bottom-32 left-[28%] text-6xl opacity-10">🌮</span>
      <span class="absolute top-1/4 right-[12%] text-3xl opacity-15">🥗</span>
      <span class="absolute bottom-48 right-[32%] text-5xl opacity-10">🍜</span>
      <span class="absolute top-3/4 left-[12%] text-4xl opacity-15">🍣</span>
    </div>

    <div
      class="min-h-screen flex items-center justify-center px-4 py-10 relative"
    >
      <div class="w-full max-w-5xl">
        <div
          class="bg-white/80 backdrop-blur-sm rounded-3xl shadow-2xl overflow-hidden border border-orange-100/60"
        >
          <div class="lg:flex">
            <!-- Left Brand Panel -->
            <div
              class="lg:w-5/12 bg-linear-to-br from-orange-500 via-orange-600 to-rose-600 p-8 lg:p-10 text-white flex flex-col justify-between relative overflow-hidden min-h-[280px] lg:min-h-0"
            >
              <div
                class="absolute -top-24 -right-24 w-72 h-72 bg-white/5 rounded-full"
              ></div>
              <div
                class="absolute -bottom-20 -left-20 w-56 h-56 bg-white/5 rounded-full"
              ></div>
              <div
                class="absolute top-1/2 -translate-y-1/2 right-0 w-32 h-32 bg-white/[0.03] rounded-full"
              ></div>

              <div class="relative">
                <div class="flex items-center gap-3 mb-5">
                  <span class="text-3xl">🔑</span>
                  <h1 class="text-3xl font-extrabold tracking-tight">ofos</h1>
                </div>
                <p class="text-orange-100 text-base leading-relaxed mb-7">
                  Forgot your password?
                  <span class="font-semibold text-white">No worries</span> —
                  we'll help you get back in.
                </p>
                <div class="space-y-4">
                  <div class="flex items-center gap-3">
                    <span
                      class="flex-shrink-0 w-10 h-10 bg-white/20 rounded-full flex items-center justify-center text-lg"
                      >📧</span
                    >
                    <div>
                      <p class="font-semibold text-sm">Email Reset</p>
                      <p class="text-xs text-orange-100">
                        Get a reset link instantly
                      </p>
                    </div>
                  </div>
                  <div class="flex items-center gap-3">
                    <span
                      class="flex-shrink-0 w-10 h-10 bg-white/20 rounded-full flex items-center justify-center text-lg"
                      >📱</span
                    >
                    <div>
                      <p class="font-semibold text-sm">Phone OTP</p>
                      <p class="text-xs text-orange-100">
                        Verify with a one-time code
                      </p>
                    </div>
                  </div>
                  <div class="flex items-center gap-3">
                    <span
                      class="flex-shrink-0 w-10 h-10 bg-white/20 rounded-full flex items-center justify-center text-lg"
                      >🔒</span
                    >
                    <div>
                      <p class="font-semibold text-sm">Secure & Safe</p>
                      <p class="text-xs text-orange-100">
                        Your data is always protected
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="relative mt-6 pt-5 border-t border-white/20">
                <div
                  class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-orange-100"
                >
                  <span>🍕 Pizza</span>
                  <span>🍔 Burger</span>
                  <span>🌮 Taco</span>
                  <span>🥗 Salad</span>
                  <span>🍜 Noodles</span>
                </div>
              </div>
            </div>

            <!-- Right Form Panel -->
            <div class="lg:w-7/12 p-8 lg:p-12">
              <div class="max-w-sm mx-auto">
                <div class="text-center lg:text-left mb-8">
                  <h2 class="text-2xl font-bold text-gray-800">
                    Forgot Password?
                  </h2>
                  <p class="text-gray-400 mt-1 text-sm">
                    Enter your email or phone to receive a reset link
                  </p>
                </div>

                <form id="forgotForm" class="space-y-5">
                  <div>
                    <label
                      class="block text-sm font-semibold text-gray-700 mb-1.5"
                    >
                      Email or Phone Number
                    </label>
                    <input
                      type="text"
                      id="userIdentifier"
                      name="userIdentifier"
                      placeholder="Enter email or 10 digit phone"
                      class="w-full px-4 py-3.5 rounded-2xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition duration-200 bg-gray-50 focus:bg-white"
                    />
                    <p
                      id="userIdentifierError"
                      class="text-red-500 text-sm mt-1.5"
                    ></p>
                  </div>

                  <button
                    type="submit"
                    id="submitBtn"
                    class="w-full bg-gradient-to-r from-orange-500 to-rose-500 hover:from-orange-600 hover:to-rose-600 text-white font-semibold py-3.5 rounded-2xl transition duration-200 shadow-lg shadow-orange-200 hover:shadow-xl hover:shadow-orange-300 cursor-pointer"
                  >
                    Send Reset Link
                  </button>
                </form>

                <div class="mt-8 text-center space-y-3">
                  <p class="text-gray-400 text-sm">
                    Remembered your password?
                    <a
                      href="/loginPage"
                      class="font-semibold text-orange-500 hover:text-orange-600 transition"
                    >
                      Login
                    </a>
                  </p>
                  <p class="text-gray-400 text-sm">
                    Don't have an account?
                    <a
                      href="/registerPage"
                      class="font-semibold text-orange-500 hover:text-orange-600 transition"
                    >
                      Create Account
                    </a>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      const forgotForm = document.getElementById('forgotForm');
      const userIdentifier = document.getElementById('userIdentifier');
      const userIdentifierError = document.getElementById(
        'userIdentifierError'
      );
      const submitBtn = document.getElementById('submitBtn');

      /* Validation based on your Joi schema */
      function validateUserIdentifier(value) {
        const trimmed = value.trim();
        if (!trimmed) return 'User identifier is required';

        const phoneRegex = /^[0-9]{10}$/;
        const emailRegex =
          /^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.(com|net|org|io)$/;

        if (phoneRegex.test(trimmed)) return '';
        if (/^[0-9]+$/.test(trimmed) && trimmed.length !== 10) {
          return 'Contact number must be exactly 10 digits';
        }
        if (emailRegex.test(trimmed)) return '';

        return 'Please enter a valid email address ending in .com';
      }

      function clearMessages() {
        userIdentifierError.textContent = '';
      }

      forgotForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearMessages();

        const identifierValue = userIdentifier.value.trim();
        const validationError = validateUserIdentifier(identifierValue);
        if (validationError) {
          userIdentifierError.textContent = validationError;
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';

        try {
          const response = await fetch('/auth/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userIdentifier: identifierValue }),
          });

          const data = await response.json();

          if (!response.ok) {
            showToast(data.message || 'Failed to send reset link', 'error');
            return;
          }

          if (data.otp) {
            window.location.href = `/resetPasswordPage?resetToken=${data.otp}`;
          } else if (('link', data.link)) {
            window.location.href = data.link;
          }
          showToast(data.message || 'Reset link sent successfully', 'success');
        } catch (err) {
          showToast('Something went wrong. Please try again.', 'error');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send Reset Link';
        }
      });
    </script>
    <%- include('../partials/toast') %>
  </body>
</html>
