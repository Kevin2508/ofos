      <td class="p-4">
        ${user.firstName}
      </td>

      <td class="p-4">
        ${user.email}
      </td>

      <td class="p-4">
        ${user.phone}
      </td>

      <td class="p-4 capitalize">
        ${user.role}
      </td>

      <td class="p-4 capitalize">
        ${user.status}
      </td>

      <td class="p-4">

        <button
          onclick="viewUser('${user.id}')"
          class="bg-orange-500 text-white px-3 py-2 rounded-lg">

          View

        </button>

      </td>

    </tr>

  `
          )
          .join('');
