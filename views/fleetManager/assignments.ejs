<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Assignments | Fleet Manager | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
  <script src="/js/form-validator.js"></script>
</head>

<body class="min-h-screen bg-orange-50 font-sans text-gray-800">
  <div class="flex min-h-screen">
    <%- include('../partials/fleetManager/sidebar') %>

      <!-- MAIN CONTENT -->
      <main class="flex-1 lg:ml-72 p-5 sm:p-8 transition-all duration-300" id="mainContentWrapper">
        <div class="mb-8 flex justify-between items-center">
          <div class="flex flex-wrap items-start md:items-center gap-3">
            <button onclick="toggleSidebar()"
              class="p-2 -ml-2 mt-1 md:mt-0 text-gray-600 hover:text-orange-500 rounded-xl hover:bg-orange-50 transition-colors lg:hidden">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
            <div>
              <h2 class="text-3xl font-bold text-gray-900">Active Assignments</h2>
              <p class="text-gray-500 mt-2">Track deliveries and reassign if necessary.</p>

            </div>
          </div>
          <button onclick="document.getElementById('assignModal').classList.remove('hidden')"
            class="bg-orange-600 hover:bg-orange-700 text-white font-medium py-2 px-4 rounded-xl shadow-sm transition-colors">
            + New Assignment
          </button>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left whitespace-nowrap">
              <thead>
                <tr class="bg-orange-50 border-b border-gray-100 text-gray-600 text-sm uppercase tracking-wider">
                  <th class="px-6 py-4 font-semibold">Assignment ID</th>
                  <th class="px-6 py-4 font-semibold">Order ID</th>
                  <th class="px-6 py-4 font-semibold">Partner ID</th>
                  <th class="px-6 py-4 font-semibold">Status</th>
                  <th class="px-6 py-4 font-semibold text-right">Actions</th>
                </tr>
              </thead>
              <tbody id="assignmentsList" class="divide-y divide-gray-50 text-gray-700">
                <tr id="loadingRow">
                  <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                    <div class="animate-pulse flex justify-center">Loading...</div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="mt-8 mb-4">
          <h2 class="text-2xl font-bold text-gray-900">Unassigned / Escalated Orders</h2>
          <p class="text-gray-500 mt-1">Orders that need manual assignment.</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left whitespace-nowrap">
              <thead>
                <tr class="bg-red-50 border-b border-gray-100 text-gray-600 text-sm uppercase tracking-wider">
                  <th class="px-6 py-4 font-semibold">Order ID</th>
                  <th class="px-6 py-4 font-semibold">Restaurant</th>
                  <th class="px-6 py-4 font-semibold">Status</th>
                  <th class="px-6 py-4 font-semibold text-right">Actions</th>
                </tr>
              </thead>
              <tbody id="unassignedList" class="divide-y divide-gray-50 text-gray-700">
                <tr>
                  <td colspan="4" class="px-6 py-8 text-center text-gray-500">
                    <div class="flex justify-center">Loading...</div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Assign Modal -->
        <div id="assignModal"
          class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex justify-center items-center z-50 p-4">
          <div class="bg-white rounded-2xl p-5 sm:p-8 max-w-md w-full shadow-2xl">
            <h3 class="text-xl font-bold text-gray-900 mb-4">Assign Order</h3>
            <form id="assignForm" class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Order ID</label>
                <input type="number" id="assignOrderId"
                  class="w-full px-4 py-2 bg-gray-50 border border-gray-300 rounded-lg text-gray-900 focus:ring-2 focus:ring-orange-500 outline-none"
                  required />
                <p id="assignPartnerIdError" class="text-red-500 text-xs mt-1 hidden font-medium"></p>
                <p id="assignOrderIdError" class="text-red-500 text-xs mt-1 hidden font-medium"></p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Partner ID</label>
                <input type="number" id="assignPartnerId"
                  class="w-full px-4 py-2 bg-gray-50 border border-gray-300 rounded-lg text-gray-900 focus:ring-2 focus:ring-orange-500 outline-none"
                  required />
              </div>
              <div class="flex justify-end space-x-3 pt-4">
                <button type="button" onclick="document.getElementById('assignModal').classList.add('hidden')"
                  class="px-4 py-2 text-gray-600 hover:text-gray-800 font-medium">Cancel</button>
                <button type="submit"
                  class="px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700 font-medium">Assign</button>
              </div>
            </form>
          </div>
        </div>

      
        <!-- Reassign Modal -->
        <div id="reassignModal" class="hidden fixed inset-0 bg-black/50 backdrop-blur-sm flex justify-center items-center z-50 p-4">
          <div class="bg-white rounded-2xl p-5 sm:p-8 max-w-md w-full shadow-2xl">
            <h3 class="text-xl font-bold text-gray-900 mb-4">Reassign Order</h3>
            <form id="reassignForm" class="space-y-4">
              <input type="hidden" id="reassignAssignmentId" />
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">New Partner ID</label>
                <input type="number" id="reassignPartnerId" class="w-full px-4 py-2 bg-gray-50 border border-gray-300 rounded-lg text-gray-900 focus:ring-2 focus:ring-orange-500 outline-none" required />
                <p id="reassignPartnerIdError" class="text-red-500 text-xs mt-1 hidden font-medium"></p>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Reason (Optional)</label>
                <textarea id="reassignReason" rows="2" class="w-full px-4 py-2 bg-gray-50 border border-gray-300 rounded-lg text-gray-900 focus:ring-2 focus:ring-orange-500 outline-none resize-none"></textarea>
              </div>
              <div class="flex justify-end space-x-3 pt-4">
                <button type="button" onclick="document.getElementById('reassignModal').classList.add('hidden')" class="px-4 py-2 text-gray-600 hover:text-gray-800 font-medium">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700 font-medium">Reassign</button>
              </div>
            </form>
          </div>
        </div>

      </main>
  </div>

  <script>

    const assignRules = {
      assignOrderId: { required: true, min: 1, label: 'Order ID' },
      assignPartnerId: { required: true, min: 1, label: 'Partner ID' }
    };
    const reassignRules = {
      reassignPartnerId: { required: true, min: 1, label: 'New Partner ID' }
    };
    FormValidator.bindLiveValidation(assignRules);
    FormValidator.bindLiveValidation(reassignRules);

    
    function reassign(id) {
      document.getElementById('reassignAssignmentId').value = id;
      document.getElementById('reassignPartnerId').value = '';
      document.getElementById('reassignReason').value = '';
      document.getElementById('reassignModal').classList.remove('hidden');
    }

    document.getElementById('reassignForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!FormValidator.validate(reassignRules)) return;
      
      const id = document.getElementById('reassignAssignmentId').value;
      const newPartnerId = document.getElementById('reassignPartnerId').value;
      const reason = document.getElementById('reassignReason').value;

      const token = localStorage.getItem('token') || '';
      try {
        const res = await fetch(`/fleet-manager/${id}/reassign`, {
          method: 'PATCH',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ partnerUserId: newPartnerId, reason })
        });
        if (res.ok) {
          alert('Successfully reassigned!');
          document.getElementById('reassignModal').classList.add('hidden');
          loadAssignments();
        } else {
          const err = await res.json();
          alert('Failed: ' + (err.error || 'Unknown error'));
        }
      } catch (err) {
        console.error(err);
      }
    });

    async function loadAssignments() {
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/fleet-manager/all/assignments', {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        const unassignedList = document.getElementById('unassignedList');
        const list = document.getElementById('assignmentsList');

        if (res.ok) {
          const data = await res.json();
          const assignments = data.data?.assignments || [];
          const unassignedOrders = data.data?.unassignedOrders || [];

          if (assignments.length === 0) {
            list.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">No active assignments.</td></tr>`;
          } else {
            list.innerHTML = assignments.map(a => `
              <tr class="hover:bg-orange-50/50 transition-colors">
                <td class="px-6 py-4 font-bold text-gray-900">#${a.id}</td>
                <td class="px-6 py-4 text-gray-600">Order #${a.orderId}</td>
                <td class="px-6 py-4 text-orange-600 font-medium">Partner #${a.partnerUserId}</td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                    ${a.status}
                  </span>
                </td>
                <td class="px-6 py-4 text-right space-x-2">
                  <button onclick="reassign('${a.id}')" class="text-blue-600 hover:text-blue-800 text-sm font-medium">Reassign</button>
                </td>
              </tr>
            `).join('');
          }

          if (unassignedOrders.length === 0) {
            unassignedList.innerHTML = `<tr><td colspan="4" class="px-6 py-8 text-center text-gray-500">No unassigned orders.</td></tr>`;
          } else {
            unassignedList.innerHTML = unassignedOrders.map(o => `
              <tr class="hover:bg-red-50/50 transition-colors">
                <td class="px-6 py-4 font-bold text-gray-900">#${o.id}</td>
                <td class="px-6 py-4 text-gray-600">${o.branch?.name || 'Restaurant'}</td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                    UNASSIGNED
                  </span>
                </td>
                <td class="px-6 py-4 text-right space-x-2">
                  <button onclick="openAssignModal('${o.id}')" class="text-green-600 hover:text-green-800 text-sm font-medium">Assign Partner</button>
                </td>
              </tr>
            `).join('');
          }
        }
      } catch (err) {
        console.error(err);
      }
    }

    function openAssignModal(orderId) {
      document.getElementById('assignOrderId').value = orderId || '';
      document.getElementById('assignPartnerId').value = '';
      document.getElementById('assignModal').classList.remove('hidden');
    }

    document.getElementById('assignForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const orderId = document.getElementById('assignOrderId').value;
      const partnerId = document.getElementById('assignPartnerId').value;
      const token = localStorage.getItem('token') || '';

      try {
        const res = await fetch(`/fleet-manager/${orderId}/assign`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ partnerUserId: partnerId })
        });
        if (res.ok) {
          alert('Assignment created successfully!');
          document.getElementById('assignModal').classList.add('hidden');
          document.getElementById('assignForm').reset();
          loadAssignments();
        } else {
          const err = await res.json();
          alert('Failed to assign: ' + (err.error || 'Unknown error'));
        }
      } catch (err) {
        console.error(err);
      }
    });

    loadAssignments();

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        const token = localStorage.getItem('token') || '';
        await fetch('/auth/logout', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
      } catch (e) { console.error(e); }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });;
  </script>
</body>

</html>