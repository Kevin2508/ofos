<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password | ofos</title>
    <link rel="stylesheet" href="/styles/build.css" />
  </head>

  <body
    class="min-h-screen bg-orange-50 flex items-center justify-center px-4 py-10"
  >
    <div class="w-full max-w-md">
      <!-- Logo -->
      <div class="text-center mb-8">
        <h1 class="text-5xl font-extrabold text-orange-500">ofos</h1>

        <p class="text-gray-600 mt-2">Create a new password for your account</p>
      </div>

      <!-- Card -->
      <div class="bg-white rounded-3xl shadow-xl p-8 border border-orange-100">
        <h2 class="text-2xl font-bold text-gray-800 mb-6">Reset Password</h2>

        <form id="resetForm" class="space-y-5">
          <!-- Phone Number (OTP flow only) -->
          <div id="phoneContainer" class="hidden">
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Phone Number
            </label>

            <input
              type="text"
              id="userIdentifier"
              name="userIdentifier"
              placeholder="Enter your 10 digit phone number"
              class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-orange-500"
            />

            <p id="userIdentifierError" class="text-red-500 text-sm mt-1"></p>
          </div>

          <!-- New Password -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              New Password
            </label>

            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                placeholder="Enter new password"
                class="w-full px-4 py-3 pr-16 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-orange-500"
              />

              <button
                type="button"
                id="togglePassword"
                class="absolute right-4 top-1/2 -translate-y-1/2 text-orange-500 font-medium"
              >
                Show
              </button>
            </div>

            <p id="passwordError" class="text-red-500 text-sm mt-1"></p>
          </div>

          <!-- Confirm Password -->
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">
              Confirm Password
            </label>

            <div class="relative">
              <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                placeholder="Confirm your password"
                class="w-full px-4 py-3 pr-16 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-orange-500"
              />

              <button
                type="button"
                id="toggleConfirmPassword"
                class="absolute right-4 top-1/2 -translate-y-1/2 text-orange-500 font-medium"
              >
                Show
              </button>
            </div>

            <p id="confirmPasswordError" class="text-red-500 text-sm mt-1"></p>
          </div>

          <!-- API Message -->
          <div
            id="apiMessage"
            class="hidden px-4 py-3 rounded-xl text-sm"
          ></div>

          <!-- Submit -->
          <button
            type="submit"
            id="submitBtn"
            class="w-full bg-orange-500 hover:bg-orange-600 text-white font-semibold py-3 rounded-xl transition duration-200"
          >
            Reset Password
          </button>
        </form>

        <!-- Back -->
        <div class="mt-6 text-center">
          <a
            href="/loginPage"
            class="font-semibold text-orange-500 hover:text-orange-600"
          >
            Back to Login
          </a>
        </div>
      </div>
    </div>

    <script>
      const resetForm = document.getElementById('resetForm');

      const phoneContainer = document.getElementById('phoneContainer');
      const userIdentifier = document.getElementById('userIdentifier');

      const password = document.getElementById('password');
      const confirmPassword = document.getElementById('confirmPassword');

      const userIdentifierError = document.getElementById(
        'userIdentifierError'
      );
      const passwordError = document.getElementById('passwordError');
      const confirmPasswordError = document.getElementById(
        'confirmPasswordError'
      );

      const apiMessage = document.getElementById('apiMessage');
      const submitBtn = document.getElementById('submitBtn');

      // Get reset token from URL
      const params = new URLSearchParams(window.location.search);
      const resetToken = params.get('resetToken');

      // OTP flow detection
      if (/^[0-9]{6}$/.test(resetToken)) {
        phoneContainer.classList.remove('hidden');
      }

      // Password toggles
      function toggleVisibility(buttonId, inputElement) {
        document.getElementById(buttonId).addEventListener('click', () => {
          if (inputElement.type === 'password') {
            inputElement.type = 'text';
            document.getElementById(buttonId).textContent = 'Hide';
          } else {
            inputElement.type = 'password';
            document.getElementById(buttonId).textContent = 'Show';
          }
        });
      }

      toggleVisibility('togglePassword', password);
      toggleVisibility('toggleConfirmPassword', confirmPassword);

      function clearMessages() {
        userIdentifierError.textContent = '';
        passwordError.textContent = '';
        confirmPasswordError.textContent = '';

        apiMessage.textContent = '';

        apiMessage.classList.add('hidden');

        apiMessage.classList.remove(
          'bg-red-50',
          'text-red-600',
          'border',
          'border-red-200',
          'bg-green-50',
          'text-green-600',
          'border-green-200'
        );
      }

      function validate() {
        let valid = true;

        if (!phoneContainer.classList.contains('hidden')) {
          if (!/^[0-9]{10}$/.test(userIdentifier.value.trim())) {
            userIdentifierError.textContent =
              'Contact number must be exactly 10 digits';

            valid = false;
          }
        }

        if (password.value.length < 8) {
          passwordError.textContent = 'Password must be at least 8 characters';

          valid = false;
        }

        if (confirmPassword.value !== password.value) {
          confirmPasswordError.textContent = 'Passwords do not match';

          valid = false;
        }

        return valid;
      }

      resetForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        clearMessages();

        if (!validate()) {
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Resetting...';

        try {
          const body = {
            password: password.value,
            confirmPassword: confirmPassword.value,
          };

          if (!phoneContainer.classList.contains('hidden')) {
            body.userIdentifier = userIdentifier.value.trim();
          }

          const response = await fetch(`/auth/reset-password/${resetToken}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(body),
          });

          const data = await response.json();

          if (!response.ok) {
            apiMessage.classList.remove('hidden');

            apiMessage.classList.add(
              'bg-red-50',
              'text-red-600',
              'border',
              'border-red-200'
            );

            apiMessage.textContent = data.message || 'Password reset failed';

            return;
          }

          apiMessage.classList.remove('hidden');

          apiMessage.classList.add(
            'bg-green-50',
            'text-green-600',
            'border',
            'border-green-200'
          );

          apiMessage.textContent =
            data.message || 'Password reset successfully';

          setTimeout(() => {
            window.location.href = '/loginPage';
          }, 2000);
        } catch (error) {
          apiMessage.classList.remove('hidden');

          apiMessage.classList.add(
            'bg-red-50',
            'text-red-600',
            'border',
            'border-red-200'
          );

          apiMessage.textContent = 'Something went wrong. Please try again.';
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Reset Password';
        }
      });
    </script>
  </body>
</html>
