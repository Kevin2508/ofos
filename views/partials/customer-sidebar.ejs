      if (data.success) {
        const container = document.getElementById('aiChatMessages');
        if (container) {
          // Re-render Welcome Screen
          container.innerHTML = `
            <div id="aiWelcomeScreen" class="flex flex-col items-center text-center py-6 px-2 space-y-6">
