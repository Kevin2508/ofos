<%- include('../partials/header', { pageTitle: 'Verification Documents' ,
  pageSubtitle: 'Upload documents for restaurant verification' , activePage: 'documents' , user: user }) %>

  <div class="breadcrumb">
    <a href="/ro/restaurant-owner/dashboard">Dashboard</a>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
      stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6" />
    </svg>
    <span>Verification Documents</span>
  </div>

  <div class="page-header">
    <div class="title-group">
      <h2>Verification Documents</h2>
      <p>
        <%= restaurant.name %> &middot;
          <span
            class="badge <%= restaurant.verification_status === 'verified' ? 'badge-verified' : (restaurant.verification_status === 'pending' ? 'badge-pending' : 'badge-rejected') %>">
            <%= restaurant.verification_status %>
          </span>
      </p>
    </div>
  </div>

  <% if (typeof success !=='undefined' && success) { %>
    <div class="alert alert-success" data-autohide>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
        stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
        <polyline points="22 4 12 14.01 9 11.01" />
      </svg>
      <%= success %>
    </div>
    <% } %>
      <% if (typeof error !=='undefined' && error) { %>
        <div class="alert alert-error">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" />
            <line x1="15" y1="9" x2="9" y2="15" />
            <line x1="9" y1="9" x2="15" y2="15" />
          </svg>
          <%= error %>
        </div>
        <% } %>

          <% if (restaurant.verification_status==='pending' ) { %>
            <div class="alert alert-warning">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
              </svg>
              Your documents are under review. This usually takes 24-48 hours.
            </div>
            <% } else if (restaurant.verification_status==='rejected' ) { %>
              <div class="alert alert-error">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                  stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="15" y1="9" x2="9" y2="15" />
                  <line x1="9" y1="9" x2="15" y2="15" />
                </svg>
                One or more documents were rejected. Please review the remarks below and re-upload.
              </div>
              <% } %>

                <!-- Upload form -->
                <div class="card">
                  <div class="card-header">
                    <h3>Upload New Document</h3>
                  </div>
                  <div class="card-body">
                    <form action="/ro/restaurant-owner/restaurant/<%= restaurant.id %>/documents" method="POST"
                      enctype="multipart/form-data">
                      <div class="form-row">
                        <div class="form-group">
                          <label>Document Type <span class="req">*</span></label>
                          <select name="document_type" class="form-control" required>
                            <option value="">Select document type</option>
                            <option value="gstin">GSTIN Certificate</option>
                            <option value="fssai">FSSAI License</option>
                            <option value="bank_proof">Bank Account Proof</option>
                            <option value="pan">PAN Card</option>
                            <option value="other">Other</option>
                          </select>
                        </div>
                        <div class="form-group">
                          <label>Document Number</label>
                          <input type="text" name="document_number" class="form-control"
                            placeholder="e.g. GSTIN / License No.">
                        </div>
                      </div>

                      <div class="form-group">
                        <label>Upload File <span class="req">*</span></label>
                        <div class="upload-box">
                          <input type="file" name="document" accept=".pdf,.jpg,.jpeg,.png" required>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                            <polyline points="17 8 12 3 7 8" />
                            <line x1="12" y1="3" x2="12" y2="15" />
                          </svg>
                          <div class="upload-text">Click to upload document</div>
                          <div class="upload-sub">PDF, JPG, PNG up to 5MB</div>
                        </div>
                      </div>

                      <button type="submit" class="btn btn-primary">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                          stroke-linecap="round" stroke-linejoin="round">
                          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                          <polyline points="17 8 12 3 7 8" />
                          <line x1="12" y1="3" x2="12" y2="15" />
                        </svg>
                        Upload Document
                      </button>
                    </form>
                  </div>
                </div>

                <!-- Uploaded documents list -->
                <div class="section-title">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                    stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="9" y1="13" x2="15" y2="13" />
                    <line x1="9" y1="17" x2="15" y2="17" />
                  </svg>
                  Uploaded Documents
                </div>

                <% if (documents && documents.length> 0) { %>
                  <div class="card">
                    <div class="table-wrap">
                      <table class="data-table">
                        <thead>
                          <tr>
                            <th>Type</th>
                            <th>Document Number</th>
                            <th>Status</th>
                            <th>Uploaded On</th>
                            <th>File</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% documents.forEach(doc=> { %>
                            <tr>
                              <td
                                style="text-transform:uppercase; font-weight:700; font-size:12px; color:var(--neutral-600);">
                                <%= doc.document_type %>
                              </td>
                              <td>
                                <%= doc.document_number || '-' %>
                              </td>
                              <td>
                                <span
                                  class="badge <%= doc.status === 'verified' ? 'badge-verified' : (doc.status === 'pending' ? 'badge-pending' : 'badge-rejected') %>">
                                  <%= doc.status %>
                                </span>
                                <% if (doc.status==='rejected' && doc.remarks) { %>
                                  <div style="font-size:12px; color:var(--danger); margin-top:4px;">
                                    <%= doc.remarks %>
                                  </div>
                                  <% } %>
                              </td>
                              <td>
                                <%= new Date(doc.created_at).toLocaleDateString() %>
                              </td>
                              <td>
                                <a href="<%= doc.file_url %>" target="_blank" class="icon-btn-square" title="View File">
                                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                    <circle cx="12" cy="12" r="3" />
                                  </svg>
                                </a>
                              </td>
                            </tr>
                            <% }) %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                  <% } else { %>
                    <div class="card">
                      <div class="empty-state">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                          stroke-linecap="round" stroke-linejoin="round">
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                          <polyline points="14 2 14 8 20 8" />
                        </svg>
                        <h3>No Documents Uploaded</h3>
                        <p>Upload GSTIN, FSSAI license and bank proof to get your restaurant verified.</p>
                      </div>
                    </div>
                    <% } %>

                      <%- include('../partials/footer') %>