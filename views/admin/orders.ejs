<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Global Orders | Admin | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="min-h-screen bg-orange-50 font-sans text-gray-800">
  <div class="flex min-h-screen">
    <%- include('../partials/admin/sidebar') %>

    <!-- MAIN CONTENT -->
    <main class="flex-1 lg:ml-72 p-8 transition-all duration-300" id="mainContentWrapper">
      <div class="mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Global Orders</h2>
        <p class="text-gray-500 mt-2">View all platform orders globally.</p>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left whitespace-nowrap">
            <thead>
              <tr class="bg-slate-50 border-b border-gray-100 text-slate-500 text-sm uppercase tracking-wider">
                <th class="px-6 py-4 font-semibold">Order #</th>
                <th class="px-6 py-4 font-semibold">Customer</th>
                <th class="px-6 py-4 font-semibold">Restaurant</th>
                <th class="px-6 py-4 font-semibold">Total Amount</th>
                <th class="px-6 py-4 font-semibold">Status</th>
                <th class="px-6 py-4 font-semibold">Date</th>
              </tr>
            </thead>
            <tbody id="ordersList" class="divide-y divide-gray-50 text-gray-700">
              <tr>
                <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                  <div class="animate-pulse flex justify-center">Loading orders...</div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <!-- Order Details Modal -->
  <div id="orderModal" class="hidden fixed inset-0 bg-gray-900/40 backdrop-blur-sm z-[80] flex items-center justify-center p-4 transition-opacity duration-300 opacity-0">
    <div class="bg-white w-full max-w-2xl rounded-3xl shadow-xl transform transition-transform duration-300 scale-95 flex flex-col max-h-[90vh]">
      <!-- Header -->
      <div class="flex justify-between items-center p-6 border-b border-gray-100">
        <div>
          <h3 class="text-2xl font-bold text-gray-900 flex items-center gap-3">
            Order <span id="modalOrderNumber" class="text-orange-500"></span>
          </h3>
          <p id="modalDate" class="text-sm text-gray-500 mt-1"></p>
        </div>
        <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600 transition-colors p-2 hover:bg-gray-100 rounded-full">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>

      <!-- Content -->
      <div class="p-6 overflow-y-auto space-y-6">
        
        <!-- Status Row -->
        <div class="flex flex-wrap gap-4 bg-slate-50 p-4 rounded-2xl border border-gray-100">
          <div>
            <p class="text-xs text-gray-500 uppercase font-bold tracking-wide mb-1">Order Status</p>
            <span id="modalOrderStatus" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider"></span>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase font-bold tracking-wide mb-1">Payment Status</p>
            <span id="modalPaymentStatus" class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider"></span>
          </div>
        </div>

        <!-- Participants -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="border border-gray-100 rounded-2xl p-4">
            <h4 class="text-sm font-bold text-gray-900 mb-3 flex items-center gap-2">
              <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              Customer
            </h4>
            <p id="modalCustomerName" class="font-medium text-gray-800"></p>
            <p id="modalCustomerPhone" class="text-sm text-gray-500"></p>
          </div>
          <div class="border border-gray-100 rounded-2xl p-4">
            <h4 class="text-sm font-bold text-gray-900 mb-3 flex items-center gap-2">
              <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              Restaurant
            </h4>
            <p id="modalRestaurantName" class="font-medium text-gray-800"></p>
          </div>
        </div>

        <!-- Delivery Partner Info -->
        <div id="modalDeliveryContainer" class="border border-gray-100 bg-orange-50/50 rounded-2xl p-4 hidden">
          <h4 class="text-sm font-bold text-gray-900 mb-3 flex items-center gap-2">
            <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            Delivery Details
          </h4>
          <p class="text-sm text-gray-700"><strong>Delivered By (Partner ID):</strong> #<span id="modalDeliveryPartner"></span></p>
          <p class="text-sm text-gray-700"><strong>Assignment Status:</strong> <span id="modalAssignmentStatus"></span></p>
          <p class="text-sm text-gray-700 mt-1"><strong>Latest Event:</strong> <span id="modalLatestEvent" class="italic"></span></p>
        </div>

        <!-- Financial Breakdown -->
        <div>
          <h4 class="text-sm font-bold text-gray-900 mb-3 uppercase tracking-wide">Financial Breakdown</h4>
          <div class="bg-gray-50 rounded-2xl p-5 border border-gray-100 space-y-2">
            <div class="flex justify-between text-sm text-gray-600">
              <span>Subtotal</span>
              <span>₹<span id="modalSubtotal"></span></span>
            </div>
            <div class="flex justify-between text-sm text-gray-600">
              <span>Tax</span>
              <span>₹<span id="modalTax"></span></span>
            </div>
            <div class="flex justify-between text-sm text-gray-600">
              <span>Delivery Fee</span>
              <span>₹<span id="modalDeliveryFee"></span></span>
            </div>
            <div class="flex justify-between text-sm text-green-600">
              <span>Discount</span>
              <span>-₹<span id="modalDiscount"></span></span>
            </div>
            <div class="flex justify-between font-bold text-gray-900 pt-3 border-t border-gray-200 mt-2 text-lg">
              <span>Total</span>
              <span>₹<span id="modalTotal"></span></span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <script>
    let loadedOrders = [];

    async function loadOrders() {
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/admin/orders', {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        const list = document.getElementById('ordersList');
        if (res.ok) {
          const data = await res.json();
          loadedOrders = data.data?.orders || [];

          if (loadedOrders.length === 0) {
            list.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">No orders found.</td></tr>`;
          } else {
            list.innerHTML = loadedOrders.map(o => {
              // Status coloring
              let statusColor = 'bg-gray-100 text-gray-800';
              if (o.orderStatus === 'DELIVERED') statusColor = 'bg-green-100 text-green-800';
              if (o.orderStatus === 'CANCELLED' || o.orderStatus === 'REJECTED') statusColor = 'bg-red-100 text-red-800';
              if (o.orderStatus === 'PREPARING' || o.orderStatus === 'OUT_FOR_DELIVERY') statusColor = 'bg-blue-100 text-blue-800';

              return `
              <tr onclick="viewOrder('${o.id}')" class="hover:bg-slate-50 transition-colors cursor-pointer border-t border-gray-50">
                <td class="px-6 py-4 font-bold text-gray-900">${o.orderNumber || '#' + o.id}</td>
                <td class="px-6 py-4">
                  <div class="text-sm font-medium text-gray-900">${o.customer ? o.customer.firstName : 'N/A'}</div>
                  <div class="text-xs text-gray-500">${o.customer ? o.customer.phone : ''}</div>
                </td>
                <td class="px-6 py-4 text-sm text-gray-700">${o.restaurant ? o.restaurant.businessName : 'N/A'}</td>
                <td class="px-6 py-4 font-bold text-gray-900">₹${o.totalAmount || 0}</td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider ${statusColor}">
                    ${o.orderStatus || 'PENDING'}
                  </span>
                </td>
                <td class="px-6 py-4 text-sm text-gray-500">
                  ${new Date(o.createdAt).toLocaleString()}
                </td>
              </tr>
            `}).join('');
          }
        }
      } catch (err) {
        console.error(err);
      }
    }

    function viewOrder(id) {
      const o = loadedOrders.find(ord => ord.id === id);
      if (!o) return;

      // Header
      document.getElementById('modalOrderNumber').textContent = o.orderNumber || o.id;
      document.getElementById('modalDate').textContent = new Date(o.createdAt).toLocaleString();

      // Status
      const osEl = document.getElementById('modalOrderStatus');
      osEl.textContent = o.orderStatus || 'PENDING';
      osEl.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ' + 
        (o.orderStatus === 'DELIVERED' ? 'bg-green-100 text-green-800' :
        (o.orderStatus === 'CANCELLED' || o.orderStatus === 'REJECTED') ? 'bg-red-100 text-red-800' :
        (o.orderStatus === 'PREPARING' || o.orderStatus === 'OUT_FOR_DELIVERY') ? 'bg-blue-100 text-blue-800' :
        'bg-gray-100 text-gray-800');

      const psEl = document.getElementById('modalPaymentStatus');
      psEl.textContent = o.paymentStatus || 'PENDING';
      psEl.className = 'px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider ' + 
        (o.paymentStatus === 'PAID' ? 'bg-green-100 text-green-800' :
        o.paymentStatus === 'FAILED' ? 'bg-red-100 text-red-800' :
        'bg-yellow-100 text-yellow-800');

      // Participants
      document.getElementById('modalCustomerName').textContent = o.customer ? `${o.customer.firstName} ${o.customer.lastName || ''}` : 'N/A';
      document.getElementById('modalCustomerPhone').textContent = o.customer ? o.customer.phone : 'N/A';
      document.getElementById('modalRestaurantName').textContent = o.restaurant ? o.restaurant.businessName : 'N/A';

      // Financials
      document.getElementById('modalSubtotal').textContent = o.subtotalAmount || '0';
      document.getElementById('modalTax').textContent = o.taxAmount || '0';
      document.getElementById('modalDeliveryFee').textContent = o.deliveryFee || '0';
      document.getElementById('modalDiscount').textContent = o.discountAmount || '0';
      document.getElementById('modalTotal').textContent = o.totalAmount || '0';

      // Delivery Partner
      const deliveryContainer = document.getElementById('modalDeliveryContainer');
      if (o.deliveryAssignment || o.deliveryPartner) {
        deliveryContainer.classList.remove('hidden');
        document.getElementById('modalDeliveryPartner').textContent = o.deliveryPartner?.userId || o.deliveryAssignment?.partnerUserId || 'Unassigned';
        document.getElementById('modalAssignmentStatus').textContent = o.deliveryAssignment?.status || 'N/A';
        
        let eventText = 'No delivery events yet';
        if (o.latestEvent) {
           eventText = `${o.latestEvent.eventType.replace('_', ' ')} at ${new Date(o.latestEvent.createdAt).toLocaleTimeString()}`;
        }
        document.getElementById('modalLatestEvent').textContent = eventText;
      } else {
        deliveryContainer.classList.add('hidden');
      }

      // Show Modal
      const modal = document.getElementById('orderModal');
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modal.firstElementChild.classList.remove('scale-95');
      }, 10);
    }

    function closeModal() {
      const modal = document.getElementById('orderModal');
      modal.classList.add('opacity-0');
      modal.firstElementChild.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    loadOrders();

    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      try {
        const token = localStorage.getItem('token') || '';
        await fetch('/auth/logout', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
      } catch (e) { console.error(e); }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });
  </script>
</body>

</html>