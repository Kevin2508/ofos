<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Profile | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
  <style>
    /* Tabs */
    .tab-btn {
      transition: background .2s, color .2s;
    }

    .tab-btn.active {
      background: #f97316;
      color: #fff;
    }

    /* Sections */
    .profile-section {
      display: none;
    }

    .profile-section.active {
      display: block;
    }

    /* Address card */
    .addr-card {
      transition: box-shadow .2s, border-color .2s;
    }

    .addr-card:hover {
      box-shadow: 0 4px 20px rgba(249, 115, 22, .15);
      border-color: #fdba74;
    }

    /* Label badges */
    .badge-home {
      background: #fef3c7;
      color: #d97706;
    }

    .badge-work {
      background: #eff6ff;
      color: #2563eb;
    }

    .badge-other {
      background: #f0fdf4;
      color: #16a34a;
    }

    /* Inputs */
    .if {
      width: 100%;
      padding: .6rem 1rem;
      border: 1.5px solid #e5e7eb;
      border-radius: .75rem;
      outline: none;
      font-size: .95rem;
      background: #fff;
      transition: border-color .2s, box-shadow .2s;
    }

    .if:focus {
      border-color: #f97316;
      box-shadow: 0 0 0 3px rgba(249, 115, 22, .15);
    }

    /* Modal — hidden by default, toggled via JS */
    .modal-overlay {
      display: none;
      /* KEY FIX: hidden by default */
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, .5);
      z-index: 200;
      align-items: center;
      justify-content: center;
      padding: 1rem;
    }

    .modal-overlay.open {
      display: flex;
    }

    /* opened only when JS adds .open */

    .modal-box {
      background: #fff;
      border-radius: 1.25rem;
      padding: 2rem;
      width: 100%;
      max-width: 520px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 20px 60px rgba(0, 0, 0, .25);
      animation: slideUp .2s ease;
    }

    @keyframes slideUp {
      from {
        transform: translateY(20px);
        opacity: 0;
      }

      to {
        transform: translateY(0);
        opacity: 1;
      }
    }

    /* Spinner */
    .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid #fed7aa;
      border-top-color: #f97316;
      border-radius: 50%;
      animation: spin .8s linear infinite;
      margin: auto;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* Avatar */
    .profile-avatar {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #f97316;
    }

    .avatar-initial {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f97316, #fb923c);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
      font-weight: 800;
      border: 3px solid #fed7aa;
      flex-shrink: 0;
    }

    /* Radio label cards */
    .label-radio input {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
    }

    .label-radio span {
      display: block;
      text-align: center;
      padding: .5rem 1rem;
      border: 2px solid #e5e7eb;
      border-radius: .75rem;
      font-weight: 600;
      font-size: .875rem;
      cursor: pointer;
      transition: all .15s;
    }

    .label-radio input:checked+span {
      border-color: #f97316;
      background: #fff7ed;
      color: #ea580c;
    }

    .label-radio:hover span {
      border-color: #fdba74;
    }
  </style>
</head>

<body class="min-h-screen bg-orange-50">

  <div class="lg:ml-72 transition-all duration-300 flex flex-col min-h-screen">

    <!-- Top nav -->
    <nav class="bg-white border-b border-orange-100 shadow-sm sticky top-0 z-40">
      <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <button onclick="toggleSidebar()"
            class="p-2 -ml-2 text-gray-600 hover:text-orange-500 rounded-xl hover:bg-orange-50 transition-colors lg:hidden">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <a href="/" class="text-3xl font-extrabold text-orange-500 lg:hidden">epicure</a>
        </div>
        <a href="/" class="text-sm text-gray-500 hover:text-orange-500 transition-colors flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          Home
        </a>
      </div>
    </nav>

    <div class="max-w-4xl mx-auto px-4 py-8 w-full flex-1">
      <h1 class="text-3xl font-bold text-gray-800 mb-6">My Profile</h1>

      <!-- Loading -->
      <div id="profileLoading" class="py-24 text-center">
        <div class="spinner mb-4"></div>
        <p class="text-gray-500 font-medium">Loading your profile…</p>
      </div>

      <!-- Content (hidden until loaded) -->
      <div id="profileContent" class="hidden">

        <!-- Profile header -->
        <div
          class="bg-white rounded-2xl border border-orange-100 shadow-sm p-6 mb-6 flex flex-col sm:flex-row items-center sm:items-start gap-6">
          <div id="avatarContainer" class="flex-shrink-0"></div>
          <div class="flex-1 min-w-0 text-center sm:text-left">
            <h2 class="text-2xl font-bold text-gray-800 truncate" id="profileName">—</h2>
            <span
              class="inline-block mt-1 px-3 py-0.5 rounded-full text-xs font-bold bg-orange-50 text-orange-600 uppercase tracking-wider">Customer</span>

            <div class="mt-3 flex flex-col sm:flex-row gap-2 text-sm text-gray-600 flex-wrap">
              <span id="profileEmail" class="flex items-center gap-1.5 justify-center sm:justify-start">
                <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span>—</span>
              </span>
              <span id="profilePhone" class="flex items-center gap-1.5 justify-center sm:justify-start">
                <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>—</span>
              </span>
            </div>

            <div class="mt-2 flex flex-wrap gap-2 justify-center sm:justify-start" id="verificationBadges"></div>
            <p class="mt-2 text-xs text-gray-400" id="profileJoined"></p>
          </div>
        </div>

        <!-- Tabs -->
        <div class="flex gap-1.5 mb-6 bg-white rounded-xl p-1.5 border border-orange-100 shadow-sm w-fit flex-wrap">
          <button id="tab-personal"
            class="tab-btn flex items-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-sm text-gray-600 hover:bg-orange-50"
            onclick="switchTab('personal')">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            Personal Info
          </button>
          <button id="tab-addresses"
            class="tab-btn active flex items-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-sm"
            onclick="switchTab('addresses')">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Addresses
          </button>
          <button id="tab-roles"
            class="tab-btn flex items-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-sm text-gray-600 hover:bg-orange-50"
            onclick="switchTab('roles')">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            Roles & Access
          </button>
          <button id="tab-security"
            class="tab-btn flex items-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-sm text-gray-600 hover:bg-orange-50"
            onclick="switchTab('security')">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            Security
          </button>
          <button id="tab-payments"
            class="tab-btn flex items-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-sm text-gray-600 hover:bg-orange-50"
            onclick="switchTab('payments')">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
            Payment Methods
          </button>
          <button id="tab-loyalty"
            class="tab-btn flex items-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-sm text-gray-600 hover:bg-orange-50"
            onclick="switchTab('loyalty')">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Loyalty
          </button>
        </div>

        <!-- ── Personal Info Tab ── -->
        <div id="section-personal" class="profile-section">
          <div class="bg-white rounded-2xl border border-orange-100 shadow-sm p-6 mb-6 max-w-2xl">
            <h3 class="text-lg font-bold text-gray-700 mb-1">Personal Information</h3>
            <p class="text-sm text-gray-400 mb-6">Update your display name and contact details.</p>

            <form id="personalInfoForm" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-semibold text-gray-600 mb-1" for="pi_firstName">First Name</label>
                  <input type="text" id="pi_firstName" name="firstName"  minlength="2" maxlength="100" pattern="^[A-Za-z]+$" required class="if" />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-600 mb-1" for="pi_lastName">Last Name</label>
                  <input type="text" id="pi_lastName" name="lastName"  maxlength="100" pattern="^[A-Za-z]+$" class="if" />
                </div>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-semibold text-gray-600 mb-1" for="pi_email">Email</label>
                  <input type="email" id="pi_email" name="email"  pattern="^[^\s@]+@[^\s@]+\.(com|net|org|io)$" class="if" />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-600 mb-1" for="pi_phone">Phone</label>
                  <input type="tel" id="pi_phone" name="phone"  pattern="^[0-9]{10}$" minlength="10" maxlength="10" required class="if" />
                </div>
              </div>
              <div>
                 <label class="block text-sm font-semibold text-gray-600 mb-1" for="pi_profilePicture">Profile Picture</label>
                 <input type="file" id="pi_profilePicture" name="profilePicture" class="if" accept="image/*" />
              </div>
              <button type="submit" id="savePersonalInfoBtn"
                class="w-full sm:w-auto bg-orange-500 hover:bg-orange-600 text-white font-bold py-2.5 px-6 rounded-xl transition-colors shadow-sm">
                Save Changes
              </button>
            </form>
          </div>

          <div class="bg-white rounded-2xl border border-orange-100 shadow-sm p-6 max-w-2xl mt-6">
            <h3 class="text-lg font-bold text-gray-700 mb-1">Dietary Preferences</h3>
            <p class="text-sm text-gray-400 mb-6">Filter menus by default based on your preferences.</p>
            <form id="preferencesForm" class="space-y-4">
              <div class="flex flex-wrap gap-4">
                <label class="flex items-center gap-2 cursor-pointer select-none">
                  <input type="checkbox" id="pref_vegetarian" name="vegetarian" class="w-4 h-4 accent-orange-500 rounded" />
                  <span class="text-sm font-semibold text-gray-700">Vegetarian</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer select-none">
                  <input type="checkbox" id="pref_vegan" name="vegan" class="w-4 h-4 accent-orange-500 rounded" />
                  <span class="text-sm font-semibold text-gray-700">Vegan</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer select-none">
                  <input type="checkbox" id="pref_glutenFree" name="glutenFree" class="w-4 h-4 accent-orange-500 rounded" />
                  <span class="text-sm font-semibold text-gray-700">Gluten-Free</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer select-none">
                  <input type="checkbox" id="pref_halal" name="halal" class="w-4 h-4 accent-orange-500 rounded" />
                  <span class="text-sm font-semibold text-gray-700">Halal</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer select-none">
                  <input type="checkbox" id="pref_jain" name="jain" class="w-4 h-4 accent-orange-500 rounded" />
                  <span class="text-sm font-semibold text-gray-700">Jain</span>
                </label>
              </div>
              <button type="submit" id="savePrefsBtn"
                class="bg-orange-500 hover:bg-orange-600 text-white font-bold py-2.5 px-6 rounded-xl transition-colors shadow-sm">
                Save Preferences
              </button>
            </form>
          </div>
        </div>

        <!-- ── Addresses Tab ── -->
        <div id="section-addresses" class="profile-section active">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-gray-700">Saved Addresses</h3>
            <button id="addAddressBtn"
              class="flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors shadow-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Add New
            </button>
          </div>
          <div id="addressesList" class="space-y-4"></div>
        </div>

        <!-- ── Roles Tab ── -->
        <div id="section-roles" class="profile-section">
          <div class="bg-white rounded-2xl border border-orange-100 shadow-sm p-6 mb-6">
            <h3 class="text-lg font-bold text-gray-700 mb-4">Your Roles</h3>

            <div id="profileRolesList" class="space-y-3 mb-6">
              <!-- Roles will be injected here -->
            </div>

            <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-100">
              <a href="/role-selection"
                class="flex-1 text-center bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-3 rounded-xl transition-colors shadow-sm">
                Switch Dashboard Context
              </a>
              <a href="/registerPage"
                class="flex-1 text-center bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 rounded-xl transition-colors shadow-sm">
                Apply For Another Role
              </a>
            </div>
          </div>
        </div>

        <!-- ── Security Tab ── -->
        <div id="section-security" class="profile-section">
          <div class="bg-white rounded-2xl border border-orange-100 shadow-sm p-6 max-w-lg">
            <h3 class="text-lg font-bold text-gray-700 mb-1">Change Password</h3>
            <p class="text-sm text-gray-400 mb-6">Keep your account safe with a strong, unique password.</p>

            <form id="changePasswordForm" class="space-y-4" novalidate>
              <div>
                <label class="block text-sm font-semibold text-gray-600 mb-1" for="currentPassword">Current
                  Password</label>
                <div class="relative">
                  <input type="password" id="currentPassword" placeholder="Enter current password" class="if pr-10"
                    autocomplete="current-password" />
                  <button type="button"
                    class="pw-toggle absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
                    data-target="currentPassword" aria-label="Toggle visibility">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                  </button>
                </div>
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-600 mb-1" for="newPassword">New Password</label>
                <div class="relative">
                  <input type="password" id="newPassword" placeholder="At least 8 characters" class="if pr-10"
                    autocomplete="new-password" />
                  <button type="button"
                    class="pw-toggle absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
                    data-target="newPassword" aria-label="Toggle visibility">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                  </button>
                </div>
                <div id="pwStrengthBar" class="mt-2 h-1.5 rounded-full bg-gray-100 overflow-hidden hidden">
                  <div id="pwStrengthFill" class="h-full rounded-full transition-all duration-300 w-0"></div>
                </div>
                <p id="pwStrengthLabel" class="text-xs mt-1 hidden font-medium"></p>
              </div>

              <div>
                <label class="block text-sm font-semibold text-gray-600 mb-1" for="confirmPassword">Confirm New
                  Password</label>
                <div class="relative">
                  <input type="password" id="confirmPassword" placeholder="Repeat new password" class="if pr-10"
                    autocomplete="new-password" />
                  <button type="button"
                    class="pw-toggle absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600"
                    data-target="confirmPassword" aria-label="Toggle visibility">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                  </button>
                </div>
              </div>

              <div id="pwError"
                class="hidden bg-red-50 text-red-600 text-sm px-4 py-2.5 rounded-xl border border-red-200"></div>

              <button type="submit" id="changePwBtn"
                class="w-full bg-orange-500 hover:bg-orange-600 disabled:opacity-60 disabled:cursor-not-allowed text-white font-bold py-3 rounded-xl transition-colors shadow-sm">
                Update Password
              </button>
            </form>
          </div>

          <div class="bg-white rounded-2xl border border-orange-100 shadow-sm p-6 max-w-2xl mt-6">
            <h3 class="text-lg font-bold text-gray-700 mb-1">Active Sessions</h3>
            <p class="text-sm text-gray-400 mb-4">View and manage devices currently logged into your account.</p>
            <div id="sessionsList" class="space-y-3">
              <div class="text-sm text-gray-500">Loading sessions...</div>
            </div>
          </div>
        </div>

        <!-- ── Payments Tab ── -->
        <div id="section-payments" class="profile-section">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-gray-700">Payment Methods</h3>
            <button id="addPaymentBtn" onclick="openPaymentModal()"
              class="flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors shadow-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Add New
            </button>
