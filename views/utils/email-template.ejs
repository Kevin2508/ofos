<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Email Inbox Simulation | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="bg-gray-100 min-h-screen p-4 flex flex-col items-center">
  <div class="max-w-2xl w-full bg-white shadow-xl rounded-lg overflow-hidden border border-gray-200 mt-10">
    <div class="bg-gray-800 text-white px-4 py-3 flex items-center justify-between">
      <div class="font-semibold text-lg flex items-center gap-2">
        <span>✉️ Inbox Simulation</span>
      </div>
      <div class="text-sm opacity-70">Testing Environment</div>
    </div>

    <div class="p-6">
      <div class="border border-gray-200 rounded-lg p-5 bg-gray-50 mb-4">
        <div class="flex justify-between items-start mb-4 border-b border-gray-200 pb-3">
          <div>
            <h3 class="text-lg font-bold text-gray-800">Password Reset Request</h3>
            <p class="text-sm text-gray-500 mt-1">From: <span class="font-semibold text-gray-700">support@epicure
                .com</span></p>
            <p class="text-sm text-gray-500">To: <span class="font-semibold text-gray-700"
                id="userEmail">user@example.com</span></p>
          </div>
          <span class="text-xs text-gray-400" id="mailTime">Just now</span>
        </div>

        <div class="bg-white p-6 border border-gray-200 rounded-lg shadow-sm">
          <div class="text-center mb-6">
            <h1 class="text-3xl font-extrabold text-orange-500 mb-2">epicure</h1>
            <p class="text-gray-600">Password Reset Instructions</p>
          </div>

          <p class="text-gray-700 mb-4">Hello,</p>
          <p class="text-gray-700 mb-6">We received a request to reset your password. Click the button below to set a
            new password. This link will expire in 15 minutes.</p>

          <div class="text-center mb-6">
            <a href="#" id="resetLinkBtn"
              class="inline-block bg-orange-500 hover:bg-orange-600 text-white font-semibold py-3 px-6 rounded-lg transition-colors duration-200">
              Reset Password
            </a>
          </div>

          <p class="text-sm text-gray-500 mb-2">Or copy and paste this link into your browser:</p>
          <div class="bg-gray-100 p-3 rounded text-sm text-blue-600 break-all mb-6">
            <a href="#" id="resetLinkText">http://localhost:5050/resetPasswordPage?resetToken=...</a>
          </div>

          <p class="text-sm text-gray-500">If you did not request a password reset, you can safely ignore this email.
          </p>

          <div class="mt-8 pt-4 border-t border-gray-100 text-center text-xs text-gray-400">
            &copy; 2026 epicureInc. All rights reserved.
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Extract parameters from URL to populate the simulation
    const urlParams = new URLSearchParams(window.location.search);
    const token = urlParams.get('token');
    const email = urlParams.get('email');

    if (email) {
      document.getElementById('userEmail').textContent = email;
    }

    if (token) {
      const resetUrl = `${window.location.origin}/resetPasswordPage?resetToken=${token}`;
      document.getElementById('resetLinkBtn').href = resetUrl;

      const linkText = document.getElementById('resetLinkText');
      linkText.href = resetUrl;
      linkText.textContent = resetUrl;
    }

    // Set current time
    const now = new Date();
    document.getElementById('mailTime').textContent = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  </script>
</body>

</html>