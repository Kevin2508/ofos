<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restaurant</title>

    <link rel="stylesheet" href="/styles/build.css">

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet/dist/leaflet.css"
    />

    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
</head>

<body class="bg-orange-50 min-h-screen">

    <!-- Navbar -->

    <nav class="bg-white shadow-sm border-b">
        <div class="max-w-6xl mx-auto px-4 py-4">

            <a
                href="/"
                class="text-orange-500 font-bold text-xl"
            >
                ← Back
            </a>

        </div>
    </nav>
    <div class="max-w-6xl mx-auto p-6">

        <!-- Restaurant Info -->

        <div class="bg-white rounded-2xl shadow p-6 mb-6">

            <h1
                id="restaurantName"
                class="text-3xl font-bold text-gray-800"
            >
                Loading...
            </h1>

            <p
                id="restaurantCuisine"
                class="text-gray-500 mt-2"
            >
            </p>

            <p
                id="restaurantAddress"
                class="text-gray-500 mt-2"
            >
            </p>

        </div>

        <!-- Delivery Status / Info -->

        <div
            id="deliveryStatus"
            class="bg-white rounded-2xl shadow p-5 mb-6"
        >
            Checking delivery availability...
        </div>

        <!-- Map -->

        <div class="bg-white rounded-2xl shadow p-6 mb-6">

            <h2 class="text-xl font-bold mb-4">
                Location & Delivery Area                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
            </h2>

            <div
                id="map"
                class="rounded-xl overflow-hidden shadow-inner border border-gray-100"
                style="height:400px;"
            ></div>

        </div>

        <!-- Menu -->

        <div class="bg-white rounded-2xl shadow p-6">

            <h2 class="text-2xl font-bold mb-6 text-gray-800">
                Menu
            </h2>

            <div
                id="menuContainer"
                class="flex flex-col gap-6"
            >

            </div>

        </div>

    </div>

<script>

const restaurantId =
window.location.pathname.split('/').pop();

let restaurantData;

let map;

async function loadRestaurant()
{
    try
    {
        const response =
        await fetch(
            `/restaurant/${restaurantId}`,
            { headers: { 'Accept': 'application/json' } }
        );

        const result =
        await response.json();

        console.log("Restaurant Details:", result);

        restaurantData =
        result.data;

        document.getElementById(
            'restaurantName'
        ).innerText =
        restaurantData.businessName;

        if (restaurantData.description) {
            document.getElementById(
                'restaurantCuisine'
            ).innerText =
            restaurantData.description;
        }

        const branch = restaurantData.branches && restaurantData.branches[0];
        if (branch) {
            const address = `${branch.addressLine1}${branch.addressLine2 ? ', ' + branch.addressLine2 : ''}, ${branch.city}, ${branch.state} - ${branch.postalCode}`;
            document.getElementById(
                'restaurantAddress'
            ).innerText = address;

            // Load delivery/min order stats
            const deliveryStatusDiv = document.getElementById('deliveryStatus');
            deliveryStatusDiv.innerHTML = `
                <div class="flex justify-around text-center text-sm md:text-base">
                    <div>
                        <p class="text-gray-400 font-medium">Min. Order</p>
                        <p class="font-bold text-gray-800 mt-1">₹${branch.minimumOrderValue || '0'}</p>
                    </div>
                    <div class="border-r border-gray-200"></div>
                    <div>
                        <p class="text-gray-400 font-medium">Delivery Fee</p>
                        <p class="font-bold text-gray-800 mt-1">₹${branch.deliveryFee || '0'}</p>
                    </div>
                    <div class="border-r border-gray-200"></div>
                    <div>
                        <p class="text-gray-400 font-medium">Rating</p>
                        <p class="font-bold text-orange-500 mt-1">⭐ ${restaurantData.averageRating || 'N/A'}</p>
                    </div>
                </div>
            `;
        }

    }
    catch(error)
    {
        console.log("Error loading restaurant details:", error);
    }
}

async function loadMenu()
{
    try
    {
        const response =
        await fetch(
            `/restaurant/${restaurantId}/menu`,
            { headers: { 'Accept': 'application/json' } }
        );

        const result =
        await response.json();

        console.log("Restaurant Menu:", result);

        const menuContainer =
        document.getElementById(
            'menuContainer'
        );

        menuContainer.innerHTML = '';

        if (result.data && result.data.categories && result.data.categories.length > 0) {
            result.data.categories.forEach(category => {
                if (category.items && category.items.length > 0) {
                    // Category Header
                    const categoryWrapper = document.createElement('div');
                    categoryWrapper.className = "mt-6 first:mt-0";
                    
                    const categoryHeader = document.createElement('div');
                    categoryHeader.className = "mb-4 border-b pb-2 flex items-center justify-between";
                    categoryHeader.innerHTML = `
                        <h3 class="text-xl font-bold text-gray-850">
                            ${category.name}
                        </h3>
                        <span class="text-xs bg-orange-50 text-orange-600 px-2 py-1 rounded-full font-semibold border border-orange-100">${category.items.length} Items</span>
                    `;
                    categoryWrapper.appendChild(categoryHeader);
                    if (category.description) {
                        const catDesc = document.createElement('p');
                        catDesc.className = "text-gray-450 text-sm mb-4 italic";
                        catDesc.innerText = category.description;
                        categoryWrapper.appendChild(catDesc);
                    }

                    // Category Items Container (List style with dividers)
                    const itemsList = document.createElement('div');
                    itemsList.className = "divide-y divide-gray-100 w-full bg-white px-4 border border-gray-100 rounded-2xl";
                    categoryWrapper.appendChild(itemsList);

                    // Category Items
                    category.items.forEach(item => {
                        const itemRow = document.createElement('div');
                        itemRow.className = "py-5 flex flex-col items-start text-left w-full";

                        const isVeg = item.foodType === 'VEG' || item.foodType === 'VEGAN';
                        const badgeColor = isVeg ? 'border-green-600' : 'border-red-600';
                        const dotColor = isVeg ? 'bg-green-600' : 'bg-red-600';

                        itemRow.innerHTML = `
                            <div class="flex items-center gap-2 mb-1">
                                <span class="inline-flex items-center justify-center border ${badgeColor} p-0.5 rounded w-3.5 h-3.5 flex-shrink-0">
                                    <span class="w-1.5 h-1.5 rounded-full ${dotColor}"></span>
                                </span>
                                ${item.isBestseller ? '<span class="bg-amber-100 text-amber-800 text-[9px] font-bold px-1.5 py-0.5 rounded-full">BESTSELLER</span>' : ''}
                            </div>
                            <h4 class="font-bold text-lg text-gray-800">${item.name}</h4>
                            <p class="text-orange-500 font-bold text-base mt-0.5">₹${item.basePrice}</p>
                            ${item.description ? `<p class="text-gray-500 text-sm mt-1.5 max-w-3xl leading-relaxed">${item.description}</p>` : ''}
                        `;
                        itemsList.appendChild(itemRow);
                    });

                    menuContainer.appendChild(categoryWrapper);
                }
            });
        } else {
            menuContainer.innerHTML = `
                <div class="py-8 text-center text-gray-400">
                    <p class="text-lg font-medium">No menu items found</p>
                    <p class="text-sm">This restaurant hasn't set up their menu categories yet.</p>
                </div>
            `;
        }

    }
    catch(error)
    {
        console.log("Error loading menu:", error);
        document.getElementById('menuContainer').innerHTML = `
            <div class="py-8 text-center text-red-500">
                <p>Failed to load menu items. Please try refreshing.</p>
            </div>
        `;
    }
}

function initializeMap()
{
    const branch = restaurantData && restaurantData.branches && restaurantData.branches[0];
    const lat = branch ? parseFloat(branch.latitude) : 22.3039;
    const lng = branch ? parseFloat(branch.longitude) : 70.8022;

    map = L.map('map')
    .setView(
        [lat, lng],
        15
    );

    L.tileLayer(
        'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
        {
            attribution:
            'OpenStreetMap'
        }
    ).addTo(map);

    const marker = L.marker([lat, lng]).addTo(map);
    
    if (restaurantData) {
        marker.bindPopup(`
            <div class="p-1">
                <h4 class="font-bold text-gray-800">${restaurantData.businessName}</h4>
                ${branch ? `<p class="text-gray-500 text-xs">${branch.addressLine1}</p>` : ''}
            </div>
        `).openPopup();
    }
}

async function init()
{
    await loadRestaurant();

    await loadMenu();

    initializeMap();
}

init();

</script>

</body>
</html>