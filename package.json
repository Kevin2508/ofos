{
  "name": "ofos",
  "version": "1.0.0",
  "description": "OFOS — Enterprise Multi-Tenant Food Ordering & Delivery Platform",
  "private": true,
  "scripts": {
    "start": "docker compose up -d",
    "stop": "docker compose down",
    "backend:dev": "npm --prefix backend run start:dev",
    "backend:build": "npm --prefix backend run build",
    "backend:start": "npm --prefix backend run start:prod",
    "backend:prisma:migrate": "npm --prefix backend run prisma:migrate",
    "backend:prisma:generate": "npm --prefix backend run prisma:generate",
    "backend:seed": "npm --prefix backend run seed",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "test:e2e": "node scratch/test_master_e2e.cjs"
  },
  "keywords": [
    "food-ordering",
    "nestjs",
    "react",
    "postgresql",
    "prisma",
    "docker",
    "enterprise"
  ],
  "license": "MIT"
}
