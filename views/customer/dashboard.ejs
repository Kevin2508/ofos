<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard | ofos</title>
    <link rel="stylesheet" href="/styles/build.css" />
  </head>

  <body class="min-h-screen bg-orange-50">
    <!-- NAVBAR -->
    <nav class="bg-white border-b border-orange-100 shadow-sm">
      <div
        class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between"
      >
        <!-- Logo -->
        <h1 class="text-3xl font-extrabold text-orange-500">ofos</h1>

        <!-- Search -->
        <div class="flex-1 mx-6">
          <input
            id="searchInput"
            type="text"
            placeholder="Search restaurants or dishes..."
            class="w-full px-4 py-2 rounded-xl border border-gray-300 focus:outline-none focus:ring-2 focus:ring-orange-500"
          />
        </div>

        <!-- Auth Section -->
        <div id="authSection" class="flex items-center gap-3">
          <!-- Guest Buttons -->
          <a
            href="/loginPage"
            class="text-sm font-semibold text-orange-500 hover:text-orange-600"
            id="loginBtn"
          >
            Login
          </a>

          <a
            href="/registerPage"
            class="text-sm font-semibold bg-orange-500 text-white px-4 py-2 rounded-xl hover:bg-orange-600"
            id="registerBtn"
          >
            Register
          </a>
        </div>
      </div>
    </nav>

    <!-- MAIN -->
    <div class="max-w-6xl mx-auto px-4 py-8">
      <!-- Greeting -->
      <div class="mb-6">
        <h2 class="text-2xl font-bold text-gray-800">Welcome 👋</h2>

        <p class="text-gray-600">
          Browse restaurants, explore menus and order food easily
        </p>
      </div>

      <!-- CATEGORY FILTERS -->
      <div class="flex gap-3 flex-wrap mb-6">
        <button class="px-4 py-2 bg-orange-500 text-white rounded-xl text-sm">
          All
        </button>

        <button class="px-4 py-2 bg-white border rounded-xl text-sm">
          Pizza
        </button>

        <button class="px-4 py-2 bg-white border rounded-xl text-sm">
          Burger
        </button>

        <button class="px-4 py-2 bg-white border rounded-xl text-sm">
          Indian
        </button>

        <button class="px-4 py-2 bg-white border rounded-xl text-sm">
          Chinese
        </button>
      </div>

      <!-- RESTAURANT GRID -->
      <div
        id="restaurantGrid"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
      >
        <!-- Example Card -->
        <div
          class="bg-white rounded-2xl shadow-md border border-orange-100 overflow-hidden"
        >
          <div class="h-40 bg-orange-100"></div>

          <div class="p-4">
            <h3 class="text-lg font-bold text-gray-800">Spice Hub</h3>

            <p class="text-gray-600 text-sm">Indian • Chinese • Fast Food</p>

            <div class="mt-3 flex justify-between items-center">
              <span class="text-sm text-gray-500">⭐ 4.5</span>

              <button
                onclick="viewMenu(1)"
                class="text-sm bg-orange-500 text-white px-3 py-1 rounded-lg hover:bg-orange-600"
              >
                View Menu
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- MENU MODAL -->
    <div
      id="menuModal"
      class="hidden fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center p-4"
    >
      <div class="bg-white w-full max-w-lg rounded-2xl p-6">
        <div class="flex justify-between items-center mb-4">
          <h3 class="text-xl font-bold">Menu</h3>

          <button onclick="closeMenu()" class="text-gray-500">✕</button>
        </div>

        <div id="menuList" class="space-y-3">
          <!-- Example item -->
          <div class="flex justify-between border-b pb-2">
            <span>Paneer Butter Masala</span>
            <span class="text-orange-500 font-semibold">₹250</span>
          </div>
        </div>
      </div>
    </div>

    <script>
      /* ---------------------------
      AUTH CHECK (Frontend only)
      ---------------------------- */

      function checkAuth() {
        const token = localStorage.getItem('token');

        if (token) {
          document.getElementById('loginBtn').style.display = 'none';
          document.getElementById('registerBtn').style.display = 'none';

          const authSection = document.getElementById('authSection');

          const profile = document.createElement('div');
          profile.className = 'text-sm font-semibold text-gray-700';
          profile.innerText = 'My Account';

          authSection.appendChild(profile);
        }
      }

      checkAuth();

      /* ---------------------------
      SEARCH RESTAURANT
      ---------------------------- */

      document
        .getElementById('searchInput')
        .addEventListener('input', async (e) => {
          const query = e.target.value.trim();

          if (query.length < 2) return;

          try {
            const res = await fetch(`/restaurants?search=${query}`);
            const data = await res.json();

            renderRestaurants(data);
          } catch (err) {
            showToast('Search failed. Please try again.', 'error');
          }
        });

     
      async function fetchRestaurants() {
        try {
          const res = await fetch(`/restaurant/`);
          const { data } = await res.json();

          renderRestaurants(data.data);
        } catch (err) {
          showToast('Failed to load restaurants', 'error');
        }
      }
       fetchRestaurants();

      function renderRestaurants(restaurants) {
        const grid = document.getElementById('restaurantGrid');

        grid.innerHTML = '';

        restaurants.forEach((r) => {
          const card = document.createElement('div');

          card.className =
            'bg-white rounded-2xl shadow-md border border-orange-100 overflow-hidden';

          card.innerHTML = `
            <div class="h-40 bg-orange-100">
                <img src="${r.coverImageUrl}" />
            </div>

            <div class="p-4">
              <h3 class="text-lg font-bold text-gray-800">${r.businessName}</h3>

              <p class="text-gray-600 text-sm">${r.cuisine}</p>

              <div class="mt-3 flex justify-between items-center">
                <span class="text-sm text-gray-500">⭐ ${r.averageRating}</span>

                <button
                  onclick="viewMenu('${r.id}')"
                  class="text-sm bg-orange-500 text-white px-3 py-1 rounded-lg hover:bg-orange-600"
                >
                  View Menu
                </button>
              </div>
            </div>
          `;

          grid.appendChild(card);
        });
      }

      /* ---------------------------
      MENU HANDLING
      ---------------------------- */

      async function viewMenu(restaurantId) {
        try {
          const res = await fetch(`/restaurants/${restaurantId}/menu`);
          const data = await res.json();

          const menuList = document.getElementById('menuList');
          menuList.innerHTML = '';

          data.menu.forEach((item) => {
            const div = document.createElement('div');
            div.className = 'flex justify-between border-b pb-2';

            div.innerHTML = `
              <span>${item.name}</span>
              <span class="text-orange-500 font-semibold">₹${item.price}</span>
            `;

            menuList.appendChild(div);
          });

          document.getElementById('menuModal').classList.remove('hidden');
        } catch (err) {
          showToast('Failed to load menu', 'error');
        }
      }

      function closeMenu() {
        document.getElementById('menuModal').classList.add('hidden');
      }
    </script>
    <%- include('../partials/toast') %>
  </body>
</html>
