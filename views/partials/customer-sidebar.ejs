<script>
  let isChatOpen = false;

  function toggleAIChat() {
    try {
      const windowEl = document.getElementById('aiChatWindow');
      const buttonEl = document.getElementById('aiChatButton');
      if (!windowEl || !buttonEl) return;

      if (!isChatOpen) {
        // Open
        windowEl.classList.remove('hidden');
        windowEl.classList.add('flex');
        setTimeout(() => {
          windowEl.classList.remove('translate-y-6', 'opacity-0');
          windowEl.classList.add('translate-y-0', 'opacity-100');
        }, 10);
        isChatOpen = true;
        const inputEl = document.getElementById('aiChatInput');
        if (inputEl) inputEl.focus();
        scrollAIChatToBottom();
      } else {
        // Close
        windowEl.classList.remove('translate-y-0', 'opacity-100');
        windowEl.classList.add('translate-y-6', 'opacity-0');
        setTimeout(() => {
          windowEl.classList.add('hidden');
          windowEl.classList.remove('flex');
        }, 300);
        isChatOpen = false;
      }
    } catch (e) {
      console.error('Error toggling AI chat:', e);
    }
  }

  function scrollAIChatToBottom() {
    try {
      const container = document.getElementById('aiChatMessages');
      if (container) {
        container.scrollTop = container.scrollHeight;
      }
    } catch (e) {
      console.error(e);
    }
  }

  function copyToClipboard(btn) {
    try {
      const parentNode = btn.closest('.flex-col');
      if (!parentNode) return;
      const messageDiv = parentNode.querySelector('.bg-white');
      if (!messageDiv) return;
      
      const rawText = messageDiv.innerText;
      navigator.clipboard.writeText(rawText);
      if (typeof showToast === 'function') showToast('Copied to clipboard', 'success');
      else alert('Copied to clipboard');
    } catch (e) {
      console.error(e);
    }
  }

  async function addToCartFromChat(menuItemId, branchId, btn) {
    if (!branchId || branchId === 'undefined' || branchId === 'null') {
      if (typeof showToast === 'function') showToast('Restaurant branch is unavailable', 'error');
      else alert('Restaurant branch is unavailable');
      return;
    }

    const originalText = btn.innerHTML;
    btn.innerHTML = '...';
    btn.disabled = true;

    try {
      const res = await fetch('/cart/items', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          menuItemId: Number(menuItemId),
          restaurantBranchId: Number(branchId),
          quantity: 1
        })
      });

      const data = await res.json();
      if (!res.ok) {
        if (data.message === 'DIFFERENT_RESTAURANT_CART_EXISTS') {
          if (confirm('Your cart contains items from a different restaurant. Would you like to clear the cart and add this item instead?')) {
            btn.innerHTML = '...';
            await fetch('/cart', { method: 'DELETE', headers: { 'Content-Type': 'application/json' } });
            const retryRes = await fetch('/cart/items', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                menuItemId: Number(menuItemId),
                restaurantBranchId: Number(branchId),
                quantity: 1
              })
            });
            if (!retryRes.ok) throw new Error('Failed to add item after clearing cart');
            
            if (typeof loadCart === 'function') loadCart();
            if (typeof showToast === 'function') showToast('Cart cleared and item added', 'success');
            else alert('Cart cleared and item added');
            return;
          }
          return;
        }
        throw new Error(data.message || 'Failed to add item');
      }

      if (typeof loadCart === 'function') loadCart();
      if (typeof showToast === 'function') showToast('Item added to cart', 'success');
      else alert('Item added to cart');
    } catch (err) {
      console.error(err);
      if (typeof showToast === 'function') showToast(err.message, 'error');
      else alert(err.message);
    } finally {
      btn.innerHTML = originalText;
      btn.disabled = false;
    }
  }

  function formatAIResponse(text) {
    if (!text) return '';
    try {
      let formatted = text;

      // Parse <restaurants>[...]</restaurants>
      formatted = formatted.replace(/<restaurants>([\s\S]*?)<\/restaurants>/g, (match, jsonStr) => {
        try {
          const list = JSON.parse(jsonStr.trim());
          if (!Array.isArray(list) || list.length === 0) return '';
          
          let cardsHtml = '<div class="grid grid-cols-1 gap-3.5 mt-2 mb-2 w-full">';
          list.forEach(res => {
            const rating = res.rating ? Number(res.rating).toFixed(1) : 'New';
            const coupons = Array.isArray(res.coupons) && res.coupons.length > 0 
              ? res.coupons.map(c => `<span class="bg-red-50 text-red-600 text-[10px] px-1.5 py-0.5 rounded font-black border border-red-100">${c}</span>`).join(' ')
              : '';
            
            const defaultImg = 'https://placehold.co/600x400?text=Restaurant';
            
            cardsHtml += `
              <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 flex flex-col w-full relative group">
                <div class="h-28 bg-gray-100 relative overflow-hidden flex-shrink-0">
                  <img src="${defaultImg}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                  <!-- Rating Badge -->
                  <div class="absolute bottom-2 right-2 bg-white/95 backdrop-blur-sm px-2 py-0.5 rounded-lg text-[10px] font-black shadow-md flex items-center gap-0.5 text-gray-800">
                    <span class="text-orange-500">★</span> ${rating}
                  </div>
                </div>
                
                <div class="p-3.5 flex flex-col gap-1.5 flex-grow">
                  <h4 class="font-black text-gray-900 text-sm leading-tight line-clamp-1">${res.name || 'Restaurant'}</h4>
                  <p class="text-[11px] text-gray-500 font-semibold line-clamp-2 leading-relaxed h-8 mb-1">${res.description || 'Delicious gourmet food items'}</p>
                  
                  ${coupons ? `<div class="flex flex-wrap gap-1 mb-2">${coupons}</div>` : ''}
                  
                  <!-- Meta info line -->
                  <div class="flex items-center justify-between text-[10px] font-bold text-gray-400 border-t border-gray-50 pt-2.5 mt-auto">
                    <span class="flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>30-40m</span>
                    <span class="flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>₹250/2</span>
                  </div>

                  <!-- Actions line -->
                  <div class="grid grid-cols-2 gap-1.5 mt-2 pt-2 border-t border-gray-100">
                    <a href="/c/restaurants/${res.id}" class="bg-gray-100 hover:bg-gray-200 text-gray-800 text-[10px] font-bold py-1.5 rounded-lg flex items-center justify-center transition-colors">Menu</a>
                    <a href="/c/restaurants/${res.id}" class="bg-orange-500 hover:bg-orange-600 text-white text-[10px] font-bold py-1.5 rounded-lg flex items-center justify-center transition-all shadow-sm">Order</a>
                  </div>
                </div>
              </div>
            `;
          });
          cardsHtml += '</div>';
          return cardsHtml;
        } catch (err) {
          console.error('Failed to parse restaurant JSON in chat response:', err);
          return '';
        }
      });

      // Parse <menu_items>[...]</menu_items>
      formatted = formatted.replace(/<menu_items>([\s\S]*?)<\/menu_items>/g, (match, jsonStr) => {
        try {
          const list = JSON.parse(jsonStr.trim());
          if (!Array.isArray(list) || list.length === 0) return '';
          
          let cardsHtml = '<div class="grid grid-cols-1 gap-3.5 mt-2 mb-2 w-full">';
          list.forEach(item => {
            let badge = '';
            if (item.foodType === 'VEG') {
              badge = `<span class="border border-green-500 p-0.5 rounded flex items-center justify-center w-4 h-4 bg-white flex-shrink-0" title="Veg">
                         <circle cx="8" cy="8" r="3.5" fill="#22c55e" class="w-2 h-2 rounded-full bg-green-500 inline-block"></circle>
                       </span>`;
            } else if (item.foodType === 'NON_VEG') {
              badge = `<span class="border border-red-500 p-0.5 rounded flex items-center justify-center w-4 h-4 bg-white flex-shrink-0" title="Non-Veg">
                         <polygon points="8,3 13,11 3,11" fill="#ef4444" class="w-0 h-0 border-l-[4px] border-l-transparent border-r-[4px] border-r-transparent border-b-[8px] border-b-red-500 inline-block"></polygon>
                       </span>`;
            } else if (item.foodType === 'VEGAN') {
              badge = `<span class="border border-emerald-500 p-0.5 rounded flex items-center justify-center w-4 h-4 bg-white flex-shrink-0" title="Vegan">
                         <circle cx="8" cy="8" r="3.5" fill="#10b981" class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></circle>
                       </span>`;
            }

            const restName = item.restaurantName || item.restaurant || 'Restaurant';
            const branchId = item.restaurantBranchId || item.branchId;
            const defaultFoodImg = 'https://placehold.co/400x300?text=Food';

            cardsHtml += `
              <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 flex flex-col w-full relative group">
                <div class="h-28 bg-gray-100 relative overflow-hidden flex-shrink-0">
                  <img src="${defaultFoodImg}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
                  <!-- Veg/Non-veg badge floating -->
                  <div class="absolute top-2 right-2 z-10">
                    ${badge}
                  </div>
                </div>
                
                <div class="p-3.5 flex flex-col gap-1.5 flex-grow">
                  <div>
                    <h4 class="font-extrabold text-gray-900 text-xs line-clamp-1 leading-tight">${item.name}</h4>
                    <span class="text-[9px] text-gray-400 font-semibold block truncate mt-0.5">from ${restName}</span>
                  </div>
                  <p class="text-[10px] text-gray-500 leading-relaxed line-clamp-2 h-7 mt-0.5">${item.description || item.desc || 'Delectable dish cooked to perfection'}</p>
                  
                  <div class="flex items-center justify-between mt-auto pt-2.5 border-t border-gray-50">
                    <span class="text-xs font-black text-orange-500">₹${item.price}</span>
                    <button onclick="addToCartFromChat('${item.id}', '${branchId}', this)" class="bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white text-[9px] font-black px-2.5 py-1.5 rounded-lg shadow-sm flex items-center gap-1 transition-all">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
                      Add
                    </button>
                  </div>
                </div>
              </div>
            `;
          });
          cardsHtml += '</div>';
          return cardsHtml;
        } catch (err) {
          console.error('Failed to parse menu items JSON in chat response:', err);
          return '';
        }
      });

      // Convert bulleted lists (* item or - item)
      formatted = formatted.replace(/^\s*[\*\-]\s+(.+)$/gm, '<li class="ml-5 list-disc my-1">$1</li>');
      // Wrap lists in ul (using [\s\S] for cross-browser newline matching)
      formatted = formatted.replace(/(<li class="ml-5 list-disc my-1">[\s\S]+<\/li>)/, '<ul class="my-2">$1</ul>');

      // Convert bold (**text**)
      formatted = formatted.replace(/\*\*(.*?)\*\*/g, '<strong class="font-extrabold text-gray-900">$1</strong>');
      
      // Convert newlines to HTML breaks
      formatted = formatted.replace(/\n/g, '<br>');

      return formatted;
    } catch (e) {
      console.error('Error formatting AI response:', e);
      return text;
    }
  }

  function appendAIMessage(role, content) {
    try {
      const container = document.getElementById('aiChatMessages');
      if (!container) return;
      
      // Hide welcome screen on first user query
      const welcomeScreen = document.getElementById('aiWelcomeScreen');
      if (welcomeScreen) {
        welcomeScreen.remove();
      }
      
      // Show chips once we start talking
      const quickChips = document.getElementById('aiQuickChips');
      if (quickChips) {
        quickChips.classList.remove('hidden');
      }

      const messageDiv = document.createElement('div');
      messageDiv.className = 'flex gap-2.5 items-start w-full animate-fade-in duration-200';

      if (role === 'user') {
        messageDiv.classList.add('justify-end');
        messageDiv.innerHTML = `
          <div class="flex justify-end items-end gap-1.5 group max-w-[85%]">
            <div class="relative bg-gradient-to-br from-orange-500 to-amber-500 text-white rounded-2xl rounded-tr-none px-4 py-3 shadow-md text-sm leading-relaxed break-words font-medium">
              ${content}
            </div>
          </div>
        `;
      } else {
        messageDiv.innerHTML = `
          <div class="flex justify-start items-start gap-2.5 max-w-[95%] w-full">
            <!-- AI Avatar -->
            <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-orange-500 to-amber-500 flex items-center justify-center text-white flex-shrink-0 shadow-sm shadow-orange-500/10">
              <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <!-- Message Container -->
            <div class="flex flex-col gap-1 max-w-[85%] w-full">
              <div class="bg-white text-gray-800 rounded-2xl rounded-tl-none px-4 py-3 border border-gray-150 shadow-sm leading-relaxed break-words text-sm font-medium w-full">
                ${formatAIResponse(content)}
              </div>
              <!-- Hover action buttons (Copy) -->
              <div class="flex items-center gap-1.5 opacity-0 hover:opacity-100 transition-opacity pl-1">
                <button onclick="copyToClipboard(this)" class="p-1 hover:bg-gray-200/50 rounded text-gray-400 hover:text-gray-600 transition-colors" title="Copy response">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m-5 4h5m-5 4h3m-3 4h5"/></svg>
                </button>
              </div>
            </div>
          </div>
        `;
      }

      container.appendChild(messageDiv);
      scrollAIChatToBottom();
    } catch (e) {
      console.error('Error appending AI message:', e);
    }
  }

  function showAITypingIndicator() {
    try {
      const container = document.getElementById('aiChatMessages');
      if (!container) return;

      const welcomeScreen = document.getElementById('aiWelcomeScreen');
      if (welcomeScreen) {
        welcomeScreen.remove();
      }

      const indicatorDiv = document.createElement('div');
      indicatorDiv.id = 'aiTypingIndicator';
      indicatorDiv.className = 'flex gap-2.5 items-start max-w-[90%] animate-pulse';
      indicatorDiv.innerHTML = `
        <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-orange-500 to-amber-500 flex items-center justify-center text-white flex-shrink-0 shadow-sm shadow-orange-500/10">
          <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <div class="flex flex-col gap-1 w-full">
          <div class="bg-white text-gray-500 rounded-2xl rounded-tl-none px-4 py-3 border border-gray-150 shadow-sm flex items-center gap-2 text-xs font-semibold max-w-[200px]">
            <svg class="w-4 h-4 animate-spin text-orange-500" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <span>Epicure AI is thinking...</span>
          </div>
        </div>
      `;
      container.appendChild(indicatorDiv);
      scrollAIChatToBottom();
    } catch (e) {
      console.error(e);
    }
  }

  function removeAITypingIndicator() {
    try {
      const indicator = document.getElementById('aiTypingIndicator');
      if (indicator) indicator.remove();
    } catch (e) {
      console.error(e);
    }
  }

  async function handleAISubmit(e) {
    if (e) e.preventDefault();
    try {
      const input = document.getElementById('aiChatInput');
      if (!input) return;
      
      const text = input.value.trim();
      if (!text) return;

      input.value = '';
      appendAIMessage('user', text);
      showAITypingIndicator();

      const res = await fetch('/api/ai/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message: text })
      });

      const contentType = res.headers.get("content-type");
      if (contentType && contentType.includes("text/html")) {
        removeAITypingIndicator();
        appendAIMessage('ai', 'Your session has expired. Please refresh the page to log in again.');
        return;
      }

      if (!res.ok) {
        let errorMsg = 'I encountered an error. Please try again.';
        try {
          const data = await res.json();
          errorMsg = data.message || errorMsg;
        } catch (jsonErr) {
          errorMsg = `Server error (${res.status}): Please check if your GEMINI_API_KEY is configured correctly in the .env file.`;
        }
        removeAITypingIndicator();
        appendAIMessage('ai', errorMsg);
        return;
      }

      const data = await res.json();
      removeAITypingIndicator();

      if (data.success && data.data && data.data.reply) {
        appendAIMessage('ai', data.data.reply);
      } else {
        appendAIMessage('ai', data.message || 'I encountered an error. Please try again.');
      }
    } catch (err) {
      console.error(err);
      removeAITypingIndicator();
      appendAIMessage('ai', 'Sorry, I am having trouble connecting to the server. Please check your network connection.');
    }
  }

  function sendAISuggestion(text) {
    try {
      const input = document.getElementById('aiChatInput');
      if (input) {
        input.value = text;
        const form = document.getElementById('aiChatForm');
        if (form) {
          form.dispatchEvent(new Event('submit', { cancelable: true }));
        }
      }
    } catch (e) {
      console.error(e);
    }
  }

  async function clearAIChatHistory() {
    if (!confirm('Are you sure you want to clear our conversation history?')) return;

    try {
      const res = await fetch('/api/ai/reset', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
