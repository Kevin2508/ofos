<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Active Orders | Restaurant Staff | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="min-h-screen bg-orange-50 font-sans">
  <div class="flex min-h-screen">
    <%- include('../partials/restaurantStaff/sidebar') %>

    <!-- MAIN CONTENT -->
    <main class="flex-1 lg:ml-72 p-8 transition-all duration-300" id="mainContentWrapper">
      <div class="mb-8 flex justify-between items-center">
        <div>
          <h2 class="text-2xl font-bold text-gray-800">Active Orders</h2>
          <p class="text-gray-500 mt-1">Manage all current incoming and ongoing orders.</p>
        </div>
        <button
          class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-medium transition-colors shadow-sm"
          onclick="loadOrders()">
          Refresh 🔄
        </button>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left whitespace-nowrap">
            <thead>
              <tr class="bg-gray-50 border-b border-gray-100 text-gray-500 text-sm uppercase tracking-wider">
                <th class="px-6 py-4 font-semibold">Order ID</th>
                <th class="px-6 py-4 font-semibold">Items</th>
                <th class="px-6 py-4 font-semibold">Status</th>
                <th class="px-6 py-4 font-semibold">Date</th>
                <th class="px-6 py-4 font-semibold text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="ordersList" class="divide-y divide-gray-50 text-gray-700">
              <tr>
                <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                  <div class="animate-pulse flex justify-center">Loading orders...</div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script>
    async function loadOrders() {
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/orders', {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        const list = document.getElementById('ordersList');

        if (res.ok) {
          const data = await res.json();
          const orders = data.data || [];

          if (orders.length === 0) {
            list.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">No active orders right now.</td></tr>`;
          } else {
            list.innerHTML = orders.map(o => {
              const statusColors = {
                PENDING: 'bg-yellow-100 text-yellow-800',
                ACCEPTED: 'bg-blue-100 text-blue-800',
                PREPARING: 'bg-purple-100 text-purple-800',
                READY_FOR_PICKUP: 'bg-green-100 text-green-800',
                ASSIGNED: 'bg-indigo-100 text-indigo-800',
                PICKED_UP: 'bg-orange-100 text-orange-800',
                DELIVERED: 'bg-green-100 text-green-800',
                REJECTED: 'bg-red-100 text-red-800',
                CANCELLED: 'bg-red-100 text-red-800'
              };

              let actionButtons = '';
              if (o.orderStatus === 'PENDING') {
                actionButtons = `
                  <button onclick="updateStatus(${o.id}, 'accept')" class="bg-green-500 hover:bg-green-600 text-white px-3 py-1.5 rounded-md text-sm font-medium mr-2">Accept</button>
                  <button onclick="updateStatus(${o.id}, 'reject')" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1.5 rounded-md text-sm font-medium">Reject</button>
                `;
              } else if (o.orderStatus === 'ACCEPTED') {
                actionButtons = `<button onclick="updateStatus(${o.id}, 'preparing')" class="bg-purple-500 hover:bg-purple-600 text-white px-3 py-1.5 rounded-md text-sm font-medium">Start Preparing</button>`;
              } else if (o.orderStatus === 'PREPARING') {
                actionButtons = `<button onclick="updateStatus(${o.id}, 'ready')" class="bg-orange-500 hover:bg-orange-600 text-white px-3 py-1.5 rounded-md text-sm font-medium">Mark Ready</button>`;
              } else {
                actionButtons = `<span class="text-gray-400 text-sm">No actions</span>`;
              }

              return `
                <tr class="hover:bg-orange-50 transition-colors">
                  <td class="px-6 py-4 font-medium text-gray-900">#${o.orderNumber || o.id}</td>
                  <td class="px-6 py-4 text-gray-600 truncate max-w-xs">${o.orderItems?.length || 0} items</td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${statusColors[o.orderStatus] || 'bg-gray-100 text-gray-800'}">
                      ${o.orderStatus || 'PENDING'}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-gray-500 text-sm">${new Date(o.createdAt).toLocaleString()}</td>
                  <td class="px-6 py-4 text-right">
                    ${actionButtons}
                  </td>
                </tr>
              `;
            }).join('');
          }
        } else {
          list.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500">Failed to load orders.</td></tr>`;
        }
      } catch (err) {
        console.error(err);
        document.getElementById('ordersList').innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-red-500">Error loading data.</td></tr>`;
      }
    }

    async function updateStatus(orderId, action) {
      if (!confirm(`Are you sure you want to ${action} this order?`)) return;
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch(`/orders/${orderId}/${action}`, {
          method: 'PATCH',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          }
        });
        const data = await res.json();
        if (res.ok) {
          showToast(`Order ${action}ed successfully!`, 'success');
          loadOrders();
        } else {
          showToast(data.message || 'Failed to update order', 'error');
        }
      } catch (err) {
        console.error(err);
        showToast('Error updating order', 'error');
      }
    }

    loadOrders();
    setInterval(loadOrders, parseInt('<%= process.env.POLLING_INTERVAL_MS || 5000 %>'));

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        const token = localStorage.getItem('token') || '';
        await fetch('/auth/logout', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
      } catch (e) { console.error(e); }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });;
  </script>
  <%- include('../partials/toast') %>
</body>

</html>