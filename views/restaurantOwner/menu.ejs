        });
        if (res.ok) {
          loadItemsForCategory(categoryId);
        } else {
          const data = await res.json();
          showToast(data.message || 'Failed to update availability', 'error');
        }
      } catch (e) { showToast('Error', 'error'); }
    }

    async function deleteItem(itemId, categoryId) {
      if (!confirm('Delete this item?')) return;
      try {
        const res = await fetch(`/menu-item/menu-items/${itemId}`, {
          method: 'DELETE',

        });
        if (res.ok) {
          loadItemsForCategory(categoryId);
        } else {
          const data = await res.json();
          showToast(data.message || 'Failed to delete item', 'error');
        }
      } catch (e) { showToast('Error', 'error'); }
    }

