<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password | epicure- Food Ordering System</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body>
  <div class="min-h-screen bg-gray-50 flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-8">
      <!-- Header -->
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-800 mb-2">Set New Password</h2>
        <p class="text-gray-500 text-sm">Choose a strong password for your account</p>
      </div>

      <!-- Form -->
      <form id="resetForm" class="space-y-5">
        <!-- Phone Container (hidden unless OTP flow) -->
        <div id="phoneContainer">
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Phone Number
          </label>
          <input type="text" id="userIdentifier" name="userIdentifier" placeholder="Enter your 10 digit phone"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-colors" />
          <p id="userIdentifierError" class="mt-1 text-sm text-red-500"></p>
        </div>

        <!-- New Password -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            New Password
          </label>
          <div class="relative">
            <input type="password" id="password" name="password" placeholder="Enter new password"
               minlength="8" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-colors pr-16" />
            <button type="button" id="togglePassword"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-sm font-medium text-orange-500 hover:text-orange-600 transition-colors">
              Show
            </button>
          </div>
          <p id="passwordError" class="mt-1 text-sm text-red-500"></p>
        </div>

        <!-- Confirm Password -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Confirm Password
          </label>
          <div class="relative">
            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm new password"
               minlength="8" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-colors pr-16" />
            <button type="button" id="toggleConfirmPassword"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-sm font-medium text-orange-500 hover:text-orange-600 transition-colors">
              Show
            </button>
          </div>
          <p id="confirmPasswordError" class="mt-1 text-sm text-red-500"></p>
        </div>

        <!-- Reset Password Button -->
        <button type="submit" id="submitBtn"
          class="w-full bg-orange-500 hover:bg-orange-600 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 shadow-md hover:shadow-lg mt-2">
          Reset Password
        </button>
      </form>

      <!-- Footer -->
      <div class="text-center mt-6 pt-6 border-t border-gray-200">
        <p class="text-sm text-gray-600">
          Remembered your password?
          <a href="/loginPage" class="font-medium text-orange-500 hover:text-orange-600 transition-colors">
            Login
          </a>
        </p>
      </div>
    </div>
  </div>

  <script>
    const resetForm = document.getElementById('resetForm');

    const phoneContainer = document.getElementById('phoneContainer');
    const userIdentifier = document.getElementById('userIdentifier');

    const password = document.getElementById('password');
    const confirmPassword = document.getElementById('confirmPassword');

    const userIdentifierError = document.getElementById(
      'userIdentifierError'
    );
    const passwordError = document.getElementById('passwordError');
    const confirmPasswordError = document.getElementById(
      'confirmPasswordError'
    );

    const submitBtn = document.getElementById('submitBtn');

    // Get reset token from URL
    const params = new URLSearchParams(window.location.search);
    const resetToken = params.get('resetToken');

    // OTP flow detection
    if (/^[0-9]{6}$/.test(resetToken)) {
      phoneContainer.classList.remove('hidden');
    }

    // Password toggles
    function toggleVisibility(buttonId, inputElement) {
      document.getElementById(buttonId).addEventListener('click', () => {
        if (inputElement.type === 'password') {
          inputElement.type = 'text';
          document.getElementById(buttonId).textContent = 'Hide';
        } else {
          inputElement.type = 'password';
          document.getElementById(buttonId).textContent = 'Show';
        }
      });
    }

    toggleVisibility('togglePassword', password);
    toggleVisibility('toggleConfirmPassword', confirmPassword);

    function clearMessages() {
      userIdentifierError.textContent = '';
      passwordError.textContent = '';
      confirmPasswordError.textContent = '';
    }

    function validate() {
      let valid = true;

      if (!phoneContainer.classList.contains('hidden')) {
        if (!/^[0-9]{10}$/.test(userIdentifier.value.trim())) {
          userIdentifierError.textContent =
            'Contact number must be exactly 10 digits';

          valid = false;
        }
      }

      if (password.value.length < 8) {
        passwordError.textContent = 'Password must be at least 8 characters';

        valid = false;
      }

      if (confirmPassword.value !== password.value) {
        confirmPasswordError.textContent = 'Passwords do not match';

        valid = false;
      }

      return valid;
    }

    resetForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      clearMessages();

      if (!validate()) {
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Resetting...';

      try {
        const body = {
          password: password.value,
          confirmPassword: confirmPassword.value,
        };

        if (!phoneContainer.classList.contains('hidden')) {
          body.userIdentifier = userIdentifier.value.trim();
        }

        const response = await fetch(`/auth/reset-password/${resetToken}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(body),
        });

        const data = await response.json();

        if (!response.ok) {
          showToast(data.message || 'Password reset failed', 'error');
          return;
        }

        showToast(data.message || 'Password reset successfully', 'success');

        setTimeout(() => {
          window.location.href = '/loginPage';
        }, 2000);
      } catch (error) {
        showToast('Something went wrong. Please try again.', 'error');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Reset Password';
      }
    });
  </script>
  <%- include('../partials/toast') %>
</body>

</html>