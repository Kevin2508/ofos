                <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <h2 class="text-2xl font-black text-gray-900 tracking-tight">👋 Hi! I'm Epicure AI</h2>
                <p class="text-gray-500 text-sm font-medium mt-2 leading-relaxed max-w-[280px]">
                  I can help you discover restaurants, recommend meals, build orders, search menus, and answer food-related questions.
                </p>
              </div>
              
              <div class="grid grid-cols-2 gap-2.5 w-full pt-4">
                <button onclick="sendAISuggestion('Recommend dinner')" 
                  class="flex items-center gap-2 p-3 bg-white rounded-2xl border border-gray-100 hover:border-orange-200 hover:shadow-md transition-all duration-300 text-left text-xs font-bold text-gray-700 hover:text-orange-600">
                  <span>🍕</span> Recommend dinner
                </button>
                <button onclick="sendAISuggestion('Suggest vegetarian options')" 
                  class="flex items-center gap-2 p-3 bg-white rounded-2xl border border-gray-100 hover:border-orange-200 hover:shadow-md transition-all duration-300 text-left text-xs font-bold text-gray-700 hover:text-orange-600">
                  <span>🥗</span> Vegetarian food
                </button>
                <button onclick="sendAISuggestion('Find restaurants nearby')" 
                  class="flex items-center gap-2 p-3 bg-white rounded-2xl border border-gray-100 hover:border-orange-200 hover:shadow-md transition-all duration-300 text-left text-xs font-bold text-gray-700 hover:text-orange-600">
                  <span>🍜</span> Restaurants near
                </button>
                <button onclick="sendAISuggestion('Suggest a meal for 4 people')" 
                  class="flex items-center gap-2 p-3 bg-white rounded-2xl border border-gray-100 hover:border-orange-200 hover:shadow-md transition-all duration-300 text-left text-xs font-bold text-gray-700 hover:text-orange-600">
                  <span>👨‍👩‍👦</span> Meal for 4
                </button>
                <button onclick="sendAISuggestion('Show trending dishes')" 
                  class="flex items-center gap-2 p-3 bg-white rounded-2xl border border-gray-100 hover:border-orange-200 hover:shadow-md transition-all duration-300 text-left text-xs font-bold text-gray-700 hover:text-orange-600">
                  <span>🔥</span> Trending dishes
                </button>
                <button onclick="sendAISuggestion('Suggest food under ₹500')" 
                  class="flex items-center gap-2 p-3 bg-white rounded-2xl border border-gray-100 hover:border-orange-200 hover:shadow-md transition-all duration-300 text-left text-xs font-bold text-gray-700 hover:text-orange-600">
                  <span>💰</span> Food under ₹500
                </button>
              </div>
            </div>
          `;
          
          const quickChips = document.getElementById('aiQuickChips');
          if (quickChips) {
            quickChips.classList.add('hidden');
          }
          
          scrollAIChatToBottom();
        }
      } else {
        alert('Failed to clear chat history: ' + data.message);
      }
    } catch (err) {
      console.error(err);
      alert('Error clearing chat history.');
    }
  }
</script>