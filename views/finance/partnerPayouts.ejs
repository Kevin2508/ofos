<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Partner Payouts | Finance Manager | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="min-h-screen bg-orange-50 font-sans text-gray-800">
  <div class="flex min-h-screen">
    <%- include('../partials/finance/sidebar') %>

    <!-- MAIN CONTENT -->
    <main class="flex-1 lg:ml-72 p-8 transition-all duration-300" id="mainContentWrapper">
      <div class="mb-8">
        <h2 class="text-3xl font-bold text-gray-900">Partner Payouts</h2>
        <p class="text-gray-500 mt-2">Manage and disburse funds to delivery partners.</p>
      </div>

      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left whitespace-nowrap">
            <thead>
              <tr class="bg-orange-50 border-b border-gray-100 text-gray-600 text-sm uppercase tracking-wider">
                <th class="px-6 py-4 font-semibold">Reference</th>
                <th class="px-6 py-4 font-semibold">Partner ID</th>
                <th class="px-6 py-4 font-semibold">Gross</th>
                <th class="px-6 py-4 font-semibold">Net Amount</th>
                <th class="px-6 py-4 font-semibold">Status</th>
                <th class="px-6 py-4 font-semibold text-right">Actions</th>
              </tr>
            </thead>
            <tbody id="payoutsList" class="divide-y divide-gray-50 text-gray-700">
              <tr>
                <td colspan="6" class="px-6 py-8 text-center text-gray-500">
                  <div class="animate-pulse flex justify-center">Loading payouts...</div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script>
    async function updateStatus(id, newStatus) {
      if (!confirm(`Mark this payout as ${newStatus}?`)) return;
      const token = localStorage.getItem('token') || '';
      try {
        const res = await fetch(`/finance/payouts/partners/${id}/status`, {
          method: 'PATCH',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ status: newStatus })
        });
        if (res.ok) {
          alert('Payout status updated!');
          loadPayouts();
        } else {
          alert('Failed to update status.');
        }
      } catch (err) {
        console.error(err);
      }
    }

    async function loadPayouts() {
      try {
        const token = localStorage.getItem('token') || '';
        const res = await fetch('/finance/payouts/partners', {
          headers: { 'Authorization': `Bearer ${token}` }
        });

        const list = document.getElementById('payoutsList');
        if (res.ok) {
          const data = await res.json();
          const payouts = data.data || [];

          if (payouts.length === 0) {
            list.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">No payouts found.</td></tr>`;
          } else {
            list.innerHTML = payouts.map(p => `
              <tr class="hover:bg-orange-50/50 transition-colors">
                <td class="px-6 py-4 font-bold text-gray-900">${p.payoutReference}</td>
                <td class="px-6 py-4">
                  <p class="font-medium text-gray-900">Partner #${p.partnerUserId}</p>
                </td>
                <td class="px-6 py-4 text-sm text-gray-600">
                  ₹${p.grossAmount.toFixed(2)}
                </td>
                <td class="px-6 py-4 font-medium text-green-600">₹${p.netAmount.toFixed(2)}</td>
                <td class="px-6 py-4">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${p.status === 'PAID' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'}">
                    ${p.status}
                  </span>
                </td>
                <td class="px-6 py-4 text-right">
                  ${p.status === 'PENDING' ? `
                    <button onclick="updateStatus('${p.id}', 'PAID')" class="text-orange-600 hover:text-orange-800 text-sm font-medium">Mark Paid</button>
                  ` : `<span class="text-sm text-gray-400">Done</span>`}
                </td>
              </tr>
            `).join('');
          }
        }
      } catch (err) {
        console.error(err);
      }
    }

    loadPayouts();

    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        const token = localStorage.getItem('token') || '';
        await fetch('/auth/logout', {
          headers: { 'Authorization': `Bearer ${token}` }
        });
      } catch (e) { console.error(e); }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });;
  </script>
</body>

</html>