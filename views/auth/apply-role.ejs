<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Apply for Another Role | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
  <style>
    .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid #fed7aa;
      border-top-color: #f97316;
      border-radius: 50%;
      animation: spin .8s linear infinite;
      margin: auto;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }
  </style>
</head>

<body class="min-h-screen bg-orange-50 flex flex-col items-center justify-center p-4">

  <div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-5 sm:p-8 text-center" id="mainContainer">
    <h2 class="text-3xl font-bold text-gray-800 mb-2">Apply for Another Role</h2>
    <p class="text-gray-500 text-sm mb-6">Choose an additional role to apply for. Your existing details will be linked.</p>

    <!-- Loading -->
    <div id="loadingState" class="py-12">
      <div class="spinner mb-4"></div>
      <p class="text-gray-500 font-medium">Checking your eligible roles...</p>
    </div>

    <!-- Content -->
    <div id="rolesContent" class="hidden space-y-4">
      <div id="availableRolesList" class="space-y-3"></div>

      <div id="noEligibleRoles" class="hidden py-8">
        <div class="text-4xl mb-3">✅</div>
        <p class="text-gray-600 font-medium">You have applied for all available roles!</p>
        <p class="text-sm text-gray-400 mt-1">There are no additional roles you can apply for at this time.</p>
      </div>

      <div class="pt-6 border-t border-gray-100">
        <button onclick="history.back()" class="w-full text-center bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-3 rounded-xl transition-colors shadow-sm">
          Go Back
        </button>
      </div>
    </div>
  </div>

  <script>
    const ROLE_OPTIONS = [
      { name: 'Customer', key: 'Customer', icon: '🍔', path: '/registerPage' },
      { name: 'Restaurant Owner', key: 'Restaurant Owner', icon: '🏪', path: '/registerPage/owner' },
      { name: 'Restaurant Staff', key: 'Restaurant Staff', icon: '👨‍🍳', path: '/registerPage/staff' },
      { name: 'Delivery Partner', key: 'Delivery Partner', icon: '🛵', path: '/registerPage/deliveryPartner' },
      { name: 'Fleet Manager', key: 'Fleet Manager', icon: '🚚', path: '/registerPage/fleetManager' },
      { name: 'Finance Manager', key: 'Finance Manager', icon: '💰', path: '/registerPage/financeManager' }
    ];

    loadEligibleRoles();
    async function loadEligibleRoles() {
      try {
        const res = await fetch('/auth/me');
        if (!res.ok) {
          if (res.status === 401) window.location.href = '/loginPage';
          else throw new Error('Failed to load profile');
          return;
        }

        const json = await res.json();
        const user = json.data.user;
        
        // Extract assigned and pending roles
        const userRoles = user.userRoles || [];
        const activeOrPendingRoles = new Set();
        userRoles.forEach(ur => {
          // Normalize role name to match keys in ROLE_OPTIONS
          let roleKey = ur.roleName;
          if (roleKey === 'Customer') roleKey = 'Customer';
          else if (roleKey === 'Restaurant_owner') roleKey = 'Restaurant Owner';
          else if (roleKey === 'Restaurant_staff') roleKey = 'Restaurant Staff';
          else if (roleKey === 'Delivery_partner') roleKey = 'Delivery Partner';
          else if (roleKey === 'Fleet_manager') roleKey = 'Fleet Manager';
          else if (roleKey === 'Finance_manager') roleKey = 'Finance Manager';
          
          activeOrPendingRoles.add(roleKey);
        });

        document.getElementById('loadingState').classList.add('hidden');
        document.getElementById('rolesContent').classList.remove('hidden');

        const container = document.getElementById('availableRolesList');
        const noRoles = document.getElementById('noEligibleRoles');

        // Filter out roles already active or pending
        const eligible = ROLE_OPTIONS.filter(opt => !activeOrPendingRoles.has(opt.key));

        if (eligible.length === 0) {
          noRoles.classList.remove('hidden');
          container.classList.add('hidden');
          return;
        }

        container.innerHTML = eligible.map(opt => {
          return `
            <a href="${opt.path}" class="w-full flex items-center justify-between p-4 border-2 border-gray-100 rounded-xl hover:border-orange-500 hover:bg-orange-50 transition-all text-left group">
              <div class="flex flex-wrap items-center gap-3">
                <span class="text-2xl">${opt.icon}</span>
                <span class="font-bold text-gray-700 group-hover:text-orange-600">${opt.name}</span>
              </div>
              <svg class="w-5 h-5 text-gray-300 group-hover:text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          `;
        }).join('');

      } catch (err) {
        document.getElementById('loadingState').innerHTML = '<p class="text-red-500">Error loading eligible roles. Please refresh.</p>';
      }
    }
  </script>
</body>

</html>
