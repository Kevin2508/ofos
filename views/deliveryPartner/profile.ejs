<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Profile | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
  <script src="/js/form-validator.js"></script>
  <style>
    /* Tabs */
    .tab-btn { transition: background .2s, color .2s; }
    .tab-btn.active { background: #f97316; color: #fff; }
    
    /* Sections */
    .profile-section { display: none; }
    .profile-section.active { display: block; }
    
    /* Inputs */
    .if {
      width: 100%;
      padding: .6rem 1rem;
      border: 1.5px solid #e5e7eb;
      border-radius: .75rem;
      outline: none;
      font-size: .95rem;
      background: #fff;
      transition: border-color .2s, box-shadow .2s;
    }
    .if:focus {
      border-color: #f97316;
      box-shadow: 0 0 0 3px rgba(249, 115, 22, .15);
    }
    
    /* Spinner */
    .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid #fed7aa;
      border-top-color: #f97316;
      border-radius: 50%;
      animation: spin .8s linear infinite;
      margin: auto;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    
    /* Avatar */
    .profile-avatar {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #f97316;
    }
    .avatar-initial {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f97316, #fb923c);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
      font-weight: 800;
      border: 3px solid #fed7aa;
      flex-shrink: 0;
    }
  </style>
</head>

<body class="min-h-screen bg-orange-50 font-sans">
  <div class="flex min-h-screen">
    <%- include('../partials/deliveryPartner/sidebar') %>

    <!-- MAIN CONTENT -->
    <main class="flex-1 lg:ml-72 p-5 sm:p-8 transition-all duration-300 flex flex-col min-h-screen" id="mainContentWrapper">
      <div class="mb-8 flex justify-between items-center">
        <div class="flex flex-wrap items-start md:items-center gap-3">
          <button onclick="toggleSidebar()" class="p-2 -ml-2 mt-1 md:mt-0 text-gray-600 hover:text-orange-500 rounded-xl hover:bg-orange-50 transition-colors lg:hidden">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
          </button>
          <div>
            <h2 class="text-3xl font-bold text-gray-800">My Profile</h2>
            <p class="text-gray-500 mt-1">Manage your account information and security.</p>
          </div>
        </div>
      </div>

      <!-- Loading -->
      <div id="profileLoading" class="py-24 text-center">
        <div class="spinner mb-4"></div>
        <p class="text-gray-500 font-medium">Loading your profile…</p>
      </div>

      <!-- Content (hidden until loaded) -->
      <div id="profileContent" class="hidden max-w-4xl">

        <!-- Profile header -->
        <div class="bg-white rounded-2xl border border-orange-100 shadow-sm p-4 sm:p-6 mb-6 flex flex-wrap flex-col sm:flex-row items-center sm:items-start gap-3 sm:gap-6">
          <div id="avatarContainer" class="flex-shrink-0"></div>
          <div class="flex-1 min-w-0 text-center sm:text-left">
            <h2 class="text-2xl font-bold text-gray-800 truncate" id="profileName">—</h2>
            <span class="inline-block mt-1 px-3 py-0.5 rounded-full text-xs font-bold bg-orange-50 text-orange-600 uppercase tracking-wider">Delivery Partner</span>

            <div class="mt-3 flex flex-col sm:flex-row gap-2 text-sm text-gray-600 flex-wrap">
              <span id="profileEmail" class="flex items-center gap-1.5 justify-center sm:justify-start">
                <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span>—</span>
              </span>
              <span id="profilePhone" class="flex items-center gap-1.5 justify-center sm:justify-start">
                <svg class="w-4 h-4 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>—</span>
              </span>
            </div>
            <p class="mt-2 text-xs text-gray-400" id="profileJoined"></p>
          </div>
        </div>

        <!-- Tabs -->
        <div class="flex gap-1.5 mb-6 bg-white rounded-xl p-1.5 border border-orange-100 shadow-sm w-fit flex-wrap">
          <button id="tab-personal" class="tab-btn active flex items-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-sm" onclick="switchTab('personal')">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            Personal Info
          </button>
          <button id="tab-security" class="tab-btn flex items-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-sm text-gray-600 hover:bg-orange-50" onclick="switchTab('security')">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            Security
          </button>
          <button id="tab-roles" class="tab-btn flex items-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-sm text-gray-600 hover:bg-orange-50" onclick="switchTab('roles')">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            Roles & Access
          </button>
        </div>

        <!-- Personal Info Section -->
        <div id="section-personal" class="profile-section active">
          <form id="profileForm" class="bg-white rounded-2xl shadow-sm border border-orange-100 p-5 sm:p-8 space-y-5" novalidate>
            <h3 class="text-lg font-bold text-gray-800 mb-4 pb-3 border-b border-gray-100">Basic Information</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">First Name</label>
                <input type="text" id="p_firstName" class="if" required />
                <p id="p_firstNameError" class="text-red-500 text-xs mt-1 hidden font-medium"></p>
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">Last Name <span class="text-gray-400 font-normal">(Optional)</span></label>
                <input type="text" id="p_lastName" class="if" />
                <p id="p_lastNameError" class="text-red-500 text-xs mt-1 hidden font-medium"></p>
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">Email Address</label>
                <input type="email" id="p_email" class="if" />
                <p id="p_emailError" class="text-red-500 text-xs mt-1 hidden font-medium"></p>
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">Phone Number</label>
                <input type="tel" id="p_phone" class="if" maxlength="10" />
                <p id="p_phoneError" class="text-red-500 text-xs mt-1 hidden font-medium"></p>
              </div>
            </div>
            <div id="profileError" class="hidden bg-red-50 text-red-600 text-sm px-4 py-2.5 rounded-xl border border-red-200 mt-2"></div>
            <div class="pt-4 mt-2">
              <button type="submit" id="profileSaveBtn" class="bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-4 sm:px-8 rounded-xl transition-colors shadow-sm disabled:opacity-60 disabled:cursor-not-allowed">
                Save Changes
              </button>
            </div>
          </form>
        </div>

        <!-- Security Section -->
        <div id="section-security" class="profile-section">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-6">
            <div class="bg-white rounded-2xl shadow-sm border border-orange-100 p-4 sm:p-6 md:p-8">
              <h3 class="text-lg font-bold text-gray-800 mb-2">Change Password</h3>
              <p class="text-sm text-gray-500 mb-6">Update your password to keep your account secure.</p>
              <form id="changePwForm" class="space-y-4">
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">Current Password</label>
                  <div class="relative">
                    <input type="password" id="currentPassword" placeholder="Enter current password" class="if pr-10" autocomplete="current-password" />
                <p id="currentPasswordError" class="text-red-500 text-xs mt-1 hidden font-medium"></p>
                  </div>
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">New Password</label>
                  <div class="relative">
                    <input type="password" id="newPassword" placeholder="At least 8 characters" class="if pr-10" autocomplete="new-password" />
                <p id="newPasswordError" class="text-red-500 text-xs mt-1 hidden font-medium"></p>
                  </div>
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">Confirm New Password</label>
                  <div class="relative">
                    <input type="password" id="confirmPassword" placeholder="Repeat new password" class="if pr-10" autocomplete="new-password" />
                <p id="confirmPasswordError" class="text-red-500 text-xs mt-1 hidden font-medium"></p>
                  </div>
                </div>
                <div id="pwError" class="hidden bg-red-50 text-red-600 text-sm px-4 py-2.5 rounded-xl border border-red-200"></div>
                <button type="submit" id="changePwBtn" class="w-full bg-orange-500 hover:bg-orange-600 disabled:opacity-60 disabled:cursor-not-allowed text-white font-bold py-3 rounded-xl transition-colors shadow-sm">
                  Update Password
                </button>
              </form>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-orange-100 p-4 sm:p-6 md:p-8 flex flex-col">
              <h3 class="text-lg font-bold text-gray-800 mb-2">Active Sessions</h3>
              <p class="text-sm text-gray-500 mb-6">Manage devices currently logged into your account.</p>
              <div id="sessionsList" class="space-y-3 flex-1 overflow-y-auto max-h-[300px] pr-2">
                <div class="text-sm text-gray-500">Loading sessions...</div>
              </div>
            </div>
          </div>

          <!-- Danger Zone -->
          <div class="bg-white rounded-2xl shadow-sm border border-red-100 p-4 sm:p-6 md:p-8 mt-6">
            <h3 class="text-lg font-bold text-red-600 mb-2">Danger Zone</h3>
            <p class="text-sm text-gray-500 mb-6">Permanently delete your account and all associated data. This action is irreversible.</p>
            <button onclick="deleteAccount()" class="bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-6 rounded-xl transition-colors shadow-sm">
              Delete Account
            </button>
          </div>
        </div>

        <!-- Roles Section -->
        <div id="section-roles" class="profile-section">
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden p-5 sm:p-8">
            <h3 class="text-xl font-bold text-gray-800 mb-6">Roles & Access</h3>
            <div id="profileRolesList" class="space-y-3 mb-6">
               <div class="w-8 h-8 border-4 border-orange-100 border-t-orange-500 rounded-full animate-spin mx-auto"></div>
            </div>
            <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-gray-100">
              <a href="/role-selection" class="flex-1 text-center bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-3 rounded-xl transition-colors shadow-sm">
                Switch Dashboard Context
              </a>
              <a href="/apply-role" class="flex-1 text-center bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 rounded-xl transition-colors shadow-sm">
                Apply For Another Role
              </a>
            </div>
          </div>
        </div>

      </div>
    </main>
  </div>

  <!-- Toast -->
  <div id="toast" class="fixed bottom-5 right-5 px-6 py-3 rounded-xl text-white font-semibold shadow-xl transition-all duration-300 transform translate-y-10 opacity-0 z-50 flex items-center gap-2"></div>

  <script>
    const token = localStorage.getItem('token');

    const profileRules = {
      p_firstName: { required: true, minLength: 2, label: 'First Name' },
      p_lastName: { label: 'Last Name' },
      p_email: { required: true, isEmail: true, label: 'Email' },
      p_phone: { exactLength: 10, pattern: /^[0-9]+$/, label: 'Phone' }
    };
    
    const pwRules = {
      currentPassword: { required: true, label: 'Current Password' },
      newPassword: { required: true, minLength: 8, label: 'New Password' },
      confirmPassword: { required: true, matchField: 'newPassword', label: 'Confirm Password' }
    };

    FormValidator.bindLiveValidation(profileRules);
    FormValidator.bindLiveValidation(pwRules);

    
    // Toast
    function showToast(msg, type = 'success') {
      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.className = `fixed bottom-5 right-5 px-6 py-3 rounded-xl text-white font-semibold shadow-xl transition-all duration-300 z-50 flex items-center gap-2 ${type === 'success' ? 'bg-green-500' : 'bg-red-500'}`;
      toast.classList.remove('translate-y-10', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-10', 'opacity-0');
      }, 3000);
    }

    // Tabs
    function switchTab(tabId) {
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.classList.remove('active', 'bg-orange-500', 'text-white');
        b.classList.add('text-gray-600');
        if (b.id === 'tab-' + tabId) {
          b.classList.add('active');
          b.classList.remove('text-gray-600', 'hover:bg-orange-50');
        }
      });
      document.querySelectorAll('.profile-section').forEach(s => {
        s.classList.remove('active');
      });
      document.getElementById('section-' + tabId).classList.add('active');

      if (tabId === 'security' && !window.sessionsLoaded) loadSessions();
    }

    // Load Profile
    async function loadProfile() {
      try {
        const res = await fetch('/auth/me', { headers: { 'Authorization': `Bearer ${token}` } });
        if (!res.ok) return;
        const data = await res.json();
        const u = data.data.user;

        document.getElementById('profileLoading').classList.add('hidden');
        document.getElementById('profileContent').classList.remove('hidden');

        // Header
        const fn = u.firstName || '';
        const ln = u.lastName || '';
        const fullName = `${fn} ${ln}`.trim() || 'No Name';
        document.getElementById('profileName').textContent = fullName;
        document.getElementById('profileEmail').innerHTML = `<svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>${u.email || '—'}`;
        document.getElementById('profilePhone').innerHTML = `<svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>${u.phone || '—'}`;
        const dt = new Date(u.createdAt);
        document.getElementById('profileJoined').textContent = `Member since ${dt.toLocaleDateString(undefined, { month: 'long', year: 'numeric' })}`;

        // Avatar
        const avatarCont = document.getElementById('avatarContainer');
        if (u.profilePictureUrl) {
          avatarCont.innerHTML = `<img src="${u.profilePictureUrl}" class="profile-avatar shadow-sm" alt="Avatar"/>`;
        } else {
          avatarCont.innerHTML = `<div class="avatar-initial shadow-sm">${fn ? fn[0].toUpperCase() : 'U'}</div>`;
        }

        // Form fields
        document.getElementById('p_firstName').value = fn;
        document.getElementById('p_lastName').value = ln;
        document.getElementById('p_email').value = u.email || '';
        document.getElementById('p_phone').value = u.phone || '';

        // Roles list
        const rolesList = document.getElementById('profileRolesList');
        if (u.userRoles && u.userRoles.length > 0) {
          rolesList.innerHTML = u.userRoles.map(ur => `
            <div class="flex items-center justify-between p-4 rounded-xl border ${ur.status === 'ACTIVE' ? 'border-orange-200 bg-orange-50' : 'border-gray-200 bg-gray-50'}">
              <div>
                <p class="font-bold text-gray-800">${ur.role?.name || ur.roleName}</p>
                <p class="text-xs text-gray-500 mt-1 flex items-center gap-1">
                  ${ur.status === 'ACTIVE' ? '<span class="w-2 h-2 rounded-full bg-green-500"></span>' : '<span class="w-2 h-2 rounded-full bg-yellow-500"></span>'}
                  Status: ${ur.status}
                </p>
              </div>
            </div>
          `).join('');
        } else {
           rolesList.innerHTML = '<p class="text-gray-500">No roles found.</p>';
        }

      } catch (e) {
        console.error(e);
      }
    }

    // Profile form submit
    document.getElementById('profileForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!FormValidator.validate(profileRules)) return;
      const btn = document.getElementById('profileSaveBtn');
      const err = document.getElementById('profileError');
      btn.disabled = true;
      btn.innerHTML = 'Saving...';
      err.classList.add('hidden');

      const data = {
        firstName: document.getElementById('p_firstName').value.trim(),
        lastName: document.getElementById('p_lastName').value.trim(),
        email: document.getElementById('p_email').value.trim(),
        phone: document.getElementById('p_phone').value.trim()
      };

      try {
        const res = await fetch('/auth/profile', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify(data)
        });
        const resData = await res.json();
        if (res.ok) {
          showToast('Profile updated!', 'success');
          loadProfile();
        } else {
          let errorMsg = resData.message || 'Error updating profile';
          if (resData.errors && resData.errors.length > 0) {
            errorMsg = resData.errors.map(e => e.message).join('<br>');
          }
          err.innerHTML = errorMsg;
          err.classList.remove('hidden');
        }
      } catch (ex) {
        err.textContent = 'Network error.';
        err.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.innerHTML = 'Save Changes';
      }
    });

    // Password form submit
    document.getElementById('changePwForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!FormValidator.validate(pwRules)) return;
      const btn = document.getElementById('changePwBtn');
      const err = document.getElementById('pwError');
      btn.disabled = true;
      btn.innerHTML = 'Updating...';
      err.classList.add('hidden');

      const payload = {
        currentPassword: document.getElementById('currentPassword').value,
        newPassword: document.getElementById('newPassword').value,
        confirmPassword: document.getElementById('confirmPassword').value
      };

      try {
        const res = await fetch('/auth/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (res.ok) {
          showToast('Password updated!', 'success');
          document.getElementById('changePwForm').reset();
        } else {
          err.textContent = data.message || 'Error updating password';
          err.classList.remove('hidden');
        }
      } catch (ex) {
        err.textContent = 'Network error.';
        err.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.innerHTML = 'Update Password';
      }
    });

    // Sessions
    async function loadSessions() {
      try {
        const res = await fetch('/auth/sessions', { headers: { 'Authorization': `Bearer ${token}` } });
        if (!res.ok) return;
        const { data } = await res.json();
        const c = document.getElementById('sessionsList');
        if (!data || data.length === 0) {
          c.innerHTML = '<p class="text-sm text-gray-500">No active sessions.</p>';
          return;
        }
        c.innerHTML = data.map(s => {
          const isCurrent = s.isCurrent ? '<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-green-100 text-green-700 ml-2">Current</span>' : '';
          const dev = s.deviceInfo ? JSON.parse(s.deviceInfo) : {};
          const os = dev.os || 'Unknown Device';
          const browser = dev.browser || 'Unknown Browser';
          const dt = new Date(s.createdAt).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
          
          let icon = '<svg class="w-5 h-5 text-gray-400 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>';
          if(os.toLowerCase().includes('ios') || os.toLowerCase().includes('android')) {
            icon = '<svg class="w-5 h-5 text-gray-400 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>';
          }

          return `
            <div class="flex items-start justify-between p-3 rounded-xl border border-gray-100 bg-gray-50 hover:bg-white hover:shadow-sm transition-all group">
              <div class="flex gap-3">
                ${icon}
                <div>
                  <p class="font-bold text-sm text-gray-800">${os} &middot; ${browser} ${isCurrent}</p>
                  <p class="text-xs text-gray-500 mt-0.5">${s.ipAddress} &middot; ${dt}</p>
                </div>
              </div>
              ${!s.isCurrent ? `<button onclick="revokeSession(${s.id})" class="text-xs font-bold text-red-500 hover:text-red-700 p-2 opacity-0 group-hover:opacity-100 transition-opacity">Revoke</button>` : ''}
            </div>
          `;
        }).join('');
        window.sessionsLoaded = true;
      } catch (e) {}
    }

    window.revokeSession = async function(id) {
      if(!confirm('Are you sure you want to log out this device?')) return;
      try {
        const res = await fetch('/auth/sessions/' + id, { method: 'DELETE', headers: { 'Authorization': `Bearer ${token}` } });
        if (res.ok) {
          showToast('Session revoked', 'success');
          loadSessions();
        }
      } catch (e) {}
    };

    window.deleteAccount = async function() {
      if (!confirm('Are you sure you want to permanently delete your account? This action is irreversible and you will be logged out immediately.')) {
        return;
      }
      try {
        const res = await fetch('/auth/delete-account', {
          method: 'DELETE',
          headers: { 'Authorization': `Bearer ${token}` }
        });
        if (res.ok) {
          localStorage.removeItem('token');
          showToast('Account deleted successfully. Redirecting...', 'success');
          setTimeout(() => {
            window.location.href = '/loginPage';
          }, 1500);
        } else {
          const data = await res.json().catch(() => ({}));
          showToast(data.message || 'Failed to delete account', 'error');
        }
      } catch (e) {
        showToast('Network error occurred', 'error');
      }
    };

    loadProfile();
  </script>
</body>
</html>
