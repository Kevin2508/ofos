                  <button onclick="openSchedulesModal('${item.id}', '${categoryId}')" class="text-xs font-medium text-blue-600 bg-blue-50 hover:bg-blue-100 px-2 py-1 rounded">Time</button>
                  <button onclick="openEditItemModal('${item.id}', '${categoryId}')" class="text-xs font-medium text-orange-600 bg-orange-50 hover:bg-orange-100 px-2 py-1 rounded">Edit</button>
                  <button onclick="toggleAvailability('${item.id}', ${!item.isAvailable}, '${categoryId}')" class="text-xs font-medium text-gray-600 bg-gray-100 hover:bg-gray-200 px-2 py-1 rounded">
