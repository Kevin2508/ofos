<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password</title>
  <link rel="stylesheet" href="/styles/build.css">
</head>

<body class="bg-gray-100 min-h-screen flex items-center justify-center font-sans">

  <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-md">
    <h2 class="text-2xl font-bold text-center text-white bg-red-500 py-2 rounded mb-4">Reset Password</h2>

    <p class="text-sm text-gray-600 text-center mb-6">
      Enter your registered email address or 10-digit phone number and we'll send you instructions to reset your
      password.
    </p>

    <div id="errorMessage" class="hidden bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4 text-sm"
      role="alert"></div>

    <div id="successMessage"
      class="hidden bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4 text-sm" role="alert">
    </div>

    <form id="forgotPasswordForm" class="space-y-4">

      <div>
        <label for="userIdentifier" class="block text-sm font-medium text-gray-700 mb-1">Email or Phone Number</label>
        <input type="text" id="userIdentifier" name="userIdentifier" placeholder="Enter email or 10-digit phone"
          class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500"
          required>
      </div>

      <button type="submit" id="submitBtn"
        class="w-full bg-red-600 text-white font-bold py-2 px-4 rounded hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-opacity-50 transition duration-150 ease-in-out">
        Send Reset Link
      </button>

    </form>

    <div class="mt-6 text-center">
      <a href="/loginPage"
        class="text-sm font-medium text-red-600 hover:text-red-500 flex items-center justify-center transition duration-150 ease-in-out">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
          class="w-4 h-4 mr-1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
        Back to Login
      </a>
    </div>

  </div>

  <script>
    document.getElementById('forgotPasswordForm').addEventListener('submit', async function (event) {
      event.preventDefault();

      const errorMessageDiv = document.getElementById('errorMessage');
      const successMessageDiv = document.getElementById('successMessage');
      const submitBtn = document.getElementById('submitBtn');

      errorMessageDiv.classList.add('hidden');
      successMessageDiv.classList.add('hidden');
      errorMessageDiv.textContent = '';

      const userIdentifier = document.getElementById('userIdentifier').value.trim();

      const phoneRegex = /^[0-9]{10}$/;
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      if (!phoneRegex.test(userIdentifier) && !emailRegex.test(userIdentifier)) {
        showError('User identifier must be a valid 10-digit phone number or email address.');
        return;
      }

      try {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';

        const response = await fetch('/auth/forgot-password', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            userIdentifier
          })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || 'Failed to send reset link. Please try again.');
        }

        successMessageDiv.textContent = data.message || 'If an account matches that identifier, a reset link has been sent.';
        successMessageDiv.classList.remove('hidden');

        document.getElementById('userIdentifier').value = '';

      } catch (error) {
        showError(error.message);
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send Reset Link';
      }
    });

    function showError(message) {
      const errorMessageDiv = document.getElementById('errorMessage');
      errorMessageDiv.textContent = message;
      errorMessageDiv.classList.remove('hidden');
    }
  </script>
</body>

</html>