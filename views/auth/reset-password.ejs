<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password | ofos - Food Ordering System</title>
    <link rel="stylesheet" href="/styles/build.css" />
  </head>
  <body class="min-h-screen bg-gradient-to-br from-orange-50 via-rose-50 to-amber-50">
    <!-- Floating food decorations -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden select-none">
      <span class="absolute top-24 left-[16%] text-5xl opacity-15">🍕</span>
      <span class="absolute top-36 right-[18%] text-4xl opacity-20">🍔</span>
      <span class="absolute bottom-28 left-[30%] text-6xl opacity-10">🌮</span>
      <span class="absolute top-1/3 right-[10%] text-3xl opacity-15">🥗</span>
      <span class="absolute bottom-44 right-[35%] text-5xl opacity-10">🍜</span>
      <span class="absolute top-3/4 left-[8%] text-4xl opacity-15">🍣</span>
    </div>

    <div class="min-h-screen flex items-center justify-center px-4 py-10 relative">
      <div class="w-full max-w-5xl">
        <div class="bg-white/80 backdrop-blur-sm rounded-3xl shadow-2xl overflow-hidden border border-orange-100/60">
          <div class="lg:flex">
            <!-- Left Brand Panel -->
            <div class="lg:w-5/12 bg-gradient-to-br from-orange-500 via-orange-600 to-rose-600 p-8 lg:p-10 text-white flex flex-col justify-between relative overflow-hidden min-h-[280px] lg:min-h-0">
              <div class="absolute -top-24 -right-24 w-72 h-72 bg-white/5 rounded-full"></div>
              <div class="absolute -bottom-20 -left-20 w-56 h-56 bg-white/5 rounded-full"></div>
              <div class="absolute top-1/2 -translate-y-1/2 right-0 w-32 h-32 bg-white/[0.03] rounded-full"></div>

              <div class="relative">
                <div class="flex items-center gap-3 mb-5">
                  <span class="text-3xl">🔐</span>
                  <h1 class="text-3xl font-extrabold tracking-tight">ofos</h1>
                </div>
                <p class="text-orange-100 text-base leading-relaxed mb-7">
                  Almost there! Just <span class="font-semibold text-white">set a new password</span> and you'll be back to ordering.
                </p>
                <div class="space-y-4">
                  <div class="flex items-center gap-3">
                    <span class="flex-shrink-0 w-10 h-10 bg-white/20 rounded-full flex items-center justify-center text-lg">🛡️</span>
                    <div>
                      <p class="font-semibold text-sm">Strong Security</p>
                      <p class="text-xs text-orange-100">Encrypted & protected</p>
                    </div>
                  </div>
                  <div class="flex items-center gap-3">
                    <span class="flex-shrink-0 w-10 h-10 bg-white/20 rounded-full flex items-center justify-center text-lg">⚡</span>
                    <div>
                      <p class="font-semibold text-sm">Quick Process</p>
                      <p class="text-xs text-orange-100">Takes just a minute</p>
                    </div>
                  </div>
                  <div class="flex items-center gap-3">
                    <span class="flex-shrink-0 w-10 h-10 bg-white/20 rounded-full flex items-center justify-center text-lg">🎉</span>
                    <div>
                      <p class="font-semibold text-sm">Back to Ordering</p>
                      <p class="text-xs text-orange-100">Resume where you left off</p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="relative mt-6 pt-5 border-t border-white/20">
                <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-orange-100">
                  <span>🍕 Pizza</span>
                  <span>🍔 Burger</span>
                  <span>🌮 Taco</span>
                  <span>🥗 Salad</span>
                  <span>🍜 Noodles</span>
                </div>
              </div>
            </div>

            <!-- Right Form Panel -->
            <div class="lg:w-7/12 p-8 lg:p-12">
              <div class="max-w-sm mx-auto">
                <div class="text-center lg:text-left mb-8">
                  <h2 class="text-2xl font-bold text-gray-800">Set New Password</h2>
                  <p class="text-gray-400 mt-1 text-sm">Choose a strong password for your account</p>
                </div>

                <form id="resetForm" class="space-y-5">
                  <!-- Phone field (hidden unless OTP flow) -->
                  <div id="phoneContainer" class="hidden">
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                      Phone Number
                    </label>
                    <input
                      type="text"
                      id="userIdentifier"
                      name="userIdentifier"
                      placeholder="Enter your 10 digit phone"
                      class="w-full px-4 py-3.5 rounded-2xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition duration-200 bg-gray-50 focus:bg-white"
                    />
                    <p id="userIdentifierError" class="text-red-500 text-sm mt-1.5"></p>
                  </div>

                  <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                      New Password
                    </label>
                    <div class="relative">
                      <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter new password"
                        class="w-full px-4 py-3.5 pr-16 rounded-2xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition duration-200 bg-gray-50 focus:bg-white"
                      />
                      <button
                        type="button"
                        id="togglePassword"
                        class="absolute right-4 top-1/2 -translate-y-1/2 text-orange-500 font-semibold text-sm hover:text-orange-600 transition"
                      >
                        Show
                      </button>
                    </div>
                    <p id="passwordError" class="text-red-500 text-sm mt-1.5"></p>
                  </div>

                  <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                      Confirm Password
                    </label>
                    <div class="relative">
                      <input
                        type="password"
                        id="confirmPassword"
                        name="confirmPassword"
                        placeholder="Confirm new password"
                        class="w-full px-4 py-3.5 pr-16 rounded-2xl border border-gray-200 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-orange-500 transition duration-200 bg-gray-50 focus:bg-white"
                      />
                      <button
                        type="button"
                        id="toggleConfirmPassword"
                        class="absolute right-4 top-1/2 -translate-y-1/2 text-orange-500 font-semibold text-sm hover:text-orange-600 transition"
                      >
                        Show
                      </button>
                    </div>
                    <p id="confirmPasswordError" class="text-red-500 text-sm mt-1.5"></p>
                  </div>

                  <button
                    type="submit"
                    id="submitBtn"
                    class="w-full bg-gradient-to-r from-orange-500 to-rose-500 hover:from-orange-600 hover:to-rose-600 text-white font-semibold py-3.5 rounded-2xl transition duration-200 shadow-lg shadow-orange-200 hover:shadow-xl hover:shadow-orange-300 cursor-pointer"
                  >
                    Reset Password
                  </button>
                </form>

                <div class="mt-8 text-center">
                  <p class="text-gray-400 text-sm">
                    Remembered your password?
                    <a
                      href="/loginPage"
                      class="font-semibold text-orange-500 hover:text-orange-600 transition"
                    >
                      Login
                    </a>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <script>
      const resetForm = document.getElementById('resetForm');

      const phoneContainer = document.getElementById('phoneContainer');
      const userIdentifier = document.getElementById('userIdentifier');

      const password = document.getElementById('password');
      const confirmPassword = document.getElementById('confirmPassword');

      const userIdentifierError = document.getElementById(
        'userIdentifierError'
      );
      const passwordError = document.getElementById('passwordError');
      const confirmPasswordError = document.getElementById(
        'confirmPasswordError'
      );

      const submitBtn = document.getElementById('submitBtn');

      // Get reset token from URL
      const params = new URLSearchParams(window.location.search);
      const resetToken = params.get('resetToken');

      // OTP flow detection
      if (/^[0-9]{6}$/.test(resetToken)) {
        phoneContainer.classList.remove('hidden');
      }

      // Password toggles
      function toggleVisibility(buttonId, inputElement) {
        document.getElementById(buttonId).addEventListener('click', () => {
          if (inputElement.type === 'password') {
            inputElement.type = 'text';
            document.getElementById(buttonId).textContent = 'Hide';
          } else {
            inputElement.type = 'password';
            document.getElementById(buttonId).textContent = 'Show';
          }
        });
      }

      toggleVisibility('togglePassword', password);
      toggleVisibility('toggleConfirmPassword', confirmPassword);

      function clearMessages() {
        userIdentifierError.textContent = '';
        passwordError.textContent = '';
        confirmPasswordError.textContent = '';
      }

      function validate() {
        let valid = true;

        if (!phoneContainer.classList.contains('hidden')) {
          if (!/^[0-9]{10}$/.test(userIdentifier.value.trim())) {
            userIdentifierError.textContent =
              'Contact number must be exactly 10 digits';

            valid = false;
          }
        }

        if (password.value.length < 8) {
          passwordError.textContent = 'Password must be at least 8 characters';

          valid = false;
        }

        if (confirmPassword.value !== password.value) {
          confirmPasswordError.textContent = 'Passwords do not match';

          valid = false;
        }

        return valid;
      }

      resetForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        clearMessages();

        if (!validate()) {
          return;
        }

        submitBtn.disabled = true;
        submitBtn.textContent = 'Resetting...';

        try {
          const body = {
            password: password.value,
            confirmPassword: confirmPassword.value,
          };

          if (!phoneContainer.classList.contains('hidden')) {
            body.userIdentifier = userIdentifier.value.trim();
          }

          const response = await fetch(`/auth/reset-password/${resetToken}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(body),
          });

          const data = await response.json();

          if (!response.ok) {
            showToast(data.message || 'Password reset failed', 'error');
            return;
          }

          showToast(data.message || 'Password reset successfully', 'success');

          setTimeout(() => {
            window.location.href = '/loginPage';
          }, 2000);
        } catch (error) {
          showToast('Something went wrong. Please try again.', 'error');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Reset Password';
        }
      });
    </script>
  <%- include('../partials/toast') %>
  </body>
</html>
