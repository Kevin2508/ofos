<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Management | ofos Admin</title>
    <link rel="stylesheet" href="/styles/build.css" />
  </head>

  <body class="min-h-screen bg-orange-50">
    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="w-64 bg-white border-r border-orange-100 shadow-md">
        <div class="p-6">
          <h1 class="text-3xl font-extrabold text-orange-500">ofos Admin</h1>
        </div>

        <nav class="px-4 space-y-2">
          <a
            href="/admin/dashboard"
            class="block px-4 py-2 rounded-xl hover:bg-orange-50"
          >
            Dashboard
          </a>

          <a
            href="/admin/users"
            class="block px-4 py-2 rounded-xl bg-orange-100 text-orange-600 font-semibold"
          >
            User Management
          </a>

          <a
            href="/admin/restaurants"
            class="block px-4 py-2 rounded-xl hover:bg-orange-50"
          >
            Restaurants
          </a>

          <a
            href="/admin/orders"
            class="block px-4 py-2 rounded-xl hover:bg-orange-50"
          >
            Orders
          </a>

          <a
            href="/admin/config"
            class="block px-4 py-2 rounded-xl hover:bg-orange-50"
          >
            System Config
          </a>

          <a
            href="/admin/audit-logs"
            class="block px-4 py-2 rounded-xl hover:bg-orange-50"
          >
            Audit Logs
          </a>
        </nav>
      </aside>

      <!-- Main -->
      <main class="flex-1 p-8">
        <!-- Header -->
        <div class="mb-6">
          <h2 class="text-2xl font-bold text-gray-800">User Management</h2>

          <p class="text-gray-600">Manage customer, owners, staff and admins</p>
        </div>

        <!-- Filters -->
        <div
          class="bg-white rounded-2xl shadow border border-orange-100 p-5 mb-6"
        >
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <input
              id="searchInput"
              type="text"
              placeholder="Search name, email or phone"
              class="px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-orange-500 focus:outline-none"
            />

            <select
              id="roleFilter"
              class="px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-orange-500 focus:outline-none"
            >
              <option value="">All Roles</option>
              <option>customer</option>
              <option>restaurant_owner</option>
              <option>restaurant_staff</option>
              <option>fleet_manager</option>
              <option>platform_admin</option>
            </select>

            <select
              id="statusFilter"
              class="px-4 py-3 rounded-xl border border-gray-300 focus:ring-2 focus:ring-orange-500 focus:outline-none"
            >
              <option value="">All Status</option>
              <option>active</option>
              <option>inactive</option>
              <option>banned</option>
            </select>
          </div>
        </div>

        <!-- Table -->
        <div
          class="bg-white rounded-2xl shadow border border-orange-100 overflow-x-auto"
        >
          <table class="w-full">
            <thead class="bg-orange-100">
              <tr class="text-left">
                <th class="p-4">Name</th>
                <th class="p-4">Email</th>
                <th class="p-4">Phone</th>
                <th class="p-4">Role</th>
                <th class="p-4">Status</th>
                <th class="p-4">Action</th>
              </tr>
            </thead>

            <tbody id="usersTable">
              <tr>
                <td colspan="6" class="text-center p-6 text-gray-500">
                  Loading users...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </main>
    </div>

    <!-- User Details Modal -->
    <div
      id="userModal"
      class="hidden fixed inset-0 bg-black/40 flex items-center justify-center p-4"
    >
      <div class="bg-white w-full max-w-lg rounded-3xl p-6">
        <div class="flex justify-between items-center mb-5">
          <h3 class="text-xl font-bold">User Details</h3>

          <button onclick="closeModal()">✕</button>
        </div>

        <div id="userDetails" class="space-y-3 text-gray-700"></div>

        <div class="mt-5">
          <label class="block mb-2 font-semibold"> Role </label>

          <select id="updateRole" class="w-full px-4 py-3 rounded-xl border">
            <option>customer</option>
            <option>restaurant_owner</option>
            <option>restaurant_staff</option>
            <option>fleet_manager</option>
            <option>platform_admin</option>
          </select>
        </div>

        <div class="mt-4">
          <label class="block mb-2 font-semibold"> Status </label>

          <select id="updateStatus" class="w-full px-4 py-3 rounded-xl border">
            <option>active</option>
            <option>inactive</option>
            <option>banned</option>
          </select>
        </div>

        <button
          id="updateBtn"
          onclick="updateUser()"
          class="w-full mt-6 bg-orange-500 text-white py-3 rounded-xl hover:bg-orange-600"
        >
          Update User
        </button>
      </div>
    </div>

    <script>
      let users = [];
      let selectedUserId = null;

      // Get users
      async function fetchUsers() {
        try {
          const response = await fetch('/admin/users');

          users = await response.json();

          renderUsers(users);
        } catch (error) {
          console.log(error);
        }
      }

      function renderUsers(data) {
        const table = document.getElementById('usersTable');

        if (!data.length) {
          table.innerHTML = `
      <tr>
        <td colspan="6" class="p-6 text-center">
          No users found
        </td>
      </tr>
    `;

          return;
        }

        table.innerHTML = data
          .map(
            (user) => `

    <tr class="border-t">

      <td class="p-4">
        ${user.firstName}
      </td>

      <td class="p-4">
        ${user.email}
      </td>

      <td class="p-4">
        ${user.phone}
      </td>

      <td class="p-4 capitalize">
        ${user.role}
      </td>

      <td class="p-4 capitalize">
        ${user.status}
      </td>

      <td class="p-4">

        <button
          onclick="viewUser('${user.id}')"
          class="bg-orange-500 text-white px-3 py-2 rounded-lg">

          View

        </button>

      </td>

    </tr>

  `
          )
          .join('');
      }

      // View User
      async function viewUser(id) {
        selectedUserId = id;

        const response = await fetch(`/admin/user/${id}`);

        const user = await response.json();

        document.getElementById('userDetails').innerHTML = `
    <p><b>Name:</b> ${user.firstName}</p>
    <p><b>Email:</b> ${user.email}</p>
    <p><b>Phone:</b> ${user.phone}</p>
  `;

        document.getElementById('updateRole').value = user.role;

        document.getElementById('updateStatus').value = user.status;

        document.getElementById('userModal').classList.remove('hidden');
      }

      function closeModal() {
        document.getElementById('userModal').classList.add('hidden');
      }

      // Update user
      async function updateUser() {
        const btn = document.getElementById('updateBtn');

        btn.disabled = true;
        btn.textContent = 'Updating...';

        try {
          const response = await fetch(`/admin/user/${selectedUserId}/status`, {
            method: 'PATCH',

            headers: {
              'Content-Type': 'application/json',
            },

            body: JSON.stringify({
              role: document.getElementById('updateRole').value,
              status: document.getElementById('updateStatus').value,
            }),
          });

          if (response.ok) {
            closeModal();

            fetchUsers();
          }
        } finally {
          btn.disabled = false;
          btn.textContent = 'Update User';
        }
      }

      // Initial Load
      fetchUsers();
    </script>
  </body>
</html>
