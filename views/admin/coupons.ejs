<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Coupons | Admin | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
  <script src="/js/form-validator.js"></script>
</head>

<body class="min-h-screen bg-orange-50 font-sans text-gray-800">
  <div class="flex min-h-screen">
    <%- include('../partials/admin/sidebar') %>
      <main class="flex-1 lg:ml-72 p-5 sm:p-8 transition-all duration-300" id="mainContentWrapper">
        <div class="mb-8 flex justify-between items-end">
          <div>
            <h2 class="text-3xl font-bold text-gray-900">Coupons & Promos</h2>
            <p class="text-gray-500 mt-2">Manage platform-wide promotional campaigns.</p>
          </div>
          <button onclick="openCreateModal()"
            class="px-4 py-2 bg-orange-600 text-white rounded-lg text-sm font-bold shadow hover:bg-orange-700">
            Create Coupon
          </button>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left whitespace-nowrap">
              <thead>
                <tr class="bg-slate-50 border-b border-gray-100 text-slate-500 text-sm uppercase tracking-wider">
                  <th class="px-6 py-4 font-semibold">Code</th>
                  <th class="px-6 py-4 font-semibold">Value</th>
                  <th class="px-6 py-4 font-semibold">Valid Until</th>
                  <th class="px-6 py-4 font-semibold">Status</th>
                  <th class="px-6 py-4 font-semibold text-right">Actions</th>
                </tr>
              </thead>
              <tbody id="couponsList" class="divide-y divide-gray-50 text-gray-700">
                <tr>
                  <td colspan="5" class="px-6 py-8 text-center text-gray-500">Loading...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </main>
  </div>

  <div id="couponModal"
    class="hidden fixed inset-0 bg-gray-900/40 backdrop-blur-sm z-[80] flex items-center justify-center p-4 transition-opacity duration-300 opacity-0">
    <div
      class="bg-white w-full max-w-md rounded-3xl shadow-xl transform transition-transform duration-300 scale-95 p-4 sm:p-6">
      <h3 class="text-2xl font-bold text-gray-900 mb-4">Create Coupon</h3>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-semibold mb-1">Code</label>
          <input type="text" id="couponCode" class="w-full px-4 py-2 border border-gray-300 rounded-lg uppercase"
            placeholder="SUMMER20">
          <p id="couponCodeError" class="mt-1 text-sm text-red-500"></p>
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1">Type</label>
          <select id="couponType" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
            <option value="PERCENTAGE">Percentage</option>
            <option value="FIXED">Fixed Amount</option>
          </select>
          <p id="couponTypeError" class="mt-1 text-sm text-red-500"></p>
        </div>
        <div>
          <label class="block text-sm font-semibold mb-1">Value</label>
          <input type="number" id="couponValue" class="w-full px-4 py-2 border border-gray-300 rounded-lg" placeholder="20">
          <p id="couponValueError" class="mt-1 text-sm text-red-500"></p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-semibold mb-1">Valid From</label>
            <input type="datetime-local" id="validFrom" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
            <p id="validFromError" class="mt-1 text-sm text-red-500"></p>
          </div>
          <div>
            <label class="block text-sm font-semibold mb-1">Valid Until</label>
            <input type="datetime-local" id="validUntil" class="w-full px-4 py-2 border border-gray-300 rounded-lg">
            <p id="validUntilError" class="mt-1 text-sm text-red-500"></p>
          </div>
        </div>
        <div class="flex gap-3 mt-6">
          <button onclick="closeModal()"
            class="flex-1 bg-gray-100 text-gray-800 py-2 rounded-lg font-bold">Cancel</button>
          <button onclick="createCoupon()"
            class="flex-1 bg-orange-600 text-white py-2 rounded-lg font-bold">Create</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let coupons = [];

    function openCreateModal() {
      const modal = document.getElementById('couponModal');
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modal.firstElementChild.classList.remove('scale-95');
      }, 10);
    }

    function closeModal() {
      const modal = document.getElementById('couponModal');
      modal.classList.add('opacity-0');
      modal.firstElementChild.classList.add('scale-95');
      setTimeout(() => modal.classList.add('hidden'), 300);
    }

    async function loadCoupons() {
      try {
        const res = await fetch('/admin/coupons');
        if (res.ok) {
          const data = await res.json();
          coupons = data.data.coupons || [];
          renderCoupons();
        }
      } catch (e) { console.error(e); }
    }

    function renderCoupons() {
      const list = document.getElementById('couponsList');
      if (coupons.length === 0) {
        list.innerHTML = '<tr><td colspan="5" class="text-center p-4 sm:p-6 text-gray-500">No coupons found.</td></tr>';
        return;
      }
      list.innerHTML = coupons.map(c => `
            <tr class="hover:bg-gray-50 border-t border-gray-100">
                <td class="px-6 py-4 font-bold text-gray-900">${c.code}</td>
                <td class="px-6 py-4">${c.value} (${c.couponType})</td>
                <td class="px-6 py-4 text-sm text-gray-500">${new Date(c.validUntil).toLocaleString()}</td>
                <td class="px-6 py-4">
                    <span class="px-2 py-1 text-xs font-bold rounded ${c.isActive ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
                        ${c.isActive ? 'ACTIVE' : 'INACTIVE'}
                    </span>
                </td>
                <td class="px-6 py-4 text-right">
                    <button onclick="toggleCoupon('${c.id}', ${!c.isActive})" class="${c.isActive ? 'text-red-600' : 'text-green-600'} font-bold text-sm">
                        ${c.isActive ? 'Deactivate' : 'Activate'}
                    </button>
                </td>
            </tr>
        `).join('');
    }

    const couponRules = {
      couponCode: { required: true, label: 'Coupon code' },
      couponType: { required: true, oneOf: ['FIXED', 'PERCENTAGE'], label: 'Coupon type' },
      couponValue: { required: true, isPositive: true, label: 'Value' },
      validFrom: { required: true, isDate: true, label: 'Valid from' },
      validUntil: { required: true, isDate: true, dateAfterField: 'validFrom', dateAfterMsg: 'Valid until must be after valid from', label: 'Valid until' },
    };

    FormValidator.bindLiveValidation(couponRules);

    async function createCoupon() {
      if (!FormValidator.validate(couponRules)) return;

      const payload = {
        code: document.getElementById('couponCode').value.toUpperCase(),
        couponType: document.getElementById('couponType').value,
        value: parseFloat(document.getElementById('couponValue').value),
        validFrom: new Date(document.getElementById('validFrom').value).toISOString(),
        validUntil: new Date(document.getElementById('validUntil').value).toISOString()
      };
      try {
        const res = await fetch('/admin/coupons', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (res.ok) {
          closeModal();
          loadCoupons();
        } else {
          const data = await res.json();
          showToast(data.message || 'Failed to create coupon', 'error');
        }
      } catch (e) { showToast('Error creating coupon', 'error'); }
    }

    async function toggleCoupon(id, isActive) {
      try {
        const res = await fetch(`/admin/coupons/${id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ isActive })
        });
        if (res.ok) {
          loadCoupons();
        }
      } catch (e) { alert('Error updating coupon'); }
    }

    loadCoupons();
  </script>
</body>

</html>