<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Registration | epicure- Food Ordering System</title>
  <link rel="stylesheet" href="/styles/build.css" />
  <script src="/js/form-validator.js"></script>
</head>

<body>
  <div class="min-h-screen bg-gray-50 flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-5 sm:p-8">
      <!-- Header -->
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-800 mb-2">Register Admin</h2>
        <p class="text-gray-500 text-sm">Create an admin account to manage the platform</p>
      </div>

      <!-- Form -->
      <form id="adminRegisterForm" class="space-y-5">
        <!-- Name Fields Row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              First Name <span class="text-red-500">*</span>
            </label>
            <input type="text" id="firstName" name="firstName" placeholder="John" maxlength="100" required
               minlength="2" pattern="^[A-Za-z]+$" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-colors" />
            <p id="firstNameError" class="mt-1 text-sm text-red-500"></p>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Last Name
            </label>
            <input type="text" id="lastName" name="lastName" placeholder="Doe" maxlength="100"
               pattern="^[A-Za-z]+$" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-colors" />
            <p id="lastNameError" class="mt-1 text-sm text-red-500"></p>
          </div>
        </div>

        <!-- Email -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Email <span class="text-red-500">*</span>
          </label>
          <input type="email" id="email" name="email" placeholder="admin@example.com" pattern="^[^\s@]+@[^\s@]+\.(com|net|org|io)$" required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-colors" />
          <p id="emailError" class="mt-1 text-sm text-red-500"></p>
        </div>

        <!-- Phone -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Phone <span class="text-red-500">*</span>
          </label>
          <input type="text" id="phone" name="phone" placeholder="10 digit number" pattern="^[0-9]{10}$" minlength="10" maxlength="10" required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-colors" />
          <p id="phoneError" class="mt-1 text-sm text-red-500"></p>
        </div>

        <!-- Password & Confirm Password -->
        <div class="space-y-4">
          <!-- Password -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Password <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <input type="password" id="password" name="password" placeholder="Min 8 characters" minlength="8" required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-colors pr-12" />
              <button type="button" id="togglePassword"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 transition-colors">
                <!-- Eye Icon (Visible) -->
                <svg id="eyeIcon1" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <!-- Eye Slash Icon (Hidden) -->
                <svg id="eyeSlashIcon1" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21" />
                </svg>
              </button>
            </div>
            <p id="passwordError" class="mt-1 text-sm text-red-500"></p>
          </div>

          <!-- Confirm Password -->
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Confirm Password <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Repeat password" minlength="8" required
                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-colors pr-12" />
              <button type="button" id="toggleConfirmPassword"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700 transition-colors">
                <!-- Eye Icon (Visible) -->
                <svg id="eyeIcon2" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <!-- Eye Slash Icon (Hidden) -->
                <svg id="eyeSlashIcon2" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21" />
                </svg>
              </button>
            </div>
            <p id="confirmPasswordError" class="mt-1 text-sm text-red-500"></p>
          </div>
        </div>

        <!-- Register Admin Button -->
        <button type="submit" id="submitBtn"
          class="w-full bg-orange-500 hover:bg-orange-600 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 shadow-md hover:shadow-lg mt-2">
          Register Admin
        </button>
      </form>

      <!-- Footer -->
      <div class="text-center mt-6 pt-6 border-t border-gray-200">
        <p class="text-sm text-gray-600">
          Already have an account?
          <a href="/loginPage" class="font-medium text-orange-500 hover:text-orange-600 transition-colors">
            Login
          </a>
        </p>
      </div>
    </div>
  </div>

  <script>
    async function checkAndPrefill() {
      try {
        const res = await fetch('/auth/me');
        if (res.ok) {
          const json = await res.json();
          const u = json.data.user;
          if (u) {
            if (document.getElementById('firstName')) {
              document.getElementById('firstName').value = u.firstName || '';
              document.getElementById('firstName').readOnly = true;
            }
            if (document.getElementById('lastName')) {
              document.getElementById('lastName').value = u.lastName || '';
              document.getElementById('lastName').readOnly = true;
            }
            if (document.getElementById('email')) {
              document.getElementById('email').value = u.email || '';
              document.getElementById('email').readOnly = true;
            }
            if (document.getElementById('phone')) {
              document.getElementById('phone').value = u.phone || '';
              document.getElementById('phone').readOnly = true;
            }
            const pwInput = document.getElementById('password');
            if (pwInput) {
              pwInput.value = 'ExistingUserPassword123';
              const container = pwInput.closest('.space-y-4') || pwInput.parentElement?.parentElement;
              if (container) container.style.display = 'none';
            }
            const cpwInput = document.getElementById('confirmPassword');
            if (cpwInput) {
              cpwInput.value = 'ExistingUserPassword123';
            }
          }
        }
      } catch (e) {
        console.error('Error pre-filling profile', e);
      }
    }
    checkAndPrefill();

    function setupPasswordToggle(
      toggleBtnId,
      inputId,
      eyeIconId,
      eyeSlashIconId
    ) {
      const toggleBtn = document.getElementById(toggleBtnId);
      const input = document.getElementById(inputId);
      const eyeIcon = document.getElementById(eyeIconId);
      const eyeSlashIcon = document.getElementById(eyeSlashIconId);

      toggleBtn.addEventListener('click', function () {
        const type =
          input.getAttribute('type') === 'password' ? 'text' : 'password';
        input.setAttribute('type', type);
        eyeIcon.classList.toggle('hidden');
        eyeSlashIcon.classList.toggle('hidden');
      });
    }

    setupPasswordToggle(
      'togglePassword',
      'password',
      'eyeIcon1',
      'eyeSlashIcon1'
    );
    setupPasswordToggle(
      'toggleConfirmPassword',
      'confirmPassword',
      'eyeIcon2',
      'eyeSlashIcon2'
    );

    const adminRules = {
      firstName: { required: true, maxLength: 100, label: 'First name' },
      lastName: { maxLength: 100, label: 'Last name' },
      email: { required: true, isEmail: true, emailTlds: ['com','net','org','io'], label: 'Email' },
      phone: { required: true, exactLength: 10, pattern: /^[0-9]+$/, patternMsg: 'Contact number must only contain digits', label: 'Phone' },
      password: { required: true, minLength: 8, label: 'Password' },
      confirmPassword: { required: true, minLength: 8, matchField: 'password', matchMsg: 'Passwords do not match', label: 'Confirm password' },
    };

    FormValidator.bindLiveValidation(adminRules);

    document
      .getElementById('adminRegisterForm')
      .addEventListener('submit', async function (event) {
        event.preventDefault();

        if (!FormValidator.validate(adminRules)) return;

        const submitBtn = document.getElementById('submitBtn');
        const firstName = document.getElementById('firstName').value.trim();
        const lastName = document.getElementById('lastName').value.trim();
        const email = document.getElementById('email').value.trim();
        const phone = document.getElementById('phone').value.trim();
        const password = document.getElementById('password').value;
        const confirmPassword = document.getElementById('confirmPassword').value;

        try {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Registering Admin...';

          const payload = { firstName, email, phone, password, confirmPassword };
          if (lastName) payload.lastName = lastName;

          const response = await fetch('/auth/register/admin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await response.json();

          if (!response.ok) {
            throw new Error(data.message || 'Admin registration failed. Please try again.');
          }

          showToast('Admin account created successfully! Redirecting...', 'success');
          document.getElementById('adminRegisterForm').reset();
        } catch (error) {
          showToast(error.message, 'error');
        } finally {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Register Admin';
        }
      });
  </script>
  <%- include('../../partials/toast') %>
</body>

</html>