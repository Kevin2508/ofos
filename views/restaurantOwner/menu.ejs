                <div class="flex-1 min-w-0">
                  <div class="flex justify-between items-start">
                    <h5 class="font-bold text-gray-800 line-clamp-1">${item.name}</h5>
                    <span class="font-bold text-orange-600">₹${item.basePrice}</span>
                  </div>
                  <p class="text-xs text-gray-500 mb-1">SKU: ${item.sku}</p>
                  <p class="text-xs text-gray-500 line-clamp-1 mb-2">${item.description || ''}</p>
                  <div class="flex items-center gap-2 mb-2 flex-wrap">
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${item.foodType === 'VEG' ? 'bg-green-100 text-green-700' : item.foodType === 'NON_VEG' ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700'}">${item.foodType}</span>
                    ${item.isBestseller ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-orange-100 text-orange-700">★ Bestseller</span>` : ''}
                    ${item.isAvailable ? `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-blue-100 text-blue-700">Available</span>` : `<span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-gray-200 text-gray-700">Unavailable</span>`}
