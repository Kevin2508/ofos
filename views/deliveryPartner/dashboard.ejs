<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Delivery Partner Dashboard | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
</head>

<body class="min-h-screen bg-orange-50 font-sans">
  <div class="flex min-h-screen">
    <%- include('../partials/deliveryPartner/sidebar') %>

      <!-- MAIN CONTENT -->
      <main class="flex-1 lg:ml-72 p-4 md:p-6 lg:p-8 transition-all duration-300 w-full overflow-hidden"
        id="mainContentWrapper">
        <!-- Greeting & Status -->
        <div
          class="mb-8 flex flex-col md:flex-row md:justify-between md:items-center gap-4 bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-orange-100">
          <div class="flex flex-wrap items-start md:items-center gap-3">
            <button onclick="toggleSidebar()"
              class="p-2 -ml-2 mt-1 md:mt-0 text-gray-600 hover:text-orange-500 rounded-xl hover:bg-orange-50 transition-colors lg:hidden">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
            <div>
              <h2 class="text-2xl font-bold text-gray-800">Welcome back, Partner</h2>
              <p class="text-gray-500 mt-1">
                Ready to deliver some smiles today?
              </p>
            </div>
          </div>
          <div class="flex items-center space-x-4 bg-orange-50 px-5 py-3 rounded-xl border border-orange-100">
            <span class="text-gray-700 font-semibold">Duty Status:</span>
            <label class="flex items-center cursor-pointer">
              <div class="relative">
                <input type="checkbox" id="statusToggle" class="sr-only" />
                <div class="block bg-gray-300 w-14 h-8 rounded-full shadow-inner transition-colors duration-300"
                  id="statusBg"></div>
                <div
                  class="dot absolute left-1 top-1 bg-white w-6 h-6 rounded-full shadow-md transition transform translate-x-0 duration-300"
                  id="statusDot"></div>
              </div>
            </label>
            <span id="statusLabel" class="text-gray-500 font-bold w-16 tracking-wide">OFFLINE</span>
          </div>
        </div>

        <!-- STAT CARDS -->
        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-3 sm:gap-6">
          <div
            class="bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-orange-100 hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start">
              <div>
                <p class="text-gray-500 text-sm font-medium">Today's Earnings</p>
                <h3 id="totalEarnings" class="text-3xl font-extrabold text-gray-800 mt-2">₹0</h3>
              </div>
              <div class="p-3 bg-orange-100 text-orange-600 rounded-lg">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                  </path>
                </svg>
              </div>
            </div>
            <p class="text-xs text-green-500 mt-4 font-medium flex items-center">
              <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18">
                </path>
              </svg>
              Updated just now
            </p>
          </div>

          <div
            class="bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-orange-100 hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start">
              <div>
                <p class="text-gray-500 text-sm font-medium">Deliveries Completed</p>
                <h3 id="deliveriesCompleted" class="text-3xl font-extrabold text-gray-800 mt-2">0</h3>
              </div>
              <div class="p-3 bg-blue-100 text-blue-600 rounded-lg">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
                </svg>
              </div>
            </div>
          </div>

          <div
            class="bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-orange-100 hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start">
              <div>
                <p class="text-gray-500 text-sm font-medium">Customer Rating</p>
                <h3 id="currentRating" class="text-3xl font-extrabold text-gray-800 mt-2">0.0</h3>
              </div>
              <div class="p-3 bg-yellow-100 text-yellow-600 rounded-lg">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                  <path
                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z">
                  </path>
                </svg>
              </div>
            </div>
          </div>

          <div
            class="bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-orange-100 hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start">
              <div>
                <p class="text-gray-500 text-sm font-medium">Acceptance Rate</p>
                <h3 id="acceptanceRate" class="text-3xl font-extrabold text-gray-800 mt-2">0%</h3>
              </div>
              <div class="p-3 bg-purple-100 text-purple-600 rounded-lg">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            </div>
          </div>

          <div
            class="bg-white p-4 sm:p-6 rounded-2xl shadow-sm border border-orange-100 hover:shadow-md transition-shadow">
            <div class="flex justify-between items-start">
              <div>
                <p class="text-gray-500 text-sm font-medium">On-Time Delivery Rate</p>
                <h3 id="onTimeRate" class="text-3xl font-extrabold text-gray-800 mt-2">0%</h3>
              </div>
              <div class="p-3 bg-teal-100 text-teal-600 rounded-lg">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- ACTIVE ASSIGNMENT -->
        <div class="mt-10">
          <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
            <span class="w-2 h-6 bg-orange-500 rounded-full mr-3"></span>
            Active Assignment
          </h3>
          <div id="activeAssignmentContainer"
            class="bg-white p-5 sm:p-8 rounded-2xl shadow-sm border border-orange-100 text-center flex flex-col items-center justify-center">
            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mb-4">
              <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <p class="text-gray-500 text-lg font-medium">No active assignment right now.</p>
            <p class="text-sm text-gray-400 mt-1">Stay online and wait for incoming orders!</p>
          </div>
        </div>

        <!-- RECENT ASSIGNMENTS -->
        <div class="mt-10">
          <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
            <span class="w-2 h-6 bg-gray-800 rounded-full mr-3"></span>
            Recent Assignments
          </h3>
          <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-left whitespace-nowrap">
                <thead>
                  <tr class="bg-gray-50 border-b border-gray-100 text-gray-500 text-sm uppercase tracking-wider">
                    <th class="px-6 py-4 font-semibold">Order ID</th>
                    <th class="px-6 py-4 font-semibold">Restaurant</th>
                    <th class="px-6 py-4 font-semibold">Date</th>
                    <th class="px-6 py-4 font-semibold">Status</th>
                    <th class="px-6 py-4 font-semibold text-right">Earnings</th>
                  </tr>
                </thead>
                <tbody id="recentAssignmentsList" class="divide-y divide-gray-50 text-gray-700">
                  <tr>
                    <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                      <div class="animate-pulse flex space-x-4 justify-center">
                        <div class="flex-1 space-y-4 py-1 max-w-sm">
                          <div class="h-4 bg-gray-200 rounded w-3/4 mx-auto"></div>
                          <div class="h-4 bg-gray-200 rounded w-1/2 mx-auto"></div>
                        </div>
                      </div>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </main>
  </div>

  <script>
    // Toggle logic
    const statusToggle = document.getElementById('statusToggle');
    const statusBg = document.getElementById('statusBg');
    const statusDot = document.getElementById('statusDot');
    const statusLabel = document.getElementById('statusLabel');

    statusToggle.addEventListener('change', async (e) => {
      const isChecked = e.target.checked;
      const newStatus = isChecked ? 'ONLINE' : 'OFFLINE';

      try {
        const res = await fetch('/delivery-partner/update/status', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ isOnline: isChecked })
        });

        if (!res.ok) throw new Error('Failed to update status');

        // Update UI
        if (isChecked) {
          statusBg.classList.replace('bg-gray-300', 'bg-green-500');
          statusDot.classList.replace('translate-x-0', 'translate-x-6');
          statusLabel.textContent = 'ONLINE';
          statusLabel.classList.replace('text-gray-500', 'text-green-600');
        } else {
          statusBg.classList.replace('bg-green-500', 'bg-gray-300');
          statusDot.classList.replace('translate-x-6', 'translate-x-0');
          statusLabel.textContent = 'OFFLINE';
          statusLabel.classList.replace('text-green-600', 'text-gray-500');
        }
        showToast(`You are now ${newStatus.toLowerCase()}`, 'success');
      } catch (err) {
        e.target.checked = !isChecked; // Revert
        showToast(err.message, 'error');
      }
    });

    let lastAlertedAssignmentId = null;

    // Load data
    async function loadDashboardData() {
      try {
        const headers = {};
        let profData = null;

        // Profile / Status
        const profRes = await fetch('/delivery-partner/profile', { headers });
        if (profRes.ok) {
          profData = await profRes.json();
          const isOnline = profData?.user?.deliveryPartner?.isOnline === true;
          if (isOnline) {
            statusToggle.checked = true;
            statusBg.classList.replace('bg-gray-300', 'bg-green-500');
            statusDot.classList.replace('translate-x-0', 'translate-x-6');
            statusLabel.textContent = 'ONLINE';
            statusLabel.classList.replace('text-gray-500', 'text-green-600');
          }
        }

        // Performance
        const perfRes = await fetch('/delivery-partner/performance', { headers });
        if (perfRes.ok) {
          const perfData = await perfRes.json();
          document.getElementById('deliveriesCompleted').innerText = perfData.performance?.totalCompleted || 0;
          document.getElementById('currentRating').innerText = (profData?.user?.deliveryPartner?.averageRating || '0.0');
          document.getElementById('acceptanceRate').innerText = (perfData.performance?.acceptanceRate || 0) + '%';
          // Mocking on-time delivery rate from completion rate for display
          document.getElementById('onTimeRate').innerText = (perfData.performance?.completionRate || 0) + '%';
        }

        // Earnings
        const earnRes = await fetch('/delivery-partner/earnings?period=today', { headers });
        if (earnRes.ok) {
          const earnData = await earnRes.json();
          document.getElementById('totalEarnings').innerText = '₹' + (earnData.earnings?.totalEarning || 0);
        }

        // Assignments
        const assgnRes = await fetch('/delivery-partner/assignments/all');
        const list = document.getElementById('recentAssignmentsList');
        if (assgnRes.ok) {
          const assgnData = await assgnRes.json();
          const assignments = assgnData.assignments || [];

          if (assignments.length === 0) {
            list.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500 bg-gray-50/50">No assignments found yet.</td></tr>`;
          } else {
            list.innerHTML = assignments.map(a => `
                <tr class="hover:bg-orange-50 transition-colors group cursor-pointer">
                  <td class="px-6 py-4 font-medium text-gray-900 group-hover:text-orange-600">#${a.id}</td>
                  <td class="px-6 py-4 text-gray-600">${a.restaurant?.businessName || 'Unknown'}</td>
                  <td class="px-6 py-4 text-gray-500 text-sm">${new Date(a.createdAt).toLocaleDateString()}</td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${a.status === 'DELIVERED' ? 'bg-green-100 text-green-800' :
                a.status === 'CANCELLED' ? 'bg-red-100 text-red-800' :
                  'bg-orange-100 text-orange-800'
              }">
                      ${a.status}
                    </span>
                  </td>
                  <td class="px-6 py-4 text-right font-semibold text-gray-700">₹${a.earnings || 0}</td>
                </tr>
              `).join('');
          }

          const active = assignments.find(a => ['PENDING', 'ACCEPTED', 'PICKED_UP', 'OUT_FOR_DELIVERY', 'ASSIGNED'].includes(a.status));
          if (active) {
            if (active.status === 'PENDING' && lastAlertedAssignmentId !== active.id) {
              lastAlertedAssignmentId = active.id;
              showAlertModal(active);
            }

            let actionsHtml = '';
            if (active.status === 'PENDING') {
              actionsHtml = `
                  <button onclick="handleAssignmentAction('${active.id}', 'accept')" class="bg-green-500 text-white px-4 py-2 rounded-lg font-bold">Accept</button>
                  <button onclick="handleAssignmentAction('${active.id}', 'decline')" class="bg-red-500 text-white px-4 py-2 rounded-lg font-bold">Decline</button>
                `;
            } else if (active.status === 'ACCEPTED') {
              actionsHtml = `<button onclick="handleAssignmentAction('${active.id}', 'pickup')" class="bg-orange-500 text-white px-4 py-2 rounded-lg font-bold">Mark Picked Up</button>`;
              startLocationPing(active.id);
            } else if (active.status === 'PICKED_UP') {
              actionsHtml = `<button onclick="handleAssignmentAction('${active.id}', 'out-for-delivery')" class="bg-blue-500 text-white px-4 py-2 rounded-lg font-bold shadow-md transition-colors hover:bg-blue-600">Mark Out for Delivery</button>`;
              startLocationPing(active.id);
            } else if (active.status === 'OUT_FOR_DELIVERY') {
              actionsHtml = `
                  <button onclick="showDeliveryOtpModal('${active.id}')" class="bg-green-500 text-white px-6 py-2 rounded-lg font-bold shadow-md transition-colors hover:bg-green-600">Mark as Delivered</button>
                `;
              startLocationPing(active.id);
            }

            document.getElementById('activeAssignmentContainer').innerHTML = `
                <div class="w-full text-left">
                  <div class="flex justify-between items-center mb-4">
                    <h4 class="text-xl font-bold">Order #${active.orderId}</h4>
                    <span class="bg-orange-100 text-orange-800 px-3 py-1 rounded-full text-sm font-bold">${active.status}</span>
                  </div>
                  <div class="mb-4 bg-gray-50 p-3 rounded-lg border border-gray-100">
                    <div class="flex justify-between items-center mb-2">
                      <p class="text-sm font-semibold text-gray-700">Earnings: <span class="text-green-600">₹${active.earnings || 40}</span></p>
                      <p class="text-sm font-semibold text-gray-700">Distance: <span class="text-blue-600">${active.distance || 3.2} km</span></p>
                    </div>
                    ${active.status === 'ACCEPTED' ? `
                      <div class="mt-2 text-sm text-gray-600">
                        <p class="font-bold text-gray-800">Pickup Location:</p>
                        <p>${active.restaurant?.name || 'Restaurant'}</p>
                        <p>${active.restaurant?.address || 'Address pending...'}</p>
                      </div>
                    ` : ''}
                    ${(active.status === 'PICKED_UP' || active.status === 'OUT_FOR_DELIVERY') ? `
                      <div class="mt-2 text-sm text-gray-600">
                        <p class="font-bold text-gray-800">Delivery Location:</p>
                        <p>${active.customer?.address || 'Address pending...'}</p>
                      </div>
                    ` : ''}
                  </div>
                  <div class="flex gap-2">
                    ${actionsHtml}
                    <button onclick="reportIssue('${active.id}')" class="bg-gray-200 text-gray-700 px-4 py-2 rounded-lg font-bold ml-auto">Report Issue</button>
                  </div>
                  <div id="deliveryMap" class="w-full h-64 mt-4 rounded-xl border border-gray-200 z-10 hidden"></div>
                  <div id="turnByTurnContainer" class="w-full mt-4 max-h-48 overflow-y-auto bg-orange-50 rounded-xl p-4 border border-orange-100 hidden text-sm text-gray-800"></div>
                </div>
              `;

            if (active.status === 'ACCEPTED' || active.status === 'PICKED_UP' || active.status === 'OUT_FOR_DELIVERY') {
              setTimeout(() => initMap(active), 100);
            }
          } else {
            document.getElementById('activeAssignmentContainer').innerHTML = `
                <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mb-4">
                  <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
                <p class="text-gray-500 text-lg font-medium">No active assignment right now.</p>
                <p class="text-sm text-gray-400 mt-1">Stay online and wait for incoming orders!</p>
              `;
            stopLocationPing();
          }
        } else {
          list.innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-gray-500 bg-gray-50/50">Could not load assignments.</td></tr>`;
        }
      } catch (err) {
        console.error('Error loading dashboard', err);
        document.getElementById('recentAssignmentsList').innerHTML = `<tr><td colspan="5" class="px-6 py-8 text-center text-red-500">Failed to load dashboard data.</td></tr>`;
      }
    }

    function showAlertModal(assignment) {
      const modal = document.createElement('div');
      modal.className = 'fixed inset-0 z-[100] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4';
      const earnings = assignment.earnings || 40; // Default base earning
      modal.innerHTML = `
        <div class="bg-white rounded-2xl shadow-2xl p-6 max-w-sm w-full animate-[bounce_1s_infinite]">
          <h2 class="text-2xl font-bold text-orange-600 mb-4 flex items-center gap-2">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path></svg>
            New Order!
          </h2>
          <div class="space-y-3 mb-6 text-gray-700">
            <p><strong class="text-gray-900">Restaurant:</strong> ${assignment.restaurant?.name || 'Unknown'}</p>
            <p><strong class="text-gray-900">Pickup:</strong> ${assignment.restaurant?.address || 'Unknown'}</p>
            <p><strong class="text-gray-900">Customer Area:</strong> ${assignment.customer?.address || 'Unknown'}</p>
            <p><strong class="text-gray-900">Est. Earnings:</strong> ₹${earnings}</p>
            <p class="text-sm text-red-500 font-medium mt-2">Auto-declines in 60s if ignored</p>
          </div>
          <div class="flex gap-4">
            <button onclick="handleAssignmentAction('${assignment.id}', 'decline'); this.closest('.fixed').remove()" class="flex-1 bg-red-100 text-red-700 py-3 rounded-xl font-bold hover:bg-red-200 transition-colors">Decline</button>
            <button onclick="handleAssignmentAction('${assignment.id}', 'accept'); this.closest('.fixed').remove()" class="flex-1 bg-green-500 text-white py-3 rounded-xl font-bold hover:bg-green-600 shadow-md transition-colors">Accept</button>
          </div>
        </div>
      `;
      document.body.appendChild(modal);
      
      // Stop bouncing after 3 seconds so it's not too annoying
      setTimeout(() => {
        const inner = modal.querySelector('.animate-\\[bounce_1s_infinite\\]');
        if (inner) {
          inner.classList.remove('animate-[bounce_1s_infinite]');
        }
      }, 3000);
      
      try {
        const audio = new Audio('https://actions.google.com/sounds/v1/alarms/beep_short.ogg');
        audio.play().catch(e => console.log('Audio autoplay blocked'));
      } catch (e) {}
    }

    loadDashboardData();
    
    // Poll for new assignments every 10 seconds if online
    setInterval(() => {
      if (document.getElementById('statusToggle').checked) {
        loadDashboardData();
      }
    }, 10000);

    // Logout
    document.getElementById('logoutBtn').addEventListener('click', async () => {
      try {
        await fetch('/auth/logout', {
          headers: {}
        });
      } catch (e) { console.error(e); }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });;
    // Location pinging
    let locationInterval = null;
    function startLocationPing(assignmentId) {
      if (locationInterval) return;
      locationInterval = setInterval(() => {
        if ("geolocation" in navigator) {
          navigator.geolocation.getCurrentPosition(async (position) => {
            try {
              await fetch(`/delivery-partner/assignments/${assignmentId}/location`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  latitude: position.coords.latitude,
                  longitude: position.coords.longitude
                })
              });
            } catch (e) { console.error('Failed to update location', e); }
          });
        }
      }, 10000);
    }

    function stopLocationPing() {
      if (locationInterval) {
        clearInterval(locationInterval);
        locationInterval = null;
      }
    }

    let map = null;
    let routingLayer = null;

    function initMap(assignment) {
      document.getElementById('deliveryMap').classList.remove('hidden');
      if (!map) {
        map = L.map('deliveryMap').setView([22.3039, 70.8022], 13);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '© OpenStreetMap'
        }).addTo(map);
      }

      if ("geolocation" in navigator) {
        navigator.geolocation.getCurrentPosition(async (position) => {
          const lat = position.coords.latitude;
          const lng = position.coords.longitude;

          let targetLat, targetLng;
          if (assignment.status === 'ACCEPTED' && assignment.restaurant) {
            targetLat = assignment.restaurant.lat;
            targetLng = assignment.restaurant.lng;
          } else if ((assignment.status === 'PICKED_UP' || assignment.status === 'OUT_FOR_DELIVERY') && assignment.customer) {
            targetLat = assignment.customer.lat;
            targetLng = assignment.customer.lng;
          }

          if (targetLat && targetLng) {
            fetchRoute(lat, lng, targetLat, targetLng);
          }
        });
      }
    }

    async function fetchRoute(startLat, startLng, endLat, endLng) {
      try {
        const url = `https://router.project-osrm.org/route/v1/driving/${startLng},${startLat};${endLng},${endLat}?overview=full&geometries=geojson&steps=true`;
        const res = await fetch(url);
        const data = await res.json();

        if (data.routes && data.routes.length > 0) {
          const route = data.routes[0];
          const coords = route.geometry.coordinates.map(c => [c[1], c[0]]);

          if (routingLayer) map.removeLayer(routingLayer);
          routingLayer = L.polyline(coords, { color: 'blue', weight: 4 }).addTo(map);
          map.fitBounds(routingLayer.getBounds(), { padding: [20, 20] });

          L.marker([startLat, startLng]).addTo(map).bindPopup('You').openPopup();
          L.marker([endLat, endLng]).addTo(map).bindPopup('Destination');
          
          const steps = route.legs[0]?.steps || [];
          const directionsContainer = document.getElementById('turnByTurnContainer');
          
          if (directionsContainer && steps.length > 0) {
            directionsContainer.classList.remove('hidden');
            let html = '<h5 class="font-bold text-gray-900 mb-2">🧭 Turn-by-Turn Navigation</h5><ul class="list-decimal pl-5 space-y-2">';
            steps.forEach(step => {
               if (step.distance === 0 && step.maneuver.type !== 'arrive') return;
               let type = step.maneuver.type;
               let modifier = step.maneuver.modifier;
               let text = type;
               if (modifier) text += ' ' + modifier;
               if (step.name) text += ' onto ' + step.name;
               else if (type === 'arrive') text = 'Arrive at destination';
               
               text = text.replace(/-/g, ' ').replace(/_/g, ' ');
               text = text.charAt(0).toUpperCase() + text.slice(1);
               
               html += `<li><span class="font-medium">${text}</span> <span class="text-gray-500">(${(step.distance).toFixed(0)}m)</span></li>`;
            });
            html += '</ul>';
            directionsContainer.innerHTML = html;
          }
        }
      } catch (err) {
        console.error("Failed to fetch route:", err);
      }
    }

    async function handleAssignmentAction(assignmentId, action) {
      try {
        const res = await fetch(`/delivery-partner/assignments/${assignmentId}/${action}`, {
          method: 'PATCH',
          headers: {}
        });
        const data = await res.json();
        if (res.ok) {
          showToast(`Assignment ${action}ed!`, 'success');
          loadDashboardData();
        } else {
          showToast(data.message || 'Action failed', 'error');
        }
      } catch (e) { showToast('Error performing action', 'error'); }
    }

    function showDeliveryOtpModal(assignmentId) {
      const modal = document.createElement('div');
      modal.className = 'fixed inset-0 z-[100] flex items-center justify-center bg-black/60 backdrop-blur-sm p-4';
      modal.innerHTML = `
        <div class="bg-white rounded-2xl shadow-2xl p-6 max-w-sm w-full">
          <h2 class="text-2xl font-bold text-gray-900 mb-2">Delivery Confirmation</h2>
          <p class="text-sm text-gray-500 mb-6">Please enter the 6-digit OTP provided by the customer to confirm delivery.</p>
          <input type="text" id="modalDeliveryOtp" placeholder="e.g. 123456" class="w-full border border-gray-300 p-3 rounded-lg mb-6 text-center text-2xl tracking-[0.5em] font-bold focus:border-orange-500 focus:ring focus:ring-orange-200 outline-none transition-all" />
          <div class="flex gap-4">
            <button onclick="this.closest('.fixed').remove()" class="flex-1 bg-gray-100 text-gray-700 py-3 rounded-xl font-bold hover:bg-gray-200 transition-colors">Cancel</button>
            <button onclick="deliverOrderFromModal('${assignmentId}', this)" class="flex-1 bg-green-500 text-white py-3 rounded-xl font-bold hover:bg-green-600 shadow-md transition-colors">Confirm</button>
          </div>
        </div>
      `;
      document.body.appendChild(modal);
      document.getElementById('modalDeliveryOtp').focus();
    }

    async function deliverOrderFromModal(assignmentId, btnEl) {
      const otp = document.getElementById('modalDeliveryOtp').value;
      if (!otp) { showToast('Please enter the customer OTP', 'error'); return; }
      
      try {
        const res = await fetch(`/delivery-partner/assignments/${assignmentId}/deliver`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ otp })
        });
        const data = await res.json();
        if (res.ok) {
          showToast('Order delivered successfully!', 'success');
          btnEl.closest('.fixed').remove();
          stopLocationPing();
          loadDashboardData();
        } else {
          showToast(data.message || 'Delivery failed', 'error');
        }
      } catch (e) { showToast('Error delivering order', 'error'); }
    }

    async function deliverOrder(assignmentId) {
      // Legacy inline function (kept just in case)
      const otp = document.getElementById('deliveryOtp')?.value;
      if (!otp) { showToast('Please enter the customer OTP', 'error'); return; }
      try {
        const res = await fetch(`/delivery-partner/assignments/${assignmentId}/deliver`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ otp })
        });
        const data = await res.json();
        if (res.ok) {
          showToast(`Order delivered!`, 'success');
          stopLocationPing();
          loadDashboardData();
        } else {
          showToast(data.message || 'Delivery failed', 'error');
        }
      } catch (e) { showToast('Error delivering order', 'error'); }
    }

    async function reportIssue(assignmentId) {
      const issue = prompt('Please describe the issue (e.g. Customer unavailable, Wrong address, Restaurant delay):');
      if (!issue) return;
      try {
        const res = await fetch(`/delivery-partner/assignments/${assignmentId}/report-issue`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ issueReason: issue })
        });
        const data = await res.json();
        if (res.ok) showToast('Issue reported successfully', 'success');
        else showToast(data.message || 'Failed to report issue', 'error');
      } catch (e) { showToast('Error reporting issue', 'error'); }
    }

    // Polling assignments
    setInterval(loadDashboardData, parseInt('<%= process.env.POLLING_INTERVAL_MS || 5000 %>'));

  </script>
  <%- include('../partials/toast') %>

</body>

</html>