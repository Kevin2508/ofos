<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login | ofos - Food Ordering System</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body>
  <div class="min-h-screen bg-gray-50 flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl p-8">
      <!-- Header -->
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-800 mb-2">Welcome Back!</h2>
        <p class="text-gray-500 text-sm">Log in to continue ordering your favorites</p>
      </div>

      <!-- Form -->
      <form id="loginForm" class="space-y-6">
        <!-- Email/Phone Field -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Email or Phone Number
          </label>
          <input type="text" id="userIdentifier" name="userIdentifier" placeholder="Enter email or 10 digit phone"
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-colors" />
          <p id="userIdentifierError" class="mt-1 text-sm text-red-500"></p>
        </div>

        <!-- Password Field -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Password
          </label>
          <div class="relative">
            <input type="password" id="password" name="password" placeholder="Enter password"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none transition-colors pr-16" />
            <button type="button" id="togglePassword"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-sm font-medium text-orange-500 hover:text-orange-600 transition-colors">
              Show
            </button>
          </div>
          <p id="passwordError" class="mt-1 text-sm text-red-500"></p>
        </div>

        <!-- Remember Me & Forgot Password -->
        <div class="flex items-center justify-between">
          <label class="flex items-center space-x-2 cursor-pointer">
            <input type="checkbox" id="rememberMe" name="rememberMe" value="true"
              class="w-4 h-4 text-orange-500 border-gray-300 rounded focus:ring-orange-500" />
            <span class="text-sm text-gray-600">Remember Me</span>
          </label>
          <a href="/forgotPasswordPage"
            class="text-sm font-medium text-orange-500 hover:text-orange-600 transition-colors">
            Forgot Password?
          </a>
        </div>

        <!-- Login Button -->
        <button type="submit" id="loginBtn"
          class="w-full bg-orange-500 hover:bg-orange-600 text-white font-semibold py-3 px-4 rounded-lg transition-colors duration-200 shadow-md hover:shadow-lg">
          Login
        </button>
      </form>

      <!-- Footer -->
      <div class="text-center mt-6 pt-6 border-t border-gray-200">
        <p class="text-sm text-gray-600">
          Don't have an account?
          <a href="/registerPage" class="font-medium text-orange-500 hover:text-orange-600 transition-colors">
            Create Account
          </a>
        </p>
      </div>
    </div>
  </div>

  <script>
    const loginForm = document.getElementById('loginForm');
    const loginBtn = document.getElementById('loginBtn');

    const userIdentifier = document.getElementById('userIdentifier');
    const password = document.getElementById('password');
    const rememberMe = document.getElementById('rememberMe');

    const userIdentifierError = document.getElementById(
      'userIdentifierError'
    );
    const passwordError = document.getElementById('passwordError');

    const togglePassword = document.getElementById('togglePassword');

    /* -------------------------------
 Show / Hide Password
-------------------------------- */
    togglePassword.addEventListener('click', () => {
      if (password.type === 'password') {
        password.type = 'text';
        togglePassword.textContent = 'Hide';
      } else {
        password.type = 'password';
        togglePassword.textContent = 'Show';
      }
    });

    /* -------------------------------
 Validation
-------------------------------- */

    function validateUserIdentifier(value) {
      const trimmed = value.trim();

      if (!trimmed) {
        return 'please enter email or phone as userIdentifier';
      }

      const phoneRegex = /^[0-9]{10}$/;

      const emailRegex =
        /^[a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.(com|net|org|io)$/;

      if (phoneRegex.test(trimmed)) {
        return '';
      }

      if (/^[0-9]+$/.test(trimmed) && trimmed.length !== 10) {
        return 'Contact number must be exactly 10 digits';
      }

      if (emailRegex.test(trimmed)) {
        return '';
      }

      return 'Please enter a valid email address ending in .com';
    }

    function validatePassword(value) {
      if (!value) {
        return 'Password is required';
      }

      if (value.length < 8) {
        return 'Password must be at least 8 characters';
      }

      return '';
    }

    function clearErrors() {
      userIdentifierError.textContent = '';
      passwordError.textContent = '';
    }

    //  Submit
    loginForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      clearErrors();

      const identifierValue = userIdentifier.value.trim();
      const passwordValue = password.value;

      const identifierValidation = validateUserIdentifier(identifierValue);

      const passwordValidation = validatePassword(passwordValue);

      let hasError = false;

      if (identifierValidation) {
        userIdentifierError.textContent = identifierValidation;
        hasError = true;
      }

      if (passwordValidation) {
        passwordError.textContent = passwordValidation;
        hasError = true;
      }

      if (hasError) return;

      loginBtn.disabled = true;
      loginBtn.textContent = 'Logging in...';

      try {
        const response = await fetch('/auth/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            userIdentifier: identifierValue,
            password: passwordValue,
            rememberMe: rememberMe.checked ? 'true' : 'false',
          }),
        });

        const data = await response.json();

        if (!response.ok) {
          showToast(data.message || data.error || 'Login failed', 'error');
          return;
        }

        // console.log(data.data.user);
        window.location.href = data.redirectUrl || '/';
      } catch (error) {
        showToast('Something went wrong. Please try again.', 'error');
      } finally {
        loginBtn.disabled = false;
        loginBtn.textContent = 'Login';
      }
    });
  </script>
  <%- include('../partials/toast') %>
</body>

</html>