# =================================================================
# OFOS Production Environment Template (.env.production.example)
# Copy this file to .env on your production host or configure
# these keys in your cloud hosting provider (Render, Railway, AWS).
# =================================================================

# Server & Networking
NODE_ENV=production
BACKEND_PORT=3000
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-app.vercel.app

# PostgreSQL Database (e.g. Supabase, Neon, AWS RDS, Render Postgres)
# Prisma 7 pg-adapter requires standard PostgreSQL connection URI:
DATABASE_URL=postgresql://user:password@db-host:5432/ofos_platform_prod?schema=public&sslmode=require

# Redis Cache, Locks & Sessions (Upstash, AWS ElastiCache, Redis Cloud)
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_secure_password
REDIS_TLS=true

# JWT Cryptographic Secrets (Use strong 256-bit randomly generated strings)
JWT_ACCESS_SECRET=replace_with_64_character_cryptographically_secure_random_key_here
JWT_REFRESH_SECRET=replace_with_another_64_character_secure_random_key_here
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Google GenAI (Gemini 2.5 Flash for OFOS Conversational Food Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Payment Gateway (Test or Live mode)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cloudinary / S3 Image Storage (Optional: fallback uses local disk)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
