<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Orders | ofos</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>
<body class="min-h-screen bg-orange-50">
<div class="lg:ml-72 transition-all duration-300 flex flex-col min-h-screen">
<nav class="bg-white border-b border-orange-100 shadow-sm sticky top-0 z-40">
  <div class="max-w-4xl mx-auto px-4 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <button onclick="toggleSidebar()" class="p-2 -ml-2 text-gray-600 hover:text-orange-500 rounded-xl hover:bg-orange-50 transition-colors lg:hidden">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
      <a href="/" class="text-3xl font-extrabold text-orange-500 lg:hidden">ofos</a>
    </div>
    <a href="/" class="text-sm text-gray-500 hover:text-orange-500 transition-colors">← Home</a>
  </div>
</nav>

<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-800 mb-8">My Orders</h1>

  <div id="ordersLoading" class="text-center py-24">
    <div class="w-12 h-12 border-4 border-orange-500 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
    <p class="text-gray-500">Loading orders…</p>
  </div>

  <div id="ordersEmpty" class="hidden text-center py-24">
    <div class="w-24 h-24 mx-auto mb-6 text-orange-200">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
      </svg>
    </div>
    <h2 class="text-2xl font-bold text-gray-700 mb-2">No orders yet</h2>
    <p class="text-gray-500 mb-6">Your past orders will appear here.</p>
    <a href="/" class="inline-block bg-orange-500 text-white px-6 py-3 rounded-xl font-semibold hover:bg-orange-600 transition-colors">Order Now</a>
  </div>

  <div id="ordersList" class="space-y-4 hidden"></div>

  <!-- Pagination -->
  <div id="pagination" class="hidden flex justify-center gap-3 mt-8">
    <button id="prevBtn" onclick="changePage(-1)" class="px-4 py-2 rounded-xl border border-gray-200 text-sm text-gray-600 hover:bg-gray-50 disabled:opacity-40" disabled>← Prev</button>
    <span id="pageInfo" class="px-4 py-2 text-sm text-gray-500 font-medium"></span>
    <button id="nextBtn" onclick="changePage(1)" class="px-4 py-2 rounded-xl border border-gray-200 text-sm text-gray-600 hover:bg-gray-50 disabled:opacity-40">Next →</button>
  </div>
</div>

<style>
  .status-badge { display: inline-flex; align-items: center; padding: 2px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; }
  .status-PENDING { background: #FEF3C7; color: #92400E; }
  .status-ACCEPTED { background: #DBEAFE; color: #1E40AF; }
  .status-PREPARING { background: #E0E7FF; color: #3730A3; }
  .status-OUT_FOR_DELIVERY { background: #D1FAE5; color: #065F46; }
  .status-DELIVERED { background: #D1FAE5; color: #065F46; }
  .status-CANCELLED { background: #FEE2E2; color: #991B1B; }
  .order-card { transition: all 0.2s ease; }
  .order-card:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(249,115,22,0.1); }
</style>

<script>
  const token = localStorage.getItem('token');
  const authH = () => ({ 'Authorization': `Bearer ${token}` });

  let currentPage = 1;
  let totalPages = 1;

  const STATUS_ICONS = {
    PENDING: '🕐', ACCEPTED: '✅', PREPARING: '👨‍🍳',
    OUT_FOR_DELIVERY: '🛵', DELIVERED: '🎉', CANCELLED: '❌'
  };

  async function loadOrders(page = 1) {
    try {
      const res = await fetch(`/orders?page=${page}&limit=10`, { headers: authH() });
      const data = await res.json();

      document.getElementById('ordersLoading').classList.add('hidden');

      const orders = data.orders || data.data || [];
      if (orders.length === 0 && page === 1) {
        document.getElementById('ordersEmpty').classList.remove('hidden');
        return;
      }

      totalPages = data.pagination?.totalPages || 1;
      currentPage = page;
      document.getElementById('pageInfo').textContent = `Page ${currentPage} of ${totalPages}`;
      document.getElementById('prevBtn').disabled = currentPage <= 1;
      document.getElementById('nextBtn').disabled = currentPage >= totalPages;
      if (totalPages > 1) document.getElementById('pagination').classList.remove('hidden');

      renderOrders(orders);
    } catch {
      document.getElementById('ordersLoading').classList.add('hidden');
      document.getElementById('ordersEmpty').classList.remove('hidden');
    }
  }

  function renderOrders(orders) {
    const list = document.getElementById('ordersList');
    list.innerHTML = '';
    list.classList.remove('hidden');

    orders.forEach(order => {
      const card = document.createElement('div');
      card.className = 'order-card bg-white rounded-2xl p-5 border border-orange-100 shadow-sm cursor-pointer';
      card.onclick = () => window.location.href = `/c/orders/${order.id || order.orderId}`;

      const date = new Date(order.createdAt || order.placedAt || Date.now()).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
      const status = order.orderStatus || order.status || 'PENDING';
      const restaurant = order.restaurant?.businessName || order.restaurantBranch?.restaurant?.businessName || '—';
      const items = (order.items || []).length;
      const total = order.totalAmount || order.total || 0;

      card.innerHTML = `
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <span class="status-badge status-${status}">${STATUS_ICONS[status] || ''} ${status.replace(/_/g,' ')}</span>
              <span class="text-xs text-gray-400">${date}</span>
            </div>
            <h3 class="font-bold text-gray-800 truncate">${restaurant}</h3>
            <p class="text-sm text-gray-500 mt-0.5">${items} item${items !== 1 ? 's' : ''} · Order #${order.orderNumber || order.id || '—'}</p>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="font-bold text-orange-500 text-lg">₹${Number(total).toFixed(2)}</p>
            ${status !== 'DELIVERED' && status !== 'CANCELLED' ? `<a href="/c/tracking/${order.id || order.orderId}" onclick="event.stopPropagation()" class="text-xs text-orange-500 font-semibold hover:underline">Track →</a>` : ''}
          </div>
        </div>
        ${status === 'PENDING' ? `<button onclick="event.stopPropagation(); cancelOrder('${order.id || order.orderId}')" class="mt-3 w-full text-sm text-red-500 border border-red-200 py-2 rounded-xl hover:bg-red-50 font-medium">Cancel Order</button>` : ''}`;
      list.appendChild(card);
    });
  }

  async function cancelOrder(orderId) {
    if (!confirm('Are you sure you want to cancel this order?')) return;
    try {
      const res = await fetch(`/orders/${orderId}/cancel`, { method: 'PATCH', headers: { ...authH(), 'Content-Type': 'application/json' }, body: JSON.stringify({ reason: 'Customer requested cancellation' }) });
      const data = await res.json();
      if (res.ok) { showToast('Order cancelled', 'success'); loadOrders(currentPage); }
      else showToast(data.message || 'Cannot cancel', 'error');
    } catch { showToast('Failed to cancel', 'error'); }
  }

  function changePage(dir) {
    const newPage = currentPage + dir;
    if (newPage >= 1 && newPage <= totalPages) loadOrders(newPage);
  }

  if (!token) window.location.href = '/loginPage';
  else loadOrders();
</script>
</div>
<%- include('../partials/toast') %>
<%- include('../partials/customer-sidebar') %>
</body>
</html>
