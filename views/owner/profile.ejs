<%-
  include('../partials/header', {
    pageTitle: 'Restaurant Profile',
    pageSubtitle: 'Manage your restaurant information',
    activePage: 'restaurant',
    user: user
  })
%>

<div class="breadcrumb">
  <a href="/restaurant-owner/dashboard">Dashboard</a>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
  <span>Restaurant Profile</span>
</div>

<div class="page-header">
  <div class="title-group">
    <h2><%= restaurant.name %></h2>
    <p>Restaurant ID: #<%= restaurant.id %></p>
  </div>
  <span class="badge <%= restaurant.verification_status === 'verified' ? 'badge-verified' : (restaurant.verification_status === 'pending' ? 'badge-pending' : 'badge-rejected') %>">
    <%= restaurant.verification_status %>
  </span>
</div>

<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success" data-autohide>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
    <%= success %>
  </div>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-error">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
    <%= error %>
  </div>
<% } %>

<!-- ============ TABS ============ -->
<div class="tabs">
  <div class="tab-link active" data-tab="profile-tab">Basic Info</div>
  <div class="tab-link" data-tab="branding-tab">Branding</div>
  <div class="tab-link" data-tab="danger-tab">Account</div>
</div>

<!-- ============ TAB: BASIC INFO ============ -->
<div id="profile-tab" class="tab-content">
  <div class="card">
    <div class="card-header">
      <h3>Restaurant Details</h3>
    </div>
    <div class="card-body">
      <form action="/restaurant-owner/restaurant/<%= restaurant.id %>?_method=PATCH" method="POST">
        <div class="form-row">
          <div class="form-group">
            <label>Restaurant Name <span class="req">*</span></label>
            <input type="text" name="name" class="form-control" value="<%= restaurant.name %>" required>
          </div>
          <div class="form-group">
            <label>Cuisine Tags</label>
            <input type="text" name="cuisine_tags" class="form-control" value="<%= restaurant.cuisine_tags ? restaurant.cuisine_tags.join(', ') : '' %>" placeholder="e.g. North Indian, Chinese, Fast Food">
            <div class="form-hint">Comma-separated tags</div>
          </div>
        </div>

        <div class="form-group">
          <label>Description</label>
          <textarea name="description" class="form-control" rows="4" placeholder="Tell customers about your restaurant..."><%= restaurant.description || '' %></textarea>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label>Registered Email</label>
            <input type="email" class="form-control" value="<%= restaurant.email || '' %>" disabled>
            <div class="form-hint">Contact admin to change registered email</div>
          </div>
          <div class="form-group">
            <label>Contact Number</label>
            <input type="text" name="phone" class="form-control" value="<%= restaurant.phone || '' %>" placeholder="+91 9XXXXXXXXX">
          </div>
        </div>

        <button type="submit" class="btn btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
          Save Changes
        </button>
      </form>
    </div>
  </div>
</div>

<!-- ============ TAB: BRANDING (LOGO & COVER) ============ -->
<div id="branding-tab" class="tab-content" style="display:none;">
  <div class="grid grid-2">

    <!-- Logo -->
    <div class="card">
      <div class="card-header"><h3>Restaurant Logo</h3></div>
      <div class="card-body">
        <% if (restaurant.logo_url) { %>
          <img src="<%= restaurant.logo_url %>" id="logoPreview" class="preview-thumb" alt="Logo">
        <% } else { %>
          <img src="" id="logoPreview" class="preview-thumb" style="display:none;" alt="Logo Preview">
        <% } %>

        <form action="/restaurant-owner/restaurant/<%= restaurant.id %>/logo" method="POST" enctype="multipart/form-data">
          <div class="upload-box">
            <input type="file" name="logo" accept="image/*" data-preview-input="logoPreview" required>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <div class="upload-text">Click to upload logo</div>
            <div class="upload-sub">PNG, JPG up to 2MB · Square image recommended</div>
          </div>
          <button type="submit" class="btn btn-primary btn-block" style="margin-top:14px;">Upload Logo</button>
        </form>
      </div>
    </div>

    <!-- Cover -->
    <div class="card">
      <div class="card-header"><h3>Cover Image</h3></div>
      <div class="card-body">
        <% if (restaurant.cover_url) { %>
          <img src="<%= restaurant.cover_url %>" id="coverPreview" class="preview-thumb" alt="Cover">
        <% } else { %>
          <img src="" id="coverPreview" class="preview-thumb" style="display:none;" alt="Cover Preview">
        <% } %>

        <form action="/restaurant-owner/restaurant/<%= restaurant.id %>/cover" method="POST" enctype="multipart/form-data">
          <div class="upload-box">
            <input type="file" name="cover" accept="image/*" data-preview-input="coverPreview" required>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <div class="upload-text">Click to upload cover image</div>
            <div class="upload-sub">PNG, JPG up to 5MB · 1200x400px recommended</div>
          </div>
          <button type="submit" class="btn btn-primary btn-block" style="margin-top:14px;">Upload Cover</button>
        </form>
      </div>
    </div>

  </div>
</div>

<!-- ============ TAB: ACCOUNT / DANGER ZONE ============ -->
<div id="danger-tab" class="tab-content" style="display:none;">
  <div class="card">
    <div class="card-header"><h3>Verification Status</h3></div>
    <div class="card-body">
      <p style="font-size:14px; margin-bottom:10px;">
        Current status:
        <span class="badge <%= restaurant.verification_status === 'verified' ? 'badge-verified' : (restaurant.verification_status === 'pending' ? 'badge-pending' : 'badge-rejected') %>"><%= restaurant.verification_status %></span>
      </p>
      <% if (restaurant.verification_status !== 'verified') { %>
        <a href="/restaurant-owner/documents" class="btn btn-secondary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          Manage Documents
        </a>
      <% } %>
    </div>
  </div>

  <div class="card" style="margin-top:20px; border-color: #FDE2E4;">
    <div class="card-header"><h3 style="color:var(--danger);">Deactivate Restaurant</h3></div>
    <div class="card-body">
      <p style="font-size:14px; color:var(--neutral-600); margin-bottom:16px;">
        Deactivating your restaurant will hide it from customers and pause all branches. This action requires admin approval to reverse.
      </p>
      <form action="/restaurant-owner/restaurant/<%= restaurant.id %>?_method=DELETE" method="POST" data-confirm="Are you sure you want to deactivate your restaurant? This will hide it from customers.">
        <button type="submit" class="btn btn-danger">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
          Deactivate Restaurant
        </button>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer', {
  extraScripts: `<script>
    document.querySelectorAll('.tab-link').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab-link').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.style.display = 'none');
        tab.classList.add('active');
        document.getElementById(tab.dataset.tab).style.display = 'block';
      });
    });
  </script>`
}) %>
