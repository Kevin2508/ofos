                    <button onclick="deleteModifierGroup('${group.id}')" class="px-2 py-1 text-xs bg-red-50 text-red-700 hover:bg-red-100 rounded">Del</button>
                  </div>
                </div>
                ${group.options && group.options.length > 0 ? `
                  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2 mt-2">
