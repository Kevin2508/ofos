<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manage Restaurants | Admin | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
</head>

<body class="min-h-screen bg-orange-50 font-sans text-gray-800">
  <div class="flex min-h-screen">
    <%- include('../partials/admin/sidebar') %>

      <!-- MAIN CONTENT -->
      <main class="flex-1 lg:ml-72 p-5 sm:p-8 transition-all duration-300" id="mainContentWrapper">
        <div class="mb-8 flex flex-col gap-4 md:flex-row md:justify-between md:items-center">
          <div>
            <h2 class="text-3xl font-bold text-gray-900" id="pageTitle">Pending Restaurants</h2>
            <p class="text-gray-500 mt-2" id="pageSubtitle">Review and approve new restaurant applications.</p>
          </div>
          <div class="flex bg-gray-100 rounded-lg p-1 w-max">
            <button id="tabAll" onclick="switchTab('all')"
              class="px-6 py-2 rounded-md bg-white shadow-sm text-sm font-semibold text-gray-800 transition-all">All
              Restaurants</button>
            <button id="tabPending" onclick="switchTab('pending')"
              class="px-6 py-2 rounded-md text-sm font-semibold text-gray-500 hover:text-gray-800 transition-all">Pending</button>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 sm:p-6">
          <div id="restaurantsGrid" class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-6">
            <div class="col-span-full py-12 text-center text-gray-500">
              Loading...
            </div>
          </div>
        </div>
      </main>
  </div>

  <!-- Restaurant Details Modal -->
  <div id="restaurantModal"
    class="hidden fixed inset-0 bg-gray-900/40 backdrop-blur-sm z-[80] flex items-center justify-center p-4 transition-opacity duration-300 opacity-0">
    <div
      class="bg-white w-full max-w-2xl rounded-3xl shadow-xl transform transition-transform duration-300 scale-95 flex flex-col max-h-[90vh]">
      <!-- Header with Cover Image -->
      <div class="relative h-48 rounded-t-3xl bg-gray-200 shrink-0">
        <img id="modalCover" class="w-full h-full object-cover rounded-t-3xl hidden" src="" alt="Cover">
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent rounded-t-3xl"></div>
        <button onclick="closeModal()"
          class="absolute top-4 right-4 bg-white/20 hover:bg-white/40 backdrop-blur-md p-2 rounded-full text-white transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
        <!-- Logo -->
        <div class="absolute -bottom-8 left-8">
          <div class="w-20 h-20 bg-white rounded-2xl shadow-lg p-1">
            <img id="modalLogo" class="w-full h-full object-cover rounded-xl bg-gray-100 hidden" src="" alt="Logo">
            <div id="modalLogoPlaceholder"
              class="w-full h-full rounded-xl bg-orange-100 flex items-center justify-center text-orange-500 font-bold text-2xl">
              ?</div>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="p-5 sm:p-8 pt-12 overflow-y-auto">
        <div class="flex justify-between items-start mb-6">
          <div>
            <h3 id="modalBusinessName" class="text-2xl font-bold text-gray-900"></h3>
            <p id="modalLegalName" class="text-gray-500 text-sm mt-1"></p>
          </div>
          <span id="modalStatus" class="px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wide"></span>
        </div>

        <div class="space-y-6">
          <!-- Description -->
          <div>
            <h4 class="text-sm font-semibold text-gray-900 mb-2 uppercase tracking-wide">Description</h4>
            <p id="modalDescription" class="text-gray-600 bg-gray-50 p-4 rounded-xl border border-gray-100 italic"></p>
          </div>

          <!-- Grid Details -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-6">
            <div class="bg-gray-50 p-4 rounded-xl border border-gray-100">
              <h4 class="text-sm font-semibold text-gray-900 mb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                Contact
              </h4>
              <p class="text-sm text-gray-600 mb-1"><strong>Email:</strong> <span id="modalEmail"></span></p>
              <p class="text-sm text-gray-600"><strong>Phone:</strong> <span id="modalPhone"></span></p>
            </div>

            <div class="bg-gray-50 p-4 rounded-xl border border-gray-100">
              <h4 class="text-sm font-semibold text-gray-900 mb-3 flex items-center gap-2">
                <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                System Info
              </h4>
              <p class="text-sm text-gray-600 mb-1"><strong>Owner ID:</strong> #<span id="modalOwnerId"></span></p>
              <p class="text-sm text-gray-600"><strong>Joined:</strong> <span id="modalJoined"></span></p>
            </div>
          </div>

          <div class="mt-6">
            <h4 class="text-sm font-semibold text-gray-900 mb-3 flex items-center gap-2">
              <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Verification Documents
            </h4>
            <div id="modalDocuments" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    let currentTab = 'allrestaurants';
    let loadedRestaurants = [];

    function switchTab(tab) {
      currentTab = tab;
      const tabPending = document.getElementById('tabPending');
      const tabAll = document.getElementById('tabAll');
      const pageTitle = document.getElementById('pageTitle');
      const pageSubtitle = document.getElementById('pageSubtitle');

      if (tab === 'pending') {
        tabPending.classList.add('bg-white', 'shadow-sm', 'text-gray-800');
        tabPending.classList.remove('text-gray-500');
        tabAll.classList.remove('bg-white', 'shadow-sm', 'text-gray-800');
        tabAll.classList.add('text-gray-500');
        pageTitle.textContent = 'Pending Restaurants';
        pageSubtitle.textContent = 'Review and approve new restaurant applications.';
        loadRestaurants();
      } else {
        tabAll.classList.add('bg-white', 'shadow-sm', 'text-gray-800');
        tabAll.classList.remove('text-gray-500');
        tabPending.classList.remove('bg-white', 'shadow-sm', 'text-gray-800');
        tabPending.classList.add('text-gray-500');
        pageTitle.textContent = 'All Restaurants';
        pageSubtitle.textContent = 'Manage all registered restaurants in the system.';
        loadRestaurants();
      }
    }

    async function updateStatus(id, newStatus) {
      if (!confirm(`Are you sure you want to change status to ${newStatus}?`)) return;

      try {
        const res = await fetch(`/admin/restaurants/${id}/status`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ status: newStatus })
        });

        if (res.ok) {
          alert('Status updated successfully!');
          loadRestaurants();
        } else {
          alert('Failed to update status.');
        }
      } catch (err) {
        console.error(err);
      }
    }

    async function loadRestaurants() {
      const grid = document.getElementById('restaurantsGrid');
      grid.innerHTML = '<div class="col-span-full py-12 text-center text-gray-500">Loading...</div>';

      try {
        const url = currentTab === 'pending' ? '/admin/restaurants/pending' : '/admin/restaurants';
        const res = await fetch(url, {
          headers: {}
        });

        if (res.ok) {
          const data = await res.json();
          loadedRestaurants = data.data?.restaurants || [];

          if (loadedRestaurants.length === 0) {
            if (currentTab === 'pending') {
              grid.innerHTML = `<div class="col-span-full text-center py-16"><div class="text-6xl mb-4">🙌</div><h3 class="text-xl font-bold text-gray-700">All caught up!</h3><p class="text-gray-500">No pending approvals.</p></div>`;
            } else {
              grid.innerHTML = `<div class="col-span-full text-center py-16"><h3 class="text-xl font-bold text-gray-700">No restaurants found.</h3></div>`;
            }
          } else {
            grid.innerHTML = loadedRestaurants.map(r => {
              const statusColor = r.status === 'APPROVED' ? 'bg-green-100 text-green-800' :
                r.status === 'REJECTED' ? 'bg-red-100 text-red-800' :
                  r.status === 'SUSPENDED' ? 'bg-gray-100 text-gray-800' :
                    'bg-amber-100 text-amber-800';

              const actionButtons = r.status === 'PENDING_VERIFICATION' ? `
                <button onclick="updateStatus('${r.id}', 'APPROVED')" class="flex-1 bg-orange-600 hover:bg-orange-700 text-white font-medium py-2 px-3 rounded-lg transition-colors text-sm">
                  Approve
                </button>
                <button onclick="updateStatus('${r.id}', 'REJECTED')" class="flex-1 bg-red-100 hover:bg-red-200 text-red-700 font-medium py-2 px-3 rounded-lg transition-colors text-sm">
                  Reject
                </button>
              ` : `
                <button onclick="updateStatus('${r.id}', '${r.status === 'SUSPENDED' ? 'APPROVED' : 'SUSPENDED'}')" class="flex-1 border border-gray-300 hover:bg-gray-50 text-gray-700 font-medium py-2 px-3 rounded-lg transition-colors text-sm">
                  ${r.status === 'SUSPENDED' ? 'Activate' : 'Suspend'}
                </button>
              `;

              return `
              <div class="border border-gray-200 rounded-xl p-4 sm:p-6 hover:shadow-lg transition-all bg-white flex flex-col relative group">
                <div class="flex justify-between items-start mb-4">
                  <div class="flex flex-wrap items-center gap-3">
                    <div class="w-12 h-12 rounded-lg bg-gray-100 overflow-hidden shrink-0 border border-gray-100">
                      ${r.logoUrl ? `<img src="${r.logoUrl}" class="w-full h-full object-cover">` : `<div class="w-full h-full flex items-center justify-center text-gray-400 font-bold">${r.businessName.charAt(0)}</div>`}
                    </div>
                    <div>
                      <h3 class="text-xl font-bold text-gray-900">${r.businessName}</h3>
                      <p class="text-sm text-gray-500">${r.legalBusinessName || ''}</p>
                    </div>
                  </div>
                </div>
                
                <div class="space-y-2 mb-6 flex-1 text-sm text-gray-600">
                  <p class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    ${r.primaryEmail || 'N/A'}
                  </p>
                  <p class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                    ${r.primaryPhone || 'N/A'}
                  </p>
                </div>
                
                <div class="flex items-center justify-between pt-4 border-t border-gray-100 mt-auto">
                  <span class="px-3 py-1 ${statusColor} rounded-full text-[10px] font-bold uppercase tracking-wider">${r.status.replace('_', ' ')}</span>
                  <div class="flex gap-2">
                    <button onclick="viewRestaurant('${r.id}')" class="text-orange-500 hover:text-orange-600 font-medium text-sm py-2 px-3 transition-colors bg-orange-50 hover:bg-orange-100 rounded-lg">Details</button>
                    ${actionButtons}
                  </div>
                </div>
              </div>
            `}).join('');
          }
        }
      } catch (err) {
        console.error(err);
      }
    }

    function viewRestaurant(id) {
      const r = loadedRestaurants.find(res => res.id === id);
      if (!r) return;

      // Populate Modal Data
      document.getElementById('modalBusinessName').textContent = r.businessName;
      document.getElementById('modalLegalName').textContent = r.legalBusinessName || 'No legal name provided';
      document.getElementById('modalDescription').textContent = r.description || 'No description available.';
      document.getElementById('modalEmail').textContent = r.primaryEmail || 'N/A';
      document.getElementById('modalPhone').textContent = r.primaryPhone || 'N/A';
      document.getElementById('modalOwnerId').textContent = r.ownerUserId;
      document.getElementById('modalJoined').textContent = new Date(r.createdAt).toLocaleDateString();

      // Status Badge
      const statusEl = document.getElementById('modalStatus');
      statusEl.textContent = r.status.replace('_', ' ');
      statusEl.className = 'px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wide ' +
        (r.status === 'APPROVED' ? 'bg-green-100 text-green-800' :
          r.status === 'REJECTED' ? 'bg-red-100 text-red-800' :
            r.status === 'SUSPENDED' ? 'bg-gray-100 text-gray-800' :
              'bg-amber-100 text-amber-800');

      // Images
      const coverEl = document.getElementById('modalCover');
      if (r.coverImageUrl) {
        coverEl.src = r.coverImageUrl;
        coverEl.classList.remove('hidden');
      } else {
        coverEl.classList.add('hidden');
      }

      const logoEl = document.getElementById('modalLogo');
      const logoPlaceholder = document.getElementById('modalLogoPlaceholder');
      if (r.logoUrl) {
        logoEl.src = r.logoUrl;
        logoEl.classList.remove('hidden');
        logoPlaceholder.classList.add('hidden');
      } else {
        logoEl.classList.add('hidden');
        logoPlaceholder.classList.remove('hidden');
        logoPlaceholder.textContent = r.businessName.charAt(0);
      }

      const docsContainer = document.getElementById('modalDocuments');
      if (r.documents && r.documents.length > 0) {
        docsContainer.innerHTML = r.documents.map(d => {
          let badge = '';
          if (d.verificationStatus === 'APPROVED') badge = '<span class="px-2 py-0.5 bg-green-100 text-green-800 rounded text-[10px] font-bold">APPROVED</span>';
          else if (d.verificationStatus === 'REJECTED') badge = '<span class="px-2 py-0.5 bg-red-100 text-red-800 rounded text-[10px] font-bold">REJECTED</span>';
          else badge = '<span class="px-2 py-0.5 bg-yellow-100 text-yellow-800 rounded text-[10px] font-bold">PENDING</span>';

          return `
          <div class="bg-gray-50 p-3 rounded-lg border border-gray-200 flex flex-col justify-between">
            <div class="flex justify-between items-center mb-1">
                <div class="text-sm font-bold text-gray-800">\${d.documentType.replace(/_/g, ' ')}</div>
                \${badge}
            </div>
            \${d.remarks ? \`<div class="text-xs text-red-600 mt-1 mb-2 bg-red-50 p-1 rounded">\${d.remarks}</div>\` : ''}
            <div class="flex justify-between items-center mt-2 pt-2 border-t border-gray-200">
                <a href="\${d.documentUrl}" target="_blank" class="text-orange-600 hover:text-orange-700 text-sm font-semibold flex items-center">
                View
                </a>
                <div class="flex gap-2">
                    <button onclick="updateDocStatus('\${r.id}', '\${d.id}', 'APPROVED')" class="text-green-600 hover:underline text-xs font-bold">Approve</button>
                    <button onclick="updateDocStatus('\${r.id}', '\${d.id}', 'REJECTED')" class="text-red-600 hover:underline text-xs font-bold">Request Docs</button>
                </div>
            </div>
          </div>
        `}).join('');
      } else {
        docsContainer.innerHTML = '<p class="text-sm text-gray-500 italic">No documents uploaded.</p>';
      }

      // Show Modal
      const modal = document.getElementById('restaurantModal');
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        modal.firstElementChild.classList.remove('scale-95');
      }, 10);
    }

    async function updateDocStatus(restaurantId, docId, status) {
      let remark = '';
      if (status === 'REJECTED') {
        remark = prompt('Enter reason for requesting additional documentation:');
        if (!remark) return;
      }

      try {
        const res = await fetch(`/admin/restaurants/${restaurantId}/documents/${docId}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status, remark })
        });

        if (res.ok) {
          alert('Document status updated');
          loadRestaurants();
          closeModal();
        } else {
          alert('Failed to update document');
        }
      } catch (e) { alert('Error updating document'); }
    }

    function closeModal() {
      const modal = document.getElementById('restaurantModal');
      modal.classList.add('opacity-0');
      modal.firstElementChild.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 300);
    }

    loadRestaurants();

    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      try {
        await fetch('/auth/logout', {
          headers: {}
        });
      } catch (e) { console.error(e); }
      localStorage.clear();
      document.cookie = 'token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;';
      window.location.href = '/loginPage';
    });;
  </script>
</body>

</html>