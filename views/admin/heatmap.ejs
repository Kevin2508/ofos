<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Heatmap | Admin | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>

<body class="min-h-screen bg-orange-50 font-sans text-gray-800">
  <div class="flex min-h-screen">
    <%- include('../partials/admin/sidebar') %>
      <main class="flex-1 lg:ml-72 p-5 sm:p-8 transition-all duration-300" id="mainContentWrapper">
        <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <h2 class="text-3xl font-bold text-gray-900">Order Density Heatmap</h2>
            <p class="text-gray-500 mt-2">Geographic order distribution across service areas.</p>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <input type="date" id="startDate"
              class="px-4 py-2 border border-gray-200 rounded-lg text-sm bg-white text-gray-700">
            <span class="text-gray-400">to</span>
            <input type="date" id="endDate"
              class="px-4 py-2 border border-gray-200 rounded-lg text-sm bg-white text-gray-700">
            <button onclick="loadHeatmap()"
              class="px-4 py-2 bg-orange-600 text-white rounded-lg text-sm font-bold shadow hover:bg-orange-700 transition-colors">Update
              Map</button>
          </div>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-2 h-[600px]">
          <div id="map" class="w-full h-full rounded-xl z-0"></div>
        </div>
      </main>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js"></script>
  <script>
    let map = L.map('map').setView([40.7128, -74.0060], 12); // Default to NYC, will center based on data
    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; <a href="https://carto.com/">CARTO</a>'
    }).addTo(map);

    let heatLayer = null;

    async function loadHeatmap() {
      const sDate = document.getElementById('startDate').value;
      const eDate = document.getElementById('endDate').value;
      let url = '/admin/reports/heatmap?';
      if (sDate) url += `startDate=\${sDate}&`;
      if (eDate) url += `endDate=\${eDate}`;

      try {
        const res = await fetch(url);
        if (res.ok) {
          const data = await res.json();
          const points = data.data;

          if (heatLayer) map.removeLayer(heatLayer);

          const heatData = points.map(p => [p.lat, p.lng, p.weight]);
          heatLayer = L.heatLayer(heatData, { radius: 25, blur: 15, maxZoom: 17 }).addTo(map);

          if (heatData.length > 0) {
            map.setView([heatData[0][0], heatData[0][1]], 12);
          }
        }
      } catch (e) { console.error(e); }
    }
    loadHeatmap();
  </script>
</body>

</html>