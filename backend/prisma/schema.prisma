  updatedBy     BigInt?  @map("updated_by")
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedByUser User?    @relation(fields: [updatedBy], references: [id])

  @@index([updatedBy], map: "system_configurations_updated_by_idx")
  @@map("system_configurations")
}

model ReportExport {
  id                BigInt   @id @default(autoincrement())
  generatedByUserId BigInt   @map("generated_by_user_id")
  reportType        String   @map("report_type") @db.VarChar(100)
  fileUrl           String   @map("file_url") @db.VarChar(500)
  generatedAt       DateTime @default(now()) @map("generated_at")
  generatedByUser   User     @relation(fields: [generatedByUserId], references: [id])

  @@index([generatedByUserId], map: "report_exports_generated_by_user_id_idx")
  @@map("report_exports")
}

model ReviewItem {
  id         BigInt   @id @default(autoincrement())
  reviewId   BigInt   @map("review_id")
  menuItemId BigInt   @map("menu_item_id")
  rating     Int      @db.SmallInt
  reviewText String?  @map("review_text") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  review     Review   @relation(fields: [reviewId], references: [id])

  @@index([reviewId])
  @@index([menuItemId])
  @@map("review_items")
}

