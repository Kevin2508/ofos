<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Restaurant | epicure</title>
  <link rel="stylesheet" href="/styles/build.css" />
  <style>
    /* Smooth scrolling for category navigation */
    html {
      scroll-behavior: smooth;
    }

    .category-nav::-webkit-scrollbar {
      display: none;
    }

    .category-nav {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>

<body class="min-h-screen bg-gray-50 font-sans">
  <div class="lg:ml-72 transition-all duration-300 flex flex-col min-h-screen">
    <!-- NAVBAR -->
    <nav class="bg-white border-b border-gray-200 shadow-sm sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <button onclick="window.history.back()"
            class="p-2 rounded-full hover:bg-gray-100 transition-colors lg:hidden">
            <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18">
              </path>
            </svg>
          </button>
          <button onclick="toggleSidebar()"
            class="p-2 -ml-2 text-gray-600 hover:text-orange-500 rounded-xl hover:bg-orange-50 transition-colors lg:hidden">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <a href="/"
            class="text-3xl font-extrabold text-orange-500 hover:text-orange-600 transition-colors lg:hidden">epicure
          </a>
        </div>

        <!-- Cart Icon -->
        <a href="/c/cart" class="relative p-2 text-gray-600 hover:text-orange-500 transition-colors">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z">
            </path>
          </svg>
          <!-- Badge -->
          <span id="cartBadge"
            class="hidden absolute top-0 right-0 bg-orange-500 text-white text-[10px] font-bold px-1.5 py-0.5 rounded-full border-2 border-white">
            0
          </span>
        </a>
      </div>
    </nav>

    <!-- RESTAURANT HEADER SKELETON -->
    <div id="headerSkeleton" class="animate-pulse bg-white">
      <div class="h-64 bg-gray-200 w-full"></div>
      <div class="max-w-6xl mx-auto px-4 py-8">
        <div class="h-8 bg-gray-200 rounded w-1/3 mb-4"></div>
        <div class="h-4 bg-gray-200 rounded w-1/4 mb-2"></div>
        <div class="h-4 bg-gray-200 rounded w-1/5"></div>
      </div>
    </div>

    <!-- RESTAURANT HEADER -->
    <div id="restaurantHeader" class="hidden bg-white shadow-sm pb-8">
      <!-- Cover Image -->
      <div class="w-full h-48 md:h-72 bg-gray-100 relative overflow-hidden">
        <img id="coverImage" src="" alt="Restaurant Cover" class="w-full h-full object-cover hidden" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
      </div>

      <div class="max-w-6xl mx-auto px-4 -mt-16 relative z-10">
        <div
          class="bg-white rounded-2xl shadow-lg p-4 sm:p-6 border border-gray-100 flex flex-wrap flex-col md:flex-row gap-3 sm:gap-6 items-start md:items-center justify-between">
          <div class="flex flex-wrap items-center gap-3 sm:gap-6">
            <div class="w-24 h-24 rounded-2xl overflow-hidden border-4 border-white shadow-md bg-gray-50 flex-shrink-0">
              <img id="logoImage" src="" alt="Logo" class="w-full h-full object-cover hidden" />
            </div>
            <div>
              <h1 id="restaurantName" class="text-3xl font-extrabold text-gray-900 mb-1">...</h1>
              <p id="restaurantDesc" class="text-gray-500 text-sm mb-3">...</p>
              <div class="flex flex-wrap items-center gap-4 text-sm font-medium">
                <div
                  class="flex items-center gap-1.5 bg-green-100 text-green-700 px-3 py-1.5 rounded-lg border border-green-200">
                  <span class="text-sm">⭐</span> <span id="restaurantRating" class="font-extrabold">...</span>
                </div>
                <div
                  class="flex items-center gap-1.5 text-gray-600 bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-100">
                  <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span id="branchAddress" class="truncate max-w-[200px] md:max-w-md">Address</span>
                </div>
                <div
                  class="flex items-center gap-1.5 text-gray-600 bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-100">
                  <svg class="w-4 h-4 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span id="branchPhone">Phone</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SEARCH & FILTERS -->
    <div class="max-w-6xl mx-auto px-4 mt-8">
      <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 flex flex-col md:flex-row gap-4 items-center justify-between">
        <div class="relative w-full md:w-1/3">
          <input type="text" id="menuSearchInput" placeholder="Search dishes..." class="w-full pl-10 pr-4 py-2 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-orange-500" oninput="filterMenu()">
          <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        <div class="flex flex-wrap gap-2">
          <label class="cursor-pointer">
            <input type="checkbox" class="peer hidden dietary-filter" value="VEG" onchange="filterMenu()">
            <span class="px-4 py-2 rounded-full border border-gray-200 text-sm font-semibold text-gray-600 peer-checked:bg-green-50 peer-checked:text-green-700 peer-checked:border-green-300 transition-colors">Veg</span>
          </label>
          <label class="cursor-pointer">
            <input type="checkbox" class="peer hidden dietary-filter" value="NON_VEG" onchange="filterMenu()">
            <span class="px-4 py-2 rounded-full border border-gray-200 text-sm font-semibold text-gray-600 peer-checked:bg-red-50 peer-checked:text-red-700 peer-checked:border-red-300 transition-colors">Non-Veg</span>
          </label>
          <label class="cursor-pointer">
            <input type="checkbox" class="peer hidden dietary-filter" value="VEGAN" onchange="filterMenu()">
            <span class="px-4 py-2 rounded-full border border-gray-200 text-sm font-semibold text-gray-600 peer-checked:bg-green-50 peer-checked:text-green-700 peer-checked:border-green-300 transition-colors">Vegan</span>
          </label>
        </div>
      </div>
    </div>

    <!-- MENU SECTION -->
    <div class="max-w-6xl mx-auto px-4 py-8 flex flex-col md:flex-row gap-4 sm:gap-6 lg:gap-8">

      <!-- CATEGORY SIDEBAR -->
      <div class="md:w-1/4">
        <div class="sticky top-24 bg-white rounded-2xl shadow-sm border border-gray-100 p-4">
          <h3 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4 px-2">Menu</h3>
          <nav id="categoryNav" class="category-nav flex md:flex-col gap-2 overflow-x-auto pb-2 md:pb-0">
            <!-- Categories populated here -->
            <div class="animate-pulse flex flex-col gap-3 w-full">
              <div class="h-8 bg-gray-100 rounded w-full"></div>
              <div class="h-8 bg-gray-100 rounded w-5/6"></div>
              <div class="h-8 bg-gray-100 rounded w-4/6"></div>
            </div>
          </nav>
        </div>
      </div>

      <!-- MENU ITEMS -->
      <div class="md:w-3/4">
        <div id="menuContainer" class="space-y-10">
          <!-- Menu skeleton -->
          <div class="animate-pulse space-y-6">
            <div class="h-6 bg-gray-200 rounded w-1/4"></div>
            <div class="bg-white p-4 rounded-2xl border border-gray-100 h-32"></div>
            <div class="bg-white p-4 rounded-2xl border border-gray-100 h-32"></div>
          </div>
        </div>
      </div>

    </div>

    <!-- VIEW CART FLOATING BAR -->
    <div id="floatingCartBar"
      class="fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 p-4 transform translate-y-full transition-transform duration-300 z-40 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)]">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        <div>
          <p class="text-sm text-gray-500 font-medium">Your Cart</p>
          <p id="floatingCartText" class="text-lg font-bold text-gray-900">0 items added</p>
        </div>
        <a href="/c/cart"
          class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-3 rounded-xl font-bold transition-colors flex items-center gap-2 shadow-sm">
          View Cart
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- MODIFIER MODAL -->
    <div id="modifierModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 backdrop-blur-sm p-4">
      <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg max-h-[90vh] flex flex-col overflow-hidden transform scale-95 opacity-0 transition-all duration-200" id="modifierModalContent">
        <div class="p-4 sm:p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50">
          <h3 class="text-xl font-extrabold text-gray-900" id="modalItemName">Customise Item</h3>
          <button onclick="closeModifierModal()" class="text-gray-400 hover:text-gray-600 p-2 bg-white rounded-full shadow-sm">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
        <div class="p-4 sm:p-6 overflow-y-auto flex-1 space-y-6 bg-white" id="modalModifierGroups">
        </div>
        <div class="p-4 sm:p-6 border-t border-gray-100 bg-gray-50">
           <textarea id="modalSpecialInstructions" maxlength="150" class="w-full p-3 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-orange-500 mb-4" placeholder="Add special instructions (optional, max 150 chars)..."></textarea>
           <button id="modalConfirmBtn" onclick="confirmModalAddToCart()" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 px-4 rounded-xl shadow-md transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
             Add to Cart | ₹<span id="modalTotalPrice">0</span>
           </button>
        </div>
      </div>
    </div>

    <%- include('../partials/toast') %>

      <script>
        // Extract ID from URL
        const urlParts = window.location.pathname.split('/');
        const branchId = urlParts[urlParts.length - 1];

        async function init() {
          await fetchBranchDetails();
          await fetchBranchMenu();
          checkActiveCart();
        }

        async function fetchBranchDetails() {
          try {
            const res = await fetch(`/restaurant/branch/${branchId}`);
            const result = await res.json();

            if (!result.success) throw new Error('Failed to load branch details');

            const branch = result.data;
            const r = branch.restaurant;

            // Hide skeleton, show header
            document.getElementById('headerSkeleton').classList.add('hidden');
            document.getElementById('restaurantHeader').classList.remove('hidden');

            // Populate header
            document.getElementById('restaurantName').textContent = `${r.businessName} - ${branch.branchName}`;
            document.getElementById('restaurantDesc').textContent = r.description || 'Amazing food delivered to you';
            document.getElementById('restaurantRating').textContent = r.reviews && r.reviews.length > 0 ? r.reviews[0].overallRating : 'New';
            document.getElementById('branchAddress').textContent = `${branch.address}, ${branch.city}`;
            document.getElementById('branchPhone').textContent = branch.phoneNumber || r.phoneNumber || 'Not available';

            if (r.coverImageUrl) {
              const cover = document.getElementById('coverImage');
              cover.src = r.coverImageUrl;
              cover.classList.remove('hidden');
            }

            if (r.logoUrl) {
              const logo = document.getElementById('logoImage');
              logo.src = r.logoUrl;
              logo.classList.remove('hidden');
            }

          } catch (error) {
            showToast('Error loading branch details', 'error');
            console.error(error);
          }
        }

        async function fetchBranchMenu() {
          try {
            const res = await fetch(`/restaurant/branch/${branchId}/menu`);
            const result = await res.json();

            if (!result.success || !result.data) {
              throw new Error('Menu data not found');
            }

            globalMenuData = result.data; // Store globally for filtering/modals
            const categories = globalMenuData.filter(c => c.menuItems && c.menuItems.length > 0);

            renderCategoryNav(categories);
            renderMenu(categories);

          } catch (error) {
            document.getElementById('menuContainer').innerHTML = '<p class="text-center text-gray-500 py-8">Menu is currently unavailable.</p>';
            console.error(error);
          }
        }

        function renderCategoryNav(categories) {
          const nav = document.getElementById('categoryNav');
          nav.innerHTML = '';

          categories.forEach(cat => {
            const link = document.createElement('a');
            link.href = `#category-${cat.id}`;
            link.className = 'whitespace-nowrap md:whitespace-normal px-4 py-2 rounded-xl text-sm font-semibold text-gray-600 hover:bg-orange-50 hover:text-orange-600 transition-colors cursor-pointer text-left';
            link.textContent = cat.name;

            link.onclick = (e) => {
              e.preventDefault();
              document.getElementById(`category-${cat.id}`).scrollIntoView({ behavior: 'smooth', block: 'start' });
            };

            nav.appendChild(link);
          });
        }

        function renderMenu(categories) {
          const container = document.getElementById('menuContainer');
          container.innerHTML = '';

          if (categories.length === 0) {
            container.innerHTML = '<p class="text-gray-500 text-center py-8">No menu items found.</p>';
            return;
          }

          categories.forEach(category => {
            const section = document.createElement('section');
            section.id = `category-${category.id}`;
            section.className = 'scroll-mt-24'; // Offset for sticky navbar

            // Section Title
            section.innerHTML = `
          <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-2">
            ${category.name}
            <span class="text-sm font-normal text-gray-400 bg-gray-100 px-2 py-0.5 rounded-full">${category.menuItems.length}</span>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="grid-${category.id}"></div>
        `;

            container.appendChild(section);

            const grid = section.querySelector(`#grid-${category.id}`);

            category.menuItems.forEach(item => {
              // Food type icon
              let foodIcon = '';
              if (item.foodType === 'VEG') {
                foodIcon = '<span class="inline-block w-4 h-4 border-2 border-green-600 rounded-sm flex items-center justify-center" title="Veg"><span class="w-2 h-2 bg-green-600 rounded-full"></span></span>';
              } else if (item.foodType === 'NON_VEG') {
                foodIcon = '<span class="inline-block w-4 h-4 border-2 border-red-600 rounded-sm flex items-center justify-center" title="Non-Veg"><span class="w-2 h-2 bg-red-600 rounded-full"></span></span>';
              } else if (item.foodType === 'VEGAN') {
                foodIcon = '<span class="inline-block w-4 h-4 border-2 border-green-400 rounded-sm flex items-center justify-center" title="Vegan"><span class="w-2 h-2 bg-green-400 rounded-full"></span></span>';
              }

              const isBestseller = item.isBestseller ? '<span class="absolute top-2 left-2 bg-orange-500 text-white text-xs font-bold px-2 py-1 rounded-md shadow-sm z-10 flex items-center gap-1">✨ Bestseller</span>' : '';
              const isAvailable = item.isAvailable;
              const cardOpacity = isAvailable ? '' : 'opacity-60 grayscale-[50%]';
              const outOfStockOverlay = !isAvailable ? '<div class="absolute inset-0 bg-white/40 z-20 flex items-center justify-center backdrop-blur-[1px] rounded-2xl"><span class="bg-black/80 text-white font-bold px-4 py-2 rounded-lg transform -rotate-12 shadow-lg tracking-wider border border-white/20">OUT OF STOCK</span></div>' : '';

              const card = document.createElement('div');
              card.className = `menu-item-card bg-white rounded-2xl p-4 border border-gray-100 hover:shadow-md transition-shadow flex flex-col justify-between h-full relative ${cardOpacity}`;
              card.setAttribute('data-name', item.name.toLowerCase());
              card.setAttribute('data-foodtype', item.foodType || '');
              
              const dietaryTags = item.dietaryTags || [];
              let dietaryStr = Array.isArray(dietaryTags) ? dietaryTags.join(',') : (typeof dietaryTags === 'string' ? dietaryTags : '');
              card.setAttribute('data-dietary', dietaryStr.toLowerCase());

              card.innerHTML = `
            ${outOfStockOverlay}
            ${isBestseller}
            <div>
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  ${foodIcon}
                  <h3 class="font-bold text-gray-900 mt-1">${item.name}</h3>
                  <p class="font-bold text-gray-700 mt-1">₹${item.basePrice}</p>
                </div>
                ${item.images && item.images.length > 0 ? `
                  <div class="w-28 h-28 rounded-xl overflow-hidden flex-shrink-0 relative bg-gray-100">
                    <img src="${item.images[0].imageUrl}" alt="${item.name}" class="w-full h-full object-cover" />
                  </div>
                ` : ''}
              </div>
              ${item.description ? `<p class="text-sm text-gray-500 mt-3 line-clamp-2">${item.description}</p>` : ''}
            </div>
            
            <div class="mt-4 flex justify-end z-30 relative">
              <button onclick="handleAddToCartClick('${item.id}', this)" class="add-to-cart-btn bg-orange-50 text-orange-600 border border-orange-200 font-bold px-6 py-2 rounded-xl hover:bg-orange-100 hover:border-orange-300 transition-colors shadow-sm" ${!isAvailable ? 'disabled' : ''}>
                ADD
              </button>
            </div>
          `;

              grid.appendChild(card);
            });
          });
        }

        let globalMenuData = [];

        function filterMenu() {
          const searchQuery = document.getElementById('menuSearchInput').value.toLowerCase();
          const checkboxes = document.querySelectorAll('.dietary-filter:checked');
          const selectedTags = Array.from(checkboxes).map(cb => cb.value.toLowerCase());

          const cards = document.querySelectorAll('.menu-item-card');
          cards.forEach(card => {
            const name = card.getAttribute('data-name');
            const foodType = card.getAttribute('data-foodtype').toLowerCase();
            const dietary = card.getAttribute('data-dietary');

            const matchesSearch = name.includes(searchQuery);
            const matchesTags = selectedTags.length === 0 || selectedTags.some(tag => foodType.includes(tag) || dietary.includes(tag));

            if (matchesSearch && matchesTags) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        }

        // Modifiers State
        let currentModalItem = null;

        function handleAddToCartClick(itemId, btn) {
          const item = findItemInGlobalData(itemId);
          if (!item) return;

          if (item.modifierGroups && item.modifierGroups.length > 0) {
             openModifierModal(item);
          } else {
             // For standard items without modifiers, open modal anyway to allow special instructions
             openModifierModal(item);
          }
        }

        function findItemInGlobalData(itemId) {
          for (let cat of globalMenuData) {
            for (let item of cat.menuItems) {
              if (item.id == itemId) return item;
            }
          }
          return null;
        }

        function openModifierModal(item) {
          currentModalItem = item;
          document.getElementById('modalItemName').textContent = item.name;
          document.getElementById('modalSpecialInstructions').value = '';
          
          const groupsContainer = document.getElementById('modalModifierGroups');
          groupsContainer.innerHTML = '';

          if (item.modifierGroups && item.modifierGroups.length > 0) {
            item.modifierGroups.forEach(mg => {
              const group = mg.modifierGroup;
              const isRadio = group.maxSelection === 1;
              const requiredLabel = group.isRequired ? '<span class="text-xs bg-red-100 text-red-600 px-2 py-0.5 rounded-full">Required</span>' : '<span class="text-xs text-gray-400">Optional</span>';
              
              let optionsHtml = '';
              group.options.forEach(opt => {
                const inputType = isRadio ? 'radio' : 'checkbox';
                const inputName = `modifierGroup_${group.id}`;
                optionsHtml += `
                  <label class="flex items-center justify-between p-3 border border-gray-100 rounded-xl hover:bg-orange-50 cursor-pointer transition-colors group">
                    <div class="flex flex-wrap items-center gap-3">
                      <input type="${inputType}" name="${inputName}" value="${opt.id}" data-price="${opt.additionalPrice}" onchange="calculateModalPrice()" class="w-4 h-4 text-orange-500 border-gray-300 focus:ring-orange-500">
                      <span class="text-gray-700 font-medium group-hover:text-orange-700">${opt.optionName}</span>
                    </div>
                    <span class="text-gray-500 text-sm border border-gray-100 px-2 py-1 rounded-md bg-white group-hover:bg-orange-50">₹${opt.additionalPrice}</span>
                  </label>
                `;
              });

              groupsContainer.innerHTML += `
                <div class="modifier-group-block" data-group-id="${group.id}" data-min="${group.minSelection}" data-max="${group.maxSelection}" data-required="${group.isRequired}">
                  <div class="flex items-center gap-2 mb-3">
                    <h4 class="font-bold text-gray-900">${group.name}</h4>
                    ${requiredLabel}
                    <span class="text-xs text-gray-400 ml-auto">Select ${group.minSelection === group.maxSelection ? group.minSelection : group.minSelection + ' to ' + group.maxSelection}</span>
                  </div>
                  <div class="space-y-2">
                    ${optionsHtml}
                  </div>
                </div>
              `;
            });
          }

          calculateModalPrice();

          const modal = document.getElementById('modifierModal');
          const content = document.getElementById('modifierModalContent');
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          // small delay for transition
          setTimeout(() => {
            content.classList.remove('scale-95', 'opacity-0');
            content.classList.add('scale-100', 'opacity-100');
          }, 10);
        }

        function closeModifierModal() {
          const modal = document.getElementById('modifierModal');
          const content = document.getElementById('modifierModalContent');
          
          content.classList.remove('scale-100', 'opacity-100');
          content.classList.add('scale-95', 'opacity-0');
          setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            currentModalItem = null;
          }, 200);
        }

        function calculateModalPrice() {
          if (!currentModalItem) return;
          let total = parseFloat(currentModalItem.basePrice);
          const checkedOpts = document.querySelectorAll('#modalModifierGroups input:checked');
          checkedOpts.forEach(opt => {
            total += parseFloat(opt.getAttribute('data-price') || 0);
          });
          document.getElementById('modalTotalPrice').textContent = total.toFixed(2);
        }

        function validateModifiers() {
          let isValid = true;
          const blocks = document.querySelectorAll('.modifier-group-block');
          blocks.forEach(block => {
            const min = parseInt(block.getAttribute('data-min'));
            const max = parseInt(block.getAttribute('data-max'));
            const isRequired = block.getAttribute('data-required') === 'true';
            const checkedCount = block.querySelectorAll('input:checked').length;

            if (isRequired && checkedCount < min) isValid = false;
            if (checkedCount > max) isValid = false;
          });
          return isValid;
        }

        async function confirmModalAddToCart() {
          if (!validateModifiers()) {
            showToast('Please fulfill modifier requirements', 'error');
            return;
          }

          const btn = document.getElementById('modalConfirmBtn');
          const originalText = btn.innerHTML;
          btn.textContent = 'ADDING...';
          btn.disabled = true;

          const checkedOpts = document.querySelectorAll('#modalModifierGroups input:checked');
          const modifiers = Array.from(checkedOpts).map(opt => ({
            modifierOptionId: opt.value,
            additionalPrice: parseFloat(opt.getAttribute('data-price') || 0)
          }));
          const specialInstructions = document.getElementById('modalSpecialInstructions').value.trim();

          try {
             await addToCart(currentModalItem.id, null, modifiers, specialInstructions);
             closeModifierModal();
          } catch(err) {
             console.error(err);
             showToast('Failed to add item', 'error');
          } finally {
             btn.innerHTML = originalText;
             btn.disabled = false;
          }
        }

        async function addToCart(menuItemId, btn, modifiers = [], specialInstructions = '') {
          if (!branchId) {
            showToast('Restaurant is currently unavailable for ordering', 'error');
            return;
          }

          if (btn) {
             // If called directly from button (fallback), add visual feedback
             const originalText = btn.textContent;
             btn.textContent = 'ADDING...';
             btn.disabled = true;
          }

          try {
            const res = await fetch('/cart/items', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                menuItemId: Number(menuItemId),
                restaurantBranchId: Number(branchId),
                quantity: 1,
                modifiers,
                specialInstructions
              })
            });

            const contentType = res.headers.get("content-type");
            if (contentType && contentType.includes("text/html")) {
              // Unauthenticated response rendered HTML
              localStorage.setItem('redirectAfterLogin', window.location.pathname);
              window.location.href = '/loginPage';
              return;
            }

            const data = await res.json();

            if (!res.ok) {
              throw new Error(data.message || 'Failed to add item');
            }

            showToast('Added to cart', 'success');
            updateCartUI(data.data); // data.data is usually the updated cart or item

          } catch (err) {
            console.error(err);
            throw err; // Propagate to caller
          } finally {
            if (btn) {
               // Restore button state if it was passed
               btn.textContent = 'ADD'; // Restore original text... or hardcode 'ADD' since it was the original text
               btn.disabled = false;
            }
          }
        }

        // Function to check cart size and show floating bar
        async function checkActiveCart() {
          try {
            const res = await fetch('/cart');

            const contentType = res.headers.get("content-type");
            if (contentType && contentType.includes("text/html")) {
              return; // Not authenticated
            }

            if (res.ok) {
              const data = await res.json();
              if (data.status === 'success' && data.data) {
                updateCartUI(data.data);
              }
            }
          } catch (err) {
            console.error('Could not fetch cart', err);
          }
        }

        function updateCartUI(cart) {
          if (!cart || !cart.items) return;

          const totalItems = cart.items.reduce((sum, item) => sum + item.quantity, 0);

          const badge = document.getElementById('cartBadge');
          const floatingBar = document.getElementById('floatingCartBar');
          const floatingText = document.getElementById('floatingCartText');

          if (totalItems > 0) {
            badge.textContent = totalItems;
            badge.classList.remove('hidden');

            floatingText.textContent = `${totalItems} item${totalItems > 1 ? 's' : ''} added`;
            floatingBar.classList.remove('translate-y-full');
          } else {
            badge.classList.add('hidden');
            floatingBar.classList.add('translate-y-full');
          }
        }

        document.addEventListener('DOMContentLoaded', init);
      </script>
  </div>
  <%- include('../partials/customer-sidebar') %>
</body>

</html>